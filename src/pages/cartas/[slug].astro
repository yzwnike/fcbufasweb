---
import Layout from "../../layouts/Layout.astro";
import { players } from "../../lib/players";
import { GROUPS, STAT_LABELS } from "../../lib/fc26";

const { slug } = Astro.params;
const player = players.find((p) => p.slug === slug);

if (!player) {
  throw new Error("Jugador no encontrado");
}
---

<Layout title={`${player.name} | Carta`} description={`Atributos y substats de ${player.name}`}>
  <section class="relative z-10 px-4 md:px-6 py-8 md:py-12 max-w-7xl mx-auto">
    <a href="/cartas" class="inline-block mb-4 text-white/90 hover:text-white transition">← Volver</a>

    <div class="rounded-2xl border border-white/10 bg-black/60 backdrop-blur-md shadow-2xl p-4 md:p-6">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8 items-start">
        <div class="md:sticky md:top-24 md:self-start">
          <img
            src={player.image}
            alt={`Carta de ${player.name}`}
            width="340"
            height="476"
            class="w-[260px] md:w-[320px] h-auto rounded-xl border border-white/10 shadow-xl"
          />
        </div>

        <div class="md:col-span-2 min-w-[260px]">
          <header class="mb-4">
            <h1 class="text-2xl md:text-3xl font-extrabold text-white drop-shadow">{player.name}</h1>
            <div class="mt-2 flex flex-wrap items-center gap-3 text-white/90">
              {typeof player.overall === 'number' && (
                <span class="inline-flex items-center gap-1 text-sm font-bold text-black bg-yellow-300/90 rounded px-2 py-0.5 shadow">OVR {player.overall}</span>
              )}
              {typeof player.filigranas === 'number' && (
                <span class="inline-flex items-center gap-1 text-xs bg-white/10 rounded px-2 py-0.5">Filigranas: {"★".repeat(player.filigranas)}</span>
              )}
              {typeof player.pierna_mala === 'number' && (
                <span class="inline-flex items-center gap-1 text-xs bg-white/10 rounded px-2 py-0.5">Pierna mala: {"★".repeat(player.pierna_mala)}</span>
              )}
            </div>
          </header>

          <p class="text-white/80 mb-4">Substats (formato FC 26)</p>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {
              Object.entries(GROUPS).map(([key, group]) => {
                const k = key as keyof typeof GROUPS;
                const s = player.stats?.[k];
                return (
                  <article class="rounded-xl border border-white/10 bg-black/40 backdrop-blur p-4 text-white">
                    <h2 class="text-base font-semibold mb-2">{group.label}{s?.total ? ` · ${s.total}` : ''}</h2>
                    <ul class="space-y-1 text-sm">
                      {group.sub.map((subKey) => (
                        <li class="flex justify-between gap-2">
                          <span class="text-white/80">{STAT_LABELS[subKey]}:</span>
                          <strong>{(s as any)?.[subKey] ?? '—'}</strong>
                        </li>
                      ))}
                    </ul>
                  </article>
                );
              })
            }
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

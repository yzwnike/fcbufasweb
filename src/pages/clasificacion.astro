---
import Layout from '@/layouts/Layout.astro'
import { clasificacion, type EquipoClasificacion } from '@/consts/clasificacion'

const title = 'Clasificación de Liga | FC Bufas'
const description = 'Tabla de clasificación actualizada de la liga de fútbol donde participa FC Bufas'
---

<Layout title={title} description={description}>
  <main class="relative min-h-screen pt-20">
    <!-- Fondo con degradado -->
    <div class="absolute inset-0 bg-gradient-to-br from-orange-50 via-white to-orange-100"></div>
    
    <!-- Contenido principal -->
    <div class="relative z-10 mx-auto max-w-7xl px-4 py-8">
      <!-- Header de la página -->
      <div class="text-center mb-12">
        <h1 class="text-4xl md:text-6xl font-bold text-gray-900 mb-4">
          Clasificación
        </h1>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          Tabla de clasificación actualizada de la liga de fútbol
        </p>
      </div>

      <!-- Tabla de clasificación -->
      <div class="bg-white rounded-2xl shadow-xl overflow-hidden border border-orange-200">
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead class="bg-gradient-to-r from-orange-500 to-orange-600 text-white">
              <tr>
                <th class="px-4 py-4 text-center font-bold text-sm uppercase tracking-wider">Pos</th>
                <th class="px-6 py-4 text-left font-bold text-sm uppercase tracking-wider">Equipo</th>
                <th class="px-4 py-4 text-center font-bold text-sm uppercase tracking-wider">PJ</th>
                <th class="px-4 py-4 text-center font-bold text-sm uppercase tracking-wider">Pts</th>
                <th class="px-4 py-4 text-center font-bold text-sm uppercase tracking-wider">G</th>
                <th class="px-4 py-4 text-center font-bold text-sm uppercase tracking-wider">E</th>
                <th class="px-4 py-4 text-center font-bold text-sm uppercase tracking-wider">P</th>
                <th class="px-4 py-4 text-center font-bold text-sm uppercase tracking-wider">GF</th>
                <th class="px-4 py-4 text-center font-bold text-sm uppercase tracking-wider">GC</th>
                <th class="px-4 py-4 text-center font-bold text-sm uppercase tracking-wider">DG</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
              {clasificacion.map((equipo: EquipoClasificacion, index) => (
                <tr class={`
                  ${equipo.nombre === 'Fc Bufas' ? 'bg-orange-50 border-l-4 border-orange-500' : 'hover:bg-gray-50'}
                  transition-colors duration-200
                `}>
                  <td class="px-4 py-4 text-center">
                    <span class="inline-flex items-center justify-center w-8 h-8 rounded-full text-sm font-bold bg-gray-100 text-gray-800">
                      {equipo.posicion}
                    </span>
                  </td>
                  <td class="px-6 py-4">
                    <div class="flex items-center">
                      <div class={`
                        w-3 h-3 rounded-full mr-3
                        ${equipo.nombre === 'Fc Bufas' ? 'bg-orange-500' : 'bg-gray-300'}
                      `}></div>
                      <span class={`
                        font-semibold text-sm
                        ${equipo.nombre === 'Fc Bufas' ? 'text-orange-700' : 'text-gray-900'}
                      `}>
                        {equipo.nombre}
                      </span>
                    </div>
                  </td>
                  <td class="px-4 py-4 text-center text-sm text-gray-700 font-medium">
                    {equipo.partidosJugados}
                  </td>
                  <td class="px-4 py-4 text-center">
                    <span class="text-sm font-bold text-gray-900">
                      {equipo.puntos}
                    </span>
                  </td>
                  <td class="px-4 py-4 text-center text-sm text-green-600 font-medium">
                    {equipo.ganados}
                  </td>
                  <td class="px-4 py-4 text-center text-sm text-yellow-600 font-medium">
                    {equipo.empatados}
                  </td>
                  <td class="px-4 py-4 text-center text-sm text-red-600 font-medium">
                    {equipo.perdidos}
                  </td>
                  <td class="px-4 py-4 text-center text-sm text-gray-700 font-medium">
                    {equipo.golesFavor}
                  </td>
                  <td class="px-4 py-4 text-center text-sm text-gray-700 font-medium">
                    {equipo.golesContra}
                  </td>
                  <td class="px-4 py-4 text-center">
                    <span class={`
                      text-sm font-bold
                      ${equipo.diferencia > 0 ? 'text-green-600' : 
                        equipo.diferencia < 0 ? 'text-red-600' : 'text-gray-600'}
                    `}>
                      {equipo.diferencia > 0 ? '+' : ''}{equipo.diferencia}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Leyenda -->
      <div class="mt-8 text-center text-sm text-gray-500">
        <div class="flex flex-wrap justify-center gap-6">
          <div class="flex items-center">
            <div class="w-3 h-3 bg-orange-500 rounded-full mr-2"></div>
            <span>FC Bufas</span>
          </div>
        </div>
        <p class="mt-4">
          <strong>PJ:</strong> Partidos Jugados | 
          <strong>Pts:</strong> Puntos | 
          <strong>G:</strong> Ganados | 
          <strong>E:</strong> Empatados | 
          <strong>P:</strong> Perdidos | 
          <strong>GF:</strong> Goles a Favor | 
          <strong>GC:</strong> Goles en Contra | 
          <strong>DG:</strong> Diferencia de Goles
        </p>
      </div>
    </div>
  </main>
</Layout>

<style>
  /* Animación suave para las filas */
  tbody tr {
    transition: all 0.2s ease;
  }
  
  tbody tr:hover {
    transform: translateX(2px);
  }

  /* Responsive adjustments */
  @media (max-width: 768px) {
    .overflow-x-auto {
      font-size: 0.875rem;
    }
    
    th, td {
      padding: 0.5rem 0.25rem;
    }
    
    th:first-child, td:first-child,
    th:nth-child(2), td:nth-child(2) {
      position: sticky;
      left: 0;
      background: white;
      z-index: 10;
    }
    
    th:first-child, th:nth-child(2) {
      background: linear-gradient(to right, rgb(249 115 22), rgb(234 88 12));
    }
  }
</style>

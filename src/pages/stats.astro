      valorTotal: 58000000
    },
    {
      id: 'perma',
      name: 'Perma',
      realName: 'Marc Pemanyer',
      position: 'DFC',
      bio: 'Nuevo fichaje en defensa central, Perma aporta solidez y experiencia a la línea defensiva del FC Bufas. Su llegada refuerza la plantilla con su físico imponente y su capacidad de liderazgo.',
      goles: 0,
      asistencias: 1,
      partidos: 4,
      puntos: 21,
      valor: 15,
      valorTotal: 62000000
    }
  ]
  
function initializePlayerStats() {
    const fieldPlayers = document.querySelectorAll('.field-player')
    const statsContainer = document.getElementById('player-stats')
    let currentSelectedPlayer = null
    
    // Evitar reinicializar si ya está inicializado
    if (statsContainer && statsContainer.hasAttribute('data-initialized')) {
      return
    }
    
    console.log('Stats container found:', statsContainer) // Debug
    console.log('Field players found:', fieldPlayers.length) // Debug
    
    function updatePlayerStats(playerId) {
      const player = FIGHTERS_DATA.find(f => f.id === playerId)
      console.log('Updating stats for:', playerId, player) // Debug
      if (!player || !statsContainer) {
        console.log('Missing player or container:', { player, statsContainer }) // Debug
        return
      }
      
      statsContainer.innerHTML = `
        <div class="space-y-4">
          <div class="text-center">
            <h3 class="text-2xl font-bold text-gray-900 mb-2">${player.name}</h3>
            <p class="text-gray-600 text-sm">${player.realName}</p>
            <p class="text-gray-500 text-sm">${player.position}</p>
          </div>
          
          <div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
            <div class="bg-orange-50 rounded-lg p-4 text-center">
              <div class="text-2xl font-bold text-orange-600">${player.goles}</div>
              <div class="text-sm text-gray-600">Goles</div>
            </div>
            
            <div class="bg-blue-50 rounded-lg p-4 text-center">
              <div class="text-2xl font-bold text-blue-600">${player.asistencias}</div>
              <div class="text-xs text-gray-600 text-center w-full">Asistencias</div>
            </div>
            
            <div class="bg-green-50 rounded-lg p-4 text-center">
              <div class="text-2xl font-bold text-green-600">${player.partidos}</div>
              <div class="text-sm text-gray-600">Partidos</div>
            </div>
            
            <div class="bg-yellow-50 rounded-lg p-4 text-center">
              <div class="text-2xl font-bold text-yellow-600">${player.puntos || 0}</div>
              <div class="text-sm text-gray-600">Puntos</div>
            </div>
          </div>
          
<div class="mt-4">
            <h4 class="font-semibold text-gray-900 mb-2">Biografía</h4>
            <p class="text-gray-700 text-sm leading-relaxed">${player.bio}</p>
          </div>
          
          <div class="mt-4">
            <div class="bg-gradient-to-r from-yellow-50 to-orange-50 rounded-lg p-4 border border-yellow-200">
              <div class="flex items-center justify-between">
                <div>
                  <h4 class="font-semibold text-gray-900 mb-1">💰 Valor Total</h4>
                  <p class="text-2xl font-bold text-yellow-600">${new Intl.NumberFormat('es-ES', { style: 'currency', currency: 'EUR', minimumFractionDigits: 0, maximumFractionDigits: 0 }).format(player.valorTotal)}</p>
                  <p class="text-xs text-gray-600 mt-1">Valor de mercado actual</p>
                </div>
                <div class="text-4xl opacity-20">💎</div>
              </div>
            </div>
        </div>
      `
    }
    
    function resetStats() {
      if (!statsContainer) return
      statsContainer.innerHTML = `
        <div class="text-center py-8">
          <div class="text-6xl mb-4">⚽</div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">Estadísticas FC Bufas</h3>
          <p class="text-gray-600">Pasa el cursor sobre un jugador para ver sus estadísticas</p>
        </div>
      `
    }
    
    function selectPlayer(playerId, playerElement) {
      // Deseleccionar jugador anterior
      if (currentSelectedPlayer) {
        currentSelectedPlayer.classList.remove('selected')
      }
      
      // Seleccionar nuevo jugador
      currentSelectedPlayer = playerElement
      playerElement.classList.add('selected')
      updatePlayerStats(playerId)
    }
    
    function deselectPlayer() {
      if (currentSelectedPlayer) {
        currentSelectedPlayer.classList.remove('selected')
        currentSelectedPlayer = null
      }
      resetStats()
    }
    
    // Click en el campo para deseleccionar
    document.querySelector('.field-container').addEventListener('click', (e) => {
      if (e.target.classList.contains('field-container') || e.target.classList.contains('bg-black/10')) {
        deselectPlayer()
      }
    })
    
    // Marcar como inicializado
    if (statsContainer) {
      statsContainer.setAttribute('data-initialized', 'true')
    }
    
    fieldPlayers.forEach(player => {
      // Para desktop: mouseenter/mouseleave (solo si no hay jugador seleccionado)
      player.addEventListener('mouseenter', () => {
        if (!currentSelectedPlayer) {
          const playerId = player.getAttribute('data-player-id')
          if (playerId) {
            updatePlayerStats(playerId)
          }
        }
      })
      
      player.addEventListener('mouseleave', () => {
        if (!currentSelectedPlayer) {
          resetStats()
        }
      })
      
      // Click para seleccionar/deseleccionar
      player.addEventListener('click', (e) => {
        e.preventDefault()
        e.stopPropagation()
        const playerId = player.getAttribute('data-player-id')
        
        if (playerId) {
          if (currentSelectedPlayer === player) {
            // Si es el mismo jugador, deseleccionar
            deselectPlayer()
          } else {
            // Seleccionar nuevo jugador
            selectPlayer(playerId, player)
          }
        }
      })
    })
}

  // Ejecutar inmediatamente si el DOM ya está listo
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializePlayerStats)
  } else {
    initializePlayerStats()
  }
  
  // Soporte para navegación SPA y View Transitions
  // Reinicializar cuando se navega a esta página
  document.addEventListener('astro:page-load', initializePlayerStats)
  
  // Fallback para navegación con history API
  window.addEventListener('popstate', () => {
    // Solo reinicializar si estamos en la página de stats
    if (window.location.pathname.includes('/stats')) {
      setTimeout(initializePlayerStats, 100)
    }
  })
</script>

<style>
  /* Fondo animado base */
  .animated-bg {
    background: linear-gradient(-45deg, #000000, #1a1a1a, #ff4500, #ff6b35, #000000, #2d1810);
    background-size: 400% 400%;
    animation: gradientShift 15s ease infinite;
  }
  
  @keyframes gradientShift {
    0% { background-position: 0% 50%; }
    25% { background-position: 100% 50%; }
    50% { background-position: 100% 100%; }
    75% { background-position: 50% 100%; }
    100% { background-position: 0% 50%; }
  }
  
  /* Partículas grandes */
  .particle {
    position: absolute;
    border-radius: 50%;
    background: linear-gradient(45deg, #ff4500, #ff6b35, #ffa500);
    opacity: 0.3;
    filter: blur(1px);
  }
  
  .particle-1 { width: 80px; height: 80px; top: 10%; left: 20%; }
  .particle-2 { width: 60px; height: 60px; top: 70%; right: 15%; }
  .particle-3 { width: 100px; height: 100px; top: 30%; right: 30%; }
  .particle-4 { width: 70px; height: 70px; bottom: 20%; left: 10%; }
  .particle-5 { width: 90px; height: 90px; top: 50%; left: 70%; }
  .particle-6 { width: 50px; height: 50px; bottom: 40%; right: 20%; }
  
  /* Partículas medianas */
  .particle-medium {
    position: absolute;
    border-radius: 50%;
    background: radial-gradient(circle, #ff6b35, #ff4500);
    opacity: 0.4;
    filter: blur(0.5px);
    width: 30px;
    height: 30px;
  }
  
  .pm-1 { top: 15%; left: 10%; }
  .pm-2 { top: 25%; right: 25%; }
  .pm-3 { bottom: 30%; left: 30%; }
  .pm-4 { top: 60%; left: 15%; }
  .pm-5 { bottom: 15%; right: 35%; }
  .pm-6 { top: 45%; right: 10%; }
  .pm-7 { bottom: 60%; left: 60%; }
  .pm-8 { top: 80%; right: 50%; }
  
  /* Partículas pequeñas */
  .particle-small {
    position: absolute;
    border-radius: 50%;
    background: #ff6b35;
    opacity: 0.6;
    width: 8px;
    height: 8px;
    box-shadow: 0 0 10px #ff4500;
  }
  
  .ps-1 { top: 20%; left: 25%; }
  .ps-2 { top: 35%; right: 20%; }
  .ps-3 { bottom: 25%; left: 15%; }
  .ps-4 { top: 65%; left: 45%; }
  .ps-5 { bottom: 45%; right: 15%; }
  .ps-6 { top: 15%; right: 40%; }
  .ps-7 { bottom: 20%; left: 55%; }
  .ps-8 { top: 75%; right: 30%; }
  .ps-9 { bottom: 35%; left: 80%; }
  .ps-10 { top: 40%; left: 5%; }
  
  /* Efectos de luz */
  .light-effect {
    position: absolute;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 107, 53, 0.3), transparent);
    filter: blur(40px);
  }
  
  .light-1 {
    width: 300px;
    height: 300px;
    top: 10%;
    left: -50px;
    animation: lightPulse 8s ease-in-out infinite;
  }
  
  .light-2 {
    width: 400px;
    height: 400px;
    bottom: 10%;
    right: -100px;
    animation: lightPulse 6s ease-in-out infinite reverse;
  }
  
  .light-3 {
    width: 250px;
    height: 250px;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    animation: lightPulse 10s ease-in-out infinite;
  }
  
  @keyframes lightPulse {
    0%, 100% { opacity: 0.3; transform: scale(1); }
    50% { opacity: 0.6; transform: scale(1.2); }
  }
  
  /* Animaciones de las partículas */
  .particle {
    animation: float 20s ease-in-out infinite;
  }
  
  .particle-1 { animation-delay: 0s; }
  .particle-2 { animation-delay: 2s; }
  .particle-3 { animation-delay: 4s; }
  .particle-4 { animation-delay: 6s; }
  .particle-5 { animation-delay: 8s; }
  .particle-6 { animation-delay: 10s; }
  
  .particle-medium {
    animation: floatMedium 15s linear infinite;
  }
  
  .pm-1 { animation-delay: 1s; }
  .pm-2 { animation-delay: 3s; }
  .pm-3 { animation-delay: 5s; }
  .pm-4 { animation-delay: 7s; }
  .pm-5 { animation-delay: 9s; }
  .pm-6 { animation-delay: 11s; }
  .pm-7 { animation-delay: 13s; }
  .pm-8 { animation-delay: 2s; }
  
  .particle-small {
    animation: floatSmall 12s linear infinite;
  }
  
  .ps-1 { animation-delay: 0.5s; }
  .ps-2 { animation-delay: 1.5s; }
  .ps-3 { animation-delay: 2.5s; }
  .ps-4 { animation-delay: 3.5s; }
  .ps-5 { animation-delay: 4.5s; }
  .ps-6 { animation-delay: 5.5s; }
  .ps-7 { animation-delay: 6.5s; }
  .ps-8 { animation-delay: 7.5s; }
  .ps-9 { animation-delay: 8.5s; }
  .ps-10 { animation-delay: 9.5s; }
  
  @keyframes float {
    0%, 100% { transform: translateY(0px) rotate(0deg); }
    25% { transform: translateY(-20px) rotate(90deg); }
    50% { transform: translateY(-10px) rotate(180deg); }
    75% { transform: translateY(-30px) rotate(270deg); }
  }
  
  @keyframes floatMedium {
    0% { transform: translateY(0px) translateX(0px) scale(1); opacity: 0.4; }
    25% { transform: translateY(-50px) translateX(20px) scale(1.2); opacity: 0.6; }
    50% { transform: translateY(-30px) translateX(-10px) scale(0.8); opacity: 0.3; }
    75% { transform: translateY(-70px) translateX(30px) scale(1.1); opacity: 0.5; }
    100% { transform: translateY(0px) translateX(0px) scale(1); opacity: 0.4; }
  }
  
  @keyframes floatSmall {
    0% { transform: translateY(0px) scale(1); opacity: 0.6; }
    33% { transform: translateY(-100px) scale(1.5); opacity: 1; }
    66% { transform: translateY(-50px) scale(0.8); opacity: 0.4; }
    100% { transform: translateY(0px) scale(1); opacity: 0.6; }
  }
  
  /* Efectos de resplandor */
  .particle::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle, rgba(255, 107, 53, 0.1), transparent);
    border-radius: 50%;
    animation: glow 4s ease-in-out infinite alternate;
  }
  
  @keyframes glow {
    0% { opacity: 0.5; transform: scale(1); }
    100% { opacity: 1; transform: scale(1.2); }
  }
</style>

<!-- GSAP desde CDN -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>

<script>
  // GSAP Animaciones avanzadas para stats
  document.addEventListener('DOMContentLoaded', function() {
    // Timeline principal
    const tl = gsap.timeline();
    
    // Animación de entrada del fondo
    tl.from('.animated-bg', {
      duration: 2,
      opacity: 0,
      scale: 1.1,
      ease: 'power2.out'
    })
    
    // Animación de las partículas grandes
    .from('.particle', {
      duration: 1.5,
      opacity: 0,
      scale: 0,
      rotation: 180,
      stagger: 0.2,
      ease: 'back.out(1.7)'
    }, '-=1.5')
    
    // Animación de las partículas medianas
    .from('.particle-medium', {
      duration: 1,
      opacity: 0,
      y: 100,
      stagger: 0.1,
      ease: 'bounce.out'
    }, '-=1')
    
    // Animación de las partículas pequeñas
    .from('.particle-small', {
      duration: 0.8,
      opacity: 0,
      scale: 0,
      stagger: 0.05,
      ease: 'power2.out'
    }, '-=0.8')
    
    // Animación de los efectos de luz
    .from('.light-effect', {
      duration: 2,
      opacity: 0,
      scale: 0.5,
      stagger: 0.3,
      ease: 'power2.out'
    }, '-=1');
    
    // Animaciones continuas con GSAP
    gsap.to('.particle-1, .particle-3, .particle-5', {
      duration: 20,
      rotation: 360,
      repeat: -1,
      ease: 'none'
    });
    
    gsap.to('.particle-2, .particle-4, .particle-6', {
      duration: 25,
      rotation: -360,
      repeat: -1,
      ease: 'none'
    });
    
    // Movimiento suave de partículas medianas
    gsap.to('.particle-medium', {
      duration: 8,
      y: '-=30',
      x: '+=20',
      repeat: -1,
      yoyo: true,
      ease: 'sine.inOut',
      stagger: 0.5
    });
    
    // Pulsación de partículas pequeñas
    gsap.to('.particle-small', {
      duration: 2,
      scale: 1.5,
      opacity: 1,
      repeat: -1,
      yoyo: true,
      ease: 'power2.inOut',
      stagger: 0.2
    });
    
    // Efecto de paralaje en scroll
    if (typeof ScrollTrigger !== 'undefined') {
      gsap.registerPlugin(ScrollTrigger);
      
      gsap.to('.particle', {
        scrollTrigger: {
          trigger: 'body',
          start: 'top top',
          end: 'bottom top',
          scrub: true
        },
        y: -100,
        stagger: 0.1
      });
      
      // Animación del campo y panel de estadísticas
      gsap.from('.field-container, .bg-white\/90', {
        scrollTrigger: {
          trigger: '.field-container',
          start: 'top 80%',
          end: 'bottom 20%',
          toggleActions: 'play none none reverse'
        },
        duration: 1,
        y: 50,
        opacity: 0,
        scale: 0.9,
        stagger: 0.2,
        ease: 'back.out(1.7)'
      });
    }
    
    // Crear partículas dinámicas adicionales
    function createDynamicParticle() {
      const particle = document.createElement('div');
      particle.className = 'dynamic-particle';
      particle.style.cssText = `
        position: fixed;
        width: ${Math.random() * 6 + 2}px;
        height: ${Math.random() * 6 + 2}px;
        background: #ff6b35;
        border-radius: 50%;
        pointer-events: none;
        z-index: 5;
        box-shadow: 0 0 10px #ff4500;
        left: ${Math.random() * window.innerWidth}px;
        top: ${window.innerHeight + 10}px;
      `;
      
      document.body.appendChild(particle);
      
      gsap.to(particle, {
        duration: Math.random() * 8 + 5,
        y: -window.innerHeight - 100,
        x: Math.random() * 200 - 100,
        rotation: Math.random() * 360,
        opacity: 0,
        ease: 'power1.out',
        onComplete: () => particle.remove()
      });
    }
    
    // Crear partículas dinámicas cada cierto tiempo
    setInterval(createDynamicParticle, 3000);
    
    // Movimiento sutil de partículas siguiendo el mouse
    gsap.set('.particle-small', {
      transformOrigin: 'center'
    });
    
    document.addEventListener('mousemove', (e) => {
      const moveX = (e.clientX - window.innerWidth / 2) * 0.02;
      const moveY = (e.clientY - window.innerHeight / 2) * 0.02;
      
      gsap.to('.particle-small', {
        duration: 2,
        x: `+=${moveX}`,
        y: `+=${moveY}`,
        ease: 'power2.out'
      });
    });
  });
</script>

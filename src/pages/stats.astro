---
import Layout from '../layouts/Layout.astro'
import PlayerStats from '../components/PlayerStats.astro'
import FieldPlayer from '../components/FieldPlayer.astro'
import { FIGHTERS } from '../consts/fighters'

const title = 'Estadísticas y Jugadores - FC Bufas'
const description = 'Conoce a los jugadores y estadísticas del equipo FC Bufas para la temporada 2025/26.'
const canonical = 'https://www.fcbufasweb.vercel.app/stats'

// Filtrar jugadores con estadísticas (incluir todos)
const playersWithStats = FIGHTERS.filter(player => 
  player.goles !== undefined
)

// Definir formación 1-4-4-1 (sin contar portero son 10 jugadores)
// Posiciones para móvil
const formationMobile = {
  // Portero
  'yazawa': { top: '85%', left: '50%' },
  
  // Defensa (4 jugadores)
  'albert': { top: '68%', left: '15%' },      // Lateral izquierdo (LI)
  'mister': { top: '68%', left: '35%' },      // Defensa central (DFC)
  'perma': { top: '68%', left: '65%' }, // Defensa central (DFC)
  'pablo': { top: '68%', left: '85%' },       // Lateral derecho (LD)
  
  // Centrocampo (4 jugadores)
  'fan': { top: '45%', left: '15%' }, // Medio izquierdo (MI)
  'javo': { top: '45%', left: '40%' },        // Medio centro (MC)
  'mario': { top: '45%', left: '60%' },       // Medio centro (MC)
  'nicou': { top: '45%', left: '85%' },       // Medio derecho (MD)
  
  // Delantero (1 jugador)
  'marcos': { top: '20%', left: '50%' },      // Delantero centro (DC)
}

// Posiciones para desktop (subidas un poco)
const formationDesktop = {
  // Portero
  'yazawa': { top: '80%', left: '50%' },
  
  // Defensa (4 jugadores)
  'albert': { top: '63%', left: '15%' },      // Lateral izquierdo (LI)
  'mister': { top: '63%', left: '35%' },      // Defensa central (DFC)
  'perma': { top: '63%', left: '65%' }, // Defensa central (DFC)
  'pablo': { top: '63%', left: '85%' },       // Lateral derecho (LD)
  
  // Centrocampo (4 jugadores)
  'fan': { top: '40%', left: '15%' }, // Medio izquierdo (MI)
  'javo': { top: '40%', left: '40%' },        // Medio centro (MC)
  'mario': { top: '40%', left: '60%' },       // Medio centro (MC)
  'nicou': { top: '40%', left: '85%' },       // Medio derecho (MD)
  
  // Delantero (1 jugador)
  'marcos': { top: '15%', left: '50%' },      // Delantero centro (DC)
}
---

<Layout title={title} description={description} canonical={canonical}>
  <!-- Fondo espectacular con efectos -->
  <div class="fixed inset-0 overflow-hidden">
    <!-- Fondo base con gradiente animado -->
    <div class="animated-bg absolute inset-0"></div>
    
    <!-- Partículas flotantes -->
    <div class="particles-container absolute inset-0">
      <!-- Partículas grandes -->
      <div class="particle particle-1"></div>
      <div class="particle particle-2"></div>
      <div class="particle particle-3"></div>
      <div class="particle particle-4"></div>
      <div class="particle particle-5"></div>
      <div class="particle particle-6"></div>
      
      <!-- Partículas medianas -->
      <div class="particle-medium pm-1"></div>
      <div class="particle-medium pm-2"></div>
      <div class="particle-medium pm-3"></div>
      <div class="particle-medium pm-4"></div>
      <div class="particle-medium pm-5"></div>
      <div class="particle-medium pm-6"></div>
      <div class="particle-medium pm-7"></div>
      <div class="particle-medium pm-8"></div>
      
      <!-- Partículas pequeñas -->
      <div class="particle-small ps-1"></div>
      <div class="particle-small ps-2"></div>
      <div class="particle-small ps-3"></div>
      <div class="particle-small ps-4"></div>
      <div class="particle-small ps-5"></div>
      <div class="particle-small ps-6"></div>
      <div class="particle-small ps-7"></div>
      <div class="particle-small ps-8"></div>
      <div class="particle-small ps-9"></div>
      <div class="particle-small ps-10"></div>
      
      <!-- Efectos de luz -->
      <div class="light-effect light-1"></div>
      <div class="light-effect light-2"></div>
      <div class="light-effect light-3"></div>
    </div>
    
    <!-- Overlay para mejorar legibilidad -->
    <div class="absolute inset-0 bg-black/20"></div>
  </div>
  
  <div class="relative z-10 min-h-screen py-2">
    <div class="container mx-auto px-4">
      <div class="text-center mb-3">
        <h1 class="text-4xl font-bold text-gray-900 mb-2">Estadísticas FC Bufas</h1>
        <p class="text-gray-600 text-lg">Temporada 2025/26</p>
      </div>
      
      <div class="flex flex-col lg:flex-row gap-8">
        <!-- Panel de estadísticas (móvil arriba, desktop izquierda) -->
        <div class="lg:w-80 flex-shrink-0 order-2 lg:order-1">
          <PlayerStats player={null} />
        </div>
        
        <!-- Campo de fútbol -->
        <div class="flex-1 order-1 lg:order-2">
          <div class="field-container relative w-full aspect-[3/4] md:aspect-[4/3] bg-cover bg-center rounded-xl overflow-hidden shadow-2xl">
            <!-- Overlay para mejorar visibilidad -->
            <div class="absolute inset-0 bg-black/10"></div>
            
            <!-- Jugadores en formación (móvil) -->
            <div class="md:hidden">
              {Object.entries(formationMobile).map(([playerId, position]) => {
                const player = playersWithStats.find(p => p.id === playerId)
                return player ? (
                  <FieldPlayer player={player} position={position} />
                ) : null
              })}
            </div>
            
            <!-- Jugadores en formación (desktop) -->
            <div class="hidden md:block">
              {Object.entries(formationDesktop).map(([playerId, position]) => {
                const player = playersWithStats.find(p => p.id === playerId)
                return player ? (
                  <FieldPlayer player={player} position={position} />
                ) : null
              })}
            </div>
            
            <!-- Título de la formación -->
            <div class="absolute top-1 left-2 md:top-4 md:left-4 bg-white/90 backdrop-blur-sm px-2 py-1 md:px-4 md:py-2 rounded-lg shadow-lg">
              <h3 class="text-sm md:text-lg font-bold text-gray-900">Formación 1-4-4-1</h3>
              <p class="text-xs md:text-sm text-gray-600">FC Bufas 2025/26</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .field-container {
    background-image: url('/campo.webp');
  }
  
  @media (max-width: 768px) {
    .field-container {
      background-image: url('/campovertical.webp');
    }
  }
</style>

<script>
  // Datos de jugadores embebidos actualizados con jornada 2
  const FIGHTERS_DATA = [
    {

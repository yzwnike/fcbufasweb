---
import Layout from '@/layouts/Layout.astro';
import Subheader from '@/components/nike-fc-cards/Subheader.astro';
---

<Layout title="Mi Colección - Nike FC Cards">
  <div class="min-h-screen bg-gradient-to-br from-blue-900 via-blue-800 to-indigo-900">
    <div class="container mx-auto px-4 py-20">
      <!-- Subheader Nav -->
      <Subheader variant="minimal" />
      <!-- Header -->
      <div class="text-center mb-12">
        <h1 class="text-4xl md:text-6xl font-bold text-white mb-4">
          📚 Mi Colección
        </h1>
        <p class="text-xl text-blue-100 max-w-2xl mx-auto">
          Gestiona todas tus cartas, filtra por rareza y posición, y pon cartas en venta
        </p>
      </div>

      <!-- Auth Check -->
      <div id="not-logged-in" class="hidden text-center">
        <div class="bg-red-500/20 backdrop-blur-md rounded-xl p-8 max-w-md mx-auto">
          <h3 class="text-2xl font-bold text-white mb-4">Acceso Requerido</h3>
          <p class="text-red-200 mb-6">Debes iniciar sesión para ver tu colección</p>
          <a href="/nike-fc-cards" class="px-6 py-3 bg-white text-red-900 font-semibold rounded-lg hover:bg-red-100 transition-colors">
            Iniciar Sesión
          </a>
        </div>
      </div>

      <!-- Collection Container -->
      <div id="collection-container" class="hidden">
        <!-- Collection Stats -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-8 max-w-4xl mx-auto">
          <div class="bg-white/10 backdrop-blur-md rounded-xl p-6 text-center">
            <div class="text-3xl font-bold text-blue-300" id="total-cards">0</div>
            <div class="text-blue-200">Cartas Totales</div>
          </div>
          <div class="bg-white/10 backdrop-blur-md rounded-xl p-6 text-center">
            <div class="text-3xl font-bold text-yellow-400" id="total-value">0</div>
            <div class="text-blue-200">Valor Total</div>
          </div>
          <div class="bg-white/10 backdrop-blur-md rounded-xl p-6 text-center">
            <div class="text-3xl font-bold text-green-400" id="unique-players">0</div>
            <div class="text-blue-200">Jugadores Únicos</div>
          </div>
          <div class="bg-white/10 backdrop-blur-md rounded-xl p-6 text-center">
            <div class="text-3xl font-bold text-purple-400" id="cards-for-sale">0</div>
            <div class="text-blue-200">En Venta</div>
          </div>
        </div>

        <!-- Rarity Distribution -->
        <div class="bg-white/10 backdrop-blur-md rounded-xl p-6 mb-8 max-w-4xl mx-auto">
          <h3 class="text-xl font-bold text-white text-center mb-4">Distribución por Rareza</h3>
          <div class="grid grid-cols-5 gap-4">
            <div class="text-center">
              <div class="w-12 h-12 bg-amber-600 rounded-lg mx-auto mb-2"></div>
              <div class="text-white font-bold" id="bronze-count">0</div>
              <div class="text-xs text-blue-200">Bronce</div>
            </div>
            <div class="text-center">
              <div class="w-12 h-12 bg-gray-400 rounded-lg mx-auto mb-2"></div>
              <div class="text-white font-bold" id="silver-count">0</div>
              <div class="text-xs text-blue-200">Plata</div>
            </div>
            <div class="text-center">
              <div class="w-12 h-12 bg-yellow-400 rounded-lg mx-auto mb-2"></div>
              <div class="text-white font-bold" id="gold-count">0</div>
              <div class="text-xs text-blue-200">Oro</div>
            </div>
            <div class="text-center">
              <div class="w-12 h-12 bg-purple-500 rounded-lg mx-auto mb-2"></div>
              <div class="text-white font-bold" id="elite-count">0</div>
              <div class="text-xs text-blue-200">Élite</div>
            </div>
            <div class="text-center">
              <div class="w-12 h-12 bg-pink-500 rounded-lg mx-auto mb-2"></div>
              <div class="text-white font-bold" id="legend-count">0</div>
              <div class="text-xs text-blue-200">Leyenda</div>
            </div>
          </div>
        </div>

        <!-- Filters -->
        <div class="bg-white/10 backdrop-blur-md rounded-xl p-6 mb-8 max-w-4xl mx-auto">
          <h3 class="text-xl font-bold text-white mb-4">Filtros</h3>
          <div class="grid md:grid-cols-4 gap-4">
            <!-- Rarity Filter -->
            <div>
              <label class="block text-sm font-medium text-blue-200 mb-2">Rareza</label>
              <select id="rarity-filter" class="w-full px-3 py-2 bg-blue-800/50 border border-blue-600 rounded-lg text-white">
                <option value="">Todas</option>
                <option value="Bronze">Bronce</option>
                <option value="Silver">Plata</option>
                <option value="Gold">Oro</option>
                <option value="Elite">Élite</option>
                <option value="Legend">Leyenda</option>
              </select>
            </div>

            <!-- Position Filter -->
            <div>
              <label class="block text-sm font-medium text-blue-200 mb-2">Posición</label>
              <select id="position-filter" class="w-full px-3 py-2 bg-blue-800/50 border border-blue-600 rounded-lg text-white">
                <option value="">Todas</option>
                <option value="GK">Portero</option>
                <option value="CB">Defensa Central</option>
                <option value="LB">Lateral Izquierdo</option>
                <option value="RB">Lateral Derecho</option>
                <option value="CM">Centrocampista</option>
                <option value="CAM">Mediocentro Ofensivo</option>
                <option value="CDM">Mediocentro Defensivo</option>
                <option value="LM">Centrocampista Izquierdo</option>
                <option value="RM">Centrocampista Derecho</option>
                <option value="LW">Extremo Izquierdo</option>
                <option value="RW">Extremo Derecho</option>
                <option value="ST">Delantero</option>
              </select>
            </div>

            <!-- Rating Filter -->
            <div>
              <label class="block text-sm font-medium text-blue-200 mb-2">Rating Mínimo</label>
              <select id="rating-filter" class="w-full px-3 py-2 bg-blue-800/50 border border-blue-600 rounded-lg text-white">
                <option value="">Cualquiera</option>
                <option value="60">60+</option>
                <option value="70">70+</option>
                <option value="80">80+</option>
                <option value="85">85+</option>
                <option value="90">90+</option>
              </select>
            </div>

            <!-- Sale Filter -->
            <div>
              <label class="block text-sm font-medium text-blue-200 mb-2">Estado</label>
              <select id="sale-filter" class="w-full px-3 py-2 bg-blue-800/50 border border-blue-600 rounded-lg text-white">
                <option value="">Todas</option>
                <option value="false">En Colección</option>
                <option value="true">En Venta</option>
              </select>
            </div>
          </div>

          <div class="mt-4 flex justify-between items-center">
            <button id="apply-filters-btn" class="px-6 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600 transition-colors">
              Aplicar Filtros
            </button>
            <button id="clear-filters-btn" class="px-6 py-2 bg-gray-500 text-white rounded-lg hover:bg-gray-600 transition-colors">
              Limpiar
            </button>
          </div>
        </div>

        <!-- Cards Grid (Unsold) -->
        <div id="unsold-section">
          <div id="cards-grid-unsold" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 max-w-7xl mx-auto">
            <!-- Unsold cards will be loaded here -->
          </div>
        </div>

        <!-- Market Listings Section -->
        <div id="market-section" class="hidden mt-10 max-w-7xl mx-auto">
          <div class="flex items-center gap-3 mb-4">
            <div class="flex-1 h-px bg-white/20"></div>
            <div class="text-white/80 text-sm uppercase tracking-wider">En mercado:</div>
            <div class="flex-1 h-px bg-white/20"></div>
          </div>
          <div id="cards-grid-market" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
            <!-- Listings will be loaded here -->
          </div>
        </div>

        <!-- Loading -->
        <div id="loading" class="text-center py-8">
          <div class="text-white">Cargando colección...</div>
        </div>

        <!-- No Cards -->
        <div id="no-cards" class="hidden text-center py-8">
          <div class="bg-white/10 backdrop-blur-md rounded-xl p-8 max-w-md mx-auto">
            <div class="text-6xl mb-4">📦</div>
            <h3 class="text-2xl font-bold text-white mb-4">Sin cartas</h3>
            <p class="text-blue-200 mb-6">No tienes cartas que coincidan con los filtros seleccionados</p>
            <a href="/nike-fc-cards/packs" class="px-6 py-3 bg-green-500 text-white font-semibold rounded-lg hover:bg-green-600 transition-colors">
              Abrir Sobres
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Card Detail Modal -->
  <div id="card-modal" class="fixed inset-0 bg-black/50 flex items-center justify-center z-50 hidden">
    <div class="bg-white rounded-xl max-w-md w-full mx-4">
      <div class="p-6">
        <div class="flex justify-between items-center mb-4">
          <h3 class="text-xl font-bold text-gray-900" id="modal-card-name">Jugador</h3>
          <button id="close-modal" class="text-gray-400 hover:text-gray-600">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>

        <!-- Card Preview -->
        <div class="text-center mb-6">
          <div id="modal-card-preview" class="inline-block">
            <!-- Card preview will be generated here -->
          </div>
        </div>

        <!-- Card Actions -->
        <div class="space-y-4">
          <div id="sale-section" class="hidden">
            <div class="flex items-center gap-4 mb-4">
              <label class="text-gray-700 font-medium">Precio de venta:</label>
              <input type="number" id="sale-price-input" min="50" class="flex-1 px-3 py-2 border border-gray-300 rounded-lg" />
            </div>
            <div class="flex gap-4">
              <button id="put-on-sale-btn" class="flex-1 bg-green-500 text-white py-2 rounded-lg hover:bg-green-600">
                Poner en Venta
              </button>
              <button id="cancel-sale-btn" class="flex-1 bg-gray-500 text-white py-2 rounded-lg hover:bg-gray-600">
                Cancelar
              </button>
            </div>
          </div>

          <div id="action-buttons" class="flex gap-4">
            <button id="sell-card-btn" class="flex-1 bg-blue-500 text-white py-2 rounded-lg hover:bg-blue-600">
              Vender al Mercado
            </button>
            <button id="remove-from-sale-btn" class="hidden flex-1 bg-red-500 text-white py-2 rounded-lg hover:bg-red-600">
              Quitar de Venta
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    // State management
    let currentUser = null;
    let authToken = null;
    let userCards = [];
    let groupedCards = [];
    let filteredCards = [];
    let selectedGroup = null;
    let cardCounts = {};

    // Auth functions
    function checkAuthState() {
      const token = sessionStorage.getItem('nike_fc_token');
      if (token) {
        authToken = token;
        return true;
      }
      return false;
    }

    // UI functions
    function showSection(sectionId) {
      const sections = ['not-logged-in', 'collection-container', 'loading', 'no-cards'];
      sections.forEach(id => {
        const element = document.getElementById(id);
        if (element) {
          element.classList.toggle('hidden', id !== sectionId);
        }
      });
    }

    // Fetch user collection from API
    async function fetchUserCollection() {
      try {
        const token = sessionStorage.getItem('nike_fc_token');
        const res = await fetch(`/api/nike-fc-cards/collection?t=${Date.now()}` , {
          headers: { Authorization: `Bearer ${token}` },
          cache: 'no-store'
        });
        return await res.json();
      } catch (e) {
        return { success: false, error: 'Error de conexión' };
      }
    }

    function generateMockCards() { /* deprecated */ return []; }

    let activeForSaleCount = 0;

    function recomputeCounts() {
      cardCounts = {};
      let saleCount = 0;
      (userCards || []).forEach(uc => {
        const id = uc.card?.id;
        if (!id) return;
        cardCounts[id] = (cardCounts[id] || 0) + 1;
        const isOnSale = (uc.is_for_sale === true) || (uc.is_for_sale === 1) || (uc.is_for_sale === '1');
        if (isOnSale) saleCount += 1;
      });
      activeForSaleCount = saleCount;
    }

    function computeGroups() {
      const unsoldMap = new Map();
      const listingGroups = [];
      const seenListingIds = new Set();

      (userCards || []).forEach(uc => {
        const id = uc.card?.id;
        if (!id) return;
        const isOnSale = (uc.is_for_sale === true) || (uc.is_for_sale === 1) || (uc.is_for_sale === '1');
        if (isOnSale) {
          // Each listing becomes its own group to allow per-listing actions and price display
          if (!seenListingIds.has(uc.id)) {
            seenListingIds.add(uc.id);
            listingGroups.push({
              card: uc.card,
              totalCount: 1,
              unsoldCount: 0,
              onSaleCount: 1,
              unsoldIds: [],
              onSaleIds: [uc.id],
              isListing: true,
              sale_price: uc.sale_price
            });
          }
        } else {
          let g = unsoldMap.get(id);
          if (!g) {
            g = {
              card: uc.card,
              totalCount: 0,
              unsoldCount: 0,
              onSaleCount: 0,
              unsoldIds: [],
              onSaleIds: [],
              isListing: false
            };
            unsoldMap.set(id, g);
          }
          g.totalCount += 1;
          g.unsoldCount += 1;
          g.unsoldIds.push(uc.id);
        }
      });

      const unsoldGroups = Array.from(unsoldMap.values());
      return [...unsoldGroups, ...listingGroups];
    }

    function displayStats(stats) {
      document.getElementById('total-cards').textContent = stats.totalCards;
      document.getElementById('total-value').textContent = stats.totalValue.toLocaleString();
      document.getElementById('unique-players').textContent = stats.uniquePlayers;
      
      const cardsForSale = (userCards || []).reduce((acc, uc) => {
        const saleFlag = (uc.is_for_sale === true) || (uc.is_for_sale === 1) || (uc.is_for_sale === '1');
        return acc + (saleFlag ? 1 : 0);
      }, 0);
      activeForSaleCount = cardsForSale;
      document.getElementById('cards-for-sale').textContent = cardsForSale;

      // Rarity counts
      document.getElementById('bronze-count').textContent = stats.cardsByRarity.Bronze || 0;
      document.getElementById('silver-count').textContent = stats.cardsByRarity.Silver || 0;
      document.getElementById('gold-count').textContent = stats.cardsByRarity.Gold || 0;
      document.getElementById('elite-count').textContent = stats.cardsByRarity.Elite || 0;
      document.getElementById('legend-count').textContent = stats.cardsByRarity.Legend || 0;
    }

    function displayCards(groups) {
      const unsold = groups.filter(g => !g.isListing);
      const listings = groups.filter(g => g.isListing);

      const unsoldGrid = document.getElementById('cards-grid-unsold');
      const marketSection = document.getElementById('market-section');
      const marketGrid = document.getElementById('cards-grid-market');

      const noCards = document.getElementById('no-cards');

      // Handle empty state
      if (unsold.length === 0 && listings.length === 0) {
        if (unsoldGrid) unsoldGrid.classList.add('hidden');
        if (marketSection) marketSection.classList.add('hidden');
        noCards.classList.remove('hidden');
        return;
      }

      noCards.classList.add('hidden');

      // Render unsold grid
      if (unsoldGrid) {
        if (unsold.length === 0) {
          unsoldGrid.classList.add('hidden');
        } else {
          unsoldGrid.classList.remove('hidden');
          unsoldGrid.innerHTML = '';
          unsold.forEach(group => {
            const el = createCardElement(group);
            unsoldGrid.appendChild(el);
          });
        }
      }

      // Render market listings grid
      if (marketSection && marketGrid) {
        if (listings.length === 0) {
          marketSection.classList.add('hidden');
        } else {
          marketSection.classList.remove('hidden');
          marketGrid.innerHTML = '';
          listings.forEach(group => {
            const el = createCardElement(group);
            marketGrid.appendChild(el);
          });
        }
      }
    }

    function createCardElement(group) {
      const card = group.card;
      const rarityColors = {
        Bronze: 'from-amber-600 to-amber-800',
        Silver: 'from-gray-400 to-gray-600',
        Gold: 'from-yellow-400 to-yellow-600',
        Elite: 'from-purple-500 to-purple-700',
        Legend: 'from-pink-500 to-pink-700'
      };

      const cardDiv = document.createElement('div');
      cardDiv.className = `bg-gradient-to-br ${rarityColors[card.rarity]} rounded-xl p-4 text-center transform hover:scale-105 transition-transform cursor-pointer relative`;
      cardDiv.addEventListener('click', () => openCardModal(group));

      let saleIndicator = '';
      if (group.isListing) {
        saleIndicator = `
          <div class=\"absolute top-2 right-2 bg-green-500 text-white text-xs px-2 py-1 rounded-full\">
            En Venta
          </div>
        `;
      }
      // Quantity badge (duplicates) - show only for unsold grouped tile and use unsoldCount
      const qty = group.unsoldCount || 0;
      const qtyBadge = (!group.isListing && qty > 1)
        ? `<div class=\"absolute -top-6 -left-6 z-10 bg-green-600 text-white text-[10px] sm:text-xs font-extrabold w-20 h-20 rounded-full flex items-center justify-center shadow-lg ring-2 ring-white/30 pointer-events-none\">TIENES: ${qty}</div>`
        : '';

      const img = card.image_path ? `<img src="${card.image_path}" alt="${card.player.name}" class="w-full rounded-lg mb-3" />` : `
        <div class="w-20 h-20 bg-white/20 rounded-lg flex items-center justify-center mx-auto mb-3">
          <span class="text-3xl">⚽</span>
        </div>`;

      const dupCount = group.totalCount;
      const canSell = (!group.isListing) && (group.unsoldCount >= 1) && (dupCount >= 2) && (activeForSaleCount < 10);
      let cantReason = '';
      if (group.isListing) cantReason = 'Ya está en venta';
      else if (!(group.unsoldCount >= 1)) cantReason = 'No hay copias disponibles';
      else if (dupCount < 2) cantReason = 'Necesitas duplicado';
      else if (activeForSaleCount >= 10) cantReason = 'Límite 10 en mercado';
      const sellBtnHtml = !group.isListing 
        ? `<button class=\"mt-2 px-3 py-1 rounded text-xs font-semibold ${canSell ? 'bg-blue-500 text-white hover:bg-blue-600' : 'bg-gray-600 text-gray-300 cursor-not-allowed'}\" ${canSell ? '' : ('data-disabled=\"1\" title=\"' + cantReason + '\"')} data-sell=\"1\">Vender</button>`
        : '';

      cardDiv.innerHTML = `
        ${saleIndicator}
        ${qtyBadge}
        ${img}
        <div class=\"text-white font-bold text-sm mb-1\">${card.player.name}</div>
        <div class="text-xs text-white/80 mb-2">${card.player.position1} - ${card.rarity}</div>
        <div class="text-xs text-white/90 mb-1">FIFA: ${card.player.fifa_rating}</div>
        <div class="text-xs text-yellow-300 font-bold">${card.base_price} 💰</div>
        ${group.isListing ? `<div class=\"text-xs text-green-300 mt-1\">Precio: ${group.sale_price}</div>` : sellBtnHtml}
      `;

      // Wire sell button to open modal directly in sale mode
      const sellBtn = cardDiv.querySelector('button[data-sell="1"]');
      if (sellBtn) {
        sellBtn.addEventListener('click', (ev) => {
          ev.stopPropagation();
          const isDisabled = sellBtn.getAttribute('data-disabled') === '1';
          if (isDisabled) {
            const reason = sellBtn.getAttribute('title') || 'No se puede vender';
            alert(reason);
            return;
          }
          selectedGroup = group;
          openCardModal(group);
          // Show sale section directly
          document.getElementById('sale-section').classList.remove('hidden');
          document.getElementById('action-buttons').classList.add('hidden');
          const suggestedPrice = Math.floor(selectedGroup.card.base_price * 1.2);
          document.getElementById('sale-price-input').value = suggestedPrice;
        });
      }

      return cardDiv;
    }

    function openCardModal(group) {
      selectedGroup = group;
      const card = group.card;

      document.getElementById('modal-card-name').textContent = card.player.name;
      
      // Generate card preview
      const preview = document.getElementById('modal-card-preview');
      preview.innerHTML = createCardElement(group).innerHTML;

      // Show/hide appropriate buttons
      const sellBtn = document.getElementById('sell-card-btn');
      const removeFromSaleBtn = document.getElementById('remove-from-sale-btn');
      const saleSection = document.getElementById('sale-section');

      // Actions depending on group type
      if (group.isListing) {
        sellBtn.classList.add('hidden');
        removeFromSaleBtn.classList.remove('hidden');
      } else {
        removeFromSaleBtn.classList.add('hidden');
        if (group.totalCount >= 2 && group.unsoldCount >= 1) {
          sellBtn.classList.remove('hidden');
        } else {
          sellBtn.classList.add('hidden');
        }
      }
      saleSection.classList.add('hidden');

      document.getElementById('card-modal').classList.remove('hidden');
    }

    function closeCardModal() {
      document.getElementById('card-modal').classList.add('hidden');
      selectedGroup = null;
    }

    function applyFilters() {
      const rarityFilter = document.getElementById('rarity-filter').value;
      const positionFilter = document.getElementById('position-filter').value;
      const ratingFilter = parseInt(document.getElementById('rating-filter').value) || 0;
      const saleFilter = document.getElementById('sale-filter').value;
 
      groupedCards = computeGroups();
      filteredCards = groupedCards.filter(group => {
        const card = group.card;
        if (rarityFilter && card.rarity !== rarityFilter) return false;
        if (positionFilter && card.player.position1 !== positionFilter) return false;
        if (ratingFilter && card.player.fifa_rating < ratingFilter) return false;
        if (saleFilter === 'true' && group.onSaleCount === 0) return false;
        if (saleFilter === 'false' && group.unsoldCount === 0) return false;
        return true;
      });

      displayCards(filteredCards);
    }

    function clearFilters() {
      document.getElementById('rarity-filter').value = '';
      document.getElementById('position-filter').value = '';
      document.getElementById('rating-filter').value = '';
      document.getElementById('sale-filter').value = '';
      
      filteredCards = [...userCards];
      displayCards(filteredCards);
    }

    async function startCollectionPage() {
      if (!checkAuthState()) {
        showSection('not-logged-in');
        return;
      }

      showSection('loading');

      const result = await fetchUserCollection();
      
      if (!result.success) {
        console.error('Collection load failed:', result);
        alert('Error al cargar la colección' + (result.error ? (': ' + result.error) : '') + (result.details ? ('\n' + result.details) : ''));
        return;
      }

      userCards = result.cards || [];
      groupedCards = computeGroups();
      filteredCards = [...groupedCards];

      showSection('collection-container');
      recomputeCounts();
      displayStats({
        totalCards: result.stats?.totalCards || 0,
        totalValue: result.stats?.totalValue || 0,
        uniquePlayers: result.stats?.uniquePlayers || 0,
        cardsByRarity: result.stats?.cardsByRarity || { Bronze:0, Silver:0, Gold:0, Elite:0, Legend:0 }
      });
      displayCards(filteredCards);

      // Event listeners
      document.getElementById('apply-filters-btn').addEventListener('click', applyFilters);
      document.getElementById('clear-filters-btn').addEventListener('click', clearFilters);
      document.getElementById('close-modal').addEventListener('click', closeCardModal);
      
      document.getElementById('sell-card-btn').addEventListener('click', () => {
        document.getElementById('sale-section').classList.remove('hidden');
        document.getElementById('action-buttons').classList.add('hidden');
        
        // Calculate suggested price
        const suggestedPrice = Math.floor(selectedGroup.card.base_price * 1.2);
        document.getElementById('sale-price-input').value = suggestedPrice;
      });

      document.getElementById('cancel-sale-btn').addEventListener('click', () => {
        document.getElementById('sale-section').classList.add('hidden');
        document.getElementById('action-buttons').classList.remove('hidden');
      });

      document.getElementById('put-on-sale-btn').addEventListener('click', async () => {
        const price = parseInt(document.getElementById('sale-price-input').value);
        if (!selectedGroup) return;
        if (Number.isNaN(price) || price < 50) {
          alert('El precio mínimo es 50 monedas');
          return;
        }
        try {
          const res = await fetch('/api/nike-fc-cards/market/put', {
            method: 'POST',
            headers: {
'Content-Type': 'application/json',
              Authorization: `Bearer ${authToken}`
            },
            body: JSON.stringify({ user_card_id: (selectedGroup.unsoldIds[0] || null), price })
          });
          const data = await res.json();
          if (!data.success) {
            alert('No se pudo poner en venta: ' + (data.error || 'error desconocido'));
            return;
          }
          // Recargar colección desde API para reflejar estado real
          const result = await fetchUserCollection();
          if (result.success) {
            userCards = result.cards || [];
            recomputeCounts();
            applyFilters();
          } else {
            // fallback recompute to keep UI consistent
            recomputeCounts();
            applyFilters();
          }
          closeCardModal();
          alert(`Carta puesta en venta por ${price} monedas`);
        } catch (e) {
          alert('Error de red al poner en venta');
        }
      });

      document.getElementById('remove-from-sale-btn').addEventListener('click', async () => {
        if (!selectedGroup) return;
        try {
          const removeId = selectedGroup.isListing ? selectedGroup.onSaleIds[0] : (selectedGroup.onSaleIds[0] || null);
          if (!removeId) {
            alert('No hay cartas en venta para quitar');
            return;
          }
          const res = await fetch('/api/nike-fc-cards/market/remove', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              Authorization: `Bearer ${authToken}`
            },
            body: JSON.stringify({ user_card_id: removeId })
          });
          const data = await res.json();
          if (!data.success) {
            alert('No se pudo quitar de venta: ' + (data.error || 'error desconocido'));
            return;
          }
          const result = await fetchUserCollection();
          if (result.success) {
            userCards = result.cards || [];
            recomputeCounts();
            applyFilters();
          } else {
            recomputeCounts();
            applyFilters();
          }
          closeCardModal();
          alert('Carta retirada del mercado');
        } catch (e) {
          alert('Error de red al quitar de venta');
        }
      });

      // Close modal on backdrop click
      document.getElementById('card-modal').addEventListener('click', (e) => {
        if (e.target.id === 'card-modal') {
          closeCardModal();
        }
      });
    }

    document.addEventListener('DOMContentLoaded', startCollectionPage);
    document.addEventListener('astro:page-load', startCollectionPage);
    document.addEventListener('astro:after-swap', startCollectionPage);
  </script>
</Layout>
---
import Layout from '@/layouts/Layout.astro';
import Subheader from '@/components/nike-fc-cards/Subheader.astro';
---

<Layout title="Nike FC Cards - Dashboard">
  <div class="min-h-screen bg-gradient-to-br from-orange-900 via-orange-800 to-red-900">
    <!-- Subheader Nav -->
    <div class="pt-28 px-4">
      <div class="max-w-7xl mx-auto mb-6">
        <Subheader variant="full" />
      </div>
    </div>
    <!-- Hero Section -->
    <section class="relative pt-32 pb-20 px-4">
      <div class="max-w-7xl mx-auto text-center">
        <div class="flex items-center justify-center mb-8">
          <svg class="w-16 h-16 text-white mr-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
          </svg>
          <h1 class="text-5xl md:text-7xl font-bold text-white">
            Bufas Cards Trading Game
          </h1>
        </div>
        
        <p class="text-xl md:text-2xl text-orange-100 mb-12 max-w-3xl mx-auto">
          Colecciona cartas de los jugadores de FC Bufas, completa desafíos diarios, 
          intercambia con otros usuarios y domina el Fantasy Rush semanal
        </p>

        <!-- User Status -->
        <div id="user-status" class="mb-12">
          <div id="logged-out" class="space-y-6">
            <p class="text-lg text-orange-200">Inicia sesión para comenzar tu colección</p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
              <button id="login-btn" class="px-8 py-3 bg-white text-orange-900 font-semibold rounded-lg hover:bg-orange-100 transition-colors">
                Iniciar Sesión
              </button>
              <button id="register-btn" class="px-8 py-3 bg-orange-600 text-white font-semibold rounded-lg hover:bg-orange-700 transition-colors">
                Registrarse
              </button>
            </div>
          </div>

          <div id="logged-in" class="hidden">
            <div class="bg-white/10 backdrop-blur-md rounded-xl p-6 mb-8 max-w-md mx-auto">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-orange-100">Bienvenido,</p>
                  <p id="username" class="text-2xl font-bold text-white"></p>
                </div>
                <div class="text-right">
                  <p class="text-orange-100">Monedas</p>
                  <p id="coins" class="text-2xl font-bold text-yellow-400">0</p>
                </div>
              </div>
          </div>
        </div>
        <div class="text-center mt-4">
          <button id="logout-btn" class="px-4 py-2 bg-red-500 text-white font-semibold rounded-lg hover:bg-red-600 transition-colors">
            Cerrar sesión
          </button>
        </div>
      </div>

      <!-- Game Features -->
        <div class="grid md:grid-cols-2 lg:grid-cols-5 gap-6 max-w-[1800px] mx-auto">
          <div class="bg-white/10 backdrop-blur-md rounded-xl p-8 text-center hover:bg-white/20 transition-colors group">
            <div class="w-20 h-20 bg-orange-500 rounded-full flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform">
              <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
<h3 class="text-2xl font-semibold text-white mb-2 break-words">Quiz Diario</h3>
<p class="text-orange-200 break-words">5 preguntas diarias sobre stats de jugadores. ¡Gana hasta 250 monedas con bonos!</p>
          </div>

          <div class="bg-white/10 backdrop-blur-md rounded-xl p-8 text-center hover:bg-white/20 transition-colors group">
            <div class="w-20 h-20 bg-green-500 rounded-full flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform">
              <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M9 1v6m6-6v6"></path>
              </svg>
            </div>
<h3 class="text-2xl font-semibold text-white mb-2 break-words">Sobres de Cartas</h3>
<p class="text-orange-200 break-words">1 sobre gratis cada 24h. Compra sobres premium y especiales con monedas</p>
          </div>

          <div class="bg-white/10 backdrop-blur-md rounded-xl p-8 text-center hover:bg-white/20 transition-colors group">
<div class="w-20 h-20 bg-yellow-500 rounded-full flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform">
              <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
              </svg>
            </div>
<h3 class="text-2xl font-semibold text-white mb-2 whitespace-nowrap">Mercado</h3>
<p class="text-yellow-300 break-words">Vende y compra cartas con otros usuarios. Filtra por posición, rareza y precio</p>
          </div>

          <!-- SBC Feature (placed between Intercambio y Fantasy Rush) -->
          <div class="bg-white/10 backdrop-blur-md rounded-xl p-8 text-center hover:bg-white/20 transition-colors group">
            <div class="w-20 h-20 bg-emerald-500 rounded-full flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform">
              <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 1.343-3 3v2H7l5 5 5-5h-2v-2c0-1.657-1.343-3-3-3z" />
              </svg>
            </div>
<h3 class="text-2xl font-semibold text-white mb-2 break-words">SBC</h3>
<p class="text-orange-200 break-words">Completa retos mensuales con requisitos (media, especiales, etc.) y gana sobres o cartas.</p>
          </div>

          <div class="bg-white/10 backdrop-blur-md rounded-xl p-8 text-center hover:bg-white/20 transition-colors group">
            <div class="w-20 h-20 bg-purple-500 rounded-full flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform">
              <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
<h3 class="text-2xl font-semibold text-white mb-2 break-words">Fantasy Rush</h3>
<p class="text-orange-200 break-words">Elige 3 jugadores cada semana. Los puntos se convierten en monedas x20</p>
          </div>
        </div>

        <!-- Quick Actions -->
        <div id="quick-actions" class="hidden mt-16">
          <div class="flex flex-wrap justify-center gap-4">
            <a href="/nike-fc-cards/quiz" class="px-6 py-3 bg-orange-500 text-white font-semibold rounded-lg hover:bg-orange-600 transition-colors">
              Quiz Diario
            </a>
            <a href="/nike-fc-cards/packs" class="px-6 py-3 bg-green-500 text-white font-semibold rounded-lg hover:bg-green-600 transition-colors">
              Abrir Sobres
            </a>
            <a href="/nike-fc-cards/collection" class="px-6 py-3 bg-blue-500 text-white font-semibold rounded-lg hover:bg-blue-600 transition-colors">
              Mi Colección
            </a>
            <a href="/nike-fc-cards/market" class="px-6 py-3 bg-yellow-500 text-white font-semibold rounded-lg hover:bg-yellow-600 transition-colors">
              Mercado
            </a>
            <a href="/nike-fc-cards/sbc" class="px-6 py-3 bg-emerald-500 text-white font-semibold rounded-lg hover:bg-emerald-600 transition-colors">
              SBC
            </a>
            <a href="/nike-fc-cards/fantasy" class="px-6 py-3 bg-purple-500 text-white font-semibold rounded-lg hover:bg-purple-600 transition-colors">
              Fantasy Rush
            </a>
            <a href="/nike-fc-cards/ranking" class="px-6 py-3 bg-slate-600 text-white font-semibold rounded-lg hover:bg-slate-700 transition-colors">
              Ranking
            </a>
            <a href="/nike-fc-cards/ajustes" class="px-6 py-3 bg-slate-500 text-white font-semibold rounded-lg hover:bg-slate-600 transition-colors">
              Ajustes de Perfil
            </a>
            <a href="/nike-fc-cards/logros" class="px-6 py-3 bg-amber-600 text-white font-semibold rounded-lg hover:bg-amber-700 transition-colors">
              Logros
            </a>
          </div>
        </div>
      </div>

    </section>
  </div>

  <!-- Authentication Modals -->
  <div id="login-modal" class="fixed inset-0 bg-black/50 flex items-center justify-center z-50 hidden">
    <div class="bg-white rounded-xl p-8 max-w-md w-full mx-4">
      <h2 class="text-2xl font-bold text-gray-900 mb-6 text-center">Iniciar Sesión</h2>
      <form id="login-form" class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Email</label>
          <input type="email" name="email" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-orange-500 focus:border-orange-500">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Contraseña</label>
          <input type="password" name="password" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-orange-500 focus:border-orange-500">
        </div>
        <div id="login-error" class="hidden text-red-500 text-sm"></div>
        <div class="flex gap-4">
          <button type="submit" class="flex-1 bg-orange-500 text-white py-2 rounded-lg hover:bg-orange-600 transition-colors">
            Iniciar Sesión
          </button>
          <button type="button" id="close-login" class="flex-1 bg-gray-300 text-gray-700 py-2 rounded-lg hover:bg-gray-400 transition-colors">
            Cancelar
          </button>
        </div>
      </form>
    </div>
  </div>

  <div id="register-modal" class="fixed inset-0 bg-black/50 flex items-center justify-center z-50 hidden">
    <div class="bg-white rounded-xl p-8 max-w-md w-full mx-4">
      <h2 class="text-2xl font-bold text-gray-900 mb-6 text-center">Registrarse</h2>
      <form id="register-form" class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Username</label>
          <input type="text" name="username" required minlength="3" maxlength="20" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-orange-500 focus:border-orange-500">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Email</label>
          <input type="email" name="email" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-orange-500 focus:border-orange-500">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Contraseña</label>
          <input type="password" name="password" required minlength="6" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-orange-500 focus:border-orange-500">
        </div>
        <div id="register-error" class="hidden text-red-500 text-sm"></div>
        <div class="flex gap-4">
          <button type="submit" class="flex-1 bg-orange-500 text-white py-2 rounded-lg hover:bg-orange-600 transition-colors">
            Registrarse
          </button>
          <button type="button" id="close-register" class="flex-1 bg-gray-300 text-gray-700 py-2 rounded-lg hover:bg-gray-400 transition-colors">
            Cancelar
          </button>
        </div>
      </form>
    </div>
  </div>
</Layout>

<script>
  // Auth State Management
  let currentUser = null;
  let authToken = null;
  const storage = window.sessionStorage;

  // Check if user is logged in
  function checkAuthState() {
    const token = storage.getItem('nike_fc_token');
    if (token) {
      authToken = token;
      fetchMe();
    } else {
      showLoggedOutState();
    }
  }

  function showLoggedInState() {
    const loggedOut = document.getElementById('logged-out');
    const loggedIn = document.getElementById('logged-in');
    const quickActions = document.getElementById('quick-actions');

    if (loggedOut) loggedOut.classList.add('hidden');
    if (loggedIn) loggedIn.classList.remove('hidden');
    if (quickActions) quickActions.classList.remove('hidden');

    if (currentUser) {
      const usernameEl = document.getElementById('username');
      const coinsEl = document.getElementById('coins');

      if (usernameEl) usernameEl.textContent = currentUser.username;
      if (coinsEl) coinsEl.textContent = currentUser.coins;
    }
  }

  function showLoggedOutState() {
    const loggedOut = document.getElementById('logged-out');
    const loggedIn = document.getElementById('logged-in');
    const quickActions = document.getElementById('quick-actions');

    if (loggedOut) loggedOut.classList.remove('hidden');
    if (loggedIn) loggedIn.classList.add('hidden');
    if (quickActions) quickActions.classList.add('hidden');
  }

  async function fetchMe() {
    try {
      const res = await fetch('/api/nike-fc-cards/auth/me', { headers: { Authorization: `Bearer ${authToken}` } });
      const data = await res.json();
      if (data.success) {
        currentUser = data.user;
        showLoggedInState();
      } else {
        showLoggedOutState();
      }
    } catch {
      showLoggedOutState();
    }
  }

  // Modal functions
  function openModal(modalId) {
    const modal = document.getElementById(modalId);
    if (modal) {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    } else {
      console.error('Modal not found:', modalId);
    }
  }

  function closeModal(modalId) {
    const modal = document.getElementById(modalId);
    if (modal) {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      // Clear error messages
      const errorEl = document.getElementById(modalId.replace('-modal', '-error'));
      if (errorEl) {
        errorEl.classList.add('hidden');
        errorEl.textContent = '';
      }
    }
  }

  // Auth API calls
  async function login(email, password) {
    console.log('Attempting login for:', email);
    
    try {
      const response = await fetch('/api/nike-fc-cards/auth/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, password })
      });

      const data = await response.json();
      console.log('Login response:', data);
      
      if (data.success) {
        storage.setItem('nike_fc_token', data.token);
        authToken = data.token;
        await fetchMe();
        closeModal('login-modal');
        // Forzar sincronización de estado en toda la app
        window.location.reload();
      }
      
      return data;
    } catch (error) {
      console.error('Login error:', error);
      return { success: false, error: 'Error de conexión' };
    }
  }

  async function register(username, email, password) {
    console.log('Attempting registration for:', username, email);
    
    try {
      const response = await fetch('/api/nike-fc-cards/auth/register', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ username, email, password })
      });

      const data = await response.json();
      console.log('Register response:', data);
      
      if (data.success) {
        storage.setItem('nike_fc_token', data.token);
        authToken = data.token;
        await fetchMe();
        closeModal('register-modal');
        // Forzar sincronización de estado en toda la app
        window.location.reload();
      }
      
      return data;
    } catch (error) {
      console.error('Register error:', error);
      return { success: false, error: 'Error de conexión' };
    }
  }

  // Initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeApp);
  } else {
    initializeApp();
  }
  // Ensure initialization on SPA navigations (Astro View Transitions)
  document.addEventListener('astro:page-load', initializeApp);
  document.addEventListener('astro:after-swap', initializeApp);

  function doLogout() {
    try {
      storage.removeItem('nike_fc_token');
      authToken = null;
      currentUser = null;
      window.location.href = '/nike-fc-cards';
    } catch {}
  }

  function initializeApp() {
    console.log('Initializing Nike FC Cards app...');
    
    checkAuthState();

    // Modal controls
    const loginBtn = document.getElementById('login-btn');
    const registerBtn = document.getElementById('register-btn');
    const closeLoginBtn = document.getElementById('close-login');
    const closeRegisterBtn = document.getElementById('close-register');
    
    if (loginBtn) {
      loginBtn.addEventListener('click', (e) => {
        e.preventDefault();
        console.log('Login button clicked');
        openModal('login-modal');
      });
    } else {
      console.error('Login button not found');
    }
    
    if (registerBtn) {
      registerBtn.addEventListener('click', (e) => {
        e.preventDefault();
        console.log('Register button clicked');
        openModal('register-modal');
      });
    } else {
      console.error('Register button not found');
    }
    
    if (closeLoginBtn) {
      closeLoginBtn.addEventListener('click', () => closeModal('login-modal'));
    }
    
    if (closeRegisterBtn) {
      closeRegisterBtn.addEventListener('click', () => closeModal('register-modal'));
    }

    const logoutBtn = document.getElementById('logout-btn');
    if (logoutBtn) logoutBtn.addEventListener('click', doLogout);
    
    // Form submissions
    const loginForm = document.getElementById('login-form');
    if (loginForm) {
      loginForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        console.log('Login form submitted');
        
        const formData = new FormData(e.target);
        const email = formData.get('email');
        const password = formData.get('password');
        
        if (!email || !password) {
          const errorEl = document.getElementById('login-error');
          if (errorEl) {
            errorEl.textContent = 'Por favor complete todos los campos';
            errorEl.style.display = 'block';
          }
          return;
        }
        
        const result = await login(email, password);
        
        if (!result.success) {
          const errorEl = document.getElementById('login-error');
          if (errorEl) {
            errorEl.textContent = result.error || 'Error al iniciar sesión';
            errorEl.style.display = 'block';
          }
        }
      });
    }

    const registerForm = document.getElementById('register-form');
    if (registerForm) {
      registerForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        console.log('Register form submitted');
        
        const formData = new FormData(e.target);
        const username = formData.get('username');
        const email = formData.get('email');
        const password = formData.get('password');
        
        if (!username || !email || !password) {
          const errorEl = document.getElementById('register-error');
          if (errorEl) {
            errorEl.textContent = 'Por favor complete todos los campos';
            errorEl.style.display = 'block';
          }
          return;
        }
        
        const result = await register(username, email, password);
        
        if (!result.success) {
          const errorEl = document.getElementById('register-error');
          if (errorEl) {
            errorEl.textContent = result.error || 'Error al registrarse';
            errorEl.style.display = 'block';
          }
        }
      });
    }

    // Close modals on backdrop click
    const loginModal = document.getElementById('login-modal');
    if (loginModal) {
      loginModal.addEventListener('click', (e) => {
        if (e.target.id === 'login-modal') {
          closeModal('login-modal');
        }
      });
    }

    const registerModal = document.getElementById('register-modal');
    if (registerModal) {
      registerModal.addEventListener('click', (e) => {
        if (e.target.id === 'register-modal') {
          closeModal('register-modal');
        }
      });
    }

    console.log('Nike FC Cards app initialized successfully');
  }
</script>

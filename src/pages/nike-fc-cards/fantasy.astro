---
import Layout from '@/layouts/Layout.astro';
import Subheader from '@/components/nike-fc-cards/Subheader.astro';
---

<Layout title="Fantasy Rush - Nike FC Cards">
  <div class="min-h-screen bg-gradient-to-br from-purple-900 via-purple-800 to-pink-900">
    <div class="container mx-auto px-4 py-2">
      <!-- Subheader Nav -->
      <Subheader variant="minimal" />
      <!-- Header -->
      <div class="text-center mb-2">
        <h1 class="text-4xl md:text-6xl font-bold text-white mb-4">
          ⚡ Fantasy Rush
        </h1>
        <p class="hidden">
          Elige tu equipo semanal: 1 Delantero, 1 Centrocampista, 1 Defensa/Portero. 
          Los puntos fantasy se convierten en monedas x20
        </p>
      </div>

      <!-- Auth Check -->
      <div id="not-logged-in" class="hidden text-center">
        <div class="bg-red-500/20 backdrop-blur-md rounded-xl p-8 max-w-md mx-auto">
          <h3 class="text-2xl font-bold text-white mb-4">Acceso Requerido</h3>
          <p class="text-red-200 mb-6">Debes iniciar sesión para participar en Fantasy Rush</p>
          <a href="/nike-fc-cards" class="px-6 py-3 bg-white text-red-900 font-semibold rounded-lg hover:bg-red-100 transition-colors">
            Iniciar Sesión
          </a>
        </div>
      </div>

      <!-- Fantasy Rush Container -->
      <div id="fantasy-container" class="hidden">
        

        <!-- Player Selection -->
        <div id="player-selection" class="space-y-8">
          <h2 class="text-2xl font-bold text-white text-center mb-6">Selecciona Tu Equipo</h2>

          <!-- Position Tabs -->
          <div class="flex justify-center mb-6 hidden">
            <div class="bg-white/10 rounded-lg p-1">
              <button id="tab-forward" class="tab-button px-4 py-2 rounded-lg font-semibold transition-colors bg-purple-500 text-white">
                Delanteros
              </button>
              <button id="tab-midfielder" class="tab-button px-4 py-2 rounded-lg font-semibold transition-colors text-purple-200 hover:text-white">
                Centrocampistas
              </button>
              <button id="tab-defender" class="tab-button px-4 py-2 rounded-lg font-semibold transition-colors text-purple-200 hover:text-white">
                Defensas/Porteros
              </button>
            </div>
          </div>

          <!-- Selector en 2 filas (7 columnas fijas) con separadores arriba: 2/3/2 -->
          <div class="w-full max-w-none space-y-2">
            <!-- Vertical separators at 2/7 and 5/7 -->
            <div class="pointer-events-none absolute inset-0 z-0">
              <div class="absolute top-0 bottom-0 w-px bg-white" style="left: calc(100% * 2 / 7);"></div>
              <div class="absolute top-0 bottom-0 w-px bg-white" style="left: calc(100% * 5 / 7);"></div>
            </div>
            <div id="labels" class="relative z-10 grid grid-cols-7 gap-2 w-full"></div>
            <div id="row1" class="relative z-10 grid grid-cols-7 gap-1 w-full"></div>
            <div id="row2" class="relative z-10 grid grid-cols-7 gap-1 w-full"></div>
          </div>

          <!-- Selection Summary -->
          <div id="selection-summary" class="bg-white/10 backdrop-blur-md rounded-xl p-6 max-w-2xl mx-auto">
            <h3 class="text-xl font-bold text-white text-center mb-4">Selección Actual</h3>
            <div class="grid grid-cols-3 gap-4 text-center mb-6">
              <div>
                <div class="text-purple-200 mb-2">Delantero</div>
                <div class="text-white font-bold" id="summary-forward">No seleccionado</div>
              </div>
              <div>
                <div class="text-purple-200 mb-2">Centrocampista</div>
                <div class="text-white font-bold" id="summary-midfielder">No seleccionado</div>
              </div>
              <div>
                <div class="text-purple-200 mb-2">Defensa/Portero</div>
                <div class="text-white font-bold" id="summary-defender">No seleccionado</div>
              </div>
            </div>
            <div class="text-center">
              <button id="confirm-selection-btn" class="px-8 py-3 bg-green-500 text-white font-semibold rounded-lg hover:bg-green-600 transition-colors disabled:bg-gray-500" disabled>
                Confirmar Selección
              </button>
            </div>
          </div>
        </div>

        <!-- Loading -->
        <div id="loading" class="text-center py-8">
          <div class="text-white">Cargando jugadores...</div>
        </div>
      </div>

      <!-- Selection Success -->
      <div id="selection-success" class="hidden text-center">
        <div class="bg-white/10 backdrop-blur-md rounded-xl p-8 max-w-2xl mx-auto">
          <div class="text-6xl mb-6">🎉</div>
          <h2 class="text-3xl font-bold text-white mb-4">¡Selección Confirmada!</h2>
          <p class="text-purple-200 mb-6">Tu equipo ha sido registrado para esta semana. Los puntos se calcularán al final de la semana.</p>
          <a href="/nike-fc-cards" class="px-6 py-3 bg-purple-500 text-white font-semibold rounded-lg hover:bg-purple-600 transition-colors">
            Volver al Dashboard
          </a>
        </div>
      </div>
    </div>
  </div>

  <script>
    // State management
    let currentUser = null;
    let authToken = null;
    const storage = window.sessionStorage;
    let eligiblePlayers = { forwards: [], midfielders: [], defenders: [] };
    
    function playerImg(src) { return src ? `<img src=\"${src}\" class=\"w-full h-96 object-cover\"/>` : `<div class=\\\"w-full h-96 bg-purple-500\\\"></div>`; }
    let currentSelection = null;
    let selectedPlayers = {
      forward: null,
      midfielder: null,
      defender: null
    };

    // Auth functions
    function checkAuthState() {
      const token = storage.getItem('nike_fc_token');
      if (token) {
        authToken = token;
        return true;
      }
      return false;
    }

    // UI functions
    function showSection(sectionId) {
      const sections = ['not-logged-in', 'fantasy-container', 'selection-success', 'loading'];
      sections.forEach(id => {
        const element = document.getElementById(id);
        if (element) {
          element.classList.toggle('hidden', id !== sectionId);
        }
      });
    }

    function showTab(tabName) {
      // Update tab buttons
      document.querySelectorAll('.tab-button').forEach(btn => {
        btn.classList.remove('bg-purple-500', 'text-white');
        btn.classList.add('text-purple-200');
      });
      
      const activeTab = document.getElementById(`tab-${tabName}`);
      if (activeTab) {
        activeTab.classList.add('bg-purple-500', 'text-white');
        activeTab.classList.remove('text-purple-200');
      }

      // Show corresponding player list
      document.querySelectorAll('.player-list').forEach(list => {
        list.classList.add('hidden');
      });
      
      const activeList = document.getElementById(`${tabName}s-list`);
      if (activeList) {
        activeList.classList.remove('hidden');
      }
    }

    // API calls
    async function fetchEligiblePlayers() {
      try {
        const response = await fetch('/api/nike-fc-cards/fantasy/eligible', {
          headers: { 'Authorization': `Bearer ${authToken}` }
        });
        return await response.json();
      } catch (error) {
        console.error('Error fetching eligible players:', error);
        return { success: false, error: 'Error de conexión' };
      }
    }

    async function fetchCurrentSelection() {
      try {
        const response = await fetch('/api/nike-fc-cards/fantasy/selection', {
          headers: { 'Authorization': `Bearer ${authToken}` }
        });
        return await response.json();
      } catch (error) {
        console.error('Error fetching current selection:', error);
        return { success: false, error: 'Error de conexión' };
      }
    }

    async function createSelection() {
      try {
        const response = await fetch('/api/nike-fc-cards/fantasy/selection', {
          method: 'POST',
          headers: { 
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${authToken}` 
          },
          body: JSON.stringify({
            forwardPlayerId: selectedPlayers.forward.id,
            midfielderPlayerId: selectedPlayers.midfielder.id,
            defenderPlayerId: selectedPlayers.defender.id
          })
        });
        return await response.json();
      } catch (error) {
        console.error('Error creating selection:', error);
        return { success: false, error: 'Error de conexión' };
      }
    }

    // Display functions
    function displayCurrentSelection(selection) {
      // Mantener siempre visible el selector; no mostrar paneles de semana/resultados
      document.getElementById('player-selection').classList.remove('hidden');
    }

    function displayPlayers() {
      const labels = document.getElementById('labels');
      const row1 = document.getElementById('row1');
      const row2 = document.getElementById('row2');
      if (!labels || !row1 || !row2) return;

      [labels, row1, row2].forEach(el => el.innerHTML = '');

      const fw = (eligiblePlayers.forwards || []).slice(0, 4);
      const mids = (eligiblePlayers.midfielders || []).slice(0, 6);
      const defs = (eligiblePlayers.defenders || []).slice(0, 4);

      // Build label row with exact spans and without flex (prevents drift)
      const makeLabelGroup = (text, span, borderRight) => {
        const g = document.createElement('div');
        g.className = `col-span-${span} ${borderRight ? 'border-r border-white' : ''}`;
        const s = document.createElement('span');
        s.className = 'block w-full text-center px-6 py-2 rounded-md bg-black/60 border border-white/10 text-white text-xl font-extrabold tracking-wide';
        s.textContent = text;
        g.appendChild(s);
        return g;
      };
      labels.appendChild(makeLabelGroup('DELANTERO', 2, true));
      labels.appendChild(makeLabelGroup('CENTROCAMPISTA', 3, true));
      labels.appendChild(makeLabelGroup('DEFENSA & PORTERO', 2, false));

      // Row builders: create group wrappers with borders and inner grids
      const buildRow = (container, fwArr, midArr, defArr) => {
        const g1 = document.createElement('div');
        g1.className = 'col-span-2 border-r border-white';
        const g1grid = document.createElement('div');
        g1grid.className = 'grid grid-cols-2 gap-1';
        fwArr.forEach(p => { const w = document.createElement('div'); w.appendChild(createPlayerCard(p, 'forward')); g1grid.appendChild(w); });
        g1.appendChild(g1grid);

        const g2 = document.createElement('div');
        g2.className = 'col-span-3 border-r border-white';
        const g2grid = document.createElement('div');
        g2grid.className = 'grid grid-cols-3 gap-1';
        midArr.forEach(p => { const w = document.createElement('div'); w.appendChild(createPlayerCard(p, 'midfielder')); g2grid.appendChild(w); });
        g2.appendChild(g2grid);

        const g3 = document.createElement('div');
        g3.className = 'col-span-2';
        const g3grid = document.createElement('div');
        g3grid.className = 'grid grid-cols-2 gap-1';
        defArr.forEach(p => { const w = document.createElement('div'); w.appendChild(createPlayerCard(p, 'defender')); g3grid.appendChild(w); });
        g3.appendChild(g3grid);

        container.appendChild(g1);
        container.appendChild(g2);
        container.appendChild(g3);
      };

      // Row 1: 2/3/2
      buildRow(row1, fw.slice(0,2), mids.slice(0,3), defs.slice(0,2));
      // Row 2: 2/3/2
      buildRow(row2, fw.slice(2,4), mids.slice(3,6), defs.slice(2,4));
    }

    function createPlayerCard(player, position) {
      const card = document.createElement('div');
      const disabled = !player.owned; const owned = !!player.owned;
      card.className = `player-card group relative inline-block w-full transition-all ${disabled ? 'opacity-60 grayscale cursor-not-allowed' : 'hover:scale-105 cursor-pointer'}`;
      card.dataset.playerId = player.id;
      card.dataset.position = position; card.dataset.owned = owned ? 'true' : 'false';

      const img = playerImg(player.image_path);
      card.innerHTML = `
        <div class=\"relative overflow-hidden rounded-lg\">
          ${img}
          <div class=\"absolute inset-0 -translate-x-full bg-gradient-to-tr from-transparent via-white/20 to-transparent transition-transform duration-700 ease-in-out group-hover:translate-x-full\"></div>
          <div class=\"absolute inset-0 rounded-lg border-0 opacity-0 transition-all duration-300 group-hover:border-2 group-hover:opacity-100 border-pink-400/70\"></div>
          <div class=\"absolute inset-0 flex translate-y-2 flex-col items-center justify-end rounded-lg bg-gradient-to-t from-pink-950/90 via-pink-950/40 to-transparent p-2 opacity-0 transition-all duration-300 group-hover:translate-y-0 group-hover:opacity-100\">
            <h3 class=\"text-pink-300 text-[10px] font-semibold tracking-wide drop-shadow\">${player.name}</h3>
          </div>
          <div class=\"bg-pink-400 absolute -bottom-1 left-1/2 h-1 w-0 -translate-x-1/2 transform rounded-t-md transition-all duration-300 group-hover:w-2/3\"></div>
        </div>
        ${disabled ? '<div class=\"text-[10px] text-purple-300 mt-1 text-center\">No tienes la base</div>' : ''}
      `;

      if (!disabled) { // click only if not disabled by ownership; locks handled in handler
        card.addEventListener('click', () => selectPlayer(player, position));
      }
      return card;
    }

    function selectPlayer(player, position) {
      // Ignore if this card is locked
      const clicked = document.querySelector(`.player-card[data-player-id="${player.id}"][data-position="${position}"]`);
      if (clicked && clicked.classList.contains('locked')) return;
      if (!player.owned) return;
      selectedPlayers[position] = player;
      
      // Update visual selection
      document.querySelectorAll(`.player-card[data-position="${position}"]`).forEach(card => {
        card.classList.remove('border-green-500', 'bg-green-500/20');
        card.classList.add('border-transparent');
      });
      
      const selectedCard = document.querySelector(`.player-card[data-player-id="${player.id}"]`);
      if (selectedCard) {
        selectedCard.classList.add('border-green-500', 'bg-green-500/20');
        selectedCard.classList.remove('border-transparent');
      }

      // Update summary
      updateCrossPositionLocks();
      updateSelectionSummary();
    }

    function updateSelectionSummary() {
      document.getElementById('summary-forward').textContent = 
        selectedPlayers.forward ? selectedPlayers.forward.name : 'No seleccionado';
      document.getElementById('summary-midfielder').textContent = 
        selectedPlayers.midfielder ? selectedPlayers.midfielder.name : 'No seleccionado';
      document.getElementById('summary-defender').textContent = 
        selectedPlayers.defender ? selectedPlayers.defender.name : 'No seleccionado';

      // Enable/disable confirm button
      const confirmBtn = document.getElementById('confirm-selection-btn');
      const allSelected = selectedPlayers.forward && selectedPlayers.midfielder && selectedPlayers.defender;
      confirmBtn.disabled = !allSelected;
    }

    function updateCrossPositionLocks() {
      // Lock duplicate appearances of selected players in other groups
      const selectedIds = {
        forward: selectedPlayers.forward?.id || null,
        midfielder: selectedPlayers.midfielder?.id || null,
        defender: selectedPlayers.defender?.id || null,
      };
      const cards = document.querySelectorAll('.player-card');
      cards.forEach((el) => {
        const id = el.getAttribute('data-player-id');
        const pos = el.getAttribute('data-position');
        const owned = el.getAttribute('data-owned') === 'true';
        el.classList.remove('locked');
        if (!owned) return; // already disabled by ownership
        if (!id || !pos) return;
        // If this id is selected in any other position, lock here
        if ((selectedIds.forward && id === String(selectedIds.forward) && pos !== 'forward') ||
            (selectedIds.midfielder && id === String(selectedIds.midfielder) && pos !== 'midfielder') ||
            (selectedIds.defender && id === String(selectedIds.defender) && pos !== 'defender')) {
          el.classList.add('locked');
        }
      });
    }

    async function startFantasyPage() {
      if (!checkAuthState()) {
        showSection('not-logged-in');
        return;
      }

      showSection('loading');


      // Load data
      const [playersResult, selectionResult] = await Promise.all([
        fetchEligiblePlayers(),
        fetchCurrentSelection()
      ]);

      if (!playersResult.success) {
        alert('Error al cargar jugadores: ' + playersResult.error);
        return;
      }

      eligiblePlayers = playersResult.players;
      currentSelection = selectionResult.selection;

      showSection('fantasy-container');

      // Mostrar siempre el selector y renderizar todos los bloques
      displayCurrentSelection(currentSelection);
      displayPlayers();
      updateCrossPositionLocks();

      // Set up event listeners
      // Tabs deshabilitados (mostramos todas las listas a la vez)
      // document.getElementById('tab-forward').addEventListener('click', () => showTab('forward'));
      // document.getElementById('tab-midfielder').addEventListener('click', () => showTab('midfielder'));
      // document.getElementById('tab-defender').addEventListener('click', () => showTab('defender'));
      // Botón de cambio ya no es necesario (panel eliminado)

      document.getElementById('confirm-selection-btn').addEventListener('click', async () => {
        const confirmBtn = document.getElementById('confirm-selection-btn');
        confirmBtn.disabled = true;
        confirmBtn.textContent = 'Confirmando...';

        const result = await createSelection();
        
        if (result.success) {
          showSection('selection-success');
        } else {
          alert('Error al confirmar selección: ' + result.error);
          confirmBtn.disabled = false;
          confirmBtn.textContent = 'Confirmar Selección';
        }
      });
    }

    // Initialize on load and Astro transitions
    document.addEventListener('DOMContentLoaded', startFantasyPage);
    document.addEventListener('astro:page-load', startFantasyPage);
    document.addEventListener('astro:after-swap', startFantasyPage);

    // Utility functions
    function getWeekStart(date = new Date()) {
      const d = new Date(date);
      const day = d.getDay();
      const diff = d.getDate() - day + (day === 0 ? -6 : 1);
      const monday = new Date(d.setDate(diff));
      monday.setHours(0, 0, 0, 0);
      return monday;
    }

    function formatDate(date) {
      return date.toLocaleDateString('es-ES', { 
        day: 'numeric', 
        month: 'long'
      });
    }
  </script>
<style>
  /* Minimal styles inspired by BoxerCard */
  @media (prefers-reduced-motion) {
    .player-card, .player-card:hover, .player-card img, .player-card div {
      transition: opacity 0.3s ease !important;
      transform: none !important;
    }
  }
</style>
<style>
  .player-card.locked { filter: grayscale(1); opacity: 0.6; cursor: not-allowed; }
</style>
</Layout>

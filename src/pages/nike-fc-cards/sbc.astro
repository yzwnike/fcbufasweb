---
import NikeFCLayout from '@/layouts/NikeFCLayout.astro';
import Subheader from '@/components/nike-fc-cards/Subheader.astro';
---

<NikeFCLayout title="SBC - Desafíos de Creación de Plantillas" helpKey="sbc">
  <div class="min-h-screen bg-gradient-to-br from-emerald-900 via-emerald-800 to-teal-900">
    <div class="container mx-auto px-4 py-6">
      <Subheader variant="minimal" />

      <div class="text-center mb-6">
        <h1 class="text-base md:text-lg font-bold text-white mb-4">SBC - Squad Building Challenges</h1>
        <p class="text-sm md:text-base text-emerald-100 max-w-2xl mx-auto">
          Completa desafíos mensuales creando plantillas y gana sobres o cartas
        </p>
      </div>

      <!-- Auth Check -->
      <div id="not-logged-in" class="hidden text-center">
        <div class="bg-red-500/20 backdrop-blur-md rounded-xl p-8 max-w-md mx-auto">
          <h3 class="text-2xl font-bold text-white mb-4">Acceso Requerido</h3>
          <p class="text-red-200 mb-6">Debes iniciar sesión para acceder a los SBC</p>
          <a href="/nike-fc-cards" class="px-6 py-3 bg-white text-red-900 font-semibold rounded-lg hover:bg-red-100 transition-colors">Iniciar Sesión</a>
        </div>
      </div>

      <!-- SBC Container -->
      <div id="sbc-container" class="hidden">
        <div class="max-w-4xl mx-auto">
          <!-- SBC List -->
          <div id="sbc-list" class="space-y-3">
            <!-- SBC items will be loaded here -->
          </div>
          
          <!-- Loading -->
          <div id="loading" class="text-center py-8">
            <div class="text-white">Cargando desafíos...</div>
          </div>

          <!-- No SBC -->
          <div id="no-sbc" class="hidden text-center py-8">
            <div class="bg-white/10 backdrop-blur-md rounded-xl p-8 max-w-md mx-auto">
              <div class="text-6xl mb-4">🏆</div>
              <h3 class="text-2xl font-bold text-white mb-4">Sin desafíos</h3>
              <p class="text-emerald-200 mb-6">No hay desafíos SBC disponibles en este momento</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    // State management
    let authToken = null;
    let challenges = [];
    const storage = window.sessionStorage;
    const expandedSBCs = new Set();

    // Auth functions
    function checkAuthState() {
      const token = storage.getItem('nike_fc_token');
      if (token) {
        authToken = token;
        return true;
      }
      return false;
    }

    // UI functions
    function showSection(sectionId) {
      const sections = ['not-logged-in', 'sbc-container', 'loading', 'no-sbc'];
      sections.forEach(id => {
        const element = document.getElementById(id);
        if (element) {
          element.classList.toggle('hidden', id !== sectionId);
        }
      });
    }

    // Fetch SBC challenges from API
    async function fetchChallenges() {
      try {
        const res = await fetch('/api/nike-fc-cards/sbc', {
          headers: { Authorization: `Bearer ${authToken}` },
          cache: 'no-store'
        });
        return await res.json();
      } catch (e) {
        return { success: false, error: 'Error de conexión' };
      }
    }

    // Toggle SBC expansion
    function toggleSBC(sbcId) {
      const content = document.getElementById(`sbc-content-${sbcId}`);
      const arrow = document.getElementById(`sbc-arrow-${sbcId}`);
      
      if (expandedSBCs.has(sbcId)) {
        // Collapse
        expandedSBCs.delete(sbcId);
        content.classList.add('hidden');
        arrow.style.transform = 'rotate(0deg)';
      } else {
        // Expand
        expandedSBCs.add(sbcId);
        content.classList.remove('hidden');
        arrow.style.transform = 'rotate(180deg)';
      }
    }

    // Create SBC element
    function createSBCElement(challenge) {
      const sbcDiv = document.createElement('div');
      sbcDiv.className = 'bg-white/10 backdrop-blur-md rounded-xl overflow-hidden';
      
      const statusBadge = challenge.completed 
        ? '<span class="px-2 py-1 bg-emerald-600 text-white text-xs rounded-full">Completado</span>'
        : '<span class="px-2 py-1 bg-yellow-500 text-black text-xs rounded-full">Disponible</span>';
      
      // Format dates
      const startDate = new Date(challenge.start_at).toLocaleDateString('es-ES');
      const endDate = new Date(challenge.end_at).toLocaleDateString('es-ES');
      
      // Format requirements
      const req = challenge.requirements || {};
      const requirements = `Jugadores: ${req.min_players||1}-${req.max_players||11} | Rating mín: ${req.min_avg_rating||0} | Especiales: ${req.min_special_cards||0}`;
      
      // Generate reward HTML
      let rewardsHTML = '';
      if (Array.isArray(challenge.rewards) && challenge.rewards.length) {
        rewardsHTML = challenge.rewards.map(reward => {
          if (reward.reward_type === 'CARD' && reward.card_image_path) {
            return `
              <div class="text-center">
                <img src="${reward.card_image_path}" alt="${reward.player_name || 'Carta'}" class="w-16 h-20 object-cover rounded-lg mx-auto mb-2" />
                <div class="text-xs text-white font-semibold">${reward.player_name || 'Carta Especial'}</div>
              </div>
            `;
          } else if (reward.reward_type === 'PACK') {
            return `
              <div class="text-center">
                <div class="w-16 h-16 bg-gradient-to-br from-yellow-400 to-yellow-600 rounded-lg flex items-center justify-center mx-auto mb-2">
                  <span class="text-2xl">📦</span>
                </div>
                <div class="text-xs text-white font-semibold">${reward.pack_type || 'Pack'}</div>
                <div class="text-xs text-emerald-200">x${reward.amount || 1}</div>
              </div>
            `;
          } else if (reward.reward_type === 'COINS') {
            return `
              <div class="text-center">
                <div class="w-16 h-16 bg-gradient-to-br from-yellow-400 to-yellow-600 rounded-lg flex items-center justify-center mx-auto mb-2">
                  <span class="text-2xl">💰</span>
                </div>
                <div class="text-xs text-white font-semibold">${reward.amount || 0} Monedas</div>
              </div>
            `;
          }
          return '';
        }).join('');
      }
      
      sbcDiv.innerHTML = `
        <!-- SBC Header (Clickable) -->
        <button class="w-full p-4 flex items-center justify-between hover:bg-white/5 transition-colors" onclick="toggleSBC('${challenge.id}')">
          <div class="flex-1 text-left">
            <div class="flex items-center gap-3 mb-2">
              <h3 class="text-lg font-bold text-white">${challenge.title || 'SBC Sin Título'}</h3>
              ${statusBadge}
            </div>
            <p class="text-sm text-emerald-200">${challenge.description || 'Descripción no disponible'}</p>
            <p class="text-xs text-emerald-300 mt-1">Disponible: ${startDate} - ${endDate}</p>
          </div>
          <div class="flex-shrink-0 ml-4">
            <svg id="sbc-arrow-${challenge.id}" class="w-5 h-5 text-white transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </div>
        </button>
        
        <!-- SBC Content (Expandable) -->
        <div id="sbc-content-${challenge.id}" class="hidden border-t border-white/10">
          <div class="p-4">
            <!-- Requirements -->
            <div class="mb-4">
              <h4 class="text-sm font-semibold text-emerald-200 mb-2">Requisitos:</h4>
              <div class="bg-black/20 rounded-lg p-3">
                <p class="text-xs text-emerald-100">${requirements}</p>
              </div>
            </div>
            
            <!-- Rewards -->
            ${rewardsHTML ? `
              <div class="mb-6">
                <h4 class="text-sm font-semibold text-emerald-200 mb-3">Recompensas:</h4>
                <div class="flex gap-4 justify-center">
                  ${rewardsHTML}
                </div>
              </div>
            ` : ''}
            
            <!-- Action Button -->
            <div class="text-center">
              ${challenge.completed 
                ? '<button class="px-6 py-2 bg-emerald-600 text-white rounded-lg opacity-50 cursor-not-allowed" disabled>Completado</button>'
                : '<button class="px-6 py-2 bg-emerald-500 hover:bg-emerald-600 text-white rounded-lg transition-colors" onclick="startSBC(\''+challenge.id+'\')">🚀 Comenzar Desafío</button>'
              }
            </div>
          </div>
        </div>
      `;
      
      return sbcDiv;
    }

    // Display SBC list
    function displaySBCs(sbcList) {
      const list = document.getElementById('sbc-list');
      
      if (sbcList.length === 0) {
        document.getElementById('no-sbc').classList.remove('hidden');
        return;
      }
      
      document.getElementById('no-sbc').classList.add('hidden');
      list.innerHTML = '';
      
      sbcList.forEach(challenge => {
        const sbcElement = createSBCElement(challenge);
        list.appendChild(sbcElement);
      });
    }

    // Start SBC (placeholder - could redirect to builder)
    function startSBC(challengeId) {
      alert(`Funcionalidad de SBC Builder para el desafío ${challengeId} estará disponible próximamente`);
      // TODO: Implement SBC builder or redirect to builder page
    }

    // Make functions global for HTML onclick
    window.toggleSBC = toggleSBC;
    window.startSBC = startSBC;

    async function startSBCPage() {
      if (!checkAuthState()) {
        showSection('not-logged-in');
        return;
      }

      showSection('loading');

      const result = await fetchChallenges();
      
      if (!result.success) {
        console.error('SBC load failed:', result);
        alert('Error al cargar los desafíos SBC' + (result.error ? (': ' + result.error) : ''));
        return;
      }

      challenges = result.challenges || [];
      
      showSection('sbc-container');
      displaySBCs(challenges);
    }

    document.addEventListener('DOMContentLoaded', startSBCPage);
    document.addEventListener('astro:page-load', startSBCPage);
    document.addEventListener('astro:after-swap', startSBCPage);
  </script>
</NikeFCLayout>

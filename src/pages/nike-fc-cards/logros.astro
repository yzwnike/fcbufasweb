---
import NikeFCLayout from '@/layouts/NikeFCLayout.astro';
import Subheader from '@/components/nike-fc-cards/Subheader.astro';
---

<NikeFCLayout title="Logros - Nike FC Cards" helpKey="logros">
  <div class="min-h-screen bg-gradient-to-br from-indigo-900 via-indigo-800 to-purple-900">
    <div class="container mx-auto px-4 pt-28 pb-10">
      <Subheader variant="minimal" />
      <h1 class="text-4xl font-extrabold text-white mb-6">Logros</h1>
      <p class="text-indigo-200 mb-4">Cumple objetivos y gana monedas</p>

      <div id="achv-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-4"></div>
    </div>
  </div>

  <script>
    const storage = window.sessionStorage;
    let token = null;

    function requireAuth() {
      const t = storage.getItem('nike_fc_token');
      if (!t) { window.location.href = '/nike-fc-cards'; return false; }
      token = t; return true;
    }

    async function fetchAchievements() {
      const res = await fetch('/api/nike-fc-cards/achievements', { cache: 'no-store', headers: { Authorization: `Bearer ${token}` }});
      return await res.json();
    }

    function render(list) {
      const grid = document.getElementById('achv-grid');
      if (!grid) return;
      grid.innerHTML = '';

      const STYLES = {
        fantasy_jornadas: { icon: '🏁', accent: 'text-rose-300' },
        cartas_totales: { icon: '🃏', accent: 'text-amber-300' },
        cartas_distintas: { icon: '🌈', accent: 'text-fuchsia-300' },
        sbc_completados: { icon: '🧩', accent: 'text-sky-300' },
        mercado_compras: { icon: '🛒', accent: 'text-emerald-300' },
        mercado_ventas: { icon: '💸', accent: 'text-lime-300' },
        sobres_abiertos: { icon: '📦', accent: 'text-indigo-300' },
        quiz_aciertos: { icon: '❓', accent: 'text-purple-300' },
      };

      list.forEach(a => {
        const s = STYLES[a.key] || { icon:'⭐', accent:'text-white' };

        // Target del nivel actual: si hay umbrales reclamables, usamos el menor para mostrar barra completa; si no, usamos el próximo objetivo
        const claimables = Array.isArray(a.claimable) ? a.claimable : [];
        const next = a.nextTarget;
        const target = claimables.length ? Math.min(...claimables.map((c:any)=>c.threshold)) : (next || (a.thresholds[a.thresholds.length-1] || 1));
        const pct = target ? Math.max(0, Math.min(100, Math.round(100 * a.currentValue / target))) : 0;
        const completedThisLevel = a.currentValue >= target && claimables.some((c:any)=>c.threshold === target);

        const card = document.createElement('div');
        card.className = 'relative rounded-xl border border-slate-700 bg-slate-800 p-4 text-white overflow-hidden';
        card.innerHTML = `
          <div class="relative flex items-center justify-between mb-4">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-lg bg-slate-700 flex items-center justify-center text-xl">${s.icon}</div>
              <div>
                <div class="text-xl font-bold">${a.title}</div>
                <div class="text-sm ${s.accent}">Progreso: ${a.currentValue}/${target}</div>
              </div>
            </div>
            <div class="text-sm text-slate-300">${next ? `Siguiente: ${next}` : 'Completado'}</div>
          </div>

          <div class="w-full h-3 bg-slate-700 rounded mb-4">
            <div class="h-3 ${completedThisLevel ? 'bg-emerald-500' : 'bg-indigo-500'} rounded transition-all" style="width:${pct}%"></div>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-4">
            <!-- Niveles -->
            <div class="lg:col-span-2">
              <div class="text-sm text-slate-300 mb-3">Niveles</div>
              <div class="grid grid-cols-4 sm:grid-cols-6 md:grid-cols-8 gap-2">
                ${a.thresholds.map((t:number) => {
                  const done = a.currentValue >= t;
                  const claimed = (a.claimedThresholds || []).includes(t);
                  const canClaim = (a.claimable || []).some((c:any) => c.threshold === t);
                  let btnClass = 'w-12 h-12 rounded-lg border-2 flex items-center justify-center text-sm font-bold cursor-pointer transition-all hover:scale-105 relative level-btn';
                  
                  const isCurrentTarget = t === target;
                  
                  if (claimed) {
                    btnClass += ' bg-green-600 border-green-400 text-white';
                  } else if (canClaim) {
                    btnClass += ' bg-emerald-600/80 border-emerald-400 text-white animate-pulse';
                  } else if (isCurrentTarget && !done) {
                    btnClass += ' bg-yellow-600 border-yellow-400 text-white ring-2 ring-yellow-300';
                  } else if (done) {
                    btnClass += ' bg-indigo-600 border-indigo-400 text-white';
                  } else {
                    btnClass += ' bg-slate-700 border-slate-600 text-slate-400';
                  }
                  
                  const checkIcon = claimed ? '<span class="absolute top-0 right-0 transform translate-x-1 -translate-y-1 bg-green-500 text-white rounded-full w-4 h-4 flex items-center justify-center text-xs">✓</span>' : '';
                  
                  return `<div class="${btnClass}" data-th="${t}">${t}${checkIcon}</div>`;
                }).join('')}
              </div>
            </div>
            
            <!-- Preview -->
            <div class="lg:col-span-1">
              <div class="text-sm text-slate-300 mb-3">Vista previa</div>
              <div class="aspect-square rounded-lg border border-slate-600 bg-slate-700 overflow-hidden flex items-center justify-center relative preview-box"></div>
            </div>
          </div>

          <div class=\"flex items-center justify-between\">
            <div class=\"text-sm text-yellow-300\">${claimables.length ? `+${claimables.reduce((s:any,x:any)=>s+x.coins,0)} monedas disponibles` : ''}</div>
            <button class=\"px-3 py-1 rounded ${completedThisLevel ? 'bg-emerald-600 hover:bg-emerald-700' : 'bg-gray-600'} disabled:bg-gray-500\" ${completedThisLevel? '' : 'disabled'} data-key=\"${a.key}\">Reclamar</button>
          </div>
        `;
        const previewBox = card.querySelector('.preview-box');
        const setPreview = (thr) => {
          const rw = (a.rewards || []).find((r)=>r.threshold===thr) || {};
          const claimed = (a.claimedThresholds || []).includes(thr);
          if (!previewBox) return;
          
          let content = '';
          let checkOverlay = claimed ? '<div class=\"absolute inset-0 bg-green-500/20 flex items-center justify-center\"><div class=\"bg-green-500 text-white rounded-full w-16 h-16 flex items-center justify-center text-2xl font-bold\">✓</div></div>' : '';
          
          if (rw.reward_type==='CARD' && rw.card_image_path) {
            content = `<img src=\"${rw.card_image_path}\" alt=\"${rw.player_name||'Carta'}\" class=\"w-full h-full object-cover\" />${checkOverlay}`;
          } else if (rw.reward_type==='PACK') {
            content = `<div class=\"text-center p-4\"><div class=\"text-6xl\">📦</div><div class=\"mt-2 text-sm text-slate-200\">${rw.pack_label || rw.pack_type || 'Sobre'}</div></div>${checkOverlay}`;
          } else {
            content = `<div class=\"text-center p-4\"><div class=\"text-6xl\">🪙</div><div class=\"mt-2 text-sm text-slate-200\">+${rw.coins||0} monedas</div></div>${checkOverlay}`;
          }
          
          previewBox.innerHTML = content;
        };
        // Event listeners for level buttons
        card.querySelectorAll('.level-btn[data-th]').forEach((el)=> {
          el.addEventListener('click', ()=> {
            // Remove active class from all buttons in this card
            card.querySelectorAll('.level-btn').forEach(btn => btn.classList.remove('ring-2', 'ring-yellow-400'));
            // Add active class to clicked button
            el.classList.add('ring-2', 'ring-yellow-400');
            // Update preview
            setPreview(Number(el.getAttribute('data-th')));
          });
        });
        // Set initial preview to current target
        setPreview(target);
        // Highlight current target button initially
        const targetBtn = card.querySelector(`[data-th="${target}"]`);
        if (targetBtn) {
          targetBtn.classList.add('ring-2', 'ring-yellow-400');
        }
        const btn = card.querySelector('button');
        btn?.addEventListener('click', async () => {
          const claimables = Array.isArray(a.claimable) ? a.claimable : [];
          if (claimables.length === 0) return;
          
          // Deshabilitar el botón mientras se procesa
          btn.disabled = true;
          btn.textContent = 'Reclamando...';
          
          try {
            const r = await fetch('/api/nike-fc-cards/achievements/claim-multiple', {
              method: 'POST', 
              headers: { 'Content-Type':'application/json', Authorization: `Bearer ${token}` },
              body: JSON.stringify({ key: a.key })
            });
            const result = await r.json();
            
            if (result.success && result.coins > 0) {
              // Mostrar notificación de éxito
              showNotification(`¡Reclamaste ${result.claimedCount} logro(s) por +${result.coins} monedas!`, 'success');
            }
            
            start(); // Recargar datos
          } catch (error) {
            showNotification('Error al reclamar recompensas', 'error');
          } finally {
            // Rehabilitar el botón
            btn.disabled = false;
            btn.textContent = 'Reclamar';
          }
        });
        grid.appendChild(card);
      });
    }

    function showNotification(message, type = 'info') {
      // Crear elemento de notificación
      const notification = document.createElement('div');
      notification.className = `fixed top-4 right-4 z-50 px-6 py-4 rounded-lg shadow-lg text-white font-medium transform translate-x-full transition-transform duration-300 ${
        type === 'success' ? 'bg-green-600' : 
        type === 'error' ? 'bg-red-600' : 
        'bg-blue-600'
      }`;
      notification.textContent = message;
      
      document.body.appendChild(notification);
      
      // Animar entrada
      setTimeout(() => {
        notification.classList.remove('translate-x-full');
      }, 100);
      
      // Auto remover después de 3 segundos
      setTimeout(() => {
        notification.classList.add('translate-x-full');
        setTimeout(() => {
          if (notification.parentNode) {
            notification.parentNode.removeChild(notification);
          }
        }, 300);
      }, 3000);
    }

    async function start() {
      if (!requireAuth()) return;
      const grid = document.getElementById('achv-grid');
      if (!grid) return;
      try {
        const data = await fetchAchievements();
        if (data && data.success) render(data.achievements || []);
      } catch {}
    }

    const kickoff = () => start();
    document.addEventListener('DOMContentLoaded', kickoff);
    document.addEventListener('astro:page-load', kickoff);
    document.addEventListener('astro:after-swap', kickoff);
    document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'visible') kickoff(); });
    window.addEventListener('pageshow', kickoff);
    setTimeout(kickoff, 0);
  </script>
</NikeFCLayout>

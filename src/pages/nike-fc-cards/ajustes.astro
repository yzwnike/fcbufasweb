---
import Layout from '@/layouts/Layout.astro';
import Subheader from '@/components/nike-fc-cards/Subheader.astro';
---

<Layout title="Ajustes de Perfil - Nike FC Cards">
  <div class="min-h-screen bg-gradient-to-br from-slate-900 via-slate-800 to-slate-700">
    <div class="container mx-auto px-4 pt-28 pb-10">
      <Subheader variant="minimal" />
      <h1 class="text-3xl md:text-4xl font-extrabold text-white mb-6">Ajustes de Perfil</h1>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Perfil -->
        <div class="bg-white/10 backdrop-blur-md border border-white/10 rounded-xl p-6">
          <h2 class="text-xl font-bold text-white mb-4">Usuario</h2>
          <form id="profile-form" class="space-y-4">
            <div>
              <label class="block text-sm text-slate-200 mb-1">Username</label>
              <input id="pf-username" type="text" minlength="3" maxlength="20" class="w-full px-3 py-2 rounded bg-white/80 text-slate-900" />
            </div>
            <div>
              <label class="block text-sm text-slate-200 mb-1">Email</label>
              <input id="pf-email" type="email" class="w-full px-3 py-2 rounded bg-white/80 text-slate-900" />
            </div>
            <div id="pf-error" class="hidden text-red-300 text-sm"></div>
            <button type="submit" class="px-4 py-2 rounded bg-emerald-600 text-white">Guardar</button>
          </form>
        </div>

        <!-- Password -->
        <div class="bg-white/10 backdrop-blur-md border border-white/10 rounded-xl p-6">
          <h2 class="text-xl font-bold text-white mb-4">Contraseña</h2>
          <form id="pw-form" class="space-y-4">
            <div>
              <label class="block text-sm text-slate-200 mb-1">Actual</label>
              <input id="pw-current" type="password" class="w-full px-3 py-2 rounded bg-white/80 text-slate-900" />
            </div>
            <div>
              <label class="block text-sm text-slate-200 mb-1">Nueva</label>
              <input id="pw-new" type="password" minlength="6" class="w-full px-3 py-2 rounded bg-white/80 text-slate-900" />
            </div>
            <div id="pw-error" class="hidden text-red-300 text-sm"></div>
            <button type="submit" class="px-4 py-2 rounded bg-blue-600 text-white">Cambiar contraseña</button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <script>
    const storage = window.sessionStorage;
    let token = null;

    function requireAuth() {
      const t = storage.getItem('nike_fc_token');
      if (!t) { window.location.href = '/nike-fc-cards'; return false; }
      token = t; return true;
    }

    async function loadProfile() {
      const res = await fetch('/api/nike-fc-cards/profile', { headers: { Authorization: `Bearer ${token}` }});
      const data = await res.json();
      if (data && data.success) {
        document.getElementById('pf-username').value = data.user.username;
        document.getElementById('pf-email').value = data.user.email;
      }
    }

    async function start() {
      if (!requireAuth()) return;
      await loadProfile();

      // Save profile
      const pf = document.getElementById('profile-form');
      pf.addEventListener('submit', async (e) => {
        e.preventDefault();
        const username = (document.getElementById('pf-username').value || '').trim();
        const email = (document.getElementById('pf-email').value || '').trim();
        const err = document.getElementById('pf-error'); err.classList.add('hidden'); err.textContent = '';
        try {
          const res = await fetch('/api/nike-fc-cards/profile', { method: 'PUT', headers: { 'Content-Type':'application/json', Authorization: `Bearer ${token}` }, body: JSON.stringify({ username, email })});
          const data = await res.json();
          if (!data.success) { err.textContent = data.error || 'No se pudo guardar'; err.classList.remove('hidden'); }
          else { alert('Actualizado'); }
        } catch {
          err.textContent = 'Error de conexión'; err.classList.remove('hidden');
        }
      });

      // Change password
      const pwf = document.getElementById('pw-form');
      pwf.addEventListener('submit', async (e) => {
        e.preventDefault();
        const currentPassword = document.getElementById('pw-current').value;
        const newPassword = document.getElementById('pw-new').value;
        const err = document.getElementById('pw-error'); err.classList.add('hidden'); err.textContent = '';
        try {
          const res = await fetch('/api/nike-fc-cards/profile/password', { method: 'PUT', headers: { 'Content-Type':'application/json', Authorization: `Bearer ${token}` }, body: JSON.stringify({ currentPassword, newPassword })});
          const data = await res.json();
          if (!data.success) { err.textContent = data.error || 'No se pudo cambiar'; err.classList.remove('hidden'); }
          else { alert('Contraseña actualizada'); document.getElementById('pw-current').value=''; document.getElementById('pw-new').value=''; }
        } catch {
          err.textContent = 'Error de conexión'; err.classList.remove('hidden');
        }
      });
    }

    document.addEventListener('DOMContentLoaded', start);
  </script>
</Layout>
<script>
  function initializeHelpToggles() {
    const toggles = document.querySelectorAll('.help-toggle');
    
    // Limpiar event listeners existentes para evitar duplicados
    toggles.forEach(toggle => {
      const newToggle = toggle.cloneNode(true);
      toggle.parentNode.replaceChild(newToggle, toggle);
    });
    
    // Obtener los nuevos toggles después del reemplazo
    const newToggles = document.querySelectorAll('.help-toggle');
    
    newToggles.forEach(toggle => {
      toggle.addEventListener('click', function() {
        const target = this.getAttribute('data-target');
        const content = document.getElementById(target);
        const arrow = this.querySelector('.help-arrow');
        
        if (content && arrow) {
          const isHidden = content.classList.contains('hidden');
          
          if (isHidden) {
            content.classList.remove('hidden');
            arrow.classList.add('rotate-180');
            content.style.maxHeight = content.scrollHeight + 'px';
          } else {
            content.classList.add('hidden');
            arrow.classList.remove('rotate-180');
            content.style.maxHeight = '0px';
          }
        }
      });
    });
  }
  
  // Inicializar cuando el DOM esté listo
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeHelpToggles);
  } else {
    initializeHelpToggles();
  }

  // Reinicializar en navegaciones de Astro
  document.addEventListener('astro:page-load', initializeHelpToggles);
  document.addEventListener('astro:after-swap', initializeHelpToggles);
</script>

<style>
  .help-content {
    transition: all 0.3s ease-in-out;
    overflow: hidden;
  }
  
  .help-arrow {
    transition: transform 0.3s ease-in-out;
  }
  
  .help-toggle:hover .help-arrow {
    transform: translateY(2px);
  }
</style>
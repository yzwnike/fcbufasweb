---
import NikeFCLayout from '@/layouts/NikeFCLayout.astro';
import Subheader from '@/components/bufas-cards/Subheader.astro';
---

<NikeFCLayout title="Ajustes de Perfil - Bufas Cards" helpKey="ajustes">
  <div class="min-h-screen bg-gradient-to-br from-slate-900 via-slate-800 to-slate-700">
    <div class="container mx-auto px-4 pt-4 pb-10">
      <Subheader variant="minimal" />
      <h1 class="text-3xl md:text-4xl font-extrabold text-white mb-6">Ajustes de Perfil</h1>
      <p class="text-slate-200 mb-4">Puedes cambiar tu nombre de usuario y tu correo editando los campos y pulsando <span class="font-semibold">Guardar</span>. Para cambiar la contraseña, introduce la <span class="font-semibold">actual</span> y la <span class="font-semibold">nueva</span> y pulsa <span class="font-semibold">Cambiar contraseña</span>.</p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Perfil -->
        <div class="bg-white/10 backdrop-blur-md border border-white/10 rounded-xl p-6">
          <h2 class="text-xl font-bold text-white mb-1">Usuario</h2>
          <p class="text-slate-200 text-sm mb-4">Edita tu nombre de usuario y tu correo y pulsa <span class="font-semibold">Guardar</span>.</p>
          <form id="profile-form" class="space-y-4">
            <div>
              <label class="block text-sm text-slate-200 mb-1">Username</label>
              <input id="pf-username" type="text" minlength="3" maxlength="20" pattern="[a-zA-Z0-9_]+" required class="w-full px-3 py-2 rounded bg-white/80 text-slate-900" />
            </div>
            <div>
              <label class="block text-sm text-slate-200 mb-1">Email</label>
              <input id="pf-email" type="email" required class="w-full px-3 py-2 rounded bg-white/80 text-slate-900" />
            </div>
            <div id="pf-error" class="hidden text-red-300 text-sm"></div>
            <button type="submit" class="px-4 py-2 rounded bg-emerald-600 text-white">Guardar</button>
          </form>
        </div>

        <!-- Password -->
        <div class="bg-white/10 backdrop-blur-md border border-white/10 rounded-xl p-6">
          <h2 class="text-xl font-bold text-white mb-1">Contraseña</h2>
          <p class="text-slate-200 text-sm mb-4">Introduce tu <span class="font-semibold">contraseña actual</span> y la <span class="font-semibold">nueva</span> y pulsa <span class="font-semibold">Cambiar contraseña</span>.</p>
          <form id="pw-form" class="space-y-4">
            <div>
              <label class="block text-sm text-slate-200 mb-1">Actual</label>
              <input id="pw-current" type="password" class="w-full px-3 py-2 rounded bg-white/80 text-slate-900" />
            </div>
            <div>
              <label class="block text-sm text-slate-200 mb-1">Nueva</label>
              <input id="pw-new" type="password" minlength="6" class="w-full px-3 py-2 rounded bg-white/80 text-slate-900" />
            </div>
            <div id="pw-error" class="hidden text-red-300 text-sm"></div>
            <button type="submit" class="px-4 py-2 rounded bg-blue-600 text-white">Cambiar contraseña</button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <script>
    const storage = window.sessionStorage;
    let token = null;

    function requireAuth() {
      const t = storage.getItem('nike_fc_token');
      if (!t) { window.location.href = '/bufas-cards'; return false; }
      token = t; return true;
    }

    async function loadProfile() {
      const res = await fetch('/api/bufas-cards/profile', { cache: 'no-store', headers: { Authorization: `Bearer ${token}` }});
      const data = await res.json();
      if (data && data.success) {
        const u = document.getElementById('pf-username');
        const e = document.getElementById('pf-email');
        if (u) u.value = data.user.username;
        if (e) e.value = data.user.email;
        
        // Guardar datos originales para comparación
        originalData.username = data.user.username;
        originalData.email = data.user.email;
      }
    }

    let originalData = { username: '', email: '' };
    
    function bindForms() {
      const pf = document.getElementById('profile-form');
      if (pf && !pf.dataset.bound) {
        pf.dataset.bound = '1';
        pf.addEventListener('submit', async (e) => {
          e.preventDefault();
          const username = (document.getElementById('pf-username').value || '').trim();
          const email = (document.getElementById('pf-email').value || '').trim();
          const err = document.getElementById('pf-error'); err.classList.add('hidden'); err.textContent = '';
          
          // Validación local básica
          if (!username || username.length < 3 || username.length > 20) {
            err.textContent = 'Username debe tener entre 3 y 20 caracteres'; err.classList.remove('hidden');
            return;
          }
          if (!email || !email.includes('@')) {
            err.textContent = 'Email no válido'; err.classList.remove('hidden');
            return;
          }
          
          // Construir objeto solo con campos que han cambiado
          const updateData = {};
          if (username !== originalData.username) {
            updateData.username = username;
          }
          if (email !== originalData.email) {
            updateData.email = email;
          }
          
          // Si no hay cambios, no hacer nada
          if (Object.keys(updateData).length === 0) {
            err.textContent = 'No hay cambios que guardar'; err.classList.remove('hidden');
            return;
          }
          
          try {
            const res = await fetch('/api/bufas-cards/profile', { 
              method: 'PUT', 
              headers: { 'Content-Type':'application/json', Authorization: `Bearer ${token}` }, 
              body: JSON.stringify(updateData)
            });
            const data = await res.json();
            if (!data.success) { 
              err.textContent = data.error || 'No se pudo guardar'; 
              err.classList.remove('hidden'); 
            } else { 
              alert('Actualizado'); 
              // Actualizar datos originales para futuras comparaciones
              originalData.username = data.user.username;
              originalData.email = data.user.email;
            }
          } catch {
            err.textContent = 'Error de conexión'; err.classList.remove('hidden');
          }
        });
      }

      const pwf = document.getElementById('pw-form');
      if (pwf && !pwf.dataset.bound) {
        pwf.dataset.bound = '1';
        pwf.addEventListener('submit', async (e) => {
          e.preventDefault();
          const currentPassword = document.getElementById('pw-current').value;
          const newPassword = document.getElementById('pw-new').value;
          const err = document.getElementById('pw-error'); err.classList.add('hidden'); err.textContent = '';
          try {
            const res = await fetch('/api/bufas-cards/profile/password', { method: 'PUT', headers: { 'Content-Type':'application/json', Authorization: `Bearer ${token}` }, body: JSON.stringify({ currentPassword, newPassword })});
            const data = await res.json();
            if (!data.success) { err.textContent = data.error || 'No se pudo cambiar'; err.classList.remove('hidden'); }
            else { alert('Contraseña actualizada'); document.getElementById('pw-current').value=''; document.getElementById('pw-new').value=''; }
          } catch {
            err.textContent = 'Error de conexión'; err.classList.remove('hidden');
          }
        });
      }
    }

    async function start() {
      if (!requireAuth()) return;
      if (!document.getElementById('profile-form')) return;
      await loadProfile();
      bindForms();
    }

    const kickoff = () => start();
    document.addEventListener('DOMContentLoaded', kickoff);
    document.addEventListener('astro:page-load', kickoff);
    document.addEventListener('astro:after-swap', kickoff);
    document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'visible') kickoff(); });
    window.addEventListener('pageshow', kickoff);
    setTimeout(kickoff, 0);
  </script>
</NikeFCLayout>

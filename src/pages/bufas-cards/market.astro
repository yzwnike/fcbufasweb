---
import NikeFCLayout from '@/layouts/NikeFCLayout.astro';
import Subheader from '@/components/bufas-cards/Subheader.astro';
---

<NikeFCLayout title="Mercado - Bufas Cards" helpKey="market">
  <div class="min-h-screen bg-gradient-to-br from-yellow-900 via-yellow-800 to-orange-900">
    <div class="container mx-auto px-4 py-6">
      <!-- Subheader Nav -->
      <Subheader variant="minimal" />
      <!-- Header -->
      <div class="text-center mb-6">
        <h1 class="text-sm md:text-base font-bold text-white mb-4">
          Mercado de Cartas
        </h1>
        <p class="text-sm md:text-base text-yellow-100 max-w-2xl mx-auto">
          Compra y vende cartas con otros usuarios. Encuentra las cartas que necesitas para completar tu colección
        </p>
      </div>

      <!-- Auth Check -->
      <div id="not-logged-in" class="hidden text-center">
        <div class="bg-red-500/20 backdrop-blur-md rounded-xl p-8 max-w-md mx-auto">
          <h3 class="text-2xl font-bold text-white mb-4">Acceso Requerido</h3>
          <p class="text-red-200 mb-6">Debes iniciar sesión para acceder al mercado</p>
          <a href="/bufas-cards" class="px-6 py-3 bg-white text-red-900 font-semibold rounded-lg hover:bg-red-100 transition-colors">
            Iniciar Sesión
          </a>
        </div>
      </div>

      <!-- Market Container -->
      <div id="market-container" class="hidden">
        <!-- User Balance -->
        <div class="bg-white/10 backdrop-blur-md rounded-xl p-3 mb-4 max-w-md mx-auto">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-xs text-yellow-100">Tu saldo:</p>
              <p id="user-balance" class="text-lg font-bold text-yellow-400">0</p>
            </div>
            <div class="text-right">
              <p class="text-xs text-yellow-100">Cartas en venta:</p>
              <p id="user-cards-for-sale" class="text-lg font-bold text-green-400">0</p>
            </div>
          </div>
        </div>

        <!-- Filter Button -->
        <div class="flex justify-between items-center mb-3 max-w-6xl mx-auto">
          <div class="text-sm font-bold text-white">Mercado de Cartas</div>
          <button id="open-filters-btn" class="flex items-center gap-2 px-4 py-2 bg-yellow-500 text-black rounded-lg hover:bg-yellow-400 transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.207A1 1 0 013 6.5V4z"></path>
            </svg>
            Filtros
          </button>
        </div>

        <!-- Market Listings -->
        <div class="max-w-6xl mx-auto">
          <!-- Pagination Info -->
          <div class="text-sm text-yellow-200 mb-3">
            Mostrando <span id="cards-showing">0-0</span> de <span id="cards-total">0</span> cartas
          </div>
          
          <!-- Market Cards Grid - Responsive Layout -->
          <div id="market-grid" class="space-y-3 md:grid md:grid-cols-4 md:gap-6 md:space-y-0 max-w-7xl mx-auto">
            <!-- Market cards will be loaded here -->
          </div>
          
          <!-- Pagination Controls -->
          <div id="pagination-controls" class="flex justify-center items-center gap-2 mt-4">
            <button id="prev-page" class="px-3 py-1 text-xs bg-yellow-500 text-black rounded hover:bg-yellow-400 transition-colors disabled:bg-gray-500">
              « Anterior
            </button>
            <div id="page-numbers" class="flex gap-1">
              <!-- Page numbers will be generated here -->
            </div>
            <button id="next-page" class="px-3 py-1 text-xs bg-yellow-500 text-black rounded hover:bg-yellow-400 transition-colors disabled:bg-gray-500">
              Siguiente »
            </button>
          </div>

          <!-- Loading -->
          <div id="loading" class="text-center py-8">
            <div class="text-white">Cargando mercado...</div>
          </div>

          <!-- No Results -->
          <div id="no-results" class="hidden text-center py-8">
            <div class="bg-white/10 backdrop-blur-md rounded-xl p-8 max-w-md mx-auto">
              <div class="text-6xl mb-4">🔍</div>
              <h3 class="text-2xl font-bold text-white mb-4">Sin resultados</h3>
              <p class="text-yellow-200 mb-6">No se encontraron cartas con los filtros seleccionados</p>
              <button id="clear-all-btn" class="px-6 py-3 bg-yellow-500 text-black font-semibold rounded-lg hover:bg-yellow-400 transition-colors">
                Ver Todas las Cartas
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Filters Modal -->
  <div id="filters-modal" class="fixed inset-0 bg-black/50 flex items-center justify-center z-50 hidden">
    <div class="bg-white rounded-xl max-w-md w-full mx-4">
      <div class="p-6">
        <div class="flex justify-between items-center mb-6">
          <h3 class="text-xl font-bold text-gray-900">Filtros y Búsqueda</h3>
          <button id="close-filters-modal" class="text-gray-400 hover:text-gray-600">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>

        <!-- Search Bar -->
        <div class="mb-4">
          <label class="block text-sm font-semibold text-gray-700 mb-2">Buscar jugador:</label>
          <input type="text" id="search-input" placeholder="Nombre del jugador..." 
                 class="w-full px-3 py-2 border border-gray-300 rounded-lg text-gray-900 placeholder-gray-500">
        </div>

        <!-- Sort Options -->
        <div class="mb-4">
          <h4 class="text-sm font-semibold text-gray-700 mb-3">Ordenar por:</h4>
          <select id="sort-filter" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-gray-900">
            <option value="price_asc">Precio: Menor a Mayor</option>
            <option value="price_desc">Precio: Mayor a Menor</option>
            <option value="rating_desc">Rating FIFA: Mayor</option>
            <option value="rarity_desc">Rareza: Mayor</option>
            <option value="recent">Más Recientes</option>
          </select>
        </div>

        <!-- Filter Options -->
        <div class="space-y-4">
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Rareza:</label>
            <select id="rarity-filter" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-gray-900">
              <option value="">Todas</option>
              <option value="NORMAL">Normal</option>
              <option value="ESPECIAL">Especial</option>
              <option value="ELITE">Elite</option>
              <option value="LEGENDARIO">Legendario</option>
            </select>
          </div>

          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Posición:</label>
            <select id="position-filter" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-gray-900">
              <option value="">Todas</option>
              <option value="GK">Portero</option>
              <option value="CB">Defensa Central</option>
              <option value="LB">Lateral Izquierdo</option>
              <option value="RB">Lateral Derecho</option>
              <option value="CM">Centrocampista</option>
              <option value="CAM">Mediocentro Ofensivo</option>
              <option value="CDM">Mediocentro Defensivo</option>
              <option value="LM">Centrocampista Izquierdo</option>
              <option value="RM">Centrocampista Derecho</option>
              <option value="LW">Extremo Izquierdo</option>
              <option value="RW">Extremo Derecho</option>
              <option value="ST">Delantero</option>
            </select>
          </div>

          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Precio Máximo:</label>
            <select id="max-price-filter" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-gray-900">
              <option value="">Sin límite</option>
              <option value="100">100</option>
              <option value="250">250</option>
              <option value="500">500</option>
              <option value="1000">1,000</option>
              <option value="2500">2,500</option>
            </select>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex gap-3 mt-6">
          <button id="apply-filters-btn" class="flex-1 bg-yellow-500 text-black py-2 rounded-lg hover:bg-yellow-400 transition-colors">
            Aplicar Filtros
          </button>
          <button id="clear-filters-btn" class="flex-1 bg-gray-500 text-white py-2 rounded-lg hover:bg-gray-600 transition-colors">
            Limpiar Todo
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Purchase Modal -->
  <div id="purchase-modal" class="fixed inset-0 bg-black/50 flex items-center justify-center z-50 hidden">
    <div class="bg-white rounded-xl max-w-md w-full mx-4">
      <div class="p-6">
        <div class="flex justify-between items-center mb-4">
          <h3 class="text-xl font-bold text-gray-900">Confirmar Compra</h3>
          <button id="close-purchase-modal" class="text-gray-400 hover:text-gray-600">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>

        <!-- Card Preview -->
        <div class="text-center mb-6">
          <div id="purchase-card-preview" class="inline-block">
            <!-- Card preview will be generated here -->
          </div>
        </div>

        <!-- Purchase Details -->
        <div class="space-y-4 mb-6">
          <div class="flex justify-between">
            <span class="text-gray-600">Jugador:</span>
            <span class="font-semibold" id="purchase-player-name">-</span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-600">Vendedor:</span>
            <span class="font-semibold" id="purchase-seller">-</span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-600">Precio:</span>
            <span class="text-2xl font-bold text-green-600" id="purchase-price">0 💰</span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-600">Tu saldo actual:</span>
            <span class="font-semibold" id="current-balance">0 💰</span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-600">Saldo después:</span>
            <span class="font-semibold" id="balance-after">0 💰</span>
          </div>
        </div>

        <!-- Purchase Actions -->
        <div class="flex gap-4">
          <button id="confirm-purchase-btn" class="flex-1 bg-green-500 text-white py-3 rounded-lg hover:bg-green-600 transition-colors">
            Confirmar Compra
          </button>
          <button id="cancel-purchase-btn" class="flex-1 bg-gray-500 text-white py-3 rounded-lg hover:bg-gray-600 transition-colors">
            Cancelar
          </button>
        </div>
      </div>
    </div>
  </div>

  <script>
    // State management
    let currentUser = null;
    let authToken = null;
    let marketListings = [];
    let filteredListings = [];
    let selectedListing = null;
    const storage = window.sessionStorage;

    // Pagination variables
    let currentPage = 1;
    const itemsPerPage = 20;
    let totalPages = 1;

    // Global helper function for display rarity
    function getDisplayRarity(specialType) {
      switch (specialType) {
        case 'Regular':
        case 'OLD_GENERATION':
          return 'NORMAL';
        case 'TEAM_OF_THE_WEEK':
          return 'ESPECIAL';
        case 'MARKET_MASTER':
        case 'RATING_RELOAD':
        case 'COMEBACK_HERO':
        case 'ASSIST_ENGINE':
          return 'ELITE';
        case 'PLAYER_OF_THE_MONTH':
          return 'LEGENDARIO';
        default:
          return 'NORMAL';
      }
    }

    // Auth functions
    function checkAuthState() {
      const token = storage.getItem('nike_fc_token');
      if (token) { authToken = token; return true; }
      return false;
    }

    // UI functions
    function showSection(sectionId) {
      const sections = ['not-logged-in', 'market-container', 'loading', 'no-results'];
      sections.forEach(id => {
        const element = document.getElementById(id);
        if (element) {
          element.classList.toggle('hidden', id !== sectionId);
        }
      });
    }

    // Fetch market data from API
    async function fetchMarketListings() {
      try {
        const res = await fetch(`/api/bufas-cards/market?t=${Date.now()}`, { headers: { Authorization: `Bearer ${authToken}` }, cache: 'no-store' });
        return await res.json();
      } catch (e) {
        return { success: false, error: 'Error de conexión' };
      }
    }

    function generateMockListings() { /* deprecated */ return []; }

    async function fetchMe() {
      try {
        const res = await fetch('/api/bufas-cards/auth/me', { headers: { Authorization: `Bearer ${authToken}` } });
        const data = await res.json();
        if (data.success) currentUser = data.user;
      } catch {}
    }

    async function updateUserBalance() {
      await fetchMe();
      document.getElementById('user-balance').textContent = (currentUser?.coins || 0).toLocaleString();
      document.getElementById('user-cards-for-sale').textContent = 0;
    }

    function displayStats(stats) {
      document.getElementById('total-listings').textContent = stats.totalListings;
      document.getElementById('avg-price').textContent = stats.avgPrice.toLocaleString();
      document.getElementById('active-sellers').textContent = stats.activeSellers;
      document.getElementById('legend-cards').textContent = stats.legendCards;
    }

    function displayListingsPaginated(listings) {
      totalPages = Math.ceil(listings.length / itemsPerPage);
      if (currentPage > totalPages) currentPage = 1;
      
      const startIndex = (currentPage - 1) * itemsPerPage;
      const endIndex = startIndex + itemsPerPage;
      const currentPageListings = listings.slice(startIndex, endIndex);
      
      // Update pagination info
      const showing = `${startIndex + 1}-${Math.min(endIndex, listings.length)}`;
      document.getElementById('cards-showing').textContent = showing;
      document.getElementById('cards-total').textContent = listings.length;
      
      // Display cards
      const grid = document.getElementById('market-grid');
      
      if (listings.length === 0) {
        grid.classList.add('hidden');
        document.getElementById('no-results').classList.remove('hidden');
        return;
      }

      grid.classList.remove('hidden');
      document.getElementById('no-results').classList.add('hidden');
      
      grid.innerHTML = '';
      
      currentPageListings.forEach(listing => {
        const cardElement = createMarketCardElement(listing);
        grid.appendChild(cardElement);
      });
      
      // Update pagination controls
      updatePaginationControls();
    }

    function updatePaginationControls() {
      const prevBtn = document.getElementById('prev-page');
      const nextBtn = document.getElementById('next-page');
      const pageNumbers = document.getElementById('page-numbers');
      
      // Show/hide buttons based on need
      prevBtn.style.display = currentPage > 1 ? 'inline-block' : 'none';
      nextBtn.style.display = currentPage < totalPages ? 'inline-block' : 'none';
      
      // Disable buttons appropriately
      prevBtn.disabled = currentPage <= 1;
      nextBtn.disabled = currentPage >= totalPages;
      
      // Generate page numbers (show current page and neighbors)
      pageNumbers.innerHTML = '';
      if (totalPages <= 1) return;
      
      const start = Math.max(1, currentPage - 2);
      const end = Math.min(totalPages, currentPage + 2);
      
      for (let i = start; i <= end; i++) {
        const pageBtn = document.createElement('button');
        pageBtn.textContent = i;
        pageBtn.className = `px-2 py-1 text-xs rounded ${i === currentPage ? 'bg-yellow-600 text-white' : 'bg-yellow-500 text-black hover:bg-yellow-400'} transition-colors`;
        pageBtn.addEventListener('click', () => {
          currentPage = i;
          displayListingsPaginated(filteredListings);
        });
        pageNumbers.appendChild(pageBtn);
      }
    }

    function createMarketCardElement(listing) {
      const card = listing.card;
      
      function getRarityColor(displayRarity) {
        switch (displayRarity) {
          case 'NORMAL':
            return 'from-gray-400 to-gray-600';
          case 'ESPECIAL':
            return 'from-blue-500 to-blue-700';
          case 'ELITE':
            return 'from-purple-500 to-purple-700';
          case 'LEGENDARIO':
            return 'from-yellow-400 to-orange-500';
          default:
            return 'from-gray-400 to-gray-600';
        }
      }
      
      const displayRarity = getDisplayRarity(card.special_type || 'Regular');
      const rarityColor = getRarityColor(displayRarity);

      const cardDiv = document.createElement('div');
      cardDiv.className = `bg-gradient-to-br ${rarityColor} rounded-xl p-3 flex items-center gap-3 md:flex-col md:items-stretch md:p-6 hover:scale-[1.02] transition-transform cursor-pointer relative shadow-lg hover:shadow-xl`;
      cardDiv.addEventListener('click', () => openPurchaseModal(listing));

      // Check if user can afford this card
      const canAfford = (currentUser?.coins || 0) >= listing.sale_price;
      const isOwn = !!listing.is_own || listing.seller_username === (currentUser?.username || '');

      const img = card.image_path ? 
        `<img src="${card.image_path}" alt="${card.player.name}" class="w-16 h-20 md:w-full md:h-64 lg:h-80 rounded-lg flex-shrink-0 md:flex-shrink object-contain md:object-cover" />` : 
        `<div class="w-16 h-20 md:w-full md:h-64 lg:h-80 bg-white/20 rounded-lg flex items-center justify-center flex-shrink-0 md:flex-shrink">
          <span class="text-2xl md:text-4xl lg:text-6xl">⚽</span>
        </div>`;

      const statusBadge = `
        <div class="absolute top-2 right-2 ${isOwn ? 'bg-blue-500' : (canAfford ? 'bg-green-500' : 'bg-red-500')} text-white text-xs px-2 py-1 rounded-full">
          ${isOwn ? 'TUYA' : (canAfford ? '✓' : '✗')}
        </div>
      `;

      cardDiv.innerHTML = `
        ${statusBadge}
        ${img}
        <div class="flex-1 md:mt-4">
          <div class="text-white font-bold text-sm md:text-xl lg:text-2xl mb-2 md:text-center">${card.player.name}</div>
          <div class="text-xs md:text-base lg:text-lg text-white/80 mb-2 md:text-center">${card.player.position1} - ${displayRarity}</div>
          <div class="text-xs md:text-base lg:text-lg text-white/90 mb-2 md:text-center">FIFA: ${card.player.fifa_rating}</div>
          <div class="text-xs md:text-sm lg:text-base text-yellow-300 mb-2 md:text-center">Vendedor: ${listing.seller_username}</div>
          <div class="text-sm md:text-lg lg:text-xl font-bold text-green-300 md:text-center">${listing.sale_price.toLocaleString()} 💰</div>
        </div>
      `;

      if (isOwn) {
        cardDiv.classList.add('opacity-70','cursor-not-allowed');
      }

      return cardDiv;
    }

    function openPurchaseModal(listing) {
      if (listing.is_own || listing.seller_username === (currentUser?.username || '')) {
        alert('Esta carta es tuya; no puedes comprarla.\nSi desea quitarlo del mercado busca la carta en venta desde Colección');
        return;
      }
      if (currentUser.coins < listing.sale_price) {
        alert('No tienes suficientes monedas para comprar esta carta');
        return;
      }

      selectedListing = listing;
      const card = listing.card;

      document.getElementById('purchase-player-name').textContent = card.player.name;
      document.getElementById('purchase-seller').textContent = listing.seller_username;
      document.getElementById('purchase-price').textContent = listing.sale_price.toLocaleString() + ' 💰';
      document.getElementById('current-balance').textContent = currentUser.coins.toLocaleString() + ' 💰';
      document.getElementById('balance-after').textContent = (currentUser.coins - listing.sale_price).toLocaleString() + ' 💰';
      
      // Generate card preview
      const preview = document.getElementById('purchase-card-preview');
      preview.innerHTML = createMarketCardElement(listing).innerHTML;

      document.getElementById('purchase-modal').classList.remove('hidden');
    }

    function closePurchaseModal() {
      document.getElementById('purchase-modal').classList.add('hidden');
      selectedListing = null;
    }

    function applySearch() {
      const searchTerm = document.getElementById('search-input').value.toLowerCase();
      const rarityFilter = document.getElementById('rarity-filter').value;
      const positionFilter = document.getElementById('position-filter').value;
      const maxPriceFilter = parseInt(document.getElementById('max-price-filter').value) || Infinity;
      const sortFilter = document.getElementById('sort-filter').value;
      
      filteredListings = marketListings.filter(listing => {
        const card = listing.card;
        
        if (searchTerm && !card.player.name.toLowerCase().includes(searchTerm)) return false;
        
        // Filtrar por nueva rareza basada en special_type
        if (rarityFilter) {
          const cardDisplayRarity = getDisplayRarity(card.special_type || 'Regular');
          if (cardDisplayRarity !== rarityFilter) return false;
        }
        
        if (positionFilter && card.player.position1 !== positionFilter) return false;
        if (listing.sale_price > maxPriceFilter) return false;

        return true;
      });

      // Apply sorting
      filteredListings.sort((a, b) => {
        switch (sortFilter) {
          case 'price_asc':
            return a.sale_price - b.sale_price;
          case 'price_desc':
            return b.sale_price - a.sale_price;
          case 'rating_desc':
            return b.card.player.fifa_rating - a.card.player.fifa_rating;
          case 'rarity_desc':
            const rarityOrder = { LEGENDARIO: 4, ELITE: 3, ESPECIAL: 2, NORMAL: 1 };
            const aRarity = getDisplayRarity(a.card.special_type || 'Regular');
            const bRarity = getDisplayRarity(b.card.special_type || 'Regular');
            return rarityOrder[bRarity] - rarityOrder[aRarity];
          case 'recent':
            return new Date(b.listed_at) - new Date(a.listed_at);
          default:
            return 0;
        }
      });

      displayListingsPaginated(filteredListings);
    }

    function clearSearch() {
      document.getElementById('search-input').value = '';
      document.getElementById('rarity-filter').value = '';
      document.getElementById('position-filter').value = '';
      document.getElementById('max-price-filter').value = '';
      document.getElementById('sort-filter').value = 'price_asc';
      
      filteredListings = [...marketListings];
      displayListingsPaginated(filteredListings);
    }

    function openFiltersModal() {
      document.getElementById('filters-modal').classList.remove('hidden');
    }

    function closeFiltersModal() {
      document.getElementById('filters-modal').classList.add('hidden');
    }

    async function purchaseCard() {
      if (!selectedListing) return;
      try {
        const res = await fetch('/api/bufas-cards/market/buy', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Authorization: `Bearer ${authToken}`
          },
          body: JSON.stringify({ trade_id: selectedListing.id })
        });
        const data = await res.json();
        if (!data.success) {
          alert('No se pudo completar la compra: ' + (data.error || 'Error desconocido'));
          return;
        }
        // Update local state
        currentUser.coins -= selectedListing.sale_price;
        document.getElementById('user-balance').textContent = currentUser.coins.toLocaleString();
        // Remove listing from arrays
        marketListings = marketListings.filter(l => l.id !== selectedListing.id);
        filteredListings = filteredListings.filter(l => l.id !== selectedListing.id);
        displayListingsPaginated(filteredListings);
        closePurchaseModal();
        alert('Compra realizada con éxito. La carta se ha añadido a tu colección.');
      } catch (e) {
        alert('Error de conexión al comprar.');
      }
    }

    // (badge de tiempo eliminado)

    async function startMarketPage() {
      if (!checkAuthState()) {
        showSection('not-logged-in');
        return;
      }

      showSection('loading');

      const result = await fetchMarketListings();
      
      if (!result.success) {
        alert('Error al cargar el mercado');
        return;
      }

      marketListings = result.listings || [];
      filteredListings = [...marketListings];

      showSection('market-container');
      await updateUserBalance();
      displayListingsPaginated(filteredListings);

      // Event listeners
      document.getElementById('open-filters-btn').addEventListener('click', openFiltersModal);
      document.getElementById('close-filters-modal').addEventListener('click', closeFiltersModal);
      document.getElementById('apply-filters-btn').addEventListener('click', () => {
        applySearch();
        closeFiltersModal();
      });
      document.getElementById('clear-filters-btn').addEventListener('click', clearSearch);
      
      // Pagination event listeners
      document.getElementById('prev-page').addEventListener('click', () => {
        if (currentPage > 1) {
          currentPage--;
          displayListingsPaginated(filteredListings);
        }
      });
      document.getElementById('next-page').addEventListener('click', () => {
        if (currentPage < totalPages) {
          currentPage++;
          displayListingsPaginated(filteredListings);
        }
      });
      
      document.getElementById('close-purchase-modal').addEventListener('click', closePurchaseModal);
      document.getElementById('cancel-purchase-btn').addEventListener('click', closePurchaseModal);
      document.getElementById('confirm-purchase-btn').addEventListener('click', purchaseCard);

      // Search on Enter key
      document.getElementById('search-input').addEventListener('keypress', (e) => {
        if (e.key === 'Enter') {
          applySearch();
        }
      });

      // Close modal on backdrop click
      document.getElementById('purchase-modal').addEventListener('click', (e) => {
        if (e.target.id === 'purchase-modal') {
          closePurchaseModal();
        }
      });
      
      // Close filters modal on backdrop click
      document.getElementById('filters-modal').addEventListener('click', (e) => {
        if (e.target.id === 'filters-modal') {
          closeFiltersModal();
        }
      });
    }

    document.addEventListener('DOMContentLoaded', startMarketPage);
    document.addEventListener('astro:page-load', startMarketPage);
    document.addEventListener('astro:after-swap', startMarketPage);
  </script>
</NikeFCLayout>

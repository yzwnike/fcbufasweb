---
import NikeFCLayout from '@/layouts/NikeFCLayout.astro';
import Subheader from '@/components/bufas-cards/Subheader.astro';
---

<NikeFCLayout title="Ranking - Bufas Cards" helpKey="ranking">
<div class="min-h-screen bg-gradient-to-br from-slate-900 via-slate-800 to-slate-700">
    <div class="container mx-auto px-4 py-2 pt-4 relative z-10">
      <Subheader variant="minimal" />

      <h1 class="text-4xl md:text-5xl font-extrabold text-white mt-4 mb-2">🏆 Ranking</h1>
      <p class="text-slate-300 mb-6">Colecciones destacadas y progreso por categoría</p>

      <div class="rounded-xl shadow-lg ring-1 ring-white/10 bg-slate-900/80 backdrop-blur overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-slate-100 text-sm">
            <thead>
              <tr class="bg-slate-800/80 sticky top-0 z-10">
                <th class="px-2 py-2 text-left">#</th>
                <th class="px-2 py-2 text-left min-w-[120px]">Usuario</th>
                <th class="px-2 py-2 text-center">TOTAL</th>
                <th class="px-2 py-2 text-left min-w-[160px]">⭐ Destacadas</th>
                <th class="px-2 py-2 text-center">BASE</th>
                <th class="px-2 py-2 text-center">OG</th>
                <th class="px-2 py-2 text-center">ESPECIAL</th>
                <th class="px-2 py-2 text-center">ELITE</th>
                <th class="px-2 py-2 text-center">LEGENDARIO</th>
              </tr>
            </thead>
            <tbody id="rank-body"></tbody>
          </table>
        </div>
      </div>

      <div id="rank-empty" class="hidden mt-6 text-slate-300">Sin datos todavía.</div>
    </div>
  </div>

  <script>
    const storage = window.sessionStorage;
    let authToken = null;

    function checkAuth() {
      const t = storage.getItem('nike_fc_token');
      if (!t) return false;
      authToken = t; return true;
    }

    async function fetchRanking() {
      const res = await fetch('/api/bufas-cards/ranking', { cache: 'no-store' });
      return await res.json();
    }

    function formatPlayerName(fullName) {
      // Casos especiales
      if (fullName.toLowerCase().includes('marc permanyer')) return 'Perma';
      if (fullName.toLowerCase().includes('marc sánchez') || fullName.toLowerCase().includes('marc sanchez')) return 'Mister';
      
      // En móvil, solo mostrar el primer nombre
      if (window.innerWidth < 768) {
        const parts = fullName.trim().split(' ');
        return parts[0] || fullName;
      }
      
      return fullName;
    }
    
    function renderBoard(board) {
      const tbody = document.getElementById('rank-body');
      const empty = document.getElementById('rank-empty');
      
      tbody.innerHTML = '';
      
      const totals = board.totals || { totalAll: 0, byCode: {} };
      const users = Array.isArray(board.users) ? board.users : [];
      
      if (!users.length) {
        empty?.classList.remove('hidden');
        return;
      }
      
      empty?.classList.add('hidden');
      
      users.forEach((u, idx) => {
        const tr = document.createElement('tr');
        tr.className = 'hover:bg-slate-800/60 transition-colors border-b border-white/5';
        
        // Crear mini-cartas destacadas
        const featuredCards = u.featuredCards || [];
        let featuredHTML = '<div class="flex gap-1 justify-start">';
        for (let i = 0; i < 3; i++) {
          const card = featuredCards[i];
          if (card) {
            const displayName = formatPlayerName(card.player_name);
            featuredHTML += `
              <div class="w-10 h-14 relative group flex-shrink-0">
                <img 
                  src="${card.image_path || '/icons/placeholder-card.png'}" 
                  alt="${displayName}" 
                  class="w-full h-full object-cover rounded border border-purple-400/50 shadow-sm"
                  onerror="this.src='/icons/placeholder-card.png'"
                />
                <div class="absolute inset-0 bg-black/80 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center rounded">
                  <span class="text-[7px] text-white text-center px-0.5 leading-tight">${displayName}</span>
                </div>
              </div>
            `;
          } else {
            featuredHTML += `
              <div class="w-10 h-14 bg-slate-700/30 rounded border border-dashed border-slate-600 flex items-center justify-center flex-shrink-0">
                <span class="text-slate-500 text-xs">-</span>
              </div>
            `;
          }
        }
        featuredHTML += '</div>';
        
        tr.innerHTML = [
          `<td class="px-2 py-3">${idx+1}</td>`,
          `<td class="px-2 py-3 font-semibold">${u.username}</td>`,
          `<td class="px-2 py-3 text-center font-bold text-purple-300">${u.byCode.TOTAL||0}/${totals.byCode.TOTAL||0}</td>`,
          `<td class="px-2 py-3">${featuredHTML}</td>`,
          `<td class="px-2 py-3 text-center">${u.byCode.BASE||0}/${totals.byCode.BASE||0}</td>`,
          `<td class="px-2 py-3 text-center">${u.byCode.OG||0}/${totals.byCode.OG||0}</td>`,
          `<td class="px-2 py-3 text-center">${u.byCode.ESPECIAL||0}/${totals.byCode.ESPECIAL||0}</td>`,
          `<td class="px-2 py-3 text-center">${u.byCode.ELITE||0}/${totals.byCode.ELITE||0}</td>`,
          `<td class="px-2 py-3 text-center">${u.byCode.LEGENDARIO||0}/${totals.byCode.LEGENDARIO||0}</td>`
        ].join('');
        
        tbody.appendChild(tr);
      });
    }

    async function start() {
      try {
        const data = await fetchRanking();
        if (data && data.success) renderBoard(data);
        else console.error('Ranking: respuesta inválida', data);
      } catch (e) {
        console.error('Ranking: fetch error', e);
      }
    }

  const kickoff = () => {
    const tbody = document.getElementById('rank-body');
    if (!tbody) { requestAnimationFrame(kickoff); return; }
    start();
  };

  document.addEventListener('DOMContentLoaded', kickoff);
  document.addEventListener('astro:page-load', kickoff);
  document.addEventListener('astro:after-swap', kickoff);
  document.addEventListener('visibilitychange', () => { if (!document.hidden) kickoff(); });
  window.addEventListener('pageshow', (e) => { if (e.persisted) { kickoff(); } });
  // Llamada inmediata por si el script carga tras el swap
  kickoff();
  </script>

  <style>
    /* Tabla responsiva */
    table {
      border-collapse: collapse;
    }
    
    thead th {
      white-space: nowrap;
      font-weight: 600;
      text-transform: uppercase;
      font-size: 0.75rem;
      letter-spacing: 0.05em;
    }
    
    tbody td {
      white-space: nowrap;
    }
    
    /* Mobile responsiveness */
    @media (max-width: 768px) {
      table {
        font-size: 0.75rem;
      }
      
      thead th {
        font-size: 0.65rem;
        padding: 0.5rem 0.25rem;
      }
      
      tbody td {
        padding: 0.5rem 0.25rem !important;
      }
      
      /* Cartas más pequeñas en móvil */
      tbody td img {
        width: 32px !important;
        height: 44px !important;
      }
      
      tbody td .w-10 {
        width: 32px !important;
        height: 44px !important;
      }
    }
  </style>
</NikeFCLayout>

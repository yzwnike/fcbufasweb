---
import NikeFCLayout from '@/layouts/NikeFCLayout.astro';
import Subheader from '@/components/bufas-cards/Subheader.astro';
import { gsap } from 'gsap';

const title = 'Resultados - Player Of The Month';
const description = 'Resultados en tiempo real de las votaciones del Player Of The Month';

export const prerender = false;

// Nombres y colores de los jugadores
const playerInfo: Record<string, { name: string; color: string; image: string }> = {
  marcos: { 
    name: 'Marcos', 
    color: 'from-blue-500 to-blue-700',
    image: '/cards/NOMPOTM/marcosNOMPOTMoct.png'
  },
  mario: { 
    name: 'Mario', 
    color: 'from-green-500 to-green-700',
    image: '/cards/NOMPOTM/marioNOMPOTMoct.png'
  },
  mister: { 
    name: 'Míster', 
    color: 'from-purple-500 to-purple-700',
    image: '/cards/NOMPOTM/misterNOMPOTMoct.png'
  },
  nicou: { 
    name: 'Nico Uriburu', 
    color: 'from-orange-500 to-red-700',
    image: '/cards/NOMPOTM/nicouNOMPOTMoct.png'
  }
};
---

<NikeFCLayout title={title} helpKey="potm">
  <!-- Fondo animado -->
  <div class="fixed inset-0 potm-bg overflow-hidden pointer-events-none">
    <div class="absolute inset-0 bg-gradient-to-br from-slate-900 via-orange-900 to-black"></div>
    <div class="stars-container absolute inset-0"></div>
  </div>

  <main class="relative z-10 min-h-screen py-4 px-4">
    <div class="container mx-auto max-w-7xl">
      <!-- Subheader -->
      <div class="mb-4">
        <Subheader variant="minimal" />
      </div>
      <!-- Header -->
      <div class="text-center mb-12 fade-in">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-white mb-4">
          🏆 Resultados POTM
        </h1>
        <script>
          // Guard: solo permitir ver resultados si has votado este mes
          (function(){
            try {
              const token = window.sessionStorage.getItem('nike_fc_token');
              if (!token) { window.location.href = '/bufas-cards/potm'; return; }
              fetch('/api/potm/check-vote', { headers: { Authorization: 'Bearer ' + token } })
                .then(r => r.json())
                .then(d => { if (!d?.hasVoted) window.location.href = '/bufas-cards/potm'; })
                .catch(() => { window.location.href = '/bufas-cards/potm'; });
            } catch { window.location.href = '/bufas-cards/potm'; }
          })();
        </script>
        <p class="text-lg sm:text-xl text-orange-300 mb-2">
          Votaciones en tiempo real
        </p>
        <div id="total-votes" class="text-gray-400 text-sm sm:text-base">
          Cargando resultados...
        </div>
      </div>

      <!-- Loading State -->
      <div id="loading" class="text-center py-20">
        <div class="inline-block animate-spin rounded-full h-16 w-16 border-t-4 border-b-4 border-orange-500"></div>
        <p class="text-white mt-4">Cargando resultados...</p>
      </div>

      <!-- Podio Section -->
      <div id="podium" class="hidden mb-16">
        <h2 class="text-3xl font-bold text-white text-center mb-8">🥇 Podio Actual</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto place-items-center">
          <!-- Segundo lugar -->
          <div class="podium-card md:mt-12 order-2 md:order-1 w-full max-w-xs mx-auto" data-position="2">
            <div class="bg-gradient-to-br from-gray-400 to-gray-600 rounded-2xl p-6 relative overflow-hidden">
              <div class="absolute top-0 right-0 text-6xl opacity-20">🥈</div>
              <div class="relative z-10">
                <div class="position-badge text-4xl font-black text-white text-center mb-4">2º</div>
                <img id="podium-2-img" src="" alt="" class="w-32 h-auto mx-auto mb-4 rounded-lg shadow-xl">
                <h3 id="podium-2-name" class="text-2xl font-bold text-white text-center mb-2"></h3>
                <div class="text-center">
                  <div id="podium-2-points" class="text-3xl font-black text-yellow-300"></div>
                  <div class="text-sm text-gray-200">puntos</div>
                </div>
              </div>
            </div>
          </div>

          <!-- Primer lugar -->
          <div class="podium-card order-1 md:order-2 w-full max-w-xs mx-auto" data-position="1">
            <div class="bg-gradient-to-br from-yellow-400 to-yellow-600 rounded-2xl p-8 relative overflow-hidden transform scale-105">
              <div class="absolute top-0 right-0 text-8xl opacity-20">👑</div>
              <div class="relative z-10">
                <div class="position-badge text-5xl font-black text-white text-center mb-4">1º</div>
                <img id="podium-1-img" src="" alt="" class="w-40 h-auto mx-auto mb-4 rounded-lg shadow-2xl border-4 border-white">
                <h3 id="podium-1-name" class="text-3xl font-bold text-white text-center mb-2"></h3>
                <div class="text-center">
                  <div id="podium-1-points" class="text-4xl font-black text-white"></div>
                  <div class="text-sm text-gray-800 font-bold">puntos</div>
                </div>
              </div>
            </div>
          </div>

          <!-- Tercer lugar -->
          <div class="podium-card md:mt-16 order-3 w-full max-w-xs mx-auto" data-position="3">
            <div class="bg-gradient-to-br from-orange-600 to-orange-800 rounded-2xl p-6 relative overflow-hidden">
              <div class="absolute top-0 right-0 text-6xl opacity-20">🥉</div>
              <div class="relative z-10">
                <div class="position-badge text-4xl font-black text-white text-center mb-4">3º</div>
                <img id="podium-3-img" src="" alt="" class="w-32 h-auto mx-auto mb-4 rounded-lg shadow-xl">
                <h3 id="podium-3-name" class="text-2xl font-bold text-white text-center mb-2"></h3>
                <div class="text-center">
                  <div id="podium-3-points" class="text-3xl font-black text-orange-200"></div>
                  <div class="text-sm text-gray-200">puntos</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Tabla detallada de resultados -->
      <div id="results-table" class="hidden">
        <h2 class="text-3xl font-bold text-white text-center mb-8">📊 Estadísticas Detalladas</h2>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 max-w-6xl mx-auto justify-items-center">
          <!-- Cards de jugadores se insertarán aquí -->
        </div>
      </div>

      <!-- Botones de acción -->
      <div class="text-center mt-12 space-y-4">
        <button 
          id="refresh-btn"
          class="bg-gradient-to-r from-orange-500 to-red-500 text-white px-8 py-4 rounded-full font-bold text-lg shadow-lg hover:scale-105 transition-all duration-300"
        >
          🔄 Actualizar Resultados
        </button>
        
        <div>
          <a 
            href="/bufas-cards/potm"
            class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm border border-white/20 text-white px-6 py-3 rounded-full font-semibold hover:bg-white/20 transition-all duration-300"
          >
            <span>← Volver a Votación</span>
          </a>
        </div>
      </div>
    </div>
  </main>
</NikeFCLayout>

<style>
  .potm-bg {
    background: linear-gradient(-45deg, #000000, #1a0d00, #ff4500, #ff6b35, #2d1810);
    background-size: 400% 400%;
    animation: gradientFlow 30s ease infinite;
  }

  @keyframes gradientFlow {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  .stars-container {
    background-image: radial-gradient(2px 2px at 20% 30%, white, transparent),
                      radial-gradient(2px 2px at 60% 70%, white, transparent),
                      radial-gradient(1px 1px at 50% 50%, white, transparent);
    background-size: 200px 200px;
    animation: stars 60s linear infinite;
  }

  @keyframes stars {
    from { transform: translateY(0); }
    to { transform: translateY(-200px); }
  }

  .fade-in {
    animation: fadeIn 1s ease-out;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(-20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .podium-card {
    animation: slideUp 0.8s ease-out backwards;
  }

  /* Mobile centering fixes */
  @media (max-width: 640px) {
    .podium-card { max-width: 360px; margin-left: auto; margin-right: auto; }
    #results-table .grid > * { width: 100%; max-width: 420px; }
  }

  .podium-card[data-position="1"] { animation-delay: 0.2s; }
  .podium-card[data-position="2"] { animation-delay: 0s; }
  .podium-card[data-position="3"] { animation-delay: 0.4s; }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(50px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .bar-chart {
    height: 30px;
    background: linear-gradient(90deg, var(--bar-color) 0%, var(--bar-color-light) 100%);
    border-radius: 15px;
    transition: width 1.5s cubic-bezier(0.4, 0, 0.2, 1);
  }
</style>

<script>
  import { gsap } from 'gsap';

  interface PlayerResult {
    playerId: string;
    playerName: string;
    totalPoints: number;
    votes: {
      first: number;
      second: number;
      third: number;
      fourth: number;
    };
    totalVotes: number;
  }

  const storage = window.sessionStorage;
  let token: string | null = null;

  function requireAuth() {
    const t = storage.getItem('nike_fc_token');
    if (!t) { 
      window.location.href = '/bufas-cards'; 
      return false; 
    }
    token = t; 
    return true;
  }

  const playerInfo: Record<string, { color: string; image: string }> = {
    marcos: { 
      color: 'from-blue-500 to-blue-700',
      image: '/cards/NOMPOTM/marcosNOMPOTMoct.png'
    },
    mario: { 
      color: 'from-green-500 to-green-700',
      image: '/cards/NOMPOTM/marioNOMPOTMoct.png'
    },
    mister: { 
      color: 'from-purple-500 to-purple-700',
      image: '/cards/NOMPOTM/misterNOMPOTMoct.png'
    },
    nicou: { 
      color: 'from-orange-500 to-red-700',
      image: '/cards/NOMPOTM/nicouNOMPOTMoct.png'
    }
  };

  document.addEventListener('DOMContentLoaded', () => {
    if (!requireAuth()) return;
    loadResults();
    
    document.getElementById('refresh-btn')?.addEventListener('click', () => {
      loadResults();
    });

    // Auto-refresh cada 30 segundos
    setInterval(loadResults, 30000);
  });

  async function loadResults() {
    const loading = document.getElementById('loading');
    const podium = document.getElementById('podium');
    const resultsTable = document.getElementById('results-table');
    
    try {
      const response = await fetch('/api/potm/results', {
        headers: { Authorization: `Bearer ${token}` }
      });
      const data = await response.json();

      if (!data.results || data.results.length === 0) {
        showNoResults();
        return;
      }

      // Ocultar loading
      if (loading) loading.classList.add('hidden');
      if (podium) podium.classList.remove('hidden');
      if (resultsTable) resultsTable.classList.remove('hidden');

      // Actualizar total de votos
      const totalVotesEl = document.getElementById('total-votes');
      if (totalVotesEl) {
        totalVotesEl.textContent = `Total de votos: ${data.totalVotes}`;
      }

      // Mostrar podio (top 3)
      updatePodium(data.results.slice(0, 3));

      // Mostrar tabla detallada
      updateResultsTable(data.results);

    } catch (error) {
      console.error('Error loading results:', error);
      showError();
    }
  }

  function updatePodium(topPlayers: PlayerResult[]) {
    topPlayers.forEach((player, index) => {
      const position = index + 1;
      const nameEl = document.getElementById(`podium-${position}-name`);
      const pointsEl = document.getElementById(`podium-${position}-points`);
      const imgEl = document.getElementById(`podium-${position}-img`) as HTMLImageElement;

      if (nameEl) nameEl.textContent = player.playerName;
      if (pointsEl) pointsEl.textContent = `${player.totalPoints}`;
      if (imgEl) {
        imgEl.src = playerInfo[player.playerId].image;
        imgEl.alt = player.playerName;
      }

      // Animación de contador
      if (pointsEl) {
        gsap.from(pointsEl, {
          textContent: 0,
          duration: 2,
          snap: { textContent: 1 },
          ease: 'power2.out'
        });
      }
    });
  }

  function updateResultsTable(results: PlayerResult[]) {
    const table = document.getElementById('results-table');
    if (!table) return;

    const maxPoints = results[0]?.totalPoints || 1;

    const cardsHTML = results.map((player, index) => {
      const info = playerInfo[player.playerId];
      const percentage = (player.totalPoints / maxPoints) * 100;

      return `
<div class=\"player-result-card w-full max-w-md mx-auto bg-white/10 backdrop-blur-sm rounded-2xl p-6 border border-white/20 hover:bg-white/15 transition-all duration-300\">
<div class=\"flex flex-wrap items-center gap-4 gap-y-2 mb-4\">
            <div class="position-rank flex-shrink-0 w-12 h-12 rounded-full bg-gradient-to-br ${info.color} flex items-center justify-center">
              <span class="text-xl font-black text-white">${index + 1}</span>
            </div>
<img src=\"${info.image}\" alt=\"${player.playerName}\" class=\"w-16 sm:w-20 h-auto rounded-lg shadow-lg\">
<div class=\"flex-grow min-w-[9rem]\">
<h3 class=\"text-xl sm:text-2xl font-bold text-white\">
              <p class="text-gray-400">${player.totalVotes} votos totales</p>
            </div>
<div class=\"text-right ml-auto flex-shrink-0\">
<div class=\"text-2xl sm:text-3xl font-black text-orange-400\">${player.totalPoints}</div>
<div class=\"text-xs sm:text-sm text-gray-400\">puntos</div>
            </div>
          </div>

          <!-- Barra de progreso -->
          <div class="mb-4">
            <div class="h-4 bg-gray-700 rounded-full overflow-hidden">
              <div class="bar-progress h-full bg-gradient-to-r ${info.color} rounded-full transition-all duration-1000" 
                   style="width: ${percentage}%"></div>
            </div>
          </div>

          <!-- Distribución de votos -->
          <div class="grid grid-cols-4 gap-2 text-center">
            <div class="bg-white/5 rounded-lg p-2">
              <div class="text-xl font-bold text-yellow-400">${player.votes.first}</div>
              <div class="text-xs text-gray-400">1º lugar</div>
            </div>
            <div class="bg-white/5 rounded-lg p-2">
              <div class="text-xl font-bold text-gray-300">${player.votes.second}</div>
              <div class="text-xs text-gray-400">2º lugar</div>
            </div>
            <div class="bg-white/5 rounded-lg p-2">
              <div class="text-xl font-bold text-orange-400">${player.votes.third}</div>
              <div class="text-xs text-gray-400">3º lugar</div>
            </div>
            <div class="bg-white/5 rounded-lg p-2">
              <div class="text-xl font-bold text-blue-400">${player.votes.fourth}</div>
              <div class="text-xs text-gray-400">4º lugar</div>
            </div>
          </div>
        </div>
      `;
    }).join('');

    // Buscar el contenedor de las cards
    const cardsContainer = table.querySelector('.grid');
    if (cardsContainer) {
      cardsContainer.innerHTML = cardsHTML;

      // Animar entrada de cards
      gsap.from('.player-result-card', {
        scale: 0.8,
        opacity: 0,
        duration: 0.6,
        stagger: 0.1,
        ease: 'back.out(1.7)'
      });

      // Animar barras de progreso
      setTimeout(() => {
        document.querySelectorAll('.bar-progress').forEach(bar => {
          const width = (bar as HTMLElement).style.width;
          (bar as HTMLElement).style.width = '0%';
          setTimeout(() => {
            (bar as HTMLElement).style.width = width;
          }, 100);
        });
      }, 300);
    }
  }

  function showNoResults() {
    const loading = document.getElementById('loading');
    if (loading) {
      loading.innerHTML = `
        <div class="text-center py-20">
          <div class="text-6xl mb-4">📊</div>
          <h2 class="text-2xl font-bold text-white mb-4">Aún no hay votos</h2>
          <p class="text-gray-400 mb-8">Sé el primero en votar por tu jugador favorito</p>
          <a href="/bufas-cards/potm" class="inline-block bg-gradient-to-r from-orange-500 to-red-500 text-white px-8 py-4 rounded-full font-bold hover:scale-105 transition-all duration-300">
            Votar Ahora
          </a>
        </div>
      `;
    }
  }

  function showError() {
    const loading = document.getElementById('loading');
    if (loading) {
      loading.innerHTML = `
        <div class="text-center py-20">
          <div class="text-6xl mb-4">⚠️</div>
          <h2 class="text-2xl font-bold text-white mb-4">Error al cargar resultados</h2>
          <p class="text-gray-400 mb-8">Por favor, intenta de nuevo más tarde</p>
          <button onclick="location.reload()" class="bg-gradient-to-r from-orange-500 to-red-500 text-white px-8 py-4 rounded-full font-bold hover:scale-105 transition-all duration-300">
            Reintentar
          </button>
        </div>
      `;
    }
  }
</script>

---
import NikeFCLayout from '@/layouts/NikeFCLayout.astro';
import Subheader from '@/components/bufas-cards/Subheader.astro';
---

<NikeFCLayout title="Quiz Diario - Bufas Cards" helpKey="quiz">
  <div class="h-screen bg-gradient-to-br from-orange-900 via-orange-800 to-red-900 flex flex-col">
    <!-- Subheader Nav -->
    <div class="px-4 pt-2 pb-1 flex-shrink-0">
      <Subheader variant="minimal" />
    </div>
    
    <!-- Main Content Container -->
    <div class="flex-1 px-4 pb-4 flex flex-col min-h-0">

      <!-- Auth Check -->
      <div id="not-logged-in" class="hidden flex-1 flex flex-col">
        <!-- Header dentro de Auth Check -->
        <div class="text-center px-4 pb-2 flex-shrink-0">
          <h1 class="text-2xl md:text-3xl lg:text-4xl font-bold text-white mb-1">
            🧠 Quiz Diario
          </h1>
          <p class="text-sm md:text-base text-orange-100 max-w-xl mx-auto">
            5 preguntas sobre stats. ¡40 monedas por acierto!
          </p>
        </div>
        
        <div class="flex-1 flex items-center justify-center">
          <div class="bg-red-500/20 backdrop-blur-md rounded-xl p-6 max-w-sm mx-auto text-center">
            <h3 class="text-xl font-bold text-white mb-3">Acceso Requerido</h3>
            <p class="text-red-200 mb-4 text-sm">Debes iniciar sesión para jugar el quiz diario</p>
            <a href="/bufas-cards" class="px-5 py-2 bg-white text-red-900 font-semibold rounded-lg hover:bg-red-100 transition-colors text-sm">
              Iniciar Sesión
            </a>
          </div>
        </div>
      </div>

      <!-- Quiz Container -->
      <div id="quiz-container" class="hidden flex-1 flex flex-col min-h-0">
        <!-- Header dentro de Quiz Container -->
        <div class="text-center px-4 pb-2 flex-shrink-0">
          <h1 class="text-2xl md:text-3xl lg:text-4xl font-bold text-white mb-1">
            🧠 Quiz Diario
          </h1>
          <p class="text-sm md:text-base text-orange-100 max-w-xl mx-auto">
            5 preguntas sobre stats. ¡40 monedas por acierto!
          </p>
        </div>
        
        <!-- Progress y Stats Compactos -->
        <div class="flex-shrink-0 mb-3">
          <!-- Progress Bar -->
          <div class="flex justify-between items-center mb-2">
            <span class="text-white font-semibold text-sm"><span id="question-progress">1/5</span></span>
            <span class="text-yellow-400 font-semibold text-sm">💰 <span id="coins-earned">0</span></span>
          </div>
          <div class="w-full bg-gray-700 rounded-full h-2 mb-3">
            <div id="progress-bar" class="bg-orange-500 h-2 rounded-full transition-all duration-300" style="width: 20%"></div>
          </div>
          
          <!-- Stats Compactos -->
          <div class="grid grid-cols-3 gap-2 text-center">
            <div class="bg-white/10 backdrop-blur-md rounded-lg p-2">
              <div class="text-lg font-bold text-white" id="questions-answered">0</div>
              <div class="text-orange-200 text-xs">Respondidas</div>
            </div>
            <div class="bg-white/10 backdrop-blur-md rounded-lg p-2">
              <div class="text-lg font-bold text-green-400" id="correct-answers">0</div>
              <div class="text-orange-200 text-xs">Correctas</div>
            </div>
            <div class="bg-white/10 backdrop-blur-md rounded-lg p-2">
              <div class="text-lg font-bold text-yellow-400" id="total-coins">0</div>
              <div class="text-orange-200 text-xs">Monedas</div>
            </div>
          </div>
        </div>

        <!-- Question Card - Flexible -->
        <div class="flex-1 flex flex-col min-h-0">
          <div id="question-card" class="bg-white/10 backdrop-blur-md rounded-xl p-4 flex-1 flex flex-col min-h-0">
            <div class="flex-1 flex flex-col lg:flex-row gap-4 min-h-0">
              <!-- Card Image Compacta -->
              <div class="flex-shrink-0 flex flex-col items-center lg:items-start">
                <div class="relative w-32 h-48 sm:w-40 sm:h-60 lg:w-44 lg:h-64 bg-gradient-to-br from-orange-500 to-red-600 rounded-lg overflow-hidden flex items-center justify-center">
                  <img id="card-image" alt="Carta" class="w-full h-full object-cover select-none" draggable="false" src="" />
                  <!-- Overlays to hide info -->
                  <div class="pointer-events-none absolute top-[17%] left-[4%] w-[28%] h-[16%] bg-black"></div>
                  <div class="pointer-events-none absolute bottom-[1.5%] left-0 right-0 h-[24%] bg-black"></div>
                </div>
                <div class="text-center mt-2">
                  <div class="text-base lg:text-lg font-bold text-white" id="player-name">Cargando...</div>
                  <div class="text-orange-200 text-sm" id="player-position">FC Bufas</div>
                </div>
              </div>

              <!-- Question y Opciones -->
              <div class="flex-1 flex flex-col justify-center min-h-0">
                <div class="text-lg sm:text-xl lg:text-2xl font-bold text-white mb-4 text-center lg:text-left" id="question-text">
                  ¿Cuál es el valor de <span class="text-orange-400" id="stat-name">Ritmo</span> de esta carta?
                </div>

                <!-- Answer Options -->
                <div class="grid grid-cols-1 gap-3 max-w-md mx-auto lg:mx-0" id="answer-options">
                  <button class="answer-option p-3 bg-white/20 hover:bg-white/30 rounded-lg text-white font-semibold transition-all text-sm sm:text-base" data-answer="a">
                    A) <span class="option-value">75</span>
                  </button>
                  <button class="answer-option p-3 bg-white/20 hover:bg-white/30 rounded-lg text-white font-semibold transition-all text-sm sm:text-base" data-answer="b">
                    B) <span class="option-value">80</span>
                  </button>
                  <button class="answer-option p-3 bg-white/20 hover:bg-white/30 rounded-lg text-white font-semibold transition-all text-sm sm:text-base" data-answer="c">
                    C) <span class="option-value">85</span>
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Result Message y Botones -->
        <div class="flex-shrink-0 mt-3">
          <div id="result-message" class="hidden text-center mb-3">
            <div id="correct-message" class="hidden bg-green-500/20 backdrop-blur-md rounded-lg p-3 max-w-sm mx-auto">
              <div class="text-2xl mb-1">🎉</div>
              <div class="text-lg font-bold text-green-400 mb-1">¡Correcto!</div>
              <div class="text-green-200 text-sm">+40 monedas</div>
            </div>
            <div id="wrong-message" class="hidden bg-red-500/20 backdrop-blur-md rounded-lg p-3 max-w-sm mx-auto">
              <div class="text-2xl mb-1">❌</div>
              <div class="text-lg font-bold text-red-400 mb-1">Incorrecto</div>
              <div class="text-red-200 text-sm">Correcta: <span id="correct-answer-text">85</span></div>
            </div>
          </div>

          <!-- Next/Finish Button -->
          <div class="text-center">
            <button id="next-question" type="button" class="hidden relative z-10 px-6 py-2 bg-orange-500 text-white font-semibold rounded-lg hover:bg-orange-600 transition-colors text-sm">
              Siguiente Pregunta
            </button>
            <button id="finish-quiz" type="button" class="hidden relative z-10 px-6 py-2 bg-green-500 text-white font-semibold rounded-lg hover:bg-green-600 transition-colors text-sm">
              Ver Resultados
            </button>
          </div>
        </div>
      </div>

      <!-- Quiz Completed -->
      <div id="quiz-completed" class="hidden flex-1 flex flex-col">
        <!-- Header dentro de Quiz Completed -->
        <div class="text-center px-4 pb-2 flex-shrink-0">
          <h1 class="text-2xl md:text-3xl lg:text-4xl font-bold text-white mb-1">
            🧠 Quiz Diario
          </h1>
          <p class="text-sm md:text-base text-orange-100 max-w-xl mx-auto">
            5 preguntas sobre stats. ¡40 monedas por acierto!
          </p>
        </div>
        
        <div class="flex-1 flex items-center justify-center">
          <div class="bg-white/10 backdrop-blur-md rounded-xl p-6 max-w-md mx-auto text-center">
            <div class="text-4xl mb-4">🏆</div>
            <h2 class="text-2xl font-bold text-white mb-4">¡Quiz Completado!</h2>
          <div class="grid grid-cols-2 gap-4 mb-4">
            <div>
              <div class="text-2xl font-bold text-green-400" id="final-correct">0</div>
              <div class="text-orange-200 text-sm">Correctas</div>
            </div>
            <div>
              <div class="text-2xl font-bold text-yellow-400" id="final-coins">0</div>
              <div class="text-orange-200 text-sm">Monedas</div>
            </div>
          </div>
          <p class="text-orange-200 mb-4 text-sm">¡Vuelve mañana para otro quiz!</p>
          <div class="flex flex-col gap-2">
            <a href="/bufas-cards" class="px-4 py-2 bg-orange-500 text-white font-semibold rounded-lg hover:bg-orange-600 transition-colors text-sm">
              Dashboard
            </a>
            <a href="/bufas-cards/packs" class="px-4 py-2 bg-green-500 text-white font-semibold rounded-lg hover:bg-green-600 transition-colors text-sm">
              Abrir Sobres
            </a>
          </div>
        </div>
        </div>
      </div>

      <!-- Already Completed Today -->
      <div id="already-completed" class="hidden flex-1 flex items-center justify-center">
          <div class="bg-blue-500/20 backdrop-blur-md rounded-xl p-6 max-w-md mx-auto text-center">
            <div class="text-4xl mb-4">⏰</div>
            <h2 class="text-2xl font-bold text-white mb-3">Quiz Ya Completado</h2>
          <p class="text-blue-200 mb-4 text-sm">Ya completaste el quiz de hoy. ¡Vuelve mañana!</p>
          <div class="grid grid-cols-2 gap-4 mb-4">
            <div>
              <div class="text-2xl font-bold text-green-400" id="today-correct">0</div>
              <div class="text-blue-200 text-sm">Correctas</div>
            </div>
            <div>
              <div class="text-2xl font-bold text-yellow-400" id="today-coins">0</div>
              <div class="text-blue-200 text-sm">Monedas</div>
            </div>
          </div>
          <a href="/bufas-cards" class="px-4 py-2 bg-blue-500 text-white font-semibold rounded-lg hover:bg-blue-600 transition-colors text-sm">
            Volver al Dashboard
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

  <script>
    // State management
    let currentUser = null;
    let authToken = null;
    const storage = window.localStorage;
    let questions = [];
    let currentQuestionIndex = 0;
    let correctAnswers = 0;
    let coinsEarned = 0;
    let answeredLock = false; // evita doble envío por pregunta

    // Get current user ID for personalized storage
    function getCurrentUserId() {
      if (currentUser && currentUser.id) {
        return currentUser.id;
      }
      // Fallback: try to decode token to get userId
      if (authToken) {
        try {
          const payload = JSON.parse(atob(authToken.split('.')[1]));
          return payload.userId || payload.sub || null;
        } catch {
          return null;
        }
      }
      return null;
    }

    // Load auth state
    function checkAuthState() {
      const token = storage.getItem('nike_fc_token');
      if (token) { authToken = token; return true; }
      return false;
    }

    // Local progress fallback (persists until 20:00) - Now personalized per user
    function currentWindowKey(userId) {
      const now = new Date();
      const base = new Date(now);
      if (now.getHours() < 20) base.setDate(base.getDate() - 1);
      base.setHours(20,0,0,0);
      return `quiz_window_${userId}_` + base.toISOString();
    }

    function loadLocalProgress() {
      const userId = getCurrentUserId();
      if (!userId) {
        console.log('No userId available for storage');
        return { answered: 0, correct: 0, completed: false, questionIndex: 0, questions: [] };
      }
      
      const key = currentWindowKey(userId);
      const savedKey = storage.getItem(`quiz_window_key_${userId}`);
      if (savedKey !== key) {
        storage.removeItem(`quiz_progress_${userId}`);
        storage.setItem(`quiz_window_key_${userId}`, key);
        return { answered: 0, correct: 0, completed: false, questionIndex: 0, questions: [] };
      }
      try {
        const raw = storage.getItem(`quiz_progress_${userId}`);
        if (!raw) return { answered: 0, correct: 0, completed: false, questionIndex: 0, questions: [] };
        const p = JSON.parse(raw);
        return { 
          answered: p.answered||0, 
          correct: p.correct||0, 
          completed: !!p.completed,
          questionIndex: p.questionIndex||0,
          questions: p.questions||[]
        };
      } catch { return { answered: 0, correct: 0, completed: false, questionIndex: 0, questions: [] }; }
    }

    function saveLocalProgress(answered, correct, completed=false, questionIndex=null) {
      const userId = getCurrentUserId();
      if (!userId) {
        console.log('No userId available for storage');
        return;
      }
      const progressData = { 
        answered, 
        correct, 
        completed,
        questionIndex: questionIndex !== null ? questionIndex : currentQuestionIndex + 1,
        questions: questions // Save current questions to restore same sequence
      };
      storage.setItem(`quiz_progress_${userId}`, JSON.stringify(progressData));
    }

    // API calls
    async function fetchQuizData() {
      try {
        const response = await fetch('/api/bufas-cards/quiz/random?count=5', {
          headers: { 'Authorization': `Bearer ${authToken}` }
        });
        return await response.json();
      } catch (error) {
        console.error('Error fetching quiz data:', error);
        return { success: false, error: 'Error de conexión' };
      }
    }

    async function submitAnswer(cardId, statName, selectedAnswer) {
      try {
        const response = await fetch('/api/bufas-cards/quiz/answer', {
          method: 'POST',
          headers: { 
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${authToken}` 
          },
          body: JSON.stringify({ cardId, statName, selectedAnswer })
        });
        return await response.json();
      } catch (error) {
        console.error('Error submitting answer:', error);
        return { success: false, error: 'Error de conexión' };
      }
    }

    // UI functions
    function showSection(sectionId) {
      const sections = ['not-logged-in', 'quiz-container', 'quiz-completed', 'already-completed'];
      sections.forEach(id => {
        const element = document.getElementById(id);
        if (element) {
          element.classList.toggle('hidden', id !== sectionId);
        }
      });
    }

    function displayQuestion(question) {
      answeredLock = false;
      
      // Asegurar que las opciones estén visibles
      document.getElementById('answer-options').classList.remove('hidden');
      
      document.getElementById('player-name').textContent = question.player.name;
      document.getElementById('player-position').textContent = `${question.player.position1} - FC Bufas`;
      document.getElementById('stat-name').textContent = getStatDisplayName(question.stat_name);
      const img = document.getElementById('card-image');
      
      if (img && question.image_path) {
        img.setAttribute('src', question.image_path);
      }
      
      const options = document.querySelectorAll('.answer-option');
      const values = [question.options.a, question.options.b, question.options.c];
      
      options.forEach((option, index) => {
        const letter = ['a', 'b', 'c'][index];
        option.dataset.answer = letter;
        option.querySelector('.option-value').textContent = values[index];
        option.disabled = false;
        option.className = 'answer-option p-3 bg-white/20 hover:bg-white/30 rounded-lg text-white font-semibold transition-all text-sm sm:text-base';
      });

      const current = currentQuestionIndex + 1;
      document.getElementById('question-progress').textContent = `${current}/5`;
      document.getElementById('progress-bar').style.width = `${(current / 5) * 100}%`;
    }

    function getStatDisplayName(statName) {
      const names = {
        pace: 'Ritmo',
        shooting: 'Tiro',
        passing: 'Pase',
        dribbling: 'Regate',
        defending: 'Defensa',
        physical: 'Físico',
        fifa_rating: 'Rating FIFA'
      };
      return names[statName] || statName;
    }

    function showResult(isCorrect, correctAnswer, earnedCoins = 0) {
      // Ocultar las opciones de respuesta
      document.getElementById('answer-options').classList.add('hidden');
      
      document.getElementById('result-message').classList.remove('hidden');
      
      if (isCorrect) {
        document.getElementById('correct-message').classList.remove('hidden');
        document.getElementById('wrong-message').classList.add('hidden');
        correctAnswers++;
        coinsEarned += earnedCoins;
      } else {
        document.getElementById('correct-message').classList.add('hidden');
        document.getElementById('wrong-message').classList.remove('hidden');
        document.getElementById('correct-answer-text').textContent = correctAnswer;
      }

      // Update stats
      document.getElementById('questions-answered').textContent = currentQuestionIndex + 1;
      document.getElementById('correct-answers').textContent = correctAnswers;
      document.getElementById('coins-earned').textContent = coinsEarned;
      const totalCoinsEl = document.getElementById('total-coins');
      if (totalCoinsEl) totalCoinsEl.textContent = String(coinsEarned);

      // Show next/finish button and (re)bind click handler to be safe on SPA swaps
      const nextBtn = document.getElementById('next-question');
      const finishBtn = document.getElementById('finish-quiz');
      // Mostrar "Siguiente" mientras queden preguntas por responder (<5)
      const answeredNow = parseInt(((document.getElementById('questions-answered') as HTMLElement).textContent) || '0');
      if (answeredNow < 5) {
        nextBtn.classList.remove('hidden');
        nextBtn.disabled = false;
        nextBtn.onclick = null;
        nextBtn.addEventListener('click', nextQuestion, { once: true });
      } else {
        finishBtn.classList.remove('hidden');
        finishBtn.disabled = false;
        finishBtn.onclick = null;
        finishBtn.addEventListener('click', finishQuiz, { once: true });
      }
    }

    // Helper to avoid duplicate listeners across SPA transitions
    function bindOnce(el, event, handler) {
      if (!el) return;
      const key = `__bound_${event}`;
      if (el[key]) return;
      el.addEventListener(event, handler);
      el[key] = true;
    }

    async function initializeQuiz() {
      // Local completed gate
      const local = loadLocalProgress();
      if (local.completed) {
        document.getElementById('today-correct').textContent = String(local.correct);
        document.getElementById('today-coins').textContent = String(local.correct * 40);
        showSection('already-completed');
        return;
      }

      const result = await fetchQuizData();
      
      if (!result.success) {
        alert('Error al cargar el quiz: ' + result.error);
        return;
      }

      // Already completed window
      if (result.alreadyCompleted) {
        document.getElementById('today-correct').textContent = (result.progress?.correct || 0).toString();
        document.getElementById('today-coins').textContent = ((result.progress?.correct || 0) * 40).toString();
        showSection('already-completed');
        return;
      }

      // Use saved questions if available, otherwise use new questions from server
      if (local.questions && local.questions.length >= 5) {
        questions = local.questions;
        console.log('Using saved questions from local storage');
      } else {
        questions = result.questions || [];
        // Top-up to ensure 5 questions if backend returned fewer
        if (questions.length < 5) {
          let attempts = 0;
          while (questions.length < 5 && attempts < 3) {
            const need = 5 - questions.length;
            try {
              const r2 = await fetch('/api/bufas-cards/quiz/random?count=' + need, { headers: { 'Authorization': `Bearer ${authToken}` } });
              const b2 = await r2.json();
              if (b2 && b2.success && Array.isArray(b2.questions)) {
                questions = questions.concat(b2.questions);
              }
            } catch {}
            attempts++;
          }
        }
        console.log('Using new questions from server');
      }
      // Load persisted progress (prefer server, fallback local)
      let answeredSoFar = result.progress?.answered ?? null;
      let correctSoFar = result.progress?.correct ?? null;
      if (answeredSoFar === null || correctSoFar === null) {
        answeredSoFar = local.answered;
        correctSoFar = local.correct;
      }
      
      // Set current question index based on progress
      currentQuestionIndex = Math.min(answeredSoFar, questions.length - 1);
      correctAnswers = correctSoFar;
      coinsEarned = correctSoFar * 40;
      document.getElementById('questions-answered').textContent = answeredSoFar.toString();
      document.getElementById('correct-answers').textContent = correctSoFar.toString();
      document.getElementById('coins-earned').textContent = coinsEarned.toString();

      if (questions.length === 0) {
        alert('No hay preguntas disponibles');
        return;
      }

      showSection('quiz-container');
      
      // Si all preguntas are answered, show completion
      if (answeredSoFar >= 5) {
        await finishQuiz();
        return;
      }
      
      // Show the next question (the one that hasn't been answered yet)
      const nextQuestionIndex = answeredSoFar;
      const nextOrdinal = nextQuestionIndex + 1;
      document.getElementById('question-progress').textContent = `${nextOrdinal}/5`;
      document.getElementById('progress-bar').style.width = `${(nextOrdinal/5)*100}%`;
      
      // Make sure we have enough questions
      if (nextQuestionIndex >= questions.length) {
        // Try to get more questions
        try {
          const needed = (nextQuestionIndex + 1) - questions.length;
          const res = await fetch(`/api/bufas-cards/quiz/random?count=${needed}`, { 
            headers: { 'Authorization': `Bearer ${authToken}` } 
          });
          const data = await res.json();
          if (data && data.success && Array.isArray(data.questions)) {
            questions = questions.concat(data.questions);
          }
        } catch (error) {
          console.error('Error fetching additional questions:', error);
        }
      }
      
      // Set the current question index to the next question to be answered
      currentQuestionIndex = nextQuestionIndex;
      displayQuestion(questions[currentQuestionIndex]);
      
      // Save initial state with questions
      saveLocalProgress(answeredSoFar, correctSoFar, false);

      // Set up event listeners
      document.querySelectorAll('.answer-option').forEach(button => {
        bindOnce(button, 'click', handleAnswer);
      });

      bindOnce(document.getElementById('next-question'), 'click', nextQuestion);
      bindOnce(document.getElementById('finish-quiz'), 'click', finishQuiz);
    }

    async function handleAnswer(event) {
      if (answeredLock) return; // ya se respondió esta pregunta
      answeredLock = true;
      const selectedButton = event.target.closest('.answer-option');
      const selectedAnswer = parseInt(selectedButton.querySelector('.option-value').textContent);
      const currentQuestion = questions[currentQuestionIndex];
      
      // Disable all buttons
      document.querySelectorAll('.answer-option').forEach(btn => {
        btn.disabled = true;
        btn.classList.remove('hover:bg-white/30');
      });

      // Submit answer to API
      const result = await submitAnswer(currentQuestion.cardId, currentQuestion.stat_name, selectedAnswer);
      
      console.log('Quiz answer result:', result); // Debug log
      
      if (!result.success) {
        alert('Error al enviar respuesta: ' + result.error);
        // Rehabilitar botones en caso de error
        document.querySelectorAll('.answer-option').forEach(btn => {
          btn.disabled = false;
          btn.classList.add('hover:bg-white/30');
        });
        answeredLock = false;
        return;
      }

      // Highlight correct and wrong answers (antes de ocultarlas)
      document.querySelectorAll('.answer-option').forEach(btn => {
        const value = parseInt(btn.querySelector('.option-value').textContent);
        if (value === result.correctAnswer) {
          btn.classList.add('bg-green-500/50');
        } else if (btn === selectedButton && value !== result.correctAnswer) {
          btn.classList.add('bg-red-500/50');
        }
      });
      
      // Dar un breve momento para ver la respuesta antes de ocultar
      setTimeout(() => {
        showResult(result.isCorrect, result.correctAnswer, result.coinsEarned);
      }, 1000);

      // Update local counters to reflect server-side progress
      const ansEl = document.getElementById('questions-answered');
      const corrEl = document.getElementById('correct-answers');
      const coinsEl = document.getElementById('coins-earned');
      const prevAnswered = parseInt(ansEl.textContent || '0');
      const newAnswered = prevAnswered + 1;
      ansEl.textContent = String(newAnswered);
      let newCorrect = parseInt(corrEl.textContent || '0');
      if (result.isCorrect) {
        newCorrect = newCorrect + 1;
        corrEl.textContent = String(newCorrect);
        const prevCoins = parseInt(coinsEl.textContent || '0');
        coinsEl.textContent = String(prevCoins + (result.coinsEarned || 0));
        
        // Verificar que las monedas se guardaron correctamente
        setTimeout(async () => {
          try {
            await fetchCurrentUser();
            console.log('User profile refreshed after correct answer');
          } catch (error) {
            console.error('Error refreshing user profile:', error);
          }
        }, 2000);
      }
      // Persist locally
      saveLocalProgress(newAnswered, newCorrect, newAnswered >= 5);

      // El showResult se llama en el setTimeout arriba
    }

    async function nextQuestion() {
      currentQuestionIndex++;
      
      // Mostrar las opciones de nuevo y ocultar mensajes de resultado
      document.getElementById('answer-options').classList.remove('hidden');
      document.getElementById('result-message').classList.add('hidden');
      document.getElementById('correct-message').classList.add('hidden');
      document.getElementById('wrong-message').classList.add('hidden');
      const nextBtn = document.getElementById('next-question');
      const finishBtn = document.getElementById('finish-quiz');
      nextBtn.classList.add('hidden');
      finishBtn.classList.add('hidden');

      // Si faltan preguntas en el array, traer 1 más para completar 5
      if (currentQuestionIndex >= questions.length) {
        try {
          const res = await fetch('/api/bufas-cards/quiz/random?count=1', { headers: { 'Authorization': `Bearer ${authToken}` } });
          const data = await res.json();
          if (data && data.success && Array.isArray(data.questions) && data.questions.length) {
            questions = questions.concat(data.questions);
            // Save updated questions to local storage
            const ans = parseInt(document.getElementById('questions-answered').textContent || '0');
            const corr = parseInt(document.getElementById('correct-answers').textContent || '0');
            saveLocalProgress(ans, corr, false);
          } else {
            await finishQuiz();
            return;
          }
        } catch (_) {
          await finishQuiz();
          return;
        }
      }

      // Update top progress (answered + 1 for the next ordinal)
      const ans = parseInt(document.getElementById('questions-answered').textContent || '0');
      const ordinal = (ans % 5) + 1;
      document.getElementById('question-progress').textContent = `${ordinal}/5`;
      document.getElementById('progress-bar').style.width = `${(ordinal/5)*100}%`;

      // Show next question
      displayQuestion(questions[currentQuestionIndex]);
    }

    async function finishQuiz() {
      document.getElementById('final-correct').textContent = correctAnswers;
      document.getElementById('final-coins').textContent = coinsEarned;
      showSection('quiz-completed');

      // Persist local completion until 20:00
      saveLocalProgress(5, correctAnswers, true);

      // Actualizar perfil del usuario para refrescar las monedas
      try {
        await fetchCurrentUser();
        console.log('User profile updated after quiz completion');
      } catch (error) {
        console.error('Error updating user profile:', error);
      }
    }

    // Fetch current user info
    async function fetchCurrentUser() {
      try {
        const res = await fetch('/api/bufas-cards/auth/me', { 
          headers: { Authorization: `Bearer ${authToken}` } 
        });
        const data = await res.json();
        if (data.success) {
          currentUser = data.user;
          return true;
        }
      } catch (error) {
        console.error('Error fetching user info:', error);
      }
      return false;
    }

    // Initialization function to support SPA navigations
    async function startQuizPage() {
      if (!checkAuthState()) {
        showSection('not-logged-in');
        return;
      }
      
      // Get current user info before proceeding
      const userFetched = await fetchCurrentUser();
      if (!userFetched) {
        console.error('Could not fetch user info');
        showSection('not-logged-in');
        return;
      }
      
      await initializeQuiz();
    }

    // Initialize on page load and Astro transitions
    document.addEventListener('DOMContentLoaded', startQuizPage);
    document.addEventListener('astro:page-load', startQuizPage);
    document.addEventListener('astro:after-swap', startQuizPage);
  </script>
</NikeFCLayout>

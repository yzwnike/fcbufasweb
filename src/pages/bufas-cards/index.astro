---
import NikeFCLayout from '@/layouts/NikeFCLayout.astro';
import Subheader from '@/components/bufas-cards/Subheader.astro';
import LoadingScreen from '@/components/bufas-cards/LoadingScreen.astro';
---

<NikeFCLayout title="Bufas Cards" helpKey="main">
  <div class="min-h-screen bg-gradient-to-br from-orange-900 via-orange-800 to-red-900">
    <!-- Subheader Nav -->
    <div class="pt-3 lg:pt-4 px-4">
      <div class="max-w-7xl mx-auto mb-2">
        <Subheader variant="full" />
      </div>
    </div>
    <!-- Hero Section -->
    <section class="relative pt-2 lg:pt-4 pb-6 lg:pb-8 px-4">
      <div class="max-w-7xl mx-auto text-center">
        <div class="flex flex-col sm:flex-row items-center justify-center mb-3 lg:mb-4 px-2">
          <svg class="w-10 h-10 sm:w-12 sm:h-12 text-white mb-2 sm:mb-0 sm:mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
          </svg>
          <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold text-white leading-tight">
            Bufas Cards Trading Game
          </h1>
        </div>
        
        <p class="text-sm sm:text-base md:text-lg lg:text-xl text-orange-100 mb-4 lg:mb-6 max-w-3xl mx-auto px-2 leading-relaxed">
          Colecciona cartas de los jugadores de FC Bufas, completa desafíos diarios, 
          intercambia con otros usuarios y domina el Fantasy Rush semanal
        </p>

        <!-- User Status -->
        <div id="user-status" class="mb-4 lg:mb-6 px-2">
          <div id="logged-out" class="space-y-4">
            <p class="text-sm sm:text-base text-orange-200">Inicia sesión para comenzar tu colección</p>
            <div class="flex flex-col sm:flex-row gap-2 sm:gap-3 justify-center max-w-sm sm:max-w-none mx-auto">
              <button id="login-btn" class="px-4 sm:px-6 py-2 bg-white text-orange-900 font-semibold rounded-lg hover:bg-orange-100 transition-colors text-sm">
                Iniciar Sesión
              </button>
              <button id="register-btn" class="px-4 sm:px-6 py-2 bg-orange-600 text-white font-semibold rounded-lg hover:bg-orange-700 transition-colors text-sm">
                Registrarse
              </button>
            </div>
          </div>

          <div id="logged-in" class="hidden">
            <div class="bg-white/10 backdrop-blur-md rounded-xl p-3 sm:p-4 mb-3 lg:mb-4 max-w-sm sm:max-w-md mx-auto">
              <div class="flex flex-col sm:flex-row items-center sm:justify-between gap-3 sm:gap-0">
                <div class="text-center sm:text-left">
                  <p class="text-orange-100 text-xs">Bienvenido,</p>
                  <div class="flex items-center justify-center sm:justify-start gap-2">
                    <p id="username" class="text-lg sm:text-xl font-bold text-white"></p>
                    <button id="open-username-modal" class="p-1 rounded bg-white/10 hover:bg-white/20" title="Editar nombre">
                      <svg class="w-3 h-3 sm:w-4 sm:h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 4h2m2 0h2m-8 0H7m6 16l3-3m0 0l3 3m-3-3v8m-6-8H5a2 2 0 01-2-2V7a2 2 0 012-2h6" />
                      </svg>
                    </button>
                  </div>
                </div>
                <div class="text-center sm:text-right">
                  <p class="text-orange-100 text-xs">Monedas</p>
                  <p id="coins" class="text-lg sm:text-xl font-bold text-yellow-400">0</p>
                </div>
              </div>
            </div>
            <div class="text-center">
              <button id="logout-btn" class="px-3 py-1.5 bg-red-500 text-white font-semibold rounded-lg hover:bg-red-600 transition-colors text-sm">
                Cerrar sesión
              </button>
            </div>
          </div>
        </div>

      <!-- Game Features -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-2 sm:gap-3 max-w-[1800px] mx-auto px-2">
          <div class="bg-white/10 backdrop-blur-md rounded-xl p-2 sm:p-3 text-center hover:bg-white/20 transition-colors group">
            <div class="w-8 h-8 sm:w-10 sm:h-10 bg-orange-500 rounded-full flex items-center justify-center mx-auto mb-1 sm:mb-2 group-hover:scale-110 transition-transform">
              <svg class="w-4 h-4 sm:w-5 sm:h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <h3 class="text-sm sm:text-base font-semibold text-white mb-1 break-words">Quiz Diario</h3>
            <p class="text-xs text-orange-200 break-words leading-tight">5 preguntas diarias. ¡Gana hasta 250 monedas!</p>
          </div>

          <div class="bg-white/10 backdrop-blur-md rounded-xl p-2 sm:p-3 text-center hover:bg-white/20 transition-colors group">
            <div class="w-8 h-8 sm:w-10 sm:h-10 bg-green-500 rounded-full flex items-center justify-center mx-auto mb-1 sm:mb-2 group-hover:scale-110 transition-transform">
              <svg class="w-4 h-4 sm:w-5 sm:h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M9 1v6m6-6v6"></path>
              </svg>
            </div>
            <h3 class="text-sm sm:text-base font-semibold text-white mb-1 break-words">Sobres de Cartas</h3>
            <p class="text-xs text-orange-200 break-words leading-tight">1 sobre gratis cada 24h. Compra premium y especiales</p>
          </div>

          <div class="bg-white/10 backdrop-blur-md rounded-xl p-2 sm:p-3 text-center hover:bg-white/20 transition-colors group">
            <div class="w-8 h-8 sm:w-10 sm:h-10 bg-yellow-500 rounded-full flex items-center justify-center mx-auto mb-1 sm:mb-2 group-hover:scale-110 transition-transform">
              <svg class="w-4 h-4 sm:w-5 sm:h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
              </svg>
            </div>
            <h3 class="text-sm sm:text-base font-semibold text-white mb-1 break-words">Mercado</h3>
            <p class="text-xs text-yellow-300 break-words leading-tight">Vende y compra cartas con otros usuarios</p>
          </div>

          <!-- SBC Feature -->
          <div class="bg-white/10 backdrop-blur-md rounded-xl p-2 sm:p-3 text-center hover:bg-white/20 transition-colors group">
            <div class="w-8 h-8 sm:w-10 sm:h-10 bg-emerald-500 rounded-full flex items-center justify-center mx-auto mb-1 sm:mb-2 group-hover:scale-110 transition-transform">
              <svg class="w-4 h-4 sm:w-5 sm:h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 1.343-3 3v2H7l5 5 5-5h-2v-2c0-1.657-1.343-3-3-3z" />
              </svg>
            </div>
            <h3 class="text-sm sm:text-base font-semibold text-white mb-1 break-words">SBC</h3>
            <p class="text-xs text-orange-200 break-words leading-tight">Completa retos mensuales y gana sobres o cartas</p>
          </div>

          <div class="bg-white/10 backdrop-blur-md rounded-xl p-2 sm:p-3 text-center hover:bg-white/20 transition-colors group">
            <div class="w-8 h-8 sm:w-10 sm:h-10 bg-purple-500 rounded-full flex items-center justify-center mx-auto mb-1 sm:mb-2 group-hover:scale-110 transition-transform">
              <svg class="w-4 h-4 sm:w-5 sm:h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
            <h3 class="text-sm sm:text-base font-semibold text-white mb-1 break-words">Fantasy Rush</h3>
            <p class="text-xs text-orange-200 break-words leading-tight">Elige 3 jugadores cada semana. Puntos x20 monedas</p>
          </div>
        </div>

        <!-- Quick Actions -->
        <div id="quick-actions" class="hidden mt-4 lg:mt-6">
          <h2 class="text-lg lg:text-xl font-bold text-white text-center mb-3">Acciones Rápidas</h2>
          
          <!-- Grid único - 2 columnas de 5 en móvil, 5+5 en escritorio -->
          <div class="grid grid-cols-2 lg:grid-cols-5 gap-2 lg:gap-3 mb-2 max-w-5xl mx-auto">
            <a href="/bufas-cards/quiz" class="group bg-white/10 backdrop-blur-sm hover:bg-white/20 text-white rounded-lg p-2 lg:p-3 transition-all duration-300 hover:scale-105 text-center">
              <div class="w-8 h-8 bg-orange-500/20 rounded-lg flex items-center justify-center mx-auto mb-1.5">
                <svg class="w-4 h-4 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <h3 class="font-semibold text-xs lg:text-sm">Quiz Diario</h3>
            </a>
            
            <a href="/bufas-cards/packs" class="group bg-white/10 backdrop-blur-sm hover:bg-white/20 text-white rounded-lg p-2 lg:p-3 transition-all duration-300 hover:scale-105 text-center">
              <div class="w-8 h-8 bg-green-500/20 rounded-lg flex items-center justify-center mx-auto mb-1.5">
                <svg class="w-4 h-4 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M9 1v6m6-6v6"></path>
                </svg>
              </div>
              <h3 class="font-semibold text-xs lg:text-sm">Abrir Sobres</h3>
            </a>
            
            <a href="/bufas-cards/collection" class="group bg-white/10 backdrop-blur-sm hover:bg-white/20 text-white rounded-lg p-2 lg:p-3 transition-all duration-300 hover:scale-105 text-center">
              <div class="w-8 h-8 bg-blue-500/20 rounded-lg flex items-center justify-center mx-auto mb-1.5">
                <svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
                </svg>
              </div>
              <h3 class="font-semibold text-xs lg:text-sm">Mi Colección</h3>
            </a>
            
            <a href="/bufas-cards/market" class="group bg-white/10 backdrop-blur-sm hover:bg-white/20 text-white rounded-lg p-2 lg:p-3 transition-all duration-300 hover:scale-105 text-center">
              <div class="w-8 h-8 bg-yellow-500/20 rounded-lg flex items-center justify-center mx-auto mb-1.5">
                <svg class="w-4 h-4 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
                </svg>
              </div>
              <h3 class="font-semibold text-xs lg:text-sm">Mercado</h3>
            </a>
            
            <a href="/bufas-cards/fantasy" class="group bg-white/10 backdrop-blur-sm hover:bg-white/20 text-white rounded-lg p-2 lg:p-3 transition-all duration-300 hover:scale-105 text-center">
              <div class="w-8 h-8 bg-purple-500/20 rounded-lg flex items-center justify-center mx-auto mb-1.5">
                <svg class="w-4 h-4 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                </svg>
              </div>
              <h3 class="font-semibold text-xs lg:text-sm">Fantasy</h3>
            </a>
            
            <a href="/bufas-cards/sbc" class="group bg-white/10 backdrop-blur-sm hover:bg-white/20 text-white rounded-lg p-2 lg:p-3 transition-all duration-300 hover:scale-105 text-center">
              <div class="w-8 h-8 bg-emerald-500/20 rounded-lg flex items-center justify-center mx-auto mb-1.5">
                <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 1.343-3 3v2H7l5 5 5-5h-2v-2c0-1.657-1.343-3-3-3z"></path>
                </svg>
              </div>
              <h3 class="font-semibold text-xs lg:text-sm">SBC</h3>
            </a>
            
            <a href="/bufas-cards/ranking" class="group bg-white/10 backdrop-blur-sm hover:bg-white/20 text-white rounded-lg p-2 lg:p-3 transition-all duration-300 hover:scale-105 text-center">
              <div class="w-8 h-8 bg-slate-500/20 rounded-lg flex items-center justify-center mx-auto mb-1.5">
                <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 012-2h2a2 2 012 2v10m-6 0a2 2 002 2h2a2 2 002-2m0 0V5a2 2 012-2h2a2 2 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                </svg>
              </div>
              <h3 class="font-semibold text-xs lg:text-sm">Ranking</h3>
            </a>
            
            <a href="/bufas-cards/ajustes" class="group bg-white/10 backdrop-blur-sm hover:bg-white/20 text-white rounded-lg p-2 lg:p-3 transition-all duration-300 hover:scale-105 text-center">
              <div class="w-8 h-8 bg-slate-500/20 rounded-lg flex items-center justify-center mx-auto mb-1.5">
                <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
              </div>
              <h3 class="font-semibold text-xs lg:text-sm">Ajustes</h3>
            </a>
            
            <a href="/bufas-cards/logros" class="group bg-white/10 backdrop-blur-sm hover:bg-white/20 text-white rounded-lg p-2 lg:p-3 transition-all duration-300 hover:scale-105 text-center">
              <div class="w-8 h-8 bg-amber-500/20 rounded-lg flex items-center justify-center mx-auto mb-1.5">
                <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path>
                </svg>
              </div>
              <h3 class="font-semibold text-xs lg:text-sm">Logros</h3>
            </a>
            
            <a href="/bufas-cards/ayuda" class="group bg-white/10 backdrop-blur-sm hover:bg-white/20 text-white rounded-lg p-2 lg:p-3 transition-all duration-300 hover:scale-105 text-center">
              <div class="w-8 h-8 bg-blue-500/20 rounded-lg flex items-center justify-center mx-auto mb-1.5">
                <svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <h3 class="font-semibold text-xs lg:text-sm">Ayuda</h3>
            </a>
          </div>
        </div>
      </div>

    </section>
  </div>

  <!-- Authentication Modals -->
  <div id="login-modal" class="fixed inset-0 bg-black/50 flex items-center justify-center z-50 hidden">
    <div class="bg-white rounded-xl p-8 max-w-md w-full mx-4">
      <h2 class="text-2xl font-bold text-gray-900 mb-6 text-center">Iniciar Sesión</h2>
      <form id="login-form" class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Email</label>
          <input type="email" name="email" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-orange-500 focus:border-orange-500">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Contraseña</label>
          <input type="password" name="password" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-orange-500 focus:border-orange-500">
        </div>
        <div id="login-error" class="hidden text-red-500 text-sm"></div>
        <div class="flex gap-4">
          <button type="submit" class="flex-1 bg-orange-500 text-white py-2 rounded-lg hover:bg-orange-600 transition-colors">
            Iniciar Sesión
          </button>
          <button type="button" id="close-login" class="flex-1 bg-gray-300 text-gray-700 py-2 rounded-lg hover:bg-gray-400 transition-colors">
            Cancelar
          </button>
        </div>
      </form>
    </div>
  </div>

  <div id="register-modal" class="fixed inset-0 bg-black/50 flex items-center justify-center z-50 hidden">
    <div class="bg-white rounded-xl p-8 max-w-md w-full mx-4">
      <h2 class="text-2xl font-bold text-gray-900 mb-6 text-center">Registrarse</h2>
      <form id="register-form" class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Username</label>
          <input type="text" name="username" required minlength="3" maxlength="20" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-orange-500 focus:border-orange-500">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Email</label>
          <input type="email" name="email" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-orange-500 focus:border-orange-500">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Contraseña</label>
          <input type="password" name="password" required minlength="6" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-orange-500 focus:border-orange-500">
        </div>
        <div id="register-error" class="hidden text-red-500 text-sm"></div>
        <div class="flex gap-4">
          <button type="submit" class="flex-1 bg-orange-500 text-white py-2 rounded-lg hover:bg-orange-600 transition-colors">
            Registrarse
          </button>
          <button type="button" id="close-register" class="flex-1 bg-gray-300 text-gray-700 py-2 rounded-lg hover:bg-gray-400 transition-colors">
            Cancelar
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Username modal -->
  <div id="username-modal" class="fixed inset-0 bg-black/50 flex items-center justify-center z-50 hidden">
    <div class="bg-white rounded-xl p-6 max-w-md w-full mx-4">
      <h2 class="text-2xl font-bold text-gray-900 mb-4 text-center">Cambiar nombre de usuario</h2>
      <form id="username-form" class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Nuevo username</label>
          <input type="text" id="new-username" name="username" required minlength="3" maxlength="20" pattern="^[a-zA-Z0-9_]+$" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-orange-500 focus:border-orange-500">
          <p class="text-xs text-gray-500 mt-1">3-20 caracteres, letras, números o _</p>
        </div>
        <div id="username-error" class="hidden text-red-500 text-sm"></div>
        <div class="flex gap-4">
          <button type="submit" class="flex-1 bg-orange-500 text-white py-2 rounded-lg hover:bg-orange-600 transition-colors">Guardar</button>
          <button type="button" id="close-username" class="flex-1 bg-gray-300 text-gray-700 py-2 rounded-lg hover:bg-gray-400 transition-colors">Cancelar</button>
        </div>
      </form>
    </div>
  </div>
  
  <!-- Loading Screen - se renderiza al final para cubrir todo el contenido -->
  <LoadingScreen />
</NikeFCLayout>

<script>
  // Auth State Management
  let currentUser = null;
  let authToken = null;
  const storage = window.sessionStorage;

  // Check if user is logged in
  function checkAuthState() {
    const token = storage.getItem('nike_fc_token');
    if (token) {
      authToken = token;
      fetchMe();
    } else {
      showLoggedOutState();
    }
  }

  function showLoggedInState() {
    const loggedOut = document.getElementById('logged-out');
    const loggedIn = document.getElementById('logged-in');
    const quickActions = document.getElementById('quick-actions');

    if (loggedOut) loggedOut.classList.add('hidden');
    if (loggedIn) loggedIn.classList.remove('hidden');
    if (quickActions) quickActions.classList.remove('hidden');

    if (currentUser) {
      const usernameEl = document.getElementById('username');
      const coinsEl = document.getElementById('coins');

      if (usernameEl) usernameEl.textContent = currentUser.username;
      if (coinsEl) coinsEl.textContent = currentUser.coins;
    }
  }

  function showLoggedOutState() {
    const loggedOut = document.getElementById('logged-out');
    const loggedIn = document.getElementById('logged-in');
    const quickActions = document.getElementById('quick-actions');

    if (loggedOut) loggedOut.classList.remove('hidden');
    if (loggedIn) loggedIn.classList.add('hidden');
    if (quickActions) quickActions.classList.add('hidden');
  }

  async function fetchMe() {
    try {
      const res = await fetch('/api/bufas-cards/auth/me', { headers: { Authorization: `Bearer ${authToken}` } });
      const data = await res.json();
      if (data.success) {
        currentUser = data.user;
        showLoggedInState();
      } else {
        showLoggedOutState();
      }
    } catch {
      showLoggedOutState();
    }
  }

  // Modal functions
  function openModal(modalId) {
    const modal = document.getElementById(modalId);
    if (modal) {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    } else {
      console.error('Modal not found:', modalId);
    }
  }

  function closeModal(modalId) {
    const modal = document.getElementById(modalId);
    if (modal) {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      // Clear error messages
      const errorEl = document.getElementById(modalId.replace('-modal', '-error'));
      if (errorEl) {
        errorEl.classList.add('hidden');
        errorEl.textContent = '';
      }
    }
  }

  // Auth API calls
  let isLoggingIn = false;
  
  async function login(email, password) {
    // Prevenir múltiples solicitudes simultáneas
    if (isLoggingIn) {
      return { success: false, error: 'Ya se está procesando una solicitud de login' };
    }
    
    isLoggingIn = true;
    console.log('Attempting login for:', email);
    
    try {
      const response = await fetch('/api/bufas-cards/auth/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, password })
      });

      const data = await response.json();
      console.log('Login response:', data);
      
      if (data.success) {
        storage.setItem('nike_fc_token', data.token);
        authToken = data.token;
        await fetchMe();
        closeModal('login-modal');
        // Forzar sincronización de estado en toda la app
        window.location.reload();
      }
      
      return data;
    } catch (error) {
      console.error('Login error:', error);
      return { success: false, error: 'Error de conexión' };
    } finally {
      isLoggingIn = false;
    }
  }

  let isRegistering = false;
  
  async function register(username, email, password) {
    // Prevenir múltiples solicitudes simultáneas
    if (isRegistering) {
      return { success: false, error: 'Ya se está procesando una solicitud de registro' };
    }
    
    isRegistering = true;
    console.log('Attempting registration for:', username, email);
    
    try {
      const response = await fetch('/api/bufas-cards/auth/register', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ username, email, password })
      });

      const data = await response.json();
      console.log('Register response:', data);
      
      if (data.success) {
        storage.setItem('nike_fc_token', data.token);
        authToken = data.token;
        await fetchMe();
        closeModal('register-modal');
        // Forzar sincronización de estado en toda la app
        window.location.reload();
      }
      
      return data;
    } catch (error) {
      console.error('Register error:', error);
      return { success: false, error: 'Error de conexión' };
    } finally {
      isRegistering = false;
    }
  }

  // Initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeApp);
  } else {
    initializeApp();
  }
  // Ensure initialization on SPA navigations (Astro View Transitions)
  document.addEventListener('astro:page-load', initializeApp);
  document.addEventListener('astro:after-swap', initializeApp);

  function doLogout() {
    try {
      storage.removeItem('nike_fc_token');
      authToken = null;
      currentUser = null;
      window.location.href = '/bufas-cards';
    } catch {}
  }

  async function updateUsername(newName) {
    try {
      const res = await fetch('/api/bufas-cards/profile/username', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${authToken}` },
        body: JSON.stringify({ username: newName })
      });
      const data = await res.json();
      return data;
    } catch (e) { return { success:false, error:'Error de conexión' }; }
  }

  function initializeApp() {
    console.log('Initializing Bufas Cards app...');
    
    checkAuthState();

    // Modal controls
    const loginBtn = document.getElementById('login-btn');
    const registerBtn = document.getElementById('register-btn');
    const closeLoginBtn = document.getElementById('close-login');
    const closeRegisterBtn = document.getElementById('close-register');
    
    if (loginBtn) {
      loginBtn.addEventListener('click', (e) => {
        e.preventDefault();
        console.log('Login button clicked');
        openModal('login-modal');
      });
    } else {
      console.error('Login button not found');
    }

    // Open username modal
    const openUsernameBtn = document.getElementById('open-username-modal');
    const usernameForm = document.getElementById('username-form');
    const closeUsernameBtn = document.getElementById('close-username');
    if (openUsernameBtn) {
      openUsernameBtn.addEventListener('click', (e) => { e.preventDefault(); openModal('username-modal'); const input = document.getElementById('new-username'); if (input && currentUser) input.value = currentUser.username; });
    }
    if (closeUsernameBtn) {
      closeUsernameBtn.addEventListener('click', (e)=>{ e.preventDefault(); closeModal('username-modal'); });
    }
    if (usernameForm) {
      usernameForm.addEventListener('submit', async (e)=>{
        e.preventDefault();
        const input = document.getElementById('new-username');
        const err = document.getElementById('username-error');
        const newName = input?.value?.trim();
        const resp = await updateUsername(newName);
        if (!resp.success) {
          if (err) { err.classList.remove('hidden'); err.textContent = resp.error || 'Error'; }
          return;
        }
        if (err) { err.classList.add('hidden'); err.textContent = ''; }
        // Update UI and close
        currentUser.username = resp.user?.username || newName;
        const usernameEl = document.getElementById('username');
        if (usernameEl) usernameEl.textContent = currentUser.username;
        closeModal('username-modal');
      });
    }
    
    if (registerBtn) {
      registerBtn.addEventListener('click', (e) => {
        e.preventDefault();
        console.log('Register button clicked');
        openModal('register-modal');
      });
    } else {
      console.error('Register button not found');
    }
    
    if (closeLoginBtn) {
      closeLoginBtn.addEventListener('click', () => closeModal('login-modal'));
    }
    
    if (closeRegisterBtn) {
      closeRegisterBtn.addEventListener('click', () => closeModal('register-modal'));
    }

    const logoutBtn = document.getElementById('logout-btn');
    if (logoutBtn) logoutBtn.addEventListener('click', doLogout);
    
    // Form submissions
    const loginForm = document.getElementById('login-form');
    if (loginForm) {
      loginForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        console.log('Login form submitted');
        
        const submitBtn = e.target.querySelector('button[type="submit"]');
        const errorEl = document.getElementById('login-error');
        
        // Deshabilitar el botón para prevenir doble clic
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = 'Iniciando...';
        }
        
        // Limpiar errores previos
        if (errorEl) {
          errorEl.classList.add('hidden');
          errorEl.textContent = '';
        }
        
        try {
          const formData = new FormData(e.target);
          const email = formData.get('email');
          const password = formData.get('password');
          
          if (!email || !password) {
            if (errorEl) {
              errorEl.textContent = 'Por favor complete todos los campos';
              errorEl.classList.remove('hidden');
            }
            return;
          }
          
          const result = await login(email, password);
          
          if (!result.success) {
            if (errorEl) {
              errorEl.textContent = result.error || 'Error al iniciar sesión';
              errorEl.classList.remove('hidden');
            }
          }
        } finally {
          // Rehabilitar el botón
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Iniciar Sesión';
          }
        }
      });
    }

    const registerForm = document.getElementById('register-form');
    if (registerForm) {
      registerForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        console.log('Register form submitted');
        
        const submitBtn = e.target.querySelector('button[type="submit"]');
        const errorEl = document.getElementById('register-error');
        
        // Deshabilitar el botón para prevenir doble clic
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = 'Registrando...';
        }
        
        // Limpiar errores previos
        if (errorEl) {
          errorEl.classList.add('hidden');
          errorEl.textContent = '';
        }
        
        try {
          const formData = new FormData(e.target);
          const username = formData.get('username');
          const email = formData.get('email');
          const password = formData.get('password');
          
          if (!username || !email || !password) {
            if (errorEl) {
              errorEl.textContent = 'Por favor complete todos los campos';
              errorEl.classList.remove('hidden');
            }
            return;
          }
          
          const result = await register(username, email, password);
          
          if (!result.success) {
            if (errorEl) {
              errorEl.textContent = result.error || 'Error al registrarse';
              errorEl.classList.remove('hidden');
            }
          }
        } finally {
          // Rehabilitar el botón
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Registrarse';
          }
        }
      });
    }

    // Close modals on backdrop click
    const loginModal = document.getElementById('login-modal');
    if (loginModal) {
      loginModal.addEventListener('click', (e) => {
        if (e.target.id === 'login-modal') {
          closeModal('login-modal');
        }
      });
    }

    const registerModal = document.getElementById('register-modal');
    if (registerModal) {
      registerModal.addEventListener('click', (e) => {
        if (e.target.id === 'register-modal') {
          closeModal('register-modal');
        }
      });
    }

    console.log('Bufas Cards app initialized successfully');
  }
</script>

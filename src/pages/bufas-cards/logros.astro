---
import NikeFCLayout from '@/layouts/NikeFCLayout.astro';
import Subheader from '@/components/bufas-cards/Subheader.astro';
---

<NikeFCLayout title="Logros - Bufas Cards" helpKey="logros">
  <div class="min-h-screen bg-gradient-to-br from-indigo-900 via-indigo-800 to-purple-900">
    <div class="container mx-auto px-4 pt-6 lg:pt-28 pb-10">
      <Subheader variant="minimal" />
      <div class="mt-6 lg:mt-0">
        <h1 class="text-3xl lg:text-4xl font-extrabold text-white mb-4 lg:mb-6">Logros</h1>
        <p class="text-indigo-200 mb-4 lg:mb-6">Cumple objetivos y gana monedas</p>
      </div>

      <div id="achv-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-4"></div>
    </div>
  </div>

  <script>
    const storage = window.sessionStorage;
    let token = null;

    function requireAuth() {
      const t = storage.getItem('nike_fc_token');
      if (!t) { window.location.href = '/bufas-cards'; return false; }
      token = t; return true;
    }

    async function fetchAchievements() {
      const res = await fetch('/api/bufas-cards/achievements', { cache: 'no-store', headers: { Authorization: `Bearer ${token}` }});
      return await res.json();
    }

    function render(list) {
      const grid = document.getElementById('achv-grid');
      if (!grid) return;
      grid.innerHTML = '';

      const STYLES = {
        fantasy_jornadas: { icon: '🏁', accent: 'text-rose-300' },
        cartas_totales: { icon: '🃏', accent: 'text-amber-300' },
        cartas_distintas: { icon: '🌈', accent: 'text-fuchsia-300' },
        sbc_completados: { icon: '🧩', accent: 'text-sky-300' },
        mercado_compras: { icon: '🛒', accent: 'text-emerald-300' },
        mercado_ventas: { icon: '💸', accent: 'text-lime-300' },
        sobres_abiertos: { icon: '📦', accent: 'text-indigo-300' },
        quiz_aciertos: { icon: '❓', accent: 'text-purple-300' },
      };

      list.forEach(a => {
        const s = STYLES[a.key] || { icon:'⭐', accent:'text-white' };

        // Target del nivel actual: si hay umbrales reclamables, usamos el menor para mostrar barra completa; si no, usamos el próximo objetivo
        const claimables = Array.isArray(a.claimable) ? a.claimable : [];
        const next = a.nextTarget;
        const target = claimables.length ? Math.min(...claimables.map((c:any)=>c.threshold)) : (next || (a.thresholds[a.thresholds.length-1] || 1));
        const pct = target ? Math.max(0, Math.min(100, Math.round(100 * a.currentValue / target))) : 0;
        const hasClaimableRewards = claimables.length > 0;

        const card = document.createElement('div');
        card.className = 'relative rounded-xl border border-slate-700 bg-slate-800 p-4 text-white overflow-hidden';
        card.innerHTML = `
          <div class="relative flex items-center justify-between mb-4">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-lg bg-slate-700 flex items-center justify-center text-xl">${s.icon}</div>
              <div>
                <div class="text-xl font-bold">${a.title}</div>
                <div class="text-sm ${s.accent}">Progreso: ${a.currentValue}/${target}</div>
              </div>
            </div>
            <div class="text-sm text-slate-300">${next ? `Siguiente: ${next}` : 'Completado'}</div>
          </div>

          <div class="w-full h-3 bg-slate-700 rounded mb-4">
            <div class="h-3 ${hasClaimableRewards ? 'bg-emerald-500' : 'bg-indigo-500'} rounded transition-all" style="width:${pct}%"></div>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-4">
            <!-- Niveles -->
            <div class="lg:col-span-2">
              <div class="text-sm text-slate-300 mb-3">Niveles</div>
              <div class="grid grid-cols-4 sm:grid-cols-6 md:grid-cols-8 gap-2">
                ${a.thresholds.map((t:number) => {
                  const done = a.currentValue >= t;
                  const claimed = (a.claimedThresholds || []).includes(t);
                  const canClaim = (a.claimable || []).some((c:any) => c.threshold === t);
                  let btnClass = 'w-12 h-12 rounded-lg border-2 flex items-center justify-center text-sm font-bold cursor-pointer transition-all hover:scale-105 relative level-btn';
                  
                  const isCurrentTarget = t === target;
                  
                  if (claimed) {
                    btnClass += ' bg-green-600 border-green-400 text-white';
                  } else if (canClaim) {
                    btnClass += ' bg-emerald-600/80 border-emerald-400 text-white animate-pulse';
                  } else if (isCurrentTarget && !done) {
                    btnClass += ' bg-yellow-600 border-yellow-400 text-white ring-2 ring-yellow-300';
                  } else if (done) {
                    btnClass += ' bg-indigo-600 border-indigo-400 text-white';
                  } else {
                    btnClass += ' bg-slate-700 border-slate-600 text-slate-400';
                  }
                  
                  const checkIcon = claimed ? '<span class="absolute top-0 right-0 transform translate-x-1 -translate-y-1 bg-green-500 text-white rounded-full w-4 h-4 flex items-center justify-center text-xs">✓</span>' : '';
                  
                  return `<div class="${btnClass}" data-th="${t}">${t}${checkIcon}</div>`;
                }).join('')}
              </div>
            </div>
            
            <!-- Preview -->
            <div class="lg:col-span-1">
              <div class="text-sm text-slate-300 mb-3">Vista previa</div>
              <div class="aspect-square rounded-lg border border-slate-600 bg-slate-700 overflow-hidden flex items-center justify-center relative preview-box"></div>
            </div>
          </div>

          <div class=\"flex items-center justify-between\">
            <div class=\"text-sm text-yellow-300\">${claimables.length ? `${claimables.length} recompensa(s) disponible(s)` : ''}</div>
            <button class=\"claim-btn px-3 py-1 rounded ${hasClaimableRewards ? 'bg-emerald-600 hover:bg-emerald-700' : 'bg-gray-600'} disabled:bg-gray-500\" ${hasClaimableRewards ? '' : 'disabled'} data-key=\"${a.key}\">Reclamar</button>
          </div>
        `;
        const previewBox = card.querySelector('.preview-box');
        const setPreview = (thr) => {
          const rw = (a.rewards || []).find((r)=>r.threshold===thr) || {};
          const claimed = (a.claimedThresholds || []).includes(thr);
          const key = a.key; // Añadir key para cálculo dinámico
          if (!previewBox) return;
          
          let content = '';
          let checkOverlay = claimed ? '<div class=\"absolute inset-0 bg-green-500/20 flex items-center justify-center\"><div class=\"bg-green-500 text-white rounded-full w-16 h-16 flex items-center justify-center text-2xl font-bold\">✓</div></div>' : '';
          
          if (rw.reward_type==='CARD' && rw.card_image_path) {
            const cardLabel = rw.player_name ? `1x carta ${rw.player_name.replace(' 83', '')}` : '1x Carta';
            content = `<div class="text-center p-1 flex flex-col justify-center h-full"><img src="${rw.card_image_path}" alt="${rw.player_name||'Carta'}" class="w-36 h-48 lg:w-24 lg:h-32 mx-auto mb-1 object-contain rounded" /><div class="text-sm lg:text-xs text-white leading-tight font-bold">${cardLabel}</div></div>${checkOverlay}`;
          } else if (rw.reward_type==='CHOICE' && rw.card_image_path) {
            const cardImages = rw.card_image_path.split(',');
            const imagesHtml = cardImages.map((img, index) => 
              `<img src="${img.trim()}" alt="Opción ${index+1}" class="w-16 h-20 lg:w-12 lg:h-16 object-contain rounded shadow-md" style="transform: translateY(${index * -8}px) translateX(${index * 4}px); z-index: ${cardImages.length - index}; position: relative;" />`
            ).join('');
            const cardLabel = rw.player_name || 'Elección de carta';
            content = `<div class="text-center p-1 flex flex-col justify-center h-full"><div class="flex justify-center items-center mb-2 relative" style="height: 120px;">${imagesHtml}</div><div class="text-sm lg:text-xs text-white leading-tight font-bold">${cardLabel}</div></div>${checkOverlay}`;
          } else if (rw.reward_type==='PACK') {
            content = `<div class="text-center p-1 flex flex-col justify-center h-full"><img src="/icons/logrossobre.png" alt="Sobre" class="w-40 h-52 lg:w-28 lg:h-36 mx-auto mb-1 object-contain" /><div class="text-base lg:text-sm text-white leading-tight font-bold">${rw.pack_label || rw.pack_type || 'Sobre'}</div></div>${checkOverlay}`;
          } else {
            // Para recompensas de monedas, mostrar cantidad específica
            let coinsAmount = rw.coins || 0;
            if (coinsAmount === 0) {
              // Calcular monedas dinámicamente si no están especificadas
              switch (key) {
                case 'fantasy_jornadas': coinsAmount = thr * 20; break;
                case 'cartas_totales': coinsAmount = thr * 5; break;
                case 'cartas_distintas': coinsAmount = thr * 10; break;
                case 'sbc_completados': coinsAmount = thr * 30; break;
                case 'mercado_compras': coinsAmount = thr * 20; break;
                case 'mercado_ventas': coinsAmount = thr * 20; break;
                case 'sobres_abiertos': coinsAmount = thr * 10; break;
                case 'quiz_aciertos': coinsAmount = thr * 5; break;
                default: coinsAmount = 10;
              }
            }
            content = `<div class="text-center p-2 flex flex-col justify-center h-full"><img src="/icons/monedaicono.png" alt="Monedas" class="w-20 h-20 lg:w-16 lg:h-16 mx-auto mb-2 object-contain" /><div class="text-sm lg:text-xs text-white leading-tight font-bold">+${coinsAmount} monedas</div></div>${checkOverlay}`;
          }
          
          previewBox.innerHTML = content;
        };
        // Función para actualizar el botón de reclamar según selección
        const updateClaimButton = (selectedThreshold) => {
          const btn = card.querySelector('.claim-btn');
          const claimables = Array.isArray(a.claimable) ? a.claimable : [];
          const selectedIsClaimable = claimables.some(c => c.threshold === selectedThreshold);
          
          if (btn) {
            if (selectedIsClaimable) {
              btn.textContent = 'Reclamar';
              btn.disabled = false;
              btn.className = 'claim-btn px-3 py-1 rounded bg-emerald-600 hover:bg-emerald-700 text-white font-medium';
            } else {
              btn.textContent = 'Reclamar';
              btn.disabled = true;
              btn.className = 'claim-btn px-3 py-1 rounded bg-gray-600 disabled:bg-gray-500 text-white font-medium';
            }
          }
        };
        
        // Event listeners for level buttons
        card.querySelectorAll('.level-btn[data-th]').forEach((el)=> {
          el.addEventListener('click', ()=> {
            const selectedThreshold = Number(el.getAttribute('data-th'));
            // Remove active class from all buttons in this card
            card.querySelectorAll('.level-btn').forEach(btn => btn.classList.remove('ring-2', 'ring-yellow-400'));
            // Add active class to clicked button
            el.classList.add('ring-2', 'ring-yellow-400');
            // Update preview
            setPreview(selectedThreshold);
            // Update claim button
            updateClaimButton(selectedThreshold);
          });
        });
        // Set initial preview to current target
        setPreview(target);
        // Highlight current target button initially
        const targetBtn = card.querySelector(`[data-th="${target}"]`);
        if (targetBtn) {
          targetBtn.classList.add('ring-2', 'ring-yellow-400');
        }
        // Initialize claim button
        updateClaimButton(target);
        const btn = card.querySelector('.claim-btn');
        btn?.addEventListener('click', async () => {
          const claimables = Array.isArray(a.claimable) ? a.claimable : [];
          if (claimables.length === 0) return;
          
          // Encontrar el logro actualmente seleccionado (con ring amarillo)
          const selectedBtn = card.querySelector('.level-btn.ring-yellow-400[data-th]');
          if (!selectedBtn) return;
          
          const selectedThreshold = Number(selectedBtn.getAttribute('data-th'));
          
          // Verificar si el logro seleccionado es reclamable
          const selectedClaimable = claimables.find(c => c.threshold === selectedThreshold);
          if (!selectedClaimable) {
            showNotification('El logro seleccionado no está disponible para reclamar', 'error');
            return;
          }
          
          // Deshabilitar botón mientras se procesa
          btn.disabled = true;
          btn.textContent = 'Reclamando...';
          
          // Reclamar solo el logro seleccionado
          await claimSingleReward(a.key, selectedClaimable.threshold, a.rewards);
          
          // Rehabilitar botón
          btn.disabled = false;
          btn.textContent = 'Reclamar';
          
          start(); // Recargar datos
        });
        grid.appendChild(card);
      });
    }

    // Función para reclamar una recompensa individual con animación
    async function claimSingleReward(key, threshold, rewards) {
      const reward = rewards.find(r => r.threshold === threshold);
      if (!reward) return;
      
      try {
        const response = await fetch('/api/bufas-cards/achievements/claim', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${token}`
          },
          body: JSON.stringify({
            key,
            threshold,
            rewardType: reward.reward_type,
            packType: reward.pack_type,
            cardImagePath: reward.card_image_path,
            coins: reward.coins
          })
        });
        
        const result = await response.json();
        
        if (result.success) {
          // Mostrar animación y esperar que el usuario la cierre
          return new Promise((resolve) => {
            let modalPromiseResolve = resolve;
            
            if (result.rewardType === 'COINS') {
              showCoinsAnimation(result.coins, modalPromiseResolve);
            } else if (result.rewardType === 'CARD') {
              showCardReveal(result.card, modalPromiseResolve);
          } else if (result.rewardType === 'PACK') {
            showPackOpening(result.card, result.packType, modalPromiseResolve, result.compensation);
          } else {
              resolve();
            }
          });
        } else {
          showNotification(result.error || 'Error al reclamar recompensa', 'error');
        }
      } catch (error) {
        console.error('Error claiming reward:', error);
        showNotification('Error de conexión', 'error');
      }
    }
    
    // Animación de monedas
    function showCoinsAnimation(coins, onClose) {
      const modal = createModal(`
        <div class="text-center">
          <div class="text-6xl mb-4 animate-bounce">💰</div>
          <h2 class="text-2xl font-bold text-yellow-400 mb-2">¡Recompensa Obtenida!</h2>
          <p class="text-xl text-white mb-4">+${coins} monedas</p>
          <button onclick="closeModalWithCallback()" class="px-6 py-2 bg-yellow-500 text-black font-bold rounded-lg hover:bg-yellow-400 transition-colors">
            ¡Genial!
          </button>
        </div>
      `);
      showModal(modal, onClose);
    }
    
    // Revelación de carta individual
    function showCardReveal(card, onClose) {
      const cardElement = createCardElement(card);
      const modal = createModal(`
        <div class="text-center max-w-sm mx-auto">
          <div class="mb-4 opacity-0 transform scale-50 transition-all duration-700 card-appear">
            ${cardElement.outerHTML}
          </div>
          <h2 class="text-xl font-bold text-white mb-2">¡Nueva Carta Obtenida!</h2>
          <p class="text-lg text-green-400 mb-4">${card.player?.name || 'Jugador'}</p>
          <button onclick="closeModalWithCallback()" class="px-6 py-2 bg-green-500 text-white font-bold rounded-lg hover:bg-green-400 transition-colors">
            Confirmar
          </button>
        </div>
      `);
      
      showModal(modal, onClose);
      
      // Animar aparición de la carta
      setTimeout(() => {
        const cardAppear = modal.querySelector('.card-appear');
        if (cardAppear) {
          cardAppear.classList.remove('opacity-0', 'scale-50');
        }
      }, 200);
    }
    
    // Apertura de sobre con animación (igual que en packs)
    function showPackOpening(card, packType, onClose, compensation = 0) {
      // Crear modal fullscreen como en packs
      const modal = document.createElement('div');
      modal.className = 'fixed inset-0 bg-black/95 text-white flex items-center justify-center z-50 p-4 overflow-y-auto';
      
      const compensationMessage = compensation > 0 
        ? `<div class="bg-yellow-600/20 border border-yellow-500 rounded-lg p-3 mb-4 text-center">
             <p class="text-yellow-300 text-sm font-bold">💰 Compensación: +${compensation} monedas</p>
             <p class="text-yellow-200 text-xs">No había cartas de la rareza prometida disponibles</p>
           </div>` 
        : '';
      
      modal.innerHTML = `
        <div id="pack-reveal-sequence" class="text-center w-full max-w-lg mx-auto px-4 my-auto">
          <div id="pack-loading-indicator" class="mt-6 text-green-300 text-lg sm:text-xl animate-pulse">Abriendo sobre…</div>
          <div id="pack-reveal-pos" class="text-lg sm:text-xl md:text-2xl lg:text-2xl xl:text-3xl font-extrabold opacity-0 transition-opacity duration-500 text-center w-full px-2 py-4 break-words"></div>
          <div id="pack-reveal-rating" class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl xl:text-7xl text-yellow-400 font-extrabold mt-2 sm:mt-4 opacity-0 transition-opacity duration-500 text-center w-full"></div>
          <div id="pack-card-zoom" class="mt-4 sm:mt-6 md:mt-8 opacity-0 transform scale-50 transition-all duration-700 w-full flex justify-center"></div>
          <div id="pack-compensation-message" class="hidden">${compensationMessage}</div>
          <button id="pack-confirm-reveal-btn" class="mt-4 sm:mt-6 px-6 sm:px-8 py-2 sm:py-3 bg-green-600 text-white font-semibold rounded-lg hover:bg-green-700 transition-colors hidden w-full max-w-xs mx-auto text-sm sm:text-base">Confirmar</button>
        </div>
      `;
      
      document.body.appendChild(modal);
      
      // Ejecutar secuencia de revelación exactamente como en packs
      runPackRevealSequence(card, modal, onClose);
    }
    
    // Secuencia de revelación idéntica a la de packs
    async function runPackRevealSequence(card, modal, onClose) {
      return new Promise((resolve) => {
        const posEl = modal.querySelector('#pack-reveal-pos');
        const ratingEl = modal.querySelector('#pack-reveal-rating');
        const zoom = modal.querySelector('#pack-card-zoom');
        const confirmBtn = modal.querySelector('#pack-confirm-reveal-btn');
        const loadingEl = modal.querySelector('#pack-loading-indicator');
        
        if (loadingEl) loadingEl.classList.add('hidden');
        
        if (posEl) {
          posEl.textContent = translatePosition(card?.player?.position1);
          setTimeout(() => posEl.classList.remove('opacity-0'), 150);
          setTimeout(() => posEl.classList.add('opacity-0'), 1000);
        }
        if (ratingEl) {
          setTimeout(() => { 
            ratingEl.textContent = String(card?.player?.fifa_rating || ''); 
            ratingEl.classList.remove('opacity-0'); 
          }, 1300);
          setTimeout(() => ratingEl.classList.add('opacity-0'), 2300);
        }
        
        setTimeout(() => {
          if (zoom) {
            const el = createCardElement(card);
            el.classList.add('mx-auto', 'w-full', 'max-w-xs', 'sm:max-w-sm');
            zoom.appendChild(el);
            zoom.classList.remove('opacity-0');
            zoom.classList.remove('scale-50');
          }
          
          // Mostrar mensaje de compensación si existe
          const compensationEl = modal.querySelector('#pack-compensation-message');
          if (compensationEl) compensationEl.classList.remove('hidden');
          
          if (confirmBtn) confirmBtn.classList.remove('hidden');
        }, 2600);
        
        if (confirmBtn) {
          const handler = async (e) => {
            e.preventDefault();
            confirmBtn.removeEventListener('click', handler);
            document.body.removeChild(modal);
            if (onClose) onClose();
            resolve(true);
          };
          confirmBtn.addEventListener('click', handler);
        } else {
          // Fallback auto-resolve after 5s
          setTimeout(async () => { 
            document.body.removeChild(modal);
            if (onClose) onClose();
            resolve(true); 
          }, 5000);
        }
      });
    }
    
    // Helper para crear elemento de carta
    function createCardElement(card) {
      const displayRarity = getDisplayRarity(card.special_type || 'Regular');
      const rarityColor = getRarityColor(displayRarity);
      
      const cardDiv = document.createElement('div');
      cardDiv.className = `bg-gradient-to-br ${rarityColor} rounded-xl p-4 text-center transform w-full max-w-xs mx-auto`;
      
      const imgSrc = card.image_path || card.player?.image_url;
      const img = imgSrc ? `<img src="${imgSrc}" alt="${card.player?.name || 'card'}" class="w-full h-auto rounded-lg mb-3" />` : `
        <div class="w-16 h-16 bg-white/20 rounded-lg flex items-center justify-center mx-auto mb-3">
          <span class="text-2xl">⚽</span>
        </div>`;
      
      cardDiv.innerHTML = `
        ${img}
        <div class="text-white font-bold text-sm mb-1">${card.player?.name || 'Jugador'}</div>
        <div class="text-xs text-white/80 mb-2">${translatePosition(card.player?.position1) || ''} - ${displayRarity}</div>
        <div class="text-xs text-yellow-300 font-bold">${card.base_price || 0} 💰</div>
        <div class="text-xs text-white/90 mt-1">FIFA: ${card.player?.fifa_rating || ''}</div>
      `;
      
      return cardDiv;
    }
    
    function getDisplayRarity(specialType) {
      switch (specialType) {
        case 'Regular':
        case 'OLD_GENERATION':
          return 'NORMAL';
        case 'TEAM_OF_THE_WEEK':
          return 'ESPECIAL';
        case 'MARKET_MASTER':
        case 'RATING_RELOAD':
        case 'COMEBACK_HERO':
        case 'ASSIST_ENGINE':
          return 'ELITE';
        case 'PLAYER_OF_THE_MONTH':
          return 'LEGENDARIO';
        default:
          return 'NORMAL';
      }
    }
    
    function getRarityColor(displayRarity) {
      switch (displayRarity) {
        case 'NORMAL':
          return 'from-gray-400 to-gray-600';
        case 'ESPECIAL':
          return 'from-blue-500 to-blue-700';
        case 'ELITE':
          return 'from-purple-500 to-purple-700';
        case 'LEGENDARIO':
          return 'from-yellow-400 to-orange-500';
        default:
          return 'from-gray-400 to-gray-600';
      }
    }
    
    function translatePosition(pos) {
      const map = {
        GK: 'PORTERO', CB: 'DEFENSA', LB: 'LATERAL IZQ', RB: 'LATERAL DCH',
        CDM: 'MCD', CM: 'CENTROCAMPISTA', CAM: 'MCO',
        LM: 'MI', RM: 'MD', LW: 'EI', RW: 'ED', ST: 'DELANTERO'
      };
      return map[pos] || pos || '';
    }
    
    // Utilidades de modal
    function createModal(content) {
      const modal = document.createElement('div');
      modal.className = 'fixed inset-0 bg-black/80 flex items-center justify-center z-50 p-4';
      modal.innerHTML = `
        <div class="bg-gradient-to-br from-slate-800 to-slate-900 rounded-xl p-6 max-w-md w-full relative">
          ${content}
        </div>
      `;
      return modal;
    }
    
    function showModal(modal, onClose = null) {
      document.body.appendChild(modal);
      window.currentModal = modal;
      window.currentModalOnClose = onClose;
    }
    
    function closeModal() {
      if (window.currentModal) {
        document.body.removeChild(window.currentModal);
        window.currentModal = null;
        window.currentModalOnClose = null;
      }
    }
    
    function closeModalWithCallback() {
      if (window.currentModalOnClose) {
        window.currentModalOnClose();
      }
      closeModal();
    }
    
    // Hacer funciones globales
    window.closeModal = closeModal;
    window.closeModalWithCallback = closeModalWithCallback;
    
    function showNotification(message, type = 'info') {
      // Crear elemento de notificación
      const notification = document.createElement('div');
      notification.className = `fixed top-4 right-4 z-50 px-6 py-4 rounded-lg shadow-lg text-white font-medium transform translate-x-full transition-transform duration-300 ${
        type === 'success' ? 'bg-green-600' : 
        type === 'error' ? 'bg-red-600' : 
        'bg-blue-600'
      }`;
      notification.textContent = message;
      
      document.body.appendChild(notification);
      
      // Animar entrada
      setTimeout(() => {
        notification.classList.remove('translate-x-full');
      }, 100);
      
      // Auto remover después de 3 segundos
      setTimeout(() => {
        notification.classList.add('translate-x-full');
        setTimeout(() => {
          if (notification.parentNode) {
            notification.parentNode.removeChild(notification);
          }
        }, 300);
      }, 3000);
    }

    async function start() {
      if (!requireAuth()) return;
      const grid = document.getElementById('achv-grid');
      if (!grid) return;
      try {
        const data = await fetchAchievements();
        if (data && data.success) render(data.achievements || []);
      } catch {}
    }

    const kickoff = () => start();
    document.addEventListener('DOMContentLoaded', kickoff);
    document.addEventListener('astro:page-load', kickoff);
    document.addEventListener('astro:after-swap', kickoff);
    document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'visible') kickoff(); });
    window.addEventListener('pageshow', kickoff);
    setTimeout(kickoff, 0);
  </script>
</NikeFCLayout>

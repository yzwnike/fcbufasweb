---
import NikeFCLayout from '@/layouts/NikeFCLayout.astro';
import Subheader from '@/components/bufas-cards/Subheader.astro';
---

<NikeFCLayout title="Sobres - Bufas Cards" helpKey="packs">
  <div class="min-h-screen bg-gradient-to-br from-green-900 via-green-800 to-teal-900">
    <div class="container mx-auto px-4 py-6">
      <!-- Subheader Nav -->
      <Subheader variant="minimal" />
      <!-- Header -->
      <div class="text-center mb-6">
        <h1 class="text-2xl md:text-4xl font-bold text-white mb-2">
          📦 Sobres de Cartas
        </h1>
        <p class="text-sm md:text-base text-green-100 max-w-2xl mx-auto">
          Abre sobres para conseguir nuevas cartas de jugadores. 
          ¡Colecciona todas las rarezas!
        </p>
      </div>

      <!-- Auth Check -->
      <div id="not-logged-in" class="hidden text-center">
        <div class="bg-red-500/20 backdrop-blur-md rounded-xl p-8 max-w-md mx-auto">
          <h3 class="text-2xl font-bold text-white mb-4">Acceso Requerido</h3>
          <p class="text-red-200 mb-6">Debes iniciar sesión para abrir sobres</p>
          <a href="/bufas-cards" class="px-6 py-3 bg-white text-red-900 font-semibold rounded-lg hover:bg-red-100 transition-colors">
            Iniciar Sesión
          </a>
        </div>
      </div>

      <!-- Pack Selection -->
      <div id="pack-selection" class="hidden">
        <!-- User Stats -->
        <div class="bg-white/10 backdrop-blur-md rounded-xl p-4 mb-4 max-w-md mx-auto">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-green-100 text-sm">Usuario:</p>
              <p id="username" class="text-lg font-bold text-white">Loading...</p>
            </div>
            <div class="text-right">
              <p class="text-green-100 text-sm">Monedas</p>
              <p id="user-coins" class="text-lg font-bold text-yellow-400">0</p>
            </div>
          </div>
        </div>

        <!-- Pack Types -->
        <div class="space-y-3 max-w-4xl mx-auto">
          <!-- Free Pack -->
          <div class="bg-white/10 backdrop-blur-md rounded-xl p-3 flex items-center gap-4 relative">
            <div class="w-16 h-16 bg-gradient-to-br from-green-400 to-green-600 rounded-lg flex items-center justify-center flex-shrink-0">
              <span class="text-2xl">🆓</span>
            </div>
            <div class="flex-1">
              <div class="flex items-center justify-between mb-1">
                <h3 class="text-base font-bold text-white">Sobre Gratuito</h3>
                <button class="pack-info-btn px-3 py-1 bg-blue-500 text-white text-xs font-bold rounded-lg hover:bg-blue-600 transition-all flex items-center gap-1" data-pack="free">
                  INFO
                  <span class="pack-info-arrow transition-transform duration-200" data-pack="free">↓</span>
                </button>
              </div>
              <p class="text-yellow-400 font-bold text-sm mb-2">GRATIS</p>
              
              <!-- Hidden Info Panel -->
              <div id="free-pack-info" class="pack-info-panel hidden bg-black/90 backdrop-blur-md rounded-lg p-2 text-xs mb-2 z-10">
                <p class="text-green-200">• 1 carta aleatoria</p>
                <p class="text-green-200">• Cada 24 horas</p>
                <p class="text-green-200">• 85% Normal, 12% Especial, 3% Legendaria</p>
              </div>
              
              <div id="free-pack-timer" class="mb-2 hidden">
                <p class="text-yellow-300 font-semibold text-xs">Próximo:</p>
                <div class="text-sm font-bold text-white">
                  <span id="hours">12</span>h <span id="minutes">34</span>m
                </div>
                <div class="mt-1">
                  <p class="text-xs text-green-200">Acelerar:</p>
                  <p class="text-sm font-bold text-yellow-400"><span id="speedup-cost">120</span> monedas</p>
                </div>
              </div>

              <div class="flex gap-2">
                <button id="free-pack-btn" class="flex-1 py-2 text-sm bg-green-500 text-white font-semibold rounded-lg hover:bg-green-600 transition-colors disabled:bg-gray-500">
                  Abrir Gratis
                </button>
                <button id="speedup-btn" class="flex-1 py-2 text-sm bg-yellow-500 text-white font-semibold rounded-lg hover:bg-yellow-600 transition-colors hidden">
                  Acelerar
                </button>
              </div>
            </div>
          </div>

          <!-- Premium Pack -->
          <div class="bg-white/10 backdrop-blur-md rounded-xl p-3 flex items-center gap-4 relative">
            <div class="w-16 h-16 bg-gradient-to-br from-blue-400 to-blue-600 rounded-lg flex items-center justify-center flex-shrink-0">
              <span class="text-2xl">💎</span>
            </div>
            <div class="flex-1">
              <div class="flex items-center justify-between mb-1">
                <h3 class="text-base font-bold text-white">Sobre Premium</h3>
                <button class="pack-info-btn px-3 py-1 bg-blue-500 text-white text-xs font-bold rounded-lg hover:bg-blue-600 transition-all flex items-center gap-1" data-pack="premium">
                  INFO
                  <span class="pack-info-arrow transition-transform duration-200" data-pack="premium">↓</span>
                </button>
              </div>
              <p class="text-yellow-400 font-bold text-sm mb-2">600 monedas</p>
              
              <!-- Hidden Info Panel -->
              <div id="premium-pack-info" class="pack-info-panel hidden bg-black/90 backdrop-blur-md rounded-lg p-2 text-xs mb-2 z-10">
                <p class="text-green-200">• 1 carta</p>
                <p class="text-green-200">• 60% Normal, 30% Especial, 10% Legendaria</p>
              </div>
              
              <button id="premium-pack-btn" class="w-full py-2 text-sm bg-blue-500 text-white font-semibold rounded-lg hover:bg-blue-600 transition-colors">
                Comprar Premium
              </button>
            </div>
          </div>

          <!-- Special Pack -->
          <div class="bg-white/10 backdrop-blur-md rounded-xl p-3 flex items-center gap-4 relative">
            <div class="w-16 h-16 bg-gradient-to-br from-purple-400 to-purple-600 rounded-lg flex items-center justify-center flex-shrink-0">
              <span class="text-2xl">✨</span>
            </div>
            <div class="flex-1">
              <div class="flex items-center justify-between mb-1">
                <h3 class="text-base font-bold text-white">Sobre Especial</h3>
                <button class="pack-info-btn px-3 py-1 bg-blue-500 text-white text-xs font-bold rounded-lg hover:bg-blue-600 transition-all flex items-center gap-1" data-pack="special">
                  INFO
                  <span class="pack-info-arrow transition-transform duration-200" data-pack="special">↓</span>
                </button>
              </div>
              <p class="text-yellow-400 font-bold text-sm mb-2">1500 monedas</p>
              
              <!-- Hidden Info Panel -->
              <div id="special-pack-info" class="pack-info-panel hidden bg-gradient-to-r from-slate-800/95 to-slate-900/95 backdrop-blur-md rounded-lg p-3 text-xs mb-3 shadow-xl border border-slate-600/30">
                <div class="space-y-1">
                  <p class="text-purple-300 flex items-center gap-2"><span class="text-purple-400">•</span> 1 carta garantizada</p>
                  <p class="text-purple-300 flex items-center gap-2"><span class="text-purple-400">•</span> 70% Especial, 30% Legendaria</p>
                </div>
              </div>
              
              <button id="special-pack-btn" class="w-full py-2 text-sm bg-purple-500 text-white font-semibold rounded-lg hover:bg-purple-600 transition-colors">
                Comprar Especial
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Pack Opening Fullscreen Overlay -->
      <div id="pack-opening" class="hidden fixed inset-0 bg-black/95 text-white flex items-center justify-center z-50 p-4 overflow-y-auto">
        <div id="reveal-sequence" class="text-center w-full max-w-lg mx-auto px-4 my-auto">
          <div id="loading-indicator" class="mt-6 text-green-300 text-lg sm:text-xl animate-pulse">Abriendo sobre…</div>
          <div id="reveal-pos" class="text-lg sm:text-xl md:text-2xl lg:text-2xl xl:text-3xl font-extrabold opacity-0 transition-opacity duration-500 text-center w-full px-2 py-4 break-words"></div>
          <div id="reveal-rating" class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl xl:text-7xl text-yellow-400 font-extrabold mt-2 sm:mt-4 opacity-0 transition-opacity duration-500 text-center w-full"></div>
          <div id="card-zoom" class="mt-4 sm:mt-6 md:mt-8 opacity-0 transform scale-50 transition-all duration-700 w-full flex justify-center"></div>
          <button id="confirm-reveal-btn" class="mt-4 sm:mt-6 px-6 sm:px-8 py-2 sm:py-3 bg-green-600 text-white font-semibold rounded-lg hover:bg-green-700 transition-colors hidden w-full max-w-xs mx-auto text-sm sm:text-base">Confirmar</button>
        </div>
      </div>

      <!-- Cards Revealed (legacy, no longer used for paid packs) -->
      <div id="cards-revealed" class="hidden">
        <div class="text-center mb-8">
          <h2 class="text-4xl font-bold text-white mb-4">¡Cartas Obtenidas!</h2>
          <div class="text-2xl text-yellow-400 font-bold" id="cards-value">Valor total: 0 monedas</div>
        </div>

        <!-- Cards Grid -->
        <div id="revealed-cards" class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 gap-6 max-w-6xl mx-auto mb-8">
          <!-- Las cartas aparecerán aquí -->
        </div>

        <div class="text-center">
          <button id="continue-btn" class="px-8 py-3 bg-green-500 text-white font-semibold rounded-lg hover:bg-green-600 transition-colors mr-4">
            Abrir Otro Sobre
          </button>
          <a href="/bufas-cards/collection" class="px-8 py-3 bg-blue-500 text-white font-semibold rounded-lg hover:bg-blue-600 transition-colors">
            Ver Colección
          </a>
        </div>
      </div>

      <!-- Confirm Purchase Modal -->
      <div id="confirm-modal" class="fixed inset-0 bg-black/60 hidden items-center justify-center z-50 p-4">
        <div class="bg-white rounded-xl p-4 sm:p-6 max-w-sm w-full mx-auto text-gray-900">
          <h3 id="confirm-title" class="text-lg sm:text-2xl font-bold mb-2">Confirmar compra</h3>
          <p id="confirm-message" class="mb-4 sm:mb-6 text-sm sm:text-base">¿Quieres comprar este sobre?</p>
          <div class="flex gap-3">
            <button id="confirm-yes" class="flex-1 py-2 sm:py-3 text-sm sm:text-base bg-green-600 text-white rounded-lg hover:bg-green-700 font-semibold">Confirmar</button>
            <button id="confirm-no" class="flex-1 py-2 sm:py-3 text-sm sm:text-base bg-gray-300 text-gray-800 rounded-lg hover:bg-gray-400 font-semibold">Cancelar</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Helpers
    function translatePosition(pos) {
      const map = {
        GK: 'PORTERO', CB: 'DEFENSA', LB: 'LATERAL IZQ', RB: 'LATERAL DCH',
        CDM: 'MCD', CM: 'CENTROCAMPISTA', CAM: 'MCO',
        LM: 'MI', RM: 'MD', LW: 'EI', RW: 'ED', ST: 'DELANTERO'
      };
      return map[pos] || pos || '';
    }

    // State management
    let currentUser = null;
    let authToken = null;
    let freePackTimer = null;
    const storage = window.sessionStorage;

    // Auth functions
    function checkAuthState() {
      const token = storage.getItem('nike_fc_token');
      if (token) {
        authToken = token;
        return true;
      }
      return false;
    }

    async function fetchMe() {
      try {
        const res = await fetch('/api/bufas-cards/auth/me', { headers: { Authorization: `Bearer ${authToken}` } });
        const data = await res.json();
        if (data.success) currentUser = data.user;
      } catch {}
    }

    async function updateUserDisplay() {
      await fetchMe();
      if (currentUser) {
        document.getElementById('username').textContent = currentUser.username;
        document.getElementById('user-coins').textContent = currentUser.coins;
        updatePackButtons();
      }
    }

    function updatePackButtons() {
      const premiumBtn = document.getElementById('premium-pack-btn');
      const specialBtn = document.getElementById('special-pack-btn');
      
      if (premiumBtn) {
        if (currentUser.coins >= 600) {
          premiumBtn.disabled = false;
          premiumBtn.textContent = 'Comprar Premium';
        } else {
          premiumBtn.disabled = true;
          premiumBtn.textContent = 'Sin monedas suficientes';
        }
      }
      
      if (specialBtn) {
        if (currentUser.coins >= 1500) {
          specialBtn.disabled = false;
          specialBtn.textContent = 'Comprar Especial';
        } else {
          specialBtn.disabled = true;
          specialBtn.textContent = 'Sin monedas suficientes';
        }
      }
    }

    // UI functions
    function showSection(sectionId) {
      const sections = ['not-logged-in', 'pack-selection', 'pack-opening', 'cards-revealed'];
      sections.forEach(id => {
        const element = document.getElementById(id);
        if (element) {
          element.classList.toggle('hidden', id !== sectionId);
        }
      });
    }

    // Helper to avoid duplicate listeners across SPA transitions
    function bindOnce(el, event, handler) {
      if (!el) return;
      const key = `__bound_${event}`;
      if (el[key]) return;
      el.addEventListener(event, handler);
      el[key] = true;
    }

    // API calls
    async function fetchPackStatus() {
      try {
        const response = await fetch('/api/bufas-cards/packs/status', {
          headers: { 'Authorization': `Bearer ${authToken}` }
        });
        if (!response.ok) {
          // Intentar leer JSON, si no, texto plano
          try {
            const err = await response.json();
            return { success: false, error: err.error || `HTTP ${response.status}` };
          } catch {
            const txt = await response.text();
            return { success: false, error: txt || `HTTP ${response.status}` };
          }
        }
        return await response.json();
      } catch (error) {
        console.error('Error fetching pack status:', error);
        return { success: false, error: 'Error de conexión' };
      }
    }

    async function claimFreePack(speedup = false) {
      try {
        const response = await fetch('/api/bufas-cards/packs/free', {
          method: 'POST',
          headers: { 
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${authToken}` 
          },
          body: JSON.stringify({ speedup })
        });
        if (!response.ok) {
          try {
            const err = await response.json();
            return { success: false, error: err.error || `HTTP ${response.status}` };
          } catch {
            const txt = await response.text();
            return { success: false, error: txt || `HTTP ${response.status}` };
          }
        }
        return await response.json();
      } catch (error) {
        console.error('Error claiming free pack:', error);
        return { success: false, error: 'Error de conexión' };
      }
    }

    async function buyPack(packType) {
      try {
        const response = await fetch('/api/bufas-cards/packs/buy', {
          method: 'POST',
          headers: { 
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${authToken}` 
          },
          body: JSON.stringify({ packType })
        });
        if (!response.ok) {
          try {
            const err = await response.json();
            return { success: false, error: err.error || `HTTP ${response.status}` };
          } catch {
            const txt = await response.text();
            return { success: false, error: txt || `HTTP ${response.status}` };
          }
        }
        return await response.json();
      } catch (error) {
        console.error('Error buying pack:', error);
        return { success: false, error: 'Error de conexión' };
      }
    }

    function updatePackStatus(status) {
      if (status.freePackStatus.canClaim) {
        document.getElementById('free-pack-timer').classList.add('hidden');
        document.getElementById('speedup-btn').classList.add('hidden');
        
        const freeBtn = document.getElementById('free-pack-btn');
        freeBtn.disabled = false;
        freeBtn.textContent = 'Abrir Gratis';
      } else {
        document.getElementById('free-pack-timer').classList.remove('hidden');
        document.getElementById('hours').textContent = status.freePackStatus.hoursRemaining;
        document.getElementById('minutes').textContent = status.freePackStatus.minutesRemaining;
        document.getElementById('speedup-cost').textContent = status.freePackStatus.speedupCost;
        document.getElementById('speedup-btn').classList.remove('hidden');
        
        const freeBtn = document.getElementById('free-pack-btn');
        freeBtn.disabled = true;
        freeBtn.textContent = 'No Disponible';
      }
    }
    
    // Helper function to refresh pack status
    async function refreshPackStatus() {
      const statusResult = await fetchPackStatus();
      if (statusResult.success) {
        updatePackStatus(statusResult);
        
        // Set up auto-refresh if pack is in cooldown
        if (!statusResult.freePackStatus.canClaim) {
          setupAutoRefresh();
        } else {
          clearAutoRefresh();
        }
      }
    }
    
    let autoRefreshInterval = null;
    
    function setupAutoRefresh() {
      // Clear any existing interval
      if (autoRefreshInterval) {
        clearInterval(autoRefreshInterval);
      }
      
      // Refresh every 30 seconds to update countdown
      autoRefreshInterval = setInterval(async () => {
        const statusResult = await fetchPackStatus();
        if (statusResult && statusResult.success) {
          updatePackStatus(statusResult);
          
          // If pack becomes available, stop auto-refresh
          if (statusResult.freePackStatus.canClaim) {
            clearAutoRefresh();
          }
        }
      }, 30000); // 30 seconds
    }
    
    function clearAutoRefresh() {
      if (autoRefreshInterval) {
        clearInterval(autoRefreshInterval);
        autoRefreshInterval = null;
      }
    }

    let pendingPackType = null;
    let lastRevealedCard = null;

    function openConfirm(packType) {
      pendingPackType = packType;
      const modal = document.getElementById('confirm-modal');
      const title = document.getElementById('confirm-title');
      const msg = document.getElementById('confirm-message');
      const price = packType === 'premium' ? 600 : 1500;
      if (title) title.textContent = 'Confirmar compra';
      if (msg) msg.textContent = `¿Quieres comprar el sobre ${packType === 'premium' ? 'Premium' : 'Especial'} por ${price} monedas?`;
      if (modal) { modal.classList.remove('hidden'); modal.classList.add('flex'); }
    }
    function closeConfirm() {
      const modal = document.getElementById('confirm-modal');
      if (modal) { modal.classList.add('hidden'); modal.classList.remove('flex'); }
      pendingPackType = null;
    }

    async function openPack(packType) {
      try {
        showSection('pack-opening');
        // Reset overlay elements
        const posEl = document.getElementById('reveal-pos');
        const ratingEl = document.getElementById('reveal-rating');
        const zoom = document.getElementById('card-zoom');
        const confirmBtn = document.getElementById('confirm-reveal-btn');
        const loadingEl = document.getElementById('loading-indicator');
        if (posEl) posEl.classList.add('opacity-0');
        if (ratingEl) ratingEl.classList.add('opacity-0');
        if (zoom) { zoom.classList.add('opacity-0','scale-50'); zoom.innerHTML=''; }
        if (confirmBtn) confirmBtn.classList.add('hidden');
        if (loadingEl) loadingEl.classList.remove('hidden');

        // Execute API call first
        let result;
        if (packType === 'free') result = await claimFreePack(false);
        else if (packType === 'speedup') result = await claimFreePack(true);
        else result = await buyPack(packType);

        if (!result || !result.success || !result.cards || result.cards.length === 0) {
          const msg = result?.error || 'Error desconocido';
          if (loadingEl) loadingEl.classList.add('hidden');
          alert('Error al abrir sobre: ' + msg);
          showSection('pack-selection');
          return;
        }

        lastRevealedCard = result.cards[0];
        if (loadingEl) loadingEl.classList.add('hidden');
        await updateUserDisplay();
        
        // Refresh pack status if it was a free pack or speedup
        if (packType === 'free' || packType === 'speedup') {
          await refreshPackStatus();
        }
        
        await runRevealSequence(lastRevealedCard);
      } catch (e) {
        const loadingEl = document.getElementById('loading-indicator');
        if (loadingEl) loadingEl.classList.add('hidden');
        console.error('openPack fatal error', e);
        alert('Error al abrir sobre');
        showSection('pack-selection');
      }
    }

    async function runRevealSequence(card) {
      return new Promise((resolve) => {
        const posEl = document.getElementById('reveal-pos');
        const ratingEl = document.getElementById('reveal-rating');
        const zoom = document.getElementById('card-zoom');
        const confirmBtn = document.getElementById('confirm-reveal-btn');
        const loadingEl = document.getElementById('loading-indicator');

        if (loadingEl) loadingEl.classList.add('hidden');

        if (posEl) {
          posEl.textContent = translatePosition(card?.player?.position1);
          setTimeout(()=>posEl.classList.remove('opacity-0'), 150);
          setTimeout(()=>posEl.classList.add('opacity-0'), 1000);
        }
        if (ratingEl) {
          setTimeout(()=>{ ratingEl.textContent = String(card?.player?.fifa_rating || ''); ratingEl.classList.remove('opacity-0'); }, 1300);
          setTimeout(()=>ratingEl.classList.add('opacity-0'), 2300);
        }

        setTimeout(()=>{
          if (zoom) {
            const el = createCardElement(card);
            el.classList.add('mx-auto', 'w-full', 'max-w-xs', 'sm:max-w-sm');
            zoom.appendChild(el);
            zoom.classList.remove('opacity-0');
            zoom.classList.remove('scale-50');
          }
          if (confirmBtn) confirmBtn.classList.remove('hidden');
        }, 2600);

        if (confirmBtn) {
          const handler = async (e) => {
            e.preventDefault();
            confirmBtn.removeEventListener('click', handler);
            showSection('pack-selection');
            
            // Refresh pack status after opening free pack or speedup
            await refreshPackStatus();
            
            resolve(true);
          };
          confirmBtn.addEventListener('click', handler);
        } else {
          // Fallback auto-resolve after 5s
          setTimeout(async ()=>{ 
            showSection('pack-selection');
            
            // Refresh pack status after opening free pack or speedup
            await refreshPackStatus();
            
            resolve(true); 
          }, 5000);
        }
      });
    }

    async function processPackOpening(packType) {
      let result;
      
      if (packType === 'free') {
        result = await claimFreePack(false);
      } else if (packType === 'speedup') {
        result = await claimFreePack(true);
      } else {
        result = await buyPack(packType);
      }
      
      if (!result || !result.success) {
        const msg = result?.error || 'Error desconocido';
        console.error('Pack open failed:', msg);
        alert('Error al abrir sobre: ' + msg);
        showSection('pack-selection');
        return;
      }
      
      // Refresh user after purchase/speedup
      await updateUserDisplay();
      revealCards(result.cards || []);
    }

    function revealCards(cards) {
      const cardsContainer = document.getElementById('revealed-cards');
      cardsContainer.innerHTML = '';
      
      if (!cards || cards.length === 0) {
        alert('No hay cartas disponibles en este momento. Inténtalo de nuevo.');
        showSection('pack-selection');
        return;
      }
      
      let totalValue = 0;
      
      cards.forEach((card, index) => {
        setTimeout(() => {
          const wrapper = document.createElement('div');
          wrapper.className = 'relative rounded-xl overflow-hidden bg-black/30 backdrop-blur-sm p-2';

          // Overlay animation container
          const overlay = document.createElement('div');
          overlay.className = 'absolute inset-0 flex flex-col items-center justify-center bg-black/80 text-white transition-opacity duration-500';

          const posEl = document.createElement('div');
          posEl.className = 'text-5xl font-extrabold opacity-0 transition-opacity duration-300';
          posEl.textContent = card.player.position1;

          const ratingEl = document.createElement('div');
          ratingEl.className = 'text-6xl font-extrabold text-yellow-400 mt-2 opacity-0 transition-opacity duration-300';
          ratingEl.textContent = card.player.fifa_rating;

          overlay.appendChild(posEl);
          overlay.appendChild(ratingEl);

          const cardElement = createCardElement(card);
          cardElement.classList.add('opacity-0','transition-opacity','duration-500');

          wrapper.appendChild(cardElement);
          wrapper.appendChild(overlay);
          cardsContainer.appendChild(wrapper);

          // Sequence: fade in overlay, show pos, show rating, then reveal card
          setTimeout(()=>{ overlay.classList.remove('opacity-0'); overlay.classList.add('opacity-100'); }, 50);
          setTimeout(()=>{ posEl.classList.add('opacity-100'); }, 250);
          setTimeout(()=>{ ratingEl.classList.add('opacity-100'); }, 650);
          setTimeout(()=>{ overlay.classList.add('opacity-0'); cardElement.classList.remove('opacity-0'); }, 1100);

          totalValue += card.base_price;
          if (index === cards.length - 1) {
            setTimeout(()=>{
              document.getElementById('cards-value').textContent = `Valor total: ${totalValue} monedas`;
              updateUserDisplay();
            }, 1200);
          }
        }, index * 600);
      });
      
      showSection('cards-revealed');
    }

    function generateMockCards(numCards, packType) {
      const players = [
        'Nico Vehi', 'Pablo Vehi', 'Albert Rodriguez', 'Marc Sanchez', 
        'Mario Roca', 'Marcos Lopez', 'Nico Uriburu', 'Javo Ayesta',
        'Marc Permanyer', 'Fan Xu'
      ];
      
      const rarities = ['Bronze', 'Silver', 'Gold', 'Elite', 'Legend'];
      const rarityColors = {
        Bronze: 'from-amber-600 to-amber-800',
        Silver: 'from-gray-400 to-gray-600',
        Gold: 'from-yellow-400 to-yellow-600',
        Elite: 'from-purple-500 to-purple-700',
        Legend: 'from-pink-500 to-pink-700'
      };
      
      const rarityValues = {
        Bronze: 50,
        Silver: 100,
        Gold: 250,
        Elite: 500,
        Legend: 1000
      };

      const cards = [];
      
      for (let i = 0; i < numCards; i++) {
        let rarity;
        
        if (packType === 'special' && i === 0) {
          // Garantizar Elite o Legend en sobre especial
          rarity = Math.random() > 0.5 ? 'Elite' : 'Legend';
        } else {
          // Probabilidades normales
          const rand = Math.random();
          if (rand < 0.5) rarity = 'Bronze';
          else if (rand < 0.75) rarity = 'Silver';
          else if (rand < 0.9) rarity = 'Gold';
          else if (rand < 0.98) rarity = 'Elite';
          else rarity = 'Legend';
        }
        
        const player = players[Math.floor(Math.random() * players.length)];
        
        cards.push({
          player,
          rarity,
          color: rarityColors[rarity],
          value: rarityValues[rarity] + Math.floor(Math.random() * 50)
        });
      }
      
      return cards;
    }

    function createCardElement(card) {
      // Función helper para obtener rareza de UI
      function getDisplayRarity(specialType) {
        switch (specialType) {
          case 'Regular':
          case 'OLD_GENERATION':
            return 'NORMAL';
          case 'TEAM_OF_THE_WEEK':
            return 'ESPECIAL';
          case 'MARKET_MASTER':
          case 'RATING_RELOAD':
          case 'COMEBACK_HERO':
          case 'ASSIST_ENGINE':
            return 'ELITE';
          case 'PLAYER_OF_THE_MONTH':
            return 'LEGENDARIO';
          default:
            return 'NORMAL';
        }
      }
      
      function getRarityColor(displayRarity) {
        switch (displayRarity) {
          case 'NORMAL':
            return 'from-gray-400 to-gray-600';
          case 'ESPECIAL':
            return 'from-blue-500 to-blue-700';
          case 'ELITE':
            return 'from-purple-500 to-purple-700';
          case 'LEGENDARIO':
            return 'from-yellow-400 to-orange-500';
          default:
            return 'from-gray-400 to-gray-600';
        }
      }
      
      const displayRarity = getDisplayRarity(card.special_type || 'Regular');
      const rarityColor = getRarityColor(displayRarity);
      
      const cardDiv = document.createElement('div');
      cardDiv.className = `bg-gradient-to-br ${rarityColor} rounded-xl p-3 sm:p-4 text-center transform hover:scale-105 transition-transform w-full`;
      const imgSrc = card.image_path || card.card_image_path || card.player?.image_url;
      const img = imgSrc ? `<img src="${imgSrc}" alt="${card.player?.name || 'card'}" class="w-full h-auto rounded-lg mb-2 sm:mb-3" />` : `
        <div class="w-12 h-12 sm:w-16 sm:h-16 bg-white/20 rounded-lg flex items-center justify-center mx-auto mb-2 sm:mb-3">
          <span class="text-xl sm:text-2xl">⚽</span>
        </div>`;
      
      cardDiv.innerHTML = `
        ${img}
        <div class="text-white font-bold text-xs sm:text-sm mb-1">${card.player?.name || 'Jugador'}</div>
        <div class="text-xs text-white/80 mb-1 sm:mb-2">${translatePosition(card.player?.position1) || ''} - ${displayRarity}</div>
        <div class="text-xs text-yellow-300 font-bold">${card.base_price || 0} 💰</div>
        <div class="text-xs text-white/90 mt-1">FIFA: ${card.player?.fifa_rating || ''}</div>
      `;
      return cardDiv;
    }

    // Initialization function to support SPA navigations
    async function startPacksPage() {
      if (!checkAuthState()) {
        showSection('not-logged-in');
        return;
      }
      
      showSection('pack-selection');
      await updateUserDisplay();

      // Load pack status
      await refreshPackStatus();

      // Pack buttons (bind once to avoid duplicates)
      bindOnce(document.getElementById('free-pack-btn'), 'click', (e) => {
        e.preventDefault();
        try {
          const btn = document.getElementById('free-pack-btn');
          if (btn && !btn.disabled) openPack('free');
        } catch (err) { console.error('free pack error', err); }
      });

      bindOnce(document.getElementById('speedup-btn'), 'click', (e) => {
        e.preventDefault();
        try {
          const cost = parseInt(document.getElementById('speedup-cost').textContent);
          if ((currentUser?.coins || 0) >= cost) {
            openPack('speedup');
          } else {
            alert('No tienes suficientes monedas para acelerar');
          }
        } catch (err) { console.error('speedup error', err); }
      });

      bindOnce(document.getElementById('premium-pack-btn'), 'click', async (e) => {
        e.preventDefault();
        try { openConfirm('premium'); } catch (err) { console.error('premium confirm error', err); }
      });

      bindOnce(document.getElementById('special-pack-btn'), 'click', async (e) => {
        e.preventDefault();
        try { openConfirm('special'); } catch (err) { console.error('special confirm error', err); }
      });

      // Confirm modal buttons
      bindOnce(document.getElementById('confirm-yes'), 'click', async (e) => {
        e.preventDefault();
        const type = pendingPackType;
        closeConfirm();
        if (type) {
          await openPack(type);
          // refresh status after opening (especially for premium/special packs)
          await refreshPackStatus();
        }
      });
      bindOnce(document.getElementById('confirm-no'), 'click', (e) => {
        e.preventDefault();
        closeConfirm();
      });

      // Legacy continue button (free packs UI)
      bindOnce(document.getElementById('continue-btn'), 'click', async (e) => {
        e.preventDefault();
        showSection('pack-selection');
        updateUserDisplay();
        await refreshPackStatus();
      });

      // Pack info buttons
      document.querySelectorAll('.pack-info-btn').forEach(btn => {
        bindOnce(btn, 'click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          const packType = btn.dataset.pack;
          const infoPanel = document.getElementById(`${packType}-pack-info`);
          const arrow = btn.querySelector('.pack-info-arrow');
          
          // Cerrar otros paneles y resetear sus flechas
          document.querySelectorAll('.pack-info-panel').forEach(panel => {
            if (panel !== infoPanel) {
              panel.classList.add('hidden');
            }
          });
          document.querySelectorAll('.pack-info-arrow').forEach(arr => {
            if (arr !== arrow) {
              arr.textContent = '↓';
              arr.style.transform = 'rotate(0deg)';
            }
          });
          
          // Toggle panel actual y flecha
          const isHidden = infoPanel.classList.contains('hidden');
          infoPanel.classList.toggle('hidden');
          
          if (isHidden) {
            // Abriendo panel - flecha hacia arriba
            arrow.textContent = '↑';
          } else {
            // Cerrando panel - flecha hacia abajo
            arrow.textContent = '↓';
          }
        });
      });

      // Close info panels when clicking outside
      document.addEventListener('click', (e) => {
        if (!e.target.closest('.pack-info-btn') && !e.target.closest('.pack-info-panel')) {
          document.querySelectorAll('.pack-info-panel').forEach(panel => {
            panel.classList.add('hidden');
          });
          // Resetear todas las flechas
          document.querySelectorAll('.pack-info-arrow').forEach(arrow => {
            arrow.textContent = '↓';
            arrow.style.transform = 'rotate(0deg)';
          });
        }
      });
    }

    // Event listeners for initial load and Astro transitions
    document.addEventListener('DOMContentLoaded', startPacksPage);
    document.addEventListener('astro:page-load', startPacksPage);
    document.addEventListener('astro:after-swap', startPacksPage);
    
    // Clean up intervals on page unload
    window.addEventListener('beforeunload', clearAutoRefresh);
    document.addEventListener('astro:before-swap', clearAutoRefresh);

    // Debug helpers (temporales)
    window.__packsDebug = {
      get token() { return authToken; },
      async testBuy(type='premium') {
        return await buyPack(type);
      }
    };
  </script>
</NikeFCLayout>

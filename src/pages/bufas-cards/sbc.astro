---
import NikeFCLayout from '@/layouts/NikeFCLayout.astro';
import Subheader from '@/components/bufas-cards/Subheader.astro';
---

<NikeFCLayout title="SBC - Desafíos de Creación de Plantillas - Bufas Cards" helpKey="sbc">
  <div class="min-h-screen bg-gradient-to-br from-emerald-900 via-emerald-800 to-teal-900">
    <div class="container mx-auto px-4 py-20">
      <Subheader variant="minimal" />

      <div class="text-center mb-10">
        <h1 class="text-4xl md:text-6xl font-bold text-white mb-2">SBC</h1>
        <p class="text-emerald-100">Completa desafíos mensuales creando plantillas y gana sobres o cartas</p>
      </div>

      <div id="not-logged-in" class="hidden text-center">
        <div class="bg-red-500/20 backdrop-blur-md rounded-xl p-8 max-w-md mx-auto">
          <h3 class="text-2xl font-bold text-white mb-4">Acceso Requerido</h3>
          <p class="text-red-200 mb-6">Debes iniciar sesión para acceder a los SBC</p>
          <a href="/bufas-cards" class="px-6 py-3 bg-white text-red-900 font-semibold rounded-lg hover:bg-red-100 transition-colors">Iniciar Sesión</a>
        </div>
      </div>

      <div id="sbc-container" class="hidden grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Challenges list -->
        <div id="challenges-sidebar" class="lg:col-span-1 bg-white/10 backdrop-blur-md rounded-xl p-6">
          <h3 class="text-xl font-bold text-white mb-4">SBCs de Tiempo Limitado</h3>
          <div id="challenges-list-limited" class="space-y-3 mb-6"></div>
          
          <h3 class="text-xl font-bold text-white mb-4">SBCs Ilimitados</h3>
          <div id="challenges-list-unlimited" class="space-y-3"></div>
        </div>

        <!-- Builder -->
        <div id="builder-container" class="lg:col-span-2 bg-white/10 backdrop-blur-md rounded-xl p-6">
          <div id="no-challenge" class="text-center text-emerald-100">Selecciona un desafío para comenzar</div>

          <div id="builder" class="hidden">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-4">
              <button id="back-to-list" class="text-emerald-200 hover:text-white transition-colors flex items-center gap-2 text-sm">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                </svg>
                Volver a SBCs
              </button>
            </div>
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-4">
              <div>
                <h3 class="text-2xl font-bold text-white" id="challenge-title-builder">-</h3>
                <p class="text-emerald-100" id="challenge-desc-builder">-</p>
              </div>
              <div class="text-right">
                <div class="text-emerald-100 text-sm">Requisitos</div>
                <div class="text-emerald-200 text-sm" id="challenge-req-builder">-</div>
              </div>
            </div>

            <!-- Checklist -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
              <div id="req-tile-count" class="rounded-lg p-4 bg-red-500/20">
                <div class="text-emerald-100 text-sm">Cartas Seleccionadas</div>
                <div class="text-2xl font-bold text-white"><span id="sel-count">0</span></div>
                <div class="text-emerald-300 text-xs" id="req-count">1-7</div>
              </div>
              <div id="req-tile-avg" class="rounded-lg p-4 bg-red-500/20">
                <div class="text-emerald-100 text-sm">Media de la Plantilla</div>
                <div class="text-2xl font-bold text-white"><span id="sel-avg">0</span></div>
                <div class="text-emerald-300 text-xs" id="req-avg">Mín 0</div>
              </div>
              <div id="req-tile-specials" class="rounded-lg p-4 bg-red-500/20">
                <div class="text-emerald-100 text-sm">Cartas Especiales</div>
                <div class="text-2xl font-bold text-white"><span id="sel-specials">0</span></div>
                <div class="text-emerald-300 text-xs" id="req-specials">Mín 0</div>
              </div>
            </div>

            <!-- Selected cards -->
            <div class="mb-6">
              <h4 class="text-white font-semibold mb-2">Plantilla</h4>
              <div id="selected-grid" class="grid grid-cols-3 sm:grid-cols-5 gap-3 min-h-[100px]"></div>
              <div id="slots-hint" class="text-emerald-200 text-xs mt-2"></div>
            </div>

            <!-- Collection picker -->
            <div>
              <h4 class="text-white font-semibold mb-2">Tu Colección</h4>
              <input id="collection-search" class="w-full mb-3 px-3 py-2 rounded bg-emerald-900/40 border border-emerald-700 text-white placeholder-emerald-300" placeholder="Buscar jugador..." />
              <div id="collection-grid" class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-5 gap-3 max-h-[360px] overflow-y-auto"></div>
            </div>

            <div class="mt-6 flex gap-3">
              <button id="validate-btn" class="px-5 py-3 bg-emerald-500 text-white rounded-lg hover:bg-emerald-600">Validar</button>
              <button id="submit-btn" class="px-5 py-3 bg-teal-500 text-white rounded-lg hover:bg-teal-600 disabled:opacity-50" disabled>Enviar</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    let authToken = null;
    let challenges = [];
    let selectedChallenge = null;
    let userCards = [];
    let selectedIds = new Set();
    let currentReq = { min_players: 1, max_players: 7, min_avg_rating: 0, min_special_cards: 0, required_players: [] };
    let lastValidation = null;
    let countdownIntervals = {};

    const storage = window.sessionStorage;
    function checkAuthState() { const t = storage.getItem('nike_fc_token'); if (t) { authToken=t; return true; } return false; }

    async function fetchChallenges() {
      const res = await fetch('/api/bufas-cards/sbc', { headers: { Authorization: 'Bearer ' + authToken } });
      return await res.json();
    }
    async function fetchCollection() {
      const res = await fetch('/api/bufas-cards/collection', { headers: { Authorization: 'Bearer ' + authToken } });
      return await res.json();
    }

    function showSection(id) {
      ['not-logged-in','sbc-container'].forEach(x=>document.getElementById(x).classList.toggle('hidden', x!==id));
    }

    function formatRequirements(req) {
      if (!req) return 'Sin requisitos';
      const parts = [];
      if (req.min_players || req.max_players) parts.push(`Jugadores: ${req.min_players||1}-${req.max_players||7}`);
      if (req.min_avg_rating) parts.push(`Media ≥ ${req.min_avg_rating}`);
      if (req.min_special_cards) parts.push(`Especiales ≥ ${req.min_special_cards}`);
      return parts.join(' | ') || 'Sin requisitos';
    }

    function renderChallenges() {
      const limitedList = document.getElementById('challenges-list-limited');
      const unlimitedList = document.getElementById('challenges-list-unlimited');
      limitedList.innerHTML = '';
      unlimitedList.innerHTML = '';
      
      const limited = challenges.filter(ch => !ch.repeatable);
      const unlimited = challenges.filter(ch => ch.repeatable);
      
      // SBCs LIMITADOS con acordeón
      limited.forEach((ch, idx) => {
        const container = document.createElement('div');
        container.className = 'bg-emerald-900/40 rounded-lg overflow-hidden relative';
        
        // Countdown en esquina superior derecha
        let countdownHTML = '';
        if (!ch.completed) {
          countdownHTML = `<div class="absolute top-2 right-2 text-xs bg-yellow-500/80 text-black px-2 py-1 rounded font-bold countdown-badge" data-end="${ch.end_at}">--:--:--</div>`;
        }
        
        // Header
        const header = document.createElement('button');
        header.className = 'w-full text-left p-4 hover:bg-emerald-800/50 text-white relative transition-all flex items-center gap-4 header-layout';
        
        let badge = '';
        if (ch.completed) {
          badge = '<span class="absolute top-2 right-2 px-2 py-0.5 text-xs rounded bg-emerald-600/70">Completado</span>';
        }
        
        let rewardPreview = '';
        if (Array.isArray(ch.rewards) && ch.rewards.length) {
          const r = ch.rewards[0];
          if (r.reward_type === 'CARD' && r.card_image_path) {
            rewardPreview = `
              <div class="flex-shrink-0">
                <img src="${r.card_image_path}" alt="Recompensa" class="reward-card-image w-20 h-28 sm:w-24 sm:h-32 object-cover rounded-lg shadow-lg transition-all duration-300" />
              </div>
            `;
          } else if (r.reward_type === 'PACK') {
            rewardPreview = `
              <div class="flex-shrink-0 relative">
                <img src="/icons/logrossobre.png" alt="Sobre" class="reward-card-image w-20 h-28 sm:w-24 sm:h-32 object-cover rounded-lg shadow-lg transition-all duration-300" />
                <div class="absolute top-0 left-1/2 transform -translate-x-1/2 bg-yellow-400 text-black px-2 py-0.5 rounded-full font-bold text-xs">+84</div>
              </div>
            `;
          }
        }
        
        header.innerHTML = `
          ${badge}
          ${countdownHTML}
          ${rewardPreview}
          <div class="flex-1 min-w-0 reward-text-container">
            <div class="reward-title font-bold text-base sm:text-lg transition-all duration-300">${ch.title}</div>
            <div class="reward-desc text-emerald-200 text-xs sm:text-sm mt-1 line-clamp-2 transition-all duration-300">${ch.description||''}</div>
          </div>
          <div class="flex items-center gap-2 flex-shrink-0 badges-container">
            <svg class="w-5 h-5 text-emerald-200 transition-transform duration-200 accordion-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </div>
        `;
        
        // Contenido desplegable
        const content = document.createElement('div');
        content.className = 'accordion-content max-h-0 overflow-hidden transition-all duration-300';
        content.innerHTML = `
          <div class="p-4 pt-0 border-t border-emerald-700/30">
            <div class="mt-3">
              <div class="text-emerald-100 text-sm mb-2">Requisitos:</div>
              <div class="text-emerald-200 text-xs mb-3">${formatRequirements(ch.requirements)}</div>
              
              <div class="text-emerald-100 text-sm mb-2">Fechas:</div>
              <div class="text-emerald-200 text-xs mb-3">${new Date(ch.start_at).toLocaleDateString()} - ${new Date(ch.end_at).toLocaleDateString()}</div>
              
              ${ch.completed && !ch.repeatable ? 
                '<button class="w-full px-4 py-2 bg-gray-600 text-white rounded-lg opacity-50 cursor-not-allowed" disabled>Completado</button>' :
                `<button class="sbc-select-btn w-full px-4 py-2 bg-emerald-500 text-white font-semibold rounded-lg hover:bg-emerald-600 transition-colors">${ch.repeatable ? 'Repetir Desafío' : 'Aceptar Desafío'}</button>`
              }
            </div>
          </div>
        `;
        
        // Toggle accordion
        header.addEventListener('click', (e) => {
          e.stopPropagation();
          const isOpen = content.style.maxHeight && content.style.maxHeight !== '0px';
          
          // Cerrar todos
          document.querySelectorAll('.accordion-content').forEach(acc => {
            acc.style.maxHeight = '0px';
          });
          document.querySelectorAll('.accordion-icon').forEach(icon => {
            icon.style.transform = 'rotate(0deg)';
          });
          document.querySelectorAll('.header-layout').forEach(header => {
            header.classList.remove('flex-col', 'items-center');
            header.classList.add('flex-row', 'items-center');
          });
          document.querySelectorAll('.reward-card-image').forEach(img => {
            img.classList.remove('w-48', 'h-72', 'sm:w-56', 'sm:h-80');
            img.classList.add('w-20', 'h-28', 'sm:w-24', 'sm:h-32');
          });
          document.querySelectorAll('.reward-title').forEach(title => {
            title.classList.remove('text-xl', 'sm:text-2xl');
            title.classList.add('text-base', 'sm:text-lg');
          });
          document.querySelectorAll('.reward-desc').forEach(desc => {
            desc.classList.remove('text-sm', 'sm:text-base', 'line-clamp-none');
            desc.classList.add('text-xs', 'sm:text-sm', 'line-clamp-2');
          });
          document.querySelectorAll('.reward-text-container').forEach(container => {
            container.classList.remove('text-center', 'w-full');
            container.classList.add('flex-1', 'min-w-0');
          });
          document.querySelectorAll('.badges-container').forEach(badges => {
            badges.style.display = 'flex';
          });
          document.querySelectorAll('.countdown-badge').forEach(cd => {
            cd.style.display = 'block';
          });
          
          // Abrir este
          if (!isOpen) {
            content.style.maxHeight = content.scrollHeight + 'px';
            header.querySelector('.accordion-icon').style.transform = 'rotate(180deg)';
            
            // Cambiar a layout vertical
            header.classList.remove('flex-row', 'items-center');
            header.classList.add('flex-col', 'items-center');
            
            // Ocultar badges al expandir
            const badgesContainer = header.querySelector('.badges-container');
            if (badgesContainer) {
              badgesContainer.style.display = 'none';
            }
            
            // Ocultar countdown al expandir
            const countdownBadge = header.querySelector('.countdown-badge');
            if (countdownBadge) {
              countdownBadge.style.display = 'none';
            }
            
            // Agrandar imagen mucho más
            const cardImage = header.querySelector('.reward-card-image');
            if (cardImage) {
              cardImage.classList.remove('w-20', 'h-28', 'sm:w-24', 'sm:h-32');
              cardImage.classList.add('w-48', 'h-72', 'sm:w-56', 'sm:h-80');
            }
            
            // Centrar textos y hacerlos más grandes
            const textContainer = header.querySelector('.reward-text-container');
            if (textContainer) {
              textContainer.classList.remove('flex-1', 'min-w-0');
              textContainer.classList.add('text-center', 'w-full');
            }
            
            const title = header.querySelector('.reward-title');
            if (title) {
              title.classList.remove('text-base', 'sm:text-lg');
              title.classList.add('text-xl', 'sm:text-2xl');
            }
            
            const desc = header.querySelector('.reward-desc');
            if (desc) {
              desc.classList.remove('text-xs', 'sm:text-sm', 'line-clamp-2');
              desc.classList.add('text-sm', 'sm:text-base', 'line-clamp-none');
            }
          }
        });
        
        const selectBtn = content.querySelector('.sbc-select-btn');
        if (selectBtn) {
          selectBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            selectChallenge(ch);
          });
        }
        
        container.appendChild(header);
        container.appendChild(content);
        limitedList.appendChild(container);
        
        // Iniciar countdown
        if (!ch.completed) {
          const countdownEl = container.querySelector('.countdown-badge');
          if (countdownEl) {
            updateCountdown(countdownEl, ch.end_at);
            countdownIntervals[`ch_${idx}`] = setInterval(() => updateCountdown(countdownEl, ch.end_at), 1000);
          }
        }
      });
      
      // SBCs ILIMITADOS con acordeón
      unlimited.forEach(ch => {
        const container = document.createElement('div');
        container.className = 'bg-emerald-900/40 rounded-lg overflow-hidden';
        
        const header = document.createElement('button');
        header.className = 'w-full text-left p-4 hover:bg-emerald-800/50 text-white transition-all flex items-center gap-4 header-layout';
        
        let rewardPreview = '';
        if (Array.isArray(ch.rewards) && ch.rewards.length) {
          const r = ch.rewards[0];
          if (r.reward_type === 'CARD' && r.card_image_path) {
            rewardPreview = `
              <div class="flex-shrink-0">
                <img src="${r.card_image_path}" alt="Recompensa" class="reward-card-image w-20 h-28 sm:w-24 sm:h-32 object-cover rounded-lg shadow-lg transition-all duration-300" />
              </div>
            `;
          } else if (r.reward_type === 'PACK') {
            rewardPreview = `
              <div class="flex-shrink-0 relative">
                <img src="/icons/logrossobre.png" alt="Sobre" class="reward-card-image w-20 h-28 sm:w-24 sm:h-32 object-cover rounded-lg shadow-lg transition-all duration-300" />
                <div class="absolute top-0 left-1/2 transform -translate-x-1/2 bg-yellow-400 text-black px-2 py-0.5 rounded-full font-bold text-xs">+84</div>
              </div>
            `;
          }
        }
        
        header.innerHTML = `
          ${rewardPreview}
          <div class="flex-1 min-w-0 reward-text-container">
            <div class="reward-title font-bold text-base sm:text-lg transition-all duration-300">${ch.title}</div>
            <div class="reward-desc text-emerald-200 text-xs sm:text-sm mt-1 line-clamp-2 transition-all duration-300">${ch.description||''}</div>
          </div>
          <div class="flex items-center gap-2 flex-shrink-0 badges-container">
            <span class="px-2 py-0.5 text-xs rounded bg-blue-600/70">∞</span>
            <svg class="w-5 h-5 text-emerald-200 transition-transform duration-200 accordion-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </div>
        `;
        
        const content = document.createElement('div');
        content.className = 'accordion-content max-h-0 overflow-hidden transition-all duration-300';
        content.innerHTML = `
          <div class="p-4 pt-0 border-t border-emerald-700/30">
            <div class="mt-3">
              <div class="text-emerald-100 text-sm mb-2">Requisitos:</div>
              <div class="text-emerald-200 text-xs mb-3">${formatRequirements(ch.requirements)}</div>
              
              <button class="sbc-select-btn w-full px-4 py-2 bg-emerald-500 text-white font-semibold rounded-lg hover:bg-emerald-600 transition-colors">Repetir Desafío</button>
            </div>
          </div>
        `;
        
        header.addEventListener('click', (e) => {
          e.stopPropagation();
          const isOpen = content.style.maxHeight && content.style.maxHeight !== '0px';
          
          document.querySelectorAll('.accordion-content').forEach(acc => {
            acc.style.maxHeight = '0px';
          });
          document.querySelectorAll('.accordion-icon').forEach(icon => {
            icon.style.transform = 'rotate(0deg)';
          });
          document.querySelectorAll('.header-layout').forEach(header => {
            header.classList.remove('flex-col', 'items-center');
            header.classList.add('flex-row', 'items-center');
          });
          document.querySelectorAll('.reward-card-image').forEach(img => {
            img.classList.remove('w-48', 'h-72', 'sm:w-56', 'sm:h-80');
            img.classList.add('w-20', 'h-28', 'sm:w-24', 'sm:h-32');
          });
          document.querySelectorAll('.reward-title').forEach(title => {
            title.classList.remove('text-xl', 'sm:text-2xl');
            title.classList.add('text-base', 'sm:text-lg');
          });
          document.querySelectorAll('.reward-desc').forEach(desc => {
            desc.classList.remove('text-sm', 'sm:text-base', 'line-clamp-none');
            desc.classList.add('text-xs', 'sm:text-sm', 'line-clamp-2');
          });
          document.querySelectorAll('.reward-text-container').forEach(container => {
            container.classList.remove('text-center', 'w-full');
            container.classList.add('flex-1', 'min-w-0');
          });
          document.querySelectorAll('.badges-container').forEach(badges => {
            badges.style.display = 'flex';
          });
          
          if (!isOpen) {
            content.style.maxHeight = content.scrollHeight + 'px';
            header.querySelector('.accordion-icon').style.transform = 'rotate(180deg)';
            
            // Cambiar a layout vertical
            header.classList.remove('flex-row', 'items-center');
            header.classList.add('flex-col', 'items-center');
            
            // Ocultar badges al expandir
            const badgesContainer = header.querySelector('.badges-container');
            if (badgesContainer) {
              badgesContainer.style.display = 'none';
            }
            
            // Agrandar imagen mucho más
            const cardImage = header.querySelector('.reward-card-image');
            if (cardImage) {
              cardImage.classList.remove('w-20', 'h-28', 'sm:w-24', 'sm:h-32');
              cardImage.classList.add('w-48', 'h-72', 'sm:w-56', 'sm:h-80');
            }
            
            // Centrar textos y hacerlos más grandes
            const textContainer = header.querySelector('.reward-text-container');
            if (textContainer) {
              textContainer.classList.remove('flex-1', 'min-w-0');
              textContainer.classList.add('text-center', 'w-full');
            }
            
            const title = header.querySelector('.reward-title');
            if (title) {
              title.classList.remove('text-base', 'sm:text-lg');
              title.classList.add('text-xl', 'sm:text-2xl');
            }
            
            const desc = header.querySelector('.reward-desc');
            if (desc) {
              desc.classList.remove('text-xs', 'sm:text-sm', 'line-clamp-2');
              desc.classList.add('text-sm', 'sm:text-base', 'line-clamp-none');
            }
          }
        });
        
        const selectBtn = content.querySelector('.sbc-select-btn');
        if (selectBtn) {
          selectBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            selectChallenge(ch);
          });
        }
        
        container.appendChild(header);
        container.appendChild(content);
        unlimitedList.appendChild(container);
      });
    }
    
    function updateCountdown(el, endDate) {
      const now = Date.now();
      const end = new Date(endDate).getTime();
      const diff = end - now;
      
      if (diff <= 0) {
        el.textContent = 'Expirado';
        return;
      }
      
      const days = Math.floor(diff / (1000 * 60 * 60 * 24));
      const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      
      if (days > 0) {
        el.textContent = `${days}d ${hours}h ${minutes}m`;
      } else {
        el.textContent = `${hours}h ${minutes}m`;
      }
    }

    function selectChallenge(ch) {
      selectedChallenge = ch;
      
      document.getElementById('challenges-sidebar').classList.add('hidden');
      document.getElementById('builder-container').classList.remove('lg:col-span-2');
      document.getElementById('builder-container').classList.add('col-span-full');
      
      document.getElementById('no-challenge').classList.add('hidden');
      document.getElementById('builder').classList.remove('hidden');
      
      const req = ch.requirements || {};
      currentReq = {
        min_players: Number(req.min_players || 1),
        max_players: Number(req.max_players || 7),
        min_avg_rating: Number(req.min_avg_rating || 0),
        min_special_cards: Number(req.min_special_cards || 0),
        required_players: req.required_players || [],
      };

      document.getElementById('challenge-title-builder').textContent = ch.title;
      document.getElementById('challenge-desc-builder').textContent = ch.description || '';
      document.getElementById('challenge-req-builder').textContent = `Jugadores: ${req.min_players||2}-${req.max_players||7} | Media ≥ ${req.min_avg_rating||0} | Especiales ≥ ${req.min_special_cards||0}`;
      document.getElementById('req-count').textContent = `${currentReq.min_players}-${currentReq.max_players}`;
      document.getElementById('req-avg').textContent = `Mín ${req.min_avg_rating||0}`;
      document.getElementById('req-specials').textContent = `Mín ${req.min_special_cards||0}`;

      selectedIds.clear();
      renderSelected();
      renderCollection(userCards);
      document.getElementById('submit-btn').disabled = true;
      document.getElementById('validate-btn').disabled = true;
    }
    
    function backToList() {
      document.getElementById('challenges-sidebar').classList.remove('hidden');
      document.getElementById('builder-container').classList.add('lg:col-span-2');
      document.getElementById('builder-container').classList.remove('col-span-full');
      
      document.getElementById('builder').classList.add('hidden');
      document.getElementById('no-challenge').classList.remove('hidden');
      
      selectedChallenge = null;
      selectedIds.clear();
    }

    function renderSelected() {
      const grid = document.getElementById('selected-grid');
      grid.innerHTML = '';
      const ids = Array.from(selectedIds);
      ids.forEach(id => {
        const uc = userCards.find(u=>u.id===id);
        if (!uc) return;
        const el = document.createElement('div');
        el.className = 'bg-emerald-800/60 rounded-lg p-2 text-center text-white relative';
        el.innerHTML = `
          <button class="absolute -top-2 -right-2 bg-red-600 text-white w-6 h-6 rounded-full">×</button>
          <div class="text-xs text-emerald-200 mb-1">${uc.card.player.name}</div>
          <div class="text-[11px]">${uc.card.player.position1} • ${uc.card.rarity}</div>
          <div class="text-[11px]">FIFA ${uc.card.player.fifa_rating}</div>
        `;
        el.querySelector('button').addEventListener('click', ()=>{ selectedIds.delete(id); renderSelected(); updateChecklist(); });
        grid.appendChild(el);
      });
      const maxSlots = Math.min(Math.max(currentReq.max_players || 1, 1), 7);
      const missing = Math.max(0, maxSlots - ids.length);
      for (let i=0;i<missing;i++) {
        const ph = document.createElement('div');
        ph.className = 'rounded-lg p-2 text-center text-emerald-200 border-2 border-dashed border-emerald-600/50 min-h-[64px] flex items-center justify-center';
        ph.textContent = 'Hueco';
        grid.appendChild(ph);
      }
      document.getElementById('slots-hint').textContent = `Huecos requeridos: ${currentReq.min_players||1}-${currentReq.max_players||7}`;
      updateChecklist();
    }

    function renderCollection(all) {
      const grid = document.getElementById('collection-grid');
      const term = document.getElementById('collection-search').value?.toLowerCase()||'';
      grid.innerHTML = '';
      all
        .filter(uc => !term || uc.card.player.name.toLowerCase().includes(term))
        .forEach(uc => {
          const card = document.createElement('button');
          card.className = 'bg-emerald-800/40 hover:bg-emerald-700/50 rounded-lg p-2 text-left text-white';
          const special = uc.card.special_type !== 'Regular' && uc.card.special_type !== 'OLD_GENERATION';
          card.innerHTML = `
            <div class="text-xs font-semibold">${uc.card.player.name}</div>
            <div class="text-[11px] text-emerald-200">${uc.card.player.position1} • ${uc.card.rarity} ${special?'• ESP':''}</div>
            <div class="text-[11px]">FIFA ${uc.card.player.fifa_rating}</div>
          `;
          card.addEventListener('click', ()=>{
            const req = selectedChallenge?.requirements || {};
            const max = req.max_players || 7;
            if (selectedIds.size >= max) { alert('Límite de cartas alcanzado'); return; }
            if (selectedIds.has(uc.id)) return;
            selectedIds.add(uc.id);
            renderSelected();
          });
          grid.appendChild(card);
        });
    }

    async function validateNow() {
      if (!selectedChallenge) return;
      const ids = Array.from(selectedIds);
      if (!ids.length) { alert('Selecciona cartas'); return; }
      const res = await fetch('/api/bufas-cards/sbc/validate', {
        method: 'POST', headers: { 'Content-Type': 'application/json', Authorization: 'Bearer '+authToken },
        body: JSON.stringify({ challenge_id: selectedChallenge.id, user_card_ids: ids })
      });
      const data = await res.json();
      if (!data.success) { alert(data.error||'Error'); return; }
      lastValidation = data;
      document.getElementById('sel-count').textContent = (data.stats?.count || ids.length).toString();
      document.getElementById('sel-avg').textContent = (data.stats?.avg || 0).toString();
      document.getElementById('sel-specials').textContent = (data.stats?.specials || 0).toString();
      document.getElementById('submit-btn').disabled = !data.ok;
      updateChecklist();
      if (!data.ok) alert('No cumple: '+ (data.reasons||[]).join(', '));
    }

    function setTileOK(tileId, ok) {
      const el = document.getElementById(tileId);
      if (!el) return;
      el.className = `rounded-lg p-4 ${ok ? 'bg-emerald-500/20' : 'bg-red-500/20'}`;
    }

    function updateChecklist() {
      const ids = Array.from(selectedIds);
      const min = currentReq.min_players||1, max = currentReq.max_players||7;
      const count = ids.length;
      document.getElementById('sel-count').textContent = count.toString();
      setTileOK('req-tile-count', count >= min && count <= max);

      const avg = lastValidation?.stats?.avg || 0;
      const specials = lastValidation?.stats?.specials || 0;
      document.getElementById('sel-avg').textContent = avg.toString();
      document.getElementById('sel-specials').textContent = specials.toString();
      setTileOK('req-tile-avg', avg >= (currentReq.min_avg_rating||0));
      setTileOK('req-tile-specials', specials >= (currentReq.min_special_cards||0));
      
      // Habilitar botón de validar solo si hay suficientes cartas
      const validateBtn = document.getElementById('validate-btn');
      if (validateBtn) {
        validateBtn.disabled = count < min;
      }
    }

    async function submitNow() {
      if (!selectedChallenge) return;
      const ids = Array.from(selectedIds);
      const res = await fetch('/api/bufas-cards/sbc/submit', {
        method: 'POST', headers: { 'Content-Type': 'application/json', Authorization: 'Bearer '+authToken },
        body: JSON.stringify({ challenge_id: selectedChallenge.id, user_card_ids: ids })
      });
      const data = await res.json();
      if (!data.success) { alert(data.error||'Error'); return; }
      const isRepeatable = selectedChallenge.repeatable;
      
      alert(`Desafío completado. Recompensa entregada.${isRepeatable ? ' Puedes repetir este desafío las veces que quieras.' : ''}`);
      
      userCards = userCards.filter(uc => !selectedIds.has(uc.id));
      selectedIds.clear();
      renderSelected();
      renderCollection(userCards);
      
      if (!isRepeatable) {
        challenges = challenges.map(ch => ch.id === selectedChallenge.id ? { ...ch, completed: true } : ch);
        renderChallenges();
      }
      
      backToList();
    }

    async function init() {
      if (!checkAuthState()) { showSection('not-logged-in'); return; }
      showSection('sbc-container');
      const [c1, c2] = await Promise.all([fetchChallenges(), fetchCollection()]);
      if (!c1.success) { alert('Error cargando SBC'); return; }
      challenges = c1.challenges || [];
      renderChallenges();
      if (!c2.success) { alert('Error cargando colección'); return; }
      userCards = c2.cards || [];

      document.getElementById('collection-search').addEventListener('input', ()=>renderCollection(userCards));
      document.getElementById('validate-btn').addEventListener('click', validateNow);
      document.getElementById('submit-btn').addEventListener('click', submitNow);
      document.getElementById('back-to-list').addEventListener('click', backToList);
    }

    document.addEventListener('DOMContentLoaded', init);
    document.addEventListener('astro:page-load', init);
    document.addEventListener('astro:after-swap', init);
  </script>
</NikeFCLayout>

---
import NikeFCLayout from '@/layouts/NikeFCLayout.astro';
import Subheader from '@/components/bufas-cards/Subheader.astro';
---

<NikeFCLayout title="SBC - Desafíos de Creación de Plantillas - Bufas Cards" helpKey="sbc">
  <div class="min-h-screen bg-gradient-to-br from-emerald-900 via-emerald-800 to-teal-900">
    <div class="container mx-auto px-4 py-20">
      <Subheader variant="minimal" />

      <div class="text-center mb-10">
        <h1 class="text-4xl md:text-6xl font-bold text-white mb-2">SBC</h1>
        <p class="text-emerald-100">Completa desafíos mensuales creando plantillas y gana sobres o cartas</p>
      </div>

      <div id="not-logged-in" class="hidden text-center">
        <div class="bg-red-500/20 backdrop-blur-md rounded-xl p-8 max-w-md mx-auto">
          <h3 class="text-2xl font-bold text-white mb-4">Acceso Requerido</h3>
          <p class="text-red-200 mb-6">Debes iniciar sesión para acceder a los SBC</p>
          <a href="/bufas-cards" class="px-6 py-3 bg-white text-red-900 font-semibold rounded-lg hover:bg-red-100 transition-colors">Iniciar Sesión</a>
        </div>
      </div>

      <div id="sbc-container" class="hidden grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Challenges list -->
        <div class="lg:col-span-1 bg-white/10 backdrop-blur-md rounded-xl p-6">
          <h3 class="text-xl font-bold text-white mb-4">Desafíos Activos</h3>
          <div id="challenges-list" class="space-y-3"></div>
        </div>

        <!-- Builder -->
        <div class="lg:col-span-2 bg-white/10 backdrop-blur-md rounded-xl p-6">
          <div id="no-challenge" class="text-center text-emerald-100">Selecciona un desafío para comenzar</div>

          <!-- Requirements Gate -->
          <div id="requirements-panel" class="hidden">
            <div class="mb-4">
              <h3 class="text-2xl font-bold text-white" id="challenge-title">-</h3>
              <p class="text-emerald-100" id="challenge-desc">-</p>
              <p class="text-emerald-200 text-sm" id="challenge-dates">-</p>
            </div>
            <div class="bg-black/20 rounded-lg p-4 mb-4">
              <div class="text-emerald-100 text-sm mb-1">Requisitos</div>
              <div class="text-emerald-200 text-sm" id="challenge-req">-</div>
            </div>
            <!-- Reward Preview -->
            <div id="reward-preview" class="mb-6 text-center"></div>
            <button id="accept-req-btn" class="px-5 py-3 bg-emerald-500 text-white rounded-lg hover:bg-emerald-600">Aceptar</button>
          </div>

          <div id="builder" class="hidden">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-4">
              <div>
                <h3 class="text-2xl font-bold text-white" id="challenge-title-builder">-</h3>
                <p class="text-emerald-100" id="challenge-desc-builder">-</p>
              </div>
              <div class="text-right">
                <div class="text-emerald-100 text-sm">Requisitos</div>
                <div class="text-emerald-200 text-sm" id="challenge-req-builder">-</div>
              </div>
            </div>

            <!-- Checklist -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
              <div id="req-tile-count" class="rounded-lg p-4 bg-red-500/20">
                <div class="text-emerald-100 text-sm">Cartas Seleccionadas</div>
                <div class="text-2xl font-bold text-white"><span id="sel-count">0</span></div>
                <div class="text-emerald-300 text-xs" id="req-count">1-7</div>
              </div>
              <div id="req-tile-avg" class="rounded-lg p-4 bg-red-500/20">
                <div class="text-emerald-100 text-sm">Media de la Plantilla</div>
                <div class="text-2xl font-bold text-white"><span id="sel-avg">0</span></div>
                <div class="text-emerald-300 text-xs" id="req-avg">Mín 0</div>
              </div>
              <div id="req-tile-specials" class="rounded-lg p-4 bg-red-500/20">
                <div class="text-emerald-100 text-sm">Cartas Especiales</div>
                <div class="text-2xl font-bold text-white"><span id="sel-specials">0</span></div>
                <div class="text-emerald-300 text-xs" id="req-specials">Mín 0</div>
              </div>
            </div>

            <!-- Selected cards -->
            <div class="mb-6">
              <h4 class="text-white font-semibold mb-2">Plantilla</h4>
              <div id="selected-grid" class="grid grid-cols-3 sm:grid-cols-5 gap-3 min-h-[100px]"></div>
              <div id="slots-hint" class="text-emerald-200 text-xs mt-2"></div>
            </div>

            <!-- Collection picker -->
            <div>
              <h4 class="text-white font-semibold mb-2">Tu Colección</h4>
              <input id="collection-search" class="w-full mb-3 px-3 py-2 rounded bg-emerald-900/40 border border-emerald-700 text-white placeholder-emerald-300" placeholder="Buscar jugador..." />
              <div id="collection-grid" class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-5 gap-3 max-h-[360px] overflow-y-auto"></div>
            </div>

            <div class="mt-6 flex gap-3">
              <button id="validate-btn" class="px-5 py-3 bg-emerald-500 text-white rounded-lg hover:bg-emerald-600">Validar</button>
              <button id="submit-btn" class="px-5 py-3 bg-teal-500 text-white rounded-lg hover:bg-teal-600 disabled:opacity-50" disabled>Enviar</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    let authToken = null;
    let challenges = [];
    let selectedChallenge = null;
    let userCards = [];
    let selectedIds = new Set();
    let currentReq = { min_players: 1, max_players: 7, min_avg_rating: 0, min_special_cards: 0 };
    let lastValidation = null;

    const storage = window.sessionStorage;
    function checkAuthState() { const t = storage.getItem('nike_fc_token'); if (t) { authToken=t; return true; } return false; }

    async function fetchChallenges() {
      const res = await fetch('/api/bufas-cards/sbc', { headers: { Authorization: 'Bearer ' + authToken } });
      return await res.json();
    }
    async function fetchCollection() {
      const res = await fetch('/api/bufas-cards/collection', { headers: { Authorization: 'Bearer ' + authToken } });
      return await res.json();
    }

    function showSection(id) {
      ['not-logged-in','sbc-container'].forEach(x=>document.getElementById(x).classList.toggle('hidden', x!==id));
    }

    function renderChallenges() {
      const list = document.getElementById('challenges-list');
      list.innerHTML = '';
      challenges.forEach(ch => {
        const btn = document.createElement('button');
        btn.className = 'w-full text-left p-3 bg-emerald-900/40 hover:bg-emerald-800/50 rounded-lg text-white flex items-center justify-between';
        let badge = '';
        if (ch.repeatable) {
          badge = '<span class="ml-3 px-2 py-0.5 text-xs rounded bg-blue-600/70">Repetible</span>';
        } else if (ch.completed) {
          badge = '<span class="ml-3 px-2 py-0.5 text-xs rounded bg-emerald-600/70">Completado</span>';
        }
        btn.innerHTML = `<div><div class=\"font-semibold\">${ch.title}</div><div class=\"text-emerald-200 text-sm\">${ch.description||''}</div></div>${badge}`;
        btn.addEventListener('click', () => selectChallenge(ch));
        list.appendChild(btn);
      });
    }

    function selectChallenge(ch) {
      selectedChallenge = ch;
      document.getElementById('no-challenge').classList.add('hidden');
      // Show requirements gate first
      document.getElementById('requirements-panel').classList.remove('hidden');
      document.getElementById('builder').classList.add('hidden');
      const acceptBtn = document.getElementById('accept-req-btn');
      if (ch.completed && !ch.repeatable) {
        acceptBtn.setAttribute('disabled','true');
        acceptBtn.classList.add('opacity-50','cursor-not-allowed');
        acceptBtn.textContent = 'Completado';
      } else {
        acceptBtn.removeAttribute('disabled');
        acceptBtn.classList.remove('opacity-50','cursor-not-allowed');
        acceptBtn.textContent = ch.repeatable ? 'Repetir Desafío' : 'Aceptar';
      }

      document.getElementById('challenge-title').textContent = ch.title;
      document.getElementById('challenge-desc').textContent = ch.description || '';
      document.getElementById('challenge-dates').textContent = new Date(ch.start_at).toLocaleDateString() + ' - ' + new Date(ch.end_at).toLocaleDateString();
      const req = ch.requirements || {};
      currentReq = {
        min_players: Number(req.min_players || 1),
        max_players: Number(req.max_players || 7),
        min_avg_rating: Number(req.min_avg_rating || 0),
        min_special_cards: Number(req.min_special_cards || 0),
      };
      document.getElementById('challenge-req').textContent = `Jugadores: ${req.min_players||2}-${req.max_players||7} | Media ≥ ${req.min_avg_rating||0} | Especiales ≥ ${req.min_special_cards||0}`;

      // Prepare builder texts
      document.getElementById('challenge-title-builder').textContent = ch.title;
      document.getElementById('challenge-desc-builder').textContent = ch.description || '';
      document.getElementById('challenge-req-builder').textContent = `Jugadores: ${req.min_players||2}-${req.max_players||7} | Media ≥ ${req.min_avg_rating||0} | Especiales ≥ ${req.min_special_cards||0}`;
      document.getElementById('req-count').textContent = `${currentReq.min_players}-${currentReq.max_players}`;
      document.getElementById('req-avg').textContent = `Mín ${req.min_avg_rating||0}`;
      document.getElementById('req-specials').textContent = `Mín ${req.min_special_cards||0}`;
      // Reward preview (big)
      const rp = document.getElementById('reward-preview');
      rp.innerHTML = '';
      if (Array.isArray(ch.rewards) && ch.rewards.length) {
        const r = ch.rewards[0];
        if (r.reward_type === 'CARD' && r.card_image_path) {
          rp.innerHTML = `
            <div class="inline-block">
              <div class="text-emerald-100 mb-2">Recompensa</div>
              <img src="${r.card_image_path}" alt="${r.player_name||'Carta'}" class="w-36 h-56 object-cover rounded-xl mx-auto shadow-lg"/>
              <div class="text-white mt-2">${r.player_name||''}</div>
            </div>`;
        } else if (r.reward_type === 'PACK') {
          // Personalizar vista para MEDIA_84_PLUS
          if (r.pack_type === 'MEDIA_84_PLUS') {
            rp.innerHTML = `
              <div class="inline-block relative">
                <div class="text-emerald-100 mb-2">Recompensa</div>
                <div class="relative inline-block">
                  <img src="/icons/logrossobre.png" alt="Sobre 84+" class="w-40 h-52 object-contain mx-auto shadow-lg"/>
                  <div class="absolute -top-2 left-1/2 transform -translate-x-1/2 bg-yellow-400 text-black px-3 py-1 rounded-full font-bold text-lg shadow-lg">
                    +84
                  </div>
                </div>
                <div class="text-white mt-2">Sobre Media 84+</div>
              </div>`;
          } else {
            rp.innerHTML = `
              <div class="inline-block">
                <div class="text-emerald-100 mb-2">Recompensa</div>
                <div class="w-40 h-40 bg-gradient-to-br from-yellow-400 to-yellow-600 rounded-2xl flex items-center justify-center mx-auto shadow-xl">
                  <span class="text-6xl">📦</span>
                </div>
                <div class="text-white mt-2">${r.pack_type || 'PACK'} × ${r.amount||1}</div>
              </div>`;
          }
        }
      }

      selectedIds.clear();
      renderSelected();
      renderCollection(userCards);
      document.getElementById('submit-btn').disabled = true;
    }

    function renderSelected() {
      const grid = document.getElementById('selected-grid');
      grid.innerHTML = '';
      const ids = Array.from(selectedIds);
      // Selected cards first
      ids.forEach(id => {
        const uc = userCards.find(u=>u.id===id);
        if (!uc) return;
        const el = document.createElement('div');
        el.className = 'bg-emerald-800/60 rounded-lg p-2 text-center text-white relative';
        el.innerHTML = `
          <button class="absolute -top-2 -right-2 bg-red-600 text-white w-6 h-6 rounded-full">×</button>
          <div class="text-xs text-emerald-200 mb-1">${uc.card.player.name}</div>
          <div class="text-[11px]">${uc.card.player.position1} • ${uc.card.rarity}</div>
          <div class="text-[11px]">FIFA ${uc.card.player.fifa_rating}</div>
        `;
        el.querySelector('button').addEventListener('click', ()=>{ selectedIds.delete(id); renderSelected(); updateChecklist(); });
        grid.appendChild(el);
      });
      // Placeholder slots up to max_players
      const maxSlots = Math.min(Math.max(currentReq.max_players || 1, 1), 7);
      const missing = Math.max(0, maxSlots - ids.length);
      for (let i=0;i<missing;i++) {
        const ph = document.createElement('div');
        ph.className = 'rounded-lg p-2 text-center text-emerald-200 border-2 border-dashed border-emerald-600/50 min-h-[64px] flex items-center justify-center';
        ph.textContent = 'Hueco';
        grid.appendChild(ph);
      }
      document.getElementById('slots-hint').textContent = `Huecos requeridos: ${currentReq.min_players||1}-${currentReq.max_players||7}`;
      updateChecklist();
    }

    function renderCollection(all) {
      const grid = document.getElementById('collection-grid');
      const term = document.getElementById('collection-search').value?.toLowerCase()||'';
      grid.innerHTML = '';
      all
        .filter(uc => !term || uc.card.player.name.toLowerCase().includes(term))
        .forEach(uc => {
          const card = document.createElement('button');
          card.className = 'bg-emerald-800/40 hover:bg-emerald-700/50 rounded-lg p-2 text-left text-white';
          const special = uc.card.special_type !== 'Regular' && uc.card.special_type !== 'OLD_GENERATION';
          card.innerHTML = `
            <div class="text-xs font-semibold">${uc.card.player.name}</div>
            <div class="text-[11px] text-emerald-200">${uc.card.player.position1} • ${uc.card.rarity} ${special?'• ESP':''}</div>
            <div class="text-[11px]">FIFA ${uc.card.player.fifa_rating}</div>
          `;
          card.addEventListener('click', ()=>{
            const req = selectedChallenge?.requirements || {};
            const max = req.max_players || 7;
            if (selectedIds.size >= max) { alert('Límite de cartas alcanzado'); return; }
            if (selectedIds.has(uc.id)) return;
            selectedIds.add(uc.id);
            renderSelected();
          });
          grid.appendChild(card);
        });
    }

    async function validateNow() {
      if (!selectedChallenge) return;
      const ids = Array.from(selectedIds);
      if (!ids.length) { alert('Selecciona cartas'); return; }
      const res = await fetch('/api/bufas-cards/sbc/validate', {
        method: 'POST', headers: { 'Content-Type': 'application/json', Authorization: 'Bearer '+authToken },
        body: JSON.stringify({ challenge_id: selectedChallenge.id, user_card_ids: ids })
      });
      const data = await res.json();
      if (!data.success) { alert(data.error||'Error'); return; }
      lastValidation = data;
      document.getElementById('sel-count').textContent = (data.stats?.count || ids.length).toString();
      document.getElementById('sel-avg').textContent = (data.stats?.avg || 0).toString();
      document.getElementById('sel-specials').textContent = (data.stats?.specials || 0).toString();
      document.getElementById('submit-btn').disabled = !data.ok;
      updateChecklist();
      if (!data.ok) alert('No cumple: '+ (data.reasons||[]).join(', '));
    }

    function setTileOK(tileId, ok) {
      const el = document.getElementById(tileId);
      if (!el) return;
      el.className = `rounded-lg p-4 ${ok ? 'bg-emerald-500/20' : 'bg-red-500/20'}`;
    }

    function updateChecklist() {
      const ids = Array.from(selectedIds);
      const min = currentReq.min_players||1, max = currentReq.max_players||7;
      const count = ids.length;
      document.getElementById('sel-count').textContent = count.toString();
      setTileOK('req-tile-count', count >= min && count <= max);

      // avg/specials: use lastValidation if available
      const avg = lastValidation?.stats?.avg || 0;
      const specials = lastValidation?.stats?.specials || 0;
      document.getElementById('sel-avg').textContent = avg.toString();
      document.getElementById('sel-specials').textContent = specials.toString();
      setTileOK('req-tile-avg', avg >= (currentReq.min_avg_rating||0));
      setTileOK('req-tile-specials', specials >= (currentReq.min_special_cards||0));
    }

    async function submitNow() {
      if (!selectedChallenge) return;
      const ids = Array.from(selectedIds);
      const res = await fetch('/api/bufas-cards/sbc/submit', {
        method: 'POST', headers: { 'Content-Type': 'application/json', Authorization: 'Bearer '+authToken },
        body: JSON.stringify({ challenge_id: selectedChallenge.id, user_card_ids: ids })
      });
      const data = await res.json();
      if (!data.success) { alert(data.error||'Error'); return; }
      const isRepeatable = selectedChallenge.repeatable;
      
      // Mostrar alert de éxito primero
      alert(`Desafío completado. Recompensa entregada.${isRepeatable ? ' Puedes repetir este desafío las veces que quieras.' : ''}`);
      
      // Remove consumed cards from local list
      userCards = userCards.filter(uc => !selectedIds.has(uc.id));
      selectedIds.clear();
      renderSelected();
      renderCollection(userCards);
      
      // Mark challenge as completed only for non-repeatable challenges
      if (!isRepeatable) {
        challenges = challenges.map(ch => ch.id === selectedChallenge.id ? { ...ch, completed: true } : ch);
        renderChallenges();
      }
      
      // Auto-open the pack reward después del alert
      await autoOpenPackReward();
      
      // For repeatable challenges, reset to requirements panel; for non-repeatable, lock builder
      document.getElementById('requirements-panel').classList.remove('hidden');
      document.getElementById('builder').classList.add('hidden');
      const acceptBtn = document.getElementById('accept-req-btn');
      
      if (isRepeatable) {
        acceptBtn.removeAttribute('disabled');
        acceptBtn.classList.remove('opacity-50','cursor-not-allowed');
        acceptBtn.textContent = 'Repetir Desafío';
      } else {
        acceptBtn.setAttribute('disabled','true');
        acceptBtn.classList.add('opacity-50','cursor-not-allowed');
        acceptBtn.textContent = 'Completado';
      }
    }

    async function autoOpenPackReward() {
      try {
        console.log('autoOpenPackReward - Starting');
        
        // Buscar el pack más reciente del usuario que no esté abierto usando una query directa
        const packsRes = await fetch('/api/bufas-cards/sbc/get-recent-pack', {
          method: 'POST',
          headers: { 
            'Content-Type': 'application/json',
            'Authorization': 'Bearer ' + authToken 
          },
          body: JSON.stringify({ pack_type: 'MEDIA_84_PLUS' })
        });
        
        console.log('autoOpenPackReward - Packs response:', packsRes.ok);
        
        if (!packsRes.ok) {
          alert('Desafío completado. Ve a la sección de Sobres para abrir tu recompensa.');
          return;
        }
        
        const packsData = await packsRes.json();
        console.log('autoOpenPackReward - Packs data:', packsData);
        
        // Verificar si encontró el pack
        if (!packsData.success || !packsData.pack) {
          alert('Desafío completado. No se encontró el sobre para abrir.');
          return;
        }
        
        const packToOpen = packsData.pack;
        console.log('autoOpenPackReward - Pack to open:', packToOpen);
        
        if (!packToOpen) {
          alert('Desafío completado. No se encontró el sobre para abrir.');
          return;
        }
        
        // Usar setTimeout para asegurar que el popup aparezca después del alert
        setTimeout(async () => {
          await showPackModal(packToOpen);
        }, 100);
        
      } catch (error) {
        console.error('Error mostrando pack de SBC:', error);
        alert('Desafío completado. Error mostrando el sobre.');
      }
    }

    async function showPackModal(pack) {
      return new Promise((resolve) => {
        // Crear modal del sobre como en /packs
        const modal = document.createElement('div');
        modal.className = 'fixed inset-0 bg-black/60 flex items-center justify-center z-50 p-4';
        modal.innerHTML = `
          <div class="bg-gradient-to-br from-slate-800 to-slate-900 rounded-xl p-6 max-w-md w-full text-center">
            <h2 class="text-2xl font-bold text-white mb-4">¡Recompensa Obtenida!</h2>
            
            <!-- Imagen del sobre con badge +84 -->
            <div class="relative inline-block mb-6">
              <img src="/icons/logrossobre.png" alt="Sobre 84+" class="w-40 h-52 object-contain mx-auto"/>
              <div class="absolute -top-2 left-1/2 transform -translate-x-1/2 bg-yellow-400 text-black px-3 py-1 rounded-full font-bold text-lg shadow-lg">
                +84
              </div>
            </div>
            
            <p class="text-lg text-white mb-4">Sobre Media 84+</p>
            <p class="text-sm text-slate-300 mb-6">Contiene 1 carta con media 84 o superior</p>
            
            <div class="flex gap-3">
              <button id="open-pack-btn" class="flex-1 py-3 bg-green-600 text-white font-bold rounded-lg hover:bg-green-700 transition-colors">
                Abrir Sobre
              </button>
              <button id="close-modal-btn" class="flex-1 py-3 bg-gray-600 text-white font-bold rounded-lg hover:bg-gray-700 transition-colors">
                Cerrar
              </button>
            </div>
          </div>
        `;
        
        document.body.appendChild(modal);
        
        const openBtn = modal.querySelector('#open-pack-btn');
        const closeBtn = modal.querySelector('#close-modal-btn');
        
        openBtn.addEventListener('click', async () => {
          document.body.removeChild(modal);
          await openSBCPack(pack);
          resolve();
        });
        
        closeBtn.addEventListener('click', () => {
          document.body.removeChild(modal);
          resolve();
        });
        
        // Cerrar con clic fuera del modal
        modal.addEventListener('click', (e) => {
          if (e.target === modal) {
            document.body.removeChild(modal);
            resolve();
          }
        });
      });
    }

    async function openSBCPack(pack) {
      try {
        // Simular la apertura del pack
        const openRes = await fetch('/api/bufas-cards/packs/open', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Authorization: 'Bearer ' + authToken
          },
          body: JSON.stringify({ pack_id: pack.id })
        });
        
        if (!openRes.ok) {
          alert('Error abriendo el sobre. Ve a la sección de Sobres para abrirlo manualmente.');
          return;
        }
        
        const result = await openRes.json();
        
        if (result.success && result.cards && result.cards.length > 0) {
          // Mostrar la animación del pack opening como en /packs
          await showSBCPackAnimation(result.cards[0]);
        } else {
          alert('Desafío completado. Recompensa entregada.');
        }
        
      } catch (error) {
        console.error('Error en openSBCPack:', error);
        alert('Desafío completado. Ve a la sección de Sobres para abrir tu recompensa.');
      }
    }

    async function showSBCPackAnimation(card) {
      return new Promise((resolve) => {
        // Crear overlay fullscreen como en packs
        const overlay = document.createElement('div');
        overlay.className = 'fixed inset-0 bg-black/95 text-white flex items-center justify-center z-50 p-4';
        overlay.innerHTML = `
          <div class="text-center w-full max-w-lg mx-auto px-4 my-auto">
            <div id="sbc-loading" class="mt-6 text-green-300 text-lg sm:text-xl animate-pulse">Abriendo sobre…</div>
            <div id="sbc-pos" class="text-lg sm:text-xl md:text-2xl font-extrabold opacity-0 transition-opacity duration-500 text-center w-full px-2 py-4"></div>
            <div id="sbc-rating" class="text-3xl sm:text-4xl md:text-5xl text-yellow-400 font-extrabold mt-2 sm:mt-4 opacity-0 transition-opacity duration-500 text-center w-full"></div>
            <div id="sbc-card" class="mt-4 sm:mt-6 md:mt-8 opacity-0 transform scale-50 transition-all duration-700 w-full flex justify-center"></div>
            <button id="sbc-confirm" class="mt-4 sm:mt-6 px-6 sm:px-8 py-2 sm:py-3 bg-green-600 text-white font-semibold rounded-lg hover:bg-green-700 transition-colors hidden">Confirmar</button>
          </div>
        `;
        
        document.body.appendChild(overlay);
        
        // Ejecutar secuencia como en packs
        const loadingEl = overlay.querySelector('#sbc-loading');
        const posEl = overlay.querySelector('#sbc-pos');
        const ratingEl = overlay.querySelector('#sbc-rating');
        const cardEl = overlay.querySelector('#sbc-card');
        const confirmBtn = overlay.querySelector('#sbc-confirm');
        
        loadingEl.classList.add('hidden');
        
        // Secuencia de animación
        posEl.textContent = translatePosition(card?.player?.position1);
        setTimeout(() => posEl.classList.remove('opacity-0'), 150);
        setTimeout(() => posEl.classList.add('opacity-0'), 1000);
        
        setTimeout(() => {
          ratingEl.textContent = String(card?.player?.fifa_rating || '');
          ratingEl.classList.remove('opacity-0');
        }, 1300);
        setTimeout(() => ratingEl.classList.add('opacity-0'), 2300);
        
        setTimeout(() => {
          const cardDiv = createSBCCardElement(card);
          cardDiv.classList.add('mx-auto', 'w-full', 'max-w-xs', 'sm:max-w-sm');
          cardEl.appendChild(cardDiv);
          cardEl.classList.remove('opacity-0', 'scale-50');
          confirmBtn.classList.remove('hidden');
        }, 2600);
        
        confirmBtn.addEventListener('click', () => {
          document.body.removeChild(overlay);
          resolve();
        });
      });
    }

    function translatePosition(pos) {
      const map = {
        GK: 'PORTERO', CB: 'DEFENSA', LB: 'LATERAL IZQ', RB: 'LATERAL DCH',
        CDM: 'MCD', CM: 'CENTROCAMPISTA', CAM: 'MCO',
        LM: 'MI', RM: 'MD', LW: 'EI', RW: 'ED', ST: 'DELANTERO'
      };
      return map[pos] || pos || '';
    }

    function createSBCCardElement(card) {
      // Similar al de packs pero adaptado
      function getDisplayRarity(specialType) {
        switch (specialType) {
          case 'Regular': case 'OLD_GENERATION': return 'NORMAL';
          case 'TEAM_OF_THE_WEEK': return 'ESPECIAL';
          case 'MARKET_MASTER': case 'RATING_RELOAD': case 'COMEBACK_HERO': case 'ASSIST_ENGINE': return 'ELITE';
          case 'PLAYER_OF_THE_MONTH': return 'LEGENDARIO';
          default: return 'NORMAL';
        }
      }
      
      function getRarityColor(displayRarity) {
        switch (displayRarity) {
          case 'NORMAL': return 'from-gray-400 to-gray-600';
          case 'ESPECIAL': return 'from-blue-500 to-blue-700';
          case 'ELITE': return 'from-purple-500 to-purple-700';
          case 'LEGENDARIO': return 'from-yellow-400 to-orange-500';
          default: return 'from-gray-400 to-gray-600';
        }
      }
      
      const displayRarity = getDisplayRarity(card.special_type || 'Regular');
      const rarityColor = getRarityColor(displayRarity);
      
      const cardDiv = document.createElement('div');
      cardDiv.className = `bg-gradient-to-br ${rarityColor} rounded-xl p-3 sm:p-4 text-center transform`;
      const imgSrc = card.image_path || card.player?.image_url;
      const img = imgSrc ? `<img src="${imgSrc}" alt="${card.player?.name || 'card'}" class="w-full h-auto rounded-lg mb-2 sm:mb-3" />` : `
        <div class="w-12 h-12 sm:w-16 sm:h-16 bg-white/20 rounded-lg flex items-center justify-center mx-auto mb-2 sm:mb-3">
          <span class="text-xl sm:text-2xl">⚽</span>
        </div>`;
      
      cardDiv.innerHTML = `
        ${img}
        <div class="text-white font-bold text-xs sm:text-sm mb-1">${card.player?.name || 'Jugador'}</div>
        <div class="text-xs text-white/80 mb-1 sm:mb-2">${translatePosition(card.player?.position1) || ''} - ${displayRarity}</div>
        <div class="text-xs text-yellow-300 font-bold">${card.base_price || 0} 💰</div>
        <div class="text-xs text-white/90 mt-1">FIFA: ${card.player?.fifa_rating || ''}</div>
      `;
      return cardDiv;
    }

    async function init() {
      if (!checkAuthState()) { showSection('not-logged-in'); return; }
      showSection('sbc-container');
      const [c1, c2] = await Promise.all([fetchChallenges(), fetchCollection()]);
      if (!c1.success) { alert('Error cargando SBC'); return; }
      challenges = c1.challenges || [];
      renderChallenges();
      if (!c2.success) { alert('Error cargando colección'); return; }
      userCards = c2.cards || [];

      document.getElementById('collection-search').addEventListener('input', ()=>renderCollection(userCards));
      document.getElementById('validate-btn').addEventListener('click', validateNow);
      document.getElementById('submit-btn').addEventListener('click', submitNow);
      document.getElementById('accept-req-btn').addEventListener('click', ()=>{
        document.getElementById('requirements-panel').classList.add('hidden');
        document.getElementById('builder').classList.remove('hidden');
      });
    }

    document.addEventListener('DOMContentLoaded', init);
    document.addEventListener('astro:page-load', init);
    document.addEventListener('astro:after-swap', init);
  </script>
</NikeFCLayout>

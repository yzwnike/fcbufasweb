---
import Layout from '../layouts/Layout.astro'
import type { Fighters } from '@/types/fighters'
import { FIGHTERS } from '../consts/fighters'

const title = 'Valores de Mercado - FC Bufas'
const description = 'Consulta los valores de mercado de los jugadores del FC Bufas.'
const canonical = 'https://www.fcbufasweb.vercel.app/valores-mercado'

// Puntos Jornada 4 por jugador (id -> puntos)
const PTS_J4: Record<string, number> = {
  yazawa: 5,
  mister: 11,
  perma: 8,
  pablo: 7,
  fan: 6,
  albert: 6,
  nicou: 7,
  mario: 16,
  javo: 7,
  marcos: 7,
}
---

<Layout title={title} description={description} canonical={canonical}>
  <!-- Fondo espectacular con efectos -->
  <div class="fixed inset-0 overflow-hidden">
    <!-- Fondo base con gradiente animado -->
    <div class="animated-bg absolute inset-0"></div>
    
    <!-- Partículas flotantes -->
    <div class="particles-container absolute inset-0">
      <!-- Partículas grandes -->
      <div class="particle particle-1"></div>
      <div class="particle particle-2"></div>
      <div class="particle particle-3"></div>
      <div class="particle particle-4"></div>
      <div class="particle particle-5"></div>
      <div class="particle particle-6"></div>
      
      <!-- Partículas medianas -->
      <div class="particle-medium pm-1"></div>
      <div class="particle-medium pm-2"></div>
      <div class="particle-medium pm-3"></div>
      <div class="particle-medium pm-4"></div>
      <div class="particle-medium pm-5"></div>
      <div class="particle-medium pm-6"></div>
      <div class="particle-medium pm-7"></div>
      <div class="particle-medium pm-8"></div>
      
      <!-- Partículas pequeñas -->
      <div class="particle-small ps-1"></div>
      <div class="particle-small ps-2"></div>
      <div class="particle-small ps-3"></div>
      <div class="particle-small ps-4"></div>
      <div class="particle-small ps-5"></div>
      <div class="particle-small ps-6"></div>
      <div class="particle-small ps-7"></div>
      <div class="particle-small ps-8"></div>
      <div class="particle-small ps-9"></div>
      <div class="particle-small ps-10"></div>
      
      <!-- Efectos de luz -->
      <div class="light-effect light-1"></div>
      <div class="light-effect light-2"></div>
      <div class="light-effect light-3"></div>
    </div>
    
    <!-- Overlay para mejorar legibilidad -->
    <div class="absolute inset-0 bg-black/20"></div>
  </div>
  
  <div class="relative z-10 min-h-screen py-2 pt-24">
    <div class="container mx-auto px-4">
      <div class="text-center mb-6">
        <h1 class="text-4xl font-bold text-gray-900 mb-2">🏆 Valores de Mercado FC Bufas</h1>
        <p class="text-gray-600 text-lg">Consulta las valoraciones actuales de todos los jugadores</p>
        <div class="mt-4 bg-green-100 border border-green-300 rounded-lg p-4 inline-block">
          <span class="text-green-800 font-semibold">💰 Valor total de la plantilla: {new Intl.NumberFormat('es-ES', { style: 'currency', currency: 'EUR', minimumFractionDigits: 0, maximumFractionDigits: 0 }).format(FIGHTERS.filter(f => f.valorTotal).reduce((sum, f) => sum + (f.valorTotal || 0), 0))}</span>
        </div>
      </div>
      
      <!-- Tabla estilo Transfermarkt -->
      <div class="bg-white rounded-lg shadow-lg overflow-hidden">
        <div class="bg-green-600 text-white px-6 py-4">
          <h2 class="text-xl font-bold">📊 Plantilla FC Bufas - Temporada 2025/26</h2>
        </div>
        
        <div class="overflow-x-auto">
          <table class="w-full">
<thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">#</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Jugador</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Posición</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Edad</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">PTS J4</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Puntos</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Valor de Mercado</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Tendencia</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              {FIGHTERS
                .filter(fighter => fighter.valorTotal)
                .sort((a, b) => (b.valorTotal || 0) - (a.valorTotal || 0))
                .map((fighter, index) => {
                  const historial = fighter.historialValores || []
                  const tendencia = historial.length >= 2 
                    ? historial[historial.length - 1].valor - historial[historial.length - 2].valor
                    : 0
                  const tendenciaPercent = historial.length >= 2
                    ? ((tendencia / historial[historial.length - 2].valor) * 100).toFixed(1)
                    : 0
                  
                  return (
                    <tr class="hover:bg-gray-50 transition-colors">
                      <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                        {index + 1}
                      </td>
                      <td class="px-6 py-4 whitespace-nowrap">
                        <a href={`/valores-mercado/${fighter.id}`} class="flex items-center hover:text-green-600 transition-colors">
                          <img 
                            src={`/images/fighters/big/${fighter.id}.webp`} 
                            alt={fighter.name} 
                            class="w-12 h-12 rounded-full mr-3 border-2 border-gray-200"
                          />
                          <div>
                            <div class="text-sm font-medium text-gray-900">{fighter.name}</div>
                            <div class="text-sm text-gray-500">{fighter.realName}</div>
                          </div>
                        </a>
                      </td>
                      <td class="px-6 py-4 whitespace-nowrap">
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                          {fighter.position}
                        </span>
                      </td>
<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                        {fighter.age} años
                      </td>
                      <td class="px-6 py-4 whitespace-nowrap">
                        <div class="text-sm font-semibold text-blue-600">
                          {PTS_J4[fighter.id] ?? 0} pts
                        </div>
                      </td>
                      <td class="px-6 py-4 whitespace-nowrap">
                        <div class="text-sm font-bold text-orange-600">
                          {fighter.puntosTotales || 0} pts
                        </div>
                      </td>
                      <td class="px-6 py-4 whitespace-nowrap">
                        <div class="text-sm font-bold text-green-600">
                          {new Intl.NumberFormat('es-ES', { style: 'currency', currency: 'EUR', minimumFractionDigits: 0, maximumFractionDigits: 0 }).format(fighter.valorTotal || 0)}
                        </div>
                      </td>
                      <td class="px-6 py-4 whitespace-nowrap">
                        {tendencia !== 0 && (
                          <div class={`flex items-center text-sm ${
                            tendencia > 0 
                              ? 'text-green-600' 
                              : tendencia < 0 
                                ? 'text-red-600' 
                                : 'text-gray-500'
                          }`}>
                            {tendencia > 0 ? '📈' : tendencia < 0 ? '📉' : '➡️'}
                            <span class="ml-1 font-medium">
                              {tendencia > 0 ? '+' : ''}{tendenciaPercent}%
                            </span>
                          </div>
                        )}
                      </td>
                    </tr>
                  )
                })
              }
            </tbody>
          </table>
        </div>
      </div>
      
      <!-- Información adicional -->
      <div class="mt-6 grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="bg-white rounded-lg shadow p-6 text-center">
          <div class="text-2xl font-bold text-green-600">
            {FIGHTERS.filter(f => f.valorTotal && f.valorTotal >= 30000000).length}
          </div>
          <div class="text-sm text-gray-600">Jugadores</div>
        </div>
        <div class="bg-white rounded-lg shadow p-6 text-center">
          <div class="text-2xl font-bold text-blue-600">
            {Math.round(FIGHTERS.filter(f => f.valorTotal).reduce((sum, f) => sum + (f.age || 0), 0) / FIGHTERS.filter(f => f.valorTotal).length)}
          </div>
          <div class="text-sm text-gray-600">Edad promedio</div>
        </div>
        <div class="bg-white rounded-lg shadow p-6 text-center">
          <div class="text-2xl font-bold text-orange-600">
            {Math.round(FIGHTERS.filter(f => f.valorTotal).reduce((sum, f) => sum + (f.valorTotal || 0), 0) / FIGHTERS.filter(f => f.valorTotal).length / 1000000)}M€
          </div>
          <div class="text-sm text-gray-600">Valor promedio</div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  /* Fondo animado base */
  .animated-bg {
    background: linear-gradient(-45deg, #000000, #1a1a1a, #ff4500, #ff6b35, #000000, #2d1810);
    background-size: 400% 400%;
    animation: gradientShift 15s ease infinite;
  }
  
  @keyframes gradientShift {
    0% { background-position: 0% 50%; }
    25% { background-position: 100% 50%; }
    50% { background-position: 100% 100%; }
    75% { background-position: 50% 100%; }
    100% { background-position: 0% 50%; }
  }
  
  /* Partículas grandes */
  .particle {
    position: absolute;
    border-radius: 50%;
    background: linear-gradient(45deg, #ff4500, #ff6b35, #ffa500);
    opacity: 0.3;
    filter: blur(1px);
  }
  
  .particle-1 { width: 80px; height: 80px; top: 10%; left: 20%; }
  .particle-2 { width: 60px; height: 60px; top: 70%; right: 15%; }
  .particle-3 { width: 100px; height: 100px; top: 30%; right: 30%; }
  .particle-4 { width: 70px; height: 70px; bottom: 20%; left: 10%; }
  .particle-5 { width: 90px; height: 90px; top: 50%; left: 70%; }
  .particle-6 { width: 50px; height: 50px; bottom: 40%; right: 20%; }
  
  /* Partículas medianas */
  .particle-medium {
    position: absolute;
    border-radius: 50%;
    background: radial-gradient(circle, #ff6b35, #ff4500);
    opacity: 0.4;
    filter: blur(0.5px);
    width: 30px;
    height: 30px;
  }
  
  .pm-1 { top: 15%; left: 10%; }
  .pm-2 { top: 25%; right: 25%; }
  .pm-3 { bottom: 30%; left: 30%; }
  .pm-4 { top: 60%; left: 15%; }
  .pm-5 { bottom: 15%; right: 35%; }
  .pm-6 { top: 45%; right: 10%; }
  .pm-7 { bottom: 60%; left: 60%; }
  .pm-8 { top: 80%; right: 50%; }
  
  /* Partículas pequeñas */
  .particle-small {
    position: absolute;
    border-radius: 50%;
    background: #ff6b35;
    opacity: 0.6;
    width: 8px;
    height: 8px;
    box-shadow: 0 0 10px #ff4500;
  }
  
  .ps-1 { top: 20%; left: 25%; }
  .ps-2 { top: 35%; right: 20%; }
  .ps-3 { bottom: 25%; left: 15%; }
  .ps-4 { top: 65%; left: 45%; }
  .ps-5 { bottom: 45%; right: 15%; }
  .ps-6 { top: 15%; right: 40%; }
  .ps-7 { bottom: 20%; left: 55%; }
  .ps-8 { top: 75%; right: 30%; }
  .ps-9 { bottom: 35%; left: 80%; }
  .ps-10 { top: 40%; left: 5%; }
  
  /* Efectos de luz */
  .light-effect {
    position: absolute;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 107, 53, 0.3), transparent);
    filter: blur(40px);
  }
  
  .light-1 {
    width: 300px;
    height: 300px;
    top: 10%;
    left: -50px;
    animation: lightPulse 8s ease-in-out infinite;
  }
  
  .light-2 {
    width: 400px;
    height: 400px;
    bottom: 10%;
    right: -100px;
    animation: lightPulse 6s ease-in-out infinite reverse;
  }
  
  .light-3 {
    width: 250px;
    height: 250px;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    animation: lightPulse 10s ease-in-out infinite;
  }
  
  @keyframes lightPulse {
    0%, 100% { opacity: 0.3; transform: scale(1); }
    50% { opacity: 0.6; transform: scale(1.2); }
  }
  
  /* Animaciones de las partículas */
  .particle {
    animation: float 20s ease-in-out infinite;
  }
  
  .particle-1 { animation-delay: 0s; }
  .particle-2 { animation-delay: 2s; }
  .particle-3 { animation-delay: 4s; }
  .particle-4 { animation-delay: 6s; }
  .particle-5 { animation-delay: 8s; }
  .particle-6 { animation-delay: 10s; }
  
  .particle-medium {
    animation: floatMedium 15s linear infinite;
  }
  
  .pm-1 { animation-delay: 1s; }
  .pm-2 { animation-delay: 3s; }
  .pm-3 { animation-delay: 5s; }
  .pm-4 { animation-delay: 7s; }
  .pm-5 { animation-delay: 9s; }
  .pm-6 { animation-delay: 11s; }
  .pm-7 { animation-delay: 13s; }
  .pm-8 { animation-delay: 2s; }
  
  .particle-small {
    animation: floatSmall 12s linear infinite;
  }
  
  .ps-1 { animation-delay: 0.5s; }
  .ps-2 { animation-delay: 1.5s; }
  .ps-3 { animation-delay: 2.5s; }
  .ps-4 { animation-delay: 3.5s; }
  .ps-5 { animation-delay: 4.5s; }
  .ps-6 { animation-delay: 5.5s; }
  .ps-7 { animation-delay: 6.5s; }
  .ps-8 { animation-delay: 7.5s; }
  .ps-9 { animation-delay: 8.5s; }
  .ps-10 { animation-delay: 9.5s; }
  
  @keyframes float {
    0%, 100% { transform: translateY(0px) rotate(0deg); }
    25% { transform: translateY(-20px) rotate(90deg); }
    50% { transform: translateY(-10px) rotate(180deg); }
    75% { transform: translateY(-30px) rotate(270deg); }
  }
  
  @keyframes floatMedium {
    0% { transform: translateY(0px) translateX(0px) scale(1); opacity: 0.4; }
    25% { transform: translateY(-50px) translateX(20px) scale(1.2); opacity: 0.6; }
    50% { transform: translateY(-30px) translateX(-10px) scale(0.8); opacity: 0.3; }
    75% { transform: translateY(-70px) translateX(30px) scale(1.1); opacity: 0.5; }
    100% { transform: translateY(0px) translateX(0px) scale(1); opacity: 0.4; }
  }
  
  @keyframes floatSmall {
    0% { transform: translateY(0px) scale(1); opacity: 0.6; }
    33% { transform: translateY(-100px) scale(1.5); opacity: 1; }
    66% { transform: translateY(-50px) scale(0.8); opacity: 0.4; }
    100% { transform: translateY(0px) scale(1); opacity: 0.6; }
  }
  
  /* Efectos adicionales con hover */
  .bg-white:hover {
    background: rgba(255, 255, 255, 0.98);
    transform: translateY(-2px);
  }
  
  /* Efectos de resplandor */
  .particle::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle, rgba(255, 107, 53, 0.1), transparent);
    border-radius: 50%;
    animation: glow 4s ease-in-out infinite alternate;
  }
  
  @keyframes glow {
    0% { opacity: 0.5; transform: scale(1); }
    100% { opacity: 1; transform: scale(1.2); }
  }
</style>

<!-- GSAP desde CDN -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>

<script>
  // GSAP Animaciones avanzadas
  document.addEventListener('DOMContentLoaded', function() {
    // Timeline principal
    const tl = gsap.timeline();
    
    // Animación de entrada del fondo
    tl.from('.animated-bg', {
      duration: 2,
      opacity: 0,
      scale: 1.1,
      ease: 'power2.out'
    })
    
    // Animación de las partículas grandes
    .from('.particle', {
      duration: 1.5,
      opacity: 0,
      scale: 0,
      rotation: 180,
      stagger: 0.2,
      ease: 'back.out(1.7)'
    }, '-=1.5')
    
    // Animación de las partículas medianas
    .from('.particle-medium', {
      duration: 1,
      opacity: 0,
      y: 100,
      stagger: 0.1,
      ease: 'bounce.out'
    }, '-=1')
    
    // Animación de las partículas pequeñas
    .from('.particle-small', {
      duration: 0.8,
      opacity: 0,
      scale: 0,
      stagger: 0.05,
      ease: 'power2.out'
    }, '-=0.8')
    
    // Animación de los efectos de luz
    .from('.light-effect', {
      duration: 2,
      opacity: 0,
      scale: 0.5,
      stagger: 0.3,
      ease: 'power2.out'
    }, '-=1');
    
    // Animaciones continuas con GSAP
    gsap.to('.particle-1, .particle-3, .particle-5', {
      duration: 20,
      rotation: 360,
      repeat: -1,
      ease: 'none'
    });
    
    gsap.to('.particle-2, .particle-4, .particle-6', {
      duration: 25,
      rotation: -360,
      repeat: -1,
      ease: 'none'
    });
    
    // Movimiento suave de partículas medianas
    gsap.to('.particle-medium', {
      duration: 8,
      y: '-=30',
      x: '+=20',
      repeat: -1,
      yoyo: true,
      ease: 'sine.inOut',
      stagger: 0.5
    });
    
    // Pulsación de partículas pequeñas
    gsap.to('.particle-small', {
      duration: 2,
      scale: 1.5,
      opacity: 1,
      repeat: -1,
      yoyo: true,
      ease: 'power2.inOut',
      stagger: 0.2
    });
    
    // Efecto de paralaje en scroll
    if (typeof ScrollTrigger !== 'undefined') {
      gsap.registerPlugin(ScrollTrigger);
      
      gsap.to('.particle', {
        scrollTrigger: {
          trigger: 'body',
          start: 'top top',
          end: 'bottom top',
          scrub: true
        },
        y: -100,
        stagger: 0.1
      });
      
      // Animación de las cards al aparecer
      gsap.from('.bg-white', {
        scrollTrigger: {
          trigger: '.bg-white',
          start: 'top 80%',
          end: 'bottom 20%',
          toggleActions: 'play none none reverse'
        },
        duration: 1,
        y: 50,
        opacity: 0,
        scale: 0.9,
        stagger: 0.1,
        ease: 'back.out(1.7)'
      });
    }
    
    // Efecto hover mejorado para las cards
    document.querySelectorAll('.bg-white').forEach(card => {
      card.addEventListener('mouseenter', () => {
        gsap.to(card, {
          duration: 0.3,
          y: -5,
          scale: 1.02,
          boxShadow: '0 20px 40px rgba(0,0,0,0.1)',
          ease: 'power2.out'
        });
      });
      
      card.addEventListener('mouseleave', () => {
        gsap.to(card, {
          duration: 0.3,
          y: 0,
          scale: 1,
          boxShadow: '0 10px 25px rgba(0,0,0,0.05)',
          ease: 'power2.out'
        });
      });
    });
    
    // Crear partículas dinámicas adicionales
    function createDynamicParticle() {
      const particle = document.createElement('div');
      particle.className = 'dynamic-particle';
      particle.style.cssText = `
        position: fixed;
        width: ${Math.random() * 6 + 2}px;
        height: ${Math.random() * 6 + 2}px;
        background: #ff6b35;
        border-radius: 50%;
        pointer-events: none;
        z-index: 5;
        box-shadow: 0 0 10px #ff4500;
        left: ${Math.random() * window.innerWidth}px;
        top: ${window.innerHeight + 10}px;
      `;
      
      document.body.appendChild(particle);
      
      gsap.to(particle, {
        duration: Math.random() * 8 + 5,
        y: -window.innerHeight - 100,
        x: Math.random() * 200 - 100,
        rotation: Math.random() * 360,
        opacity: 0,
        ease: 'power1.out',
        onComplete: () => particle.remove()
      });
    }
    
    // Crear partículas dinámicas cada cierto tiempo
    setInterval(createDynamicParticle, 3000);
    
    // Movimiento sutil de partículas siguiendo el mouse
    gsap.set('.particle-small', {
      transformOrigin: 'center'
    });
    
    document.addEventListener('mousemove', (e) => {
      const moveX = (e.clientX - window.innerWidth / 2) * 0.02;
      const moveY = (e.clientY - window.innerHeight / 2) * 0.02;
      
      gsap.to('.particle-small', {
        duration: 2,
        x: `+=${moveX}`,
        y: `+=${moveY}`,
        ease: 'power2.out'
      });
    });
  });
</script>

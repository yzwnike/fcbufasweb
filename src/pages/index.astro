          const rect = footballSection.getBoundingClientRect();
          gsap.to(followBall, {
            x: e.clientX - rect.left - 15,
            y: e.clientY - rect.top - 15,
            rotation: '+=10',
            duration: 0.3,
            ease: 'power2.out'
          });
        });
        
        footballSection.closest('section').addEventListener('mouseleave', () => {
          if (followBall) {
            gsap.to(followBall, {
              opacity: 0,
              scale: 0,
              duration: 0.3,
              onComplete: () => {
                if (followBall) {
                  followBall.remove();
                  followBall = null;
                }
              }
            });
          }
        });
      }
      
      // === ANIMACIONES GRADAS Y ELEMENTOS ADICIONALES ===
      
      // Animaciones de siluetas de jugadores
      gsap.utils.toArray('.player-silhouette').forEach((player, i) => {
        // Animación de correr
        gsap.to(player, {
          scrollTrigger: {
            trigger: player.closest('section'),
            start: 'top 80%',
            end: 'bottom 20%',
            scrub: 0.5
          },
          x: 100 * (i % 2 === 0 ? 1 : -1),
          ease: 'none'
        });
        
        // Movimiento de celebración ocasional
        gsap.to(player, {
          duration: 0.5,
          repeat: -1,
          delay: Math.random() * 5 + 3,
          ease: 'none',
          onStart: () => {
            if (Math.random() < 0.4) {
              gsap.timeline()
                .to(player, { scaleY: 1.3, duration: 0.2 })
                .to(player, { scaleY: 1, duration: 0.3 });
            }
          }
        });
      });
      
      // Animaciones de porterías
      gsap.utils.toArray('.goal').forEach((goal, i) => {
        gsap.to(goal, {
          scrollTrigger: {
            trigger: goal.closest('section'),
            start: 'top 70%',
            end: 'bottom 30%',
            scrub: 1
          },
          boxShadow: '0 0 15px rgba(255, 255, 255, 0.6)',
          borderColor: 'rgba(255, 255, 255, 0.8)',
          ease: 'none'
        });
      });
      
      // Animaciones de gradas con parallax
      gsap.utils.toArray('.stand-tier').forEach((tier, i) => {
        gsap.to(tier, {
          scrollTrigger: {
            trigger: tier.closest('section'),
            start: 'top bottom',
            end: 'bottom top',
            scrub: 0.3
          },
          y: -30 * (i + 1),
          ease: 'none'
        });
      });
      
      // Animaciones de banners ondeando
      gsap.utils.toArray('.banner').forEach((banner, i) => {
        // Movimiento con scroll
        gsap.to(banner, {
          scrollTrigger: {
            trigger: banner.closest('section'),
            start: 'top 80%',
            end: 'bottom 20%',
            scrub: 1
          },
          rotation: (i % 2 === 0 ? 10 : -10),
          scale: 1.1,
          ease: 'none'
        });
        
        // Efecto hover
        banner.addEventListener('mouseenter', () => {
          gsap.to(banner, {
            scale: 1.2,
            boxShadow: '0 8px 25px rgba(0, 0, 0, 0.4)',
            duration: 0.3,
            ease: 'power2.out'
          });
        });
        
        banner.addEventListener('mouseleave', () => {
          gsap.to(banner, {
            scale: 1,
            boxShadow: '0 4px 15px rgba(0, 0, 0, 0.3)',
            duration: 0.3,
            ease: 'power2.out'
          });
        });
      });
      
      // Animaciones de banderas
      gsap.utils.toArray('.flag').forEach((flag, i) => {
        gsap.to(flag, {
          scrollTrigger: {
            trigger: flag.closest('section'),
            start: 'top 75%',
            end: 'bottom 25%',
            scrub: 0.5
          },
          rotation: 15 * Math.sin(i),
          scale: 1.2,
          ease: 'none'
        });
      });
      
      // Animaciones de multitud por secciones
      gsap.utils.toArray('.crowd-section').forEach((section, i) => {
        // Ola de celebración
        gsap.to(section, {
          scrollTrigger: {
            trigger: section.closest('section'),
            start: 'top 70%',
            end: 'bottom 30%',
            scrub: 1
          },
          scaleY: 2 + i * 0.5,
          opacity: 0.8,
          ease: 'power2.inOut'
        });
        
        // Celebración en cadena
        gsap.to(section, {
          duration: 1,
          repeat: -1,
          delay: i * 0.8,
          ease: 'none',
          onStart: () => {
            gsap.timeline()
              .to(section, { scaleY: 2.5, duration: 0.3 })
              .to(section, { scaleY: 1, duration: 0.7 });
          }
        });
      });
      
      // Animaciones de confeti
      gsap.utils.toArray('.confetti').forEach((conf, i) => {
        // Efecto parallax
        gsap.to(conf, {
          scrollTrigger: {
            trigger: conf.closest('section'),
            start: 'top bottom',
            end: 'bottom top',
            scrub: 2
          },
          y: -300,
          rotation: 720,
          ease: 'none'
        });
        
        // Regeneración de confeti
        gsap.set(conf, {
          onComplete: () => {
            gsap.set(conf, { y: -10 });
          }
        });
      });
      
      // Animaciones de scoreboards
      gsap.utils.toArray('.scoreboard').forEach((board, i) => {
        // Entrada con scroll
        gsap.from(board, {
          scrollTrigger: {
            trigger: board.closest('section'),
            start: 'top 80%',
            toggleActions: 'play none none reverse'
          },
          y: -50,
          opacity: 0,
          duration: 1,
          ease: 'bounce.out',
          delay: i * 0.3
        });
        
        // Efecto de parpadeo digital
        gsap.to(board, {
          duration: 0.1,
          repeat: -1,
          delay: Math.random() * 8 + 4,
          ease: 'none',
          onStart: () => {
            gsap.timeline()
              .to(board, { opacity: 0.3, duration: 0.05 })
              .to(board, { opacity: 1, duration: 0.05 })
              .to(board, { opacity: 0.5, duration: 0.03 })
              .to(board, { opacity: 1, duration: 0.02 });
          }
        });
        
        // Hover effect
        board.addEventListener('mouseenter', () => {
          gsap.to(board, {
            scale: 1.1,
            boxShadow: '0 0 25px rgba(0, 255, 0, 0.8), inset 0 0 15px rgba(0, 80, 0, 0.4)',
            duration: 0.3,
            ease: 'power2.out'
          });
        });
        
        board.addEventListener('mouseleave', () => {
          gsap.to(board, {
            scale: 1,
            boxShadow: '0 0 10px rgba(0, 255, 0, 0.5), inset 0 0 10px rgba(0, 0, 0, 0.5)',
            duration: 0.3,
            ease: 'power2.out'
          });
        });
      });
      
      // Efecto de "ola" en las gradas con hover
      const standsSection = document.querySelector('.stadium-stands-bg');
      if (standsSection) {
        standsSection.closest('section').addEventListener('mouseenter', () => {
          // Ola de celebración en las gradas
          gsap.utils.toArray('.crowd-section').forEach((section, i) => {
            gsap.to(section, {
              scaleY: 3,
              duration: 0.3,
              delay: i * 0.1,
              ease: 'power2.out',
              onComplete: () => {
                gsap.to(section, {
                  scaleY: 1,
                  duration: 0.5,
                  ease: 'bounce.out'
                });
              }
            });
          });
          
          // Confeti extra
          gsap.utils.toArray('.confetti').forEach(conf => {
            gsap.to(conf, {
              scale: 1.5,
              opacity: 1,
              duration: 0.5,
              ease: 'power2.out'
            });
          });
        });
      }
      
      console.log('Animaciones futbolísticas cargadas correctamente');
    }
    
    // === CONTROL DE VIDEO CON SCROLL - VERSION SIMPLIFICADA Y ROBUSTA ===
    function initializeVideoScrollControl() {
      const video = document.getElementById('scroll-video');
      const videoSection = document.getElementById('video-scroll-section');
      const videoFallback = document.getElementById('video-fallback');
      
      if (!video || !videoSection) {
        console.error('❌ Video o sección no encontrados');
        return;
      }
      
      console.log('🎨 Inicializando control de video con scroll (versión robusta)...');
      
      // === CONFIGURACIÓN INICIAL FORZADA ===
      video.muted = true;
      video.defaultMuted = true;
      video.volume = 0;
      video.loop = false;
      video.playsinline = true;
      video.preload = 'auto';
      video.controls = false;
      video.setAttribute('webkit-playsinline', 'true');
      video.setAttribute('x5-playsinline', 'true');
      video.setAttribute('muted', 'true');
      
      // === VARIABLES DE ESTADO ===
      let videoScrollTrigger = null;
      let isVideoReady = false;
      let hasVideoLoaded = false;
      let debugInfo = {
        loadEvents: [],
        errors: [],
        attempts: 0
      };
      
      // === FUNCIÓN DE ACTUALIZACIÓN SIMPLIFICADA ===
      const updateVideoTime = (progress) => {
        if (!isVideoReady || !video.duration || isNaN(video.duration)) {
          return;
        }
        
        try {
          const targetTime = Math.max(0, Math.min(progress * video.duration, video.duration - 0.1));
          const currentDiff = Math.abs(video.currentTime - targetTime);
          
          // Solo actualizar si hay diferencia significativa
          if (currentDiff > 0.1) {
            video.currentTime = targetTime;
            console.log(`🎯 Video tiempo: ${targetTime.toFixed(2)}s (${(progress * 100).toFixed(1)}%)`);
          }
        } catch (error) {
          console.error('❌ Error actualizando video:', error);
          debugInfo.errors.push(error.message);
        }
      };
      
      // === MOSTRAR VIDEO CUANDO ESTÉ LISTO ===
      const showVideo = () => {
        video.style.opacity = '1';
        if (videoFallback) {
          videoFallback.style.opacity = '0';
          setTimeout(() => {
            videoFallback.style.display = 'none';
          }, 1000);
        }
        console.log('✅ Video mostrado correctamente');
      };
      
      // === CONFIGURAR EVENTOS DE VIDEO ===
      video.addEventListener('loadedmetadata', () => {
        console.log('🎨 Video metadata cargado');
        debugInfo.loadEvents.push('metadata');
        setupVideo();
      });
      
      video.addEventListener('loadeddata', () => {
        console.log('🎨 Video data cargado');
        debugInfo.loadEvents.push('data');
        setupVideo();
      });
      
      video.addEventListener('canplay', () => {
        console.log('🎨 Video can play');
        debugInfo.loadEvents.push('canplay');
        setupVideo();
      });
      
      video.addEventListener('canplaythrough', () => {
        console.log('🎨 Video can play through');
        debugInfo.loadEvents.push('canplaythrough');
        setupVideo();
      });
      
      // === CONFIGURAR VIDEO CUANDO ESTÉ LISTO ===
      const setupVideo = () => {
        if (hasVideoLoaded) return;
        
        // Verificar si el video tiene duración válida
        if (!video.duration || video.duration === Infinity || isNaN(video.duration)) {
          console.warn('⚠️ Video aún no tiene duración válida');
          return;
        }
        
        if (video.readyState < 2) {
          console.warn('⚠️ Video readyState insuficiente:', video.readyState);
          return;
        }
        
        hasVideoLoaded = true;
        isVideoReady = true;
        
        console.log('✅ Video completamente listo:', {
          duration: video.duration,
          readyState: video.readyState,
          videoWidth: video.videoWidth,
          videoHeight: video.videoHeight
        });
        
        // Mostrar el video
        showVideo();
        
        // Configurar ScrollTrigger
        if (videoScrollTrigger) {
          videoScrollTrigger.kill();
        }
        
        videoScrollTrigger = ScrollTrigger.create({
          trigger: videoSection,
          start: 'top bottom',
          end: 'bottom top',
          scrub: 0.5,
          onUpdate: (self) => {
            updateVideoTime(self.progress);
          },
          onRefresh: () => {
            console.log('🔄 ScrollTrigger actualizado');
          }
        });
        
        // Intentar reproducir brevemente y pausar (para iOS)
        try {
          const playPromise = video.play();
          if (playPromise !== undefined) {
            playPromise.then(() => {
              video.pause();
              video.currentTime = 0;
              console.log('✅ Video inicializado correctamente');
            }).catch(e => {
              console.warn('⚠️ No se pudo reproducir video:', e.message);
            });
          }
        } catch (e) {
          console.warn('⚠️ Error al inicializar video:', e.message);
        }
      };
      
      // === MANEJO DE ERRORES ===
      video.addEventListener('error', (e) => {
        console.error('❌ Error en video:', video.error);
        debugInfo.errors.push(video.error ? video.error.message : 'Error desconocido');
        
        // Intentar con el siguiente formato de video
        attemptNextVideoSource();
      });
      
      // === INTENTAR DIFERENTES FUENTES DE VIDEO ===
      const videoSources = ['/video.mp4', '/video2.webm'];
      let currentSourceIndex = 0;
      
      const attemptNextVideoSource = () => {
        currentSourceIndex++;
        if (currentSourceIndex < videoSources.length) {
          console.log(`🔄 Intentando siguiente fuente: ${videoSources[currentSourceIndex]}`);
          const newSource = document.createElement('source');
          newSource.src = videoSources[currentSourceIndex];
          newSource.type = currentSourceIndex === 0 ? 'video/mp4' : 'video/webm';
          video.innerHTML = '';
          video.appendChild(newSource);
          video.load();
        } else {
          console.error('❌ Todas las fuentes de video fallaron');
          // Mantener el fallback visible
        }
      };
      
      // === CARGAR EL VIDEO ===
      console.log('🔄 Iniciando carga de video...');
      video.load();
      
      // === TIMEOUT PARA FORZAR INICIO ===
      setTimeout(() => {
        if (!isVideoReady) {
          console.warn('⚠️ Video tardó más de 3 segundos, intentando forzar...');
          if (video.readyState >= 1) {
            setupVideo();
          } else {
            attemptNextVideoSource();
          }
        }
      }, 3000);
      
      // === CONTROLES DE DEBUG ===
      window.videoDebug = {
        video,
        videoSection,
        isReady: () => isVideoReady,
        forceSetup: () => setupVideo(),
        showVideo: () => showVideo(),
        state: () => debugInfo,
        nextSource: () => attemptNextVideoSource(),
        info: () => console.table({
          duration: video.duration,
          currentTime: video.currentTime,
          readyState: video.readyState,
          networkState: video.networkState,
          src: video.currentSrc,
          muted: video.muted,
          paused: video.paused
        })
      };
      
      console.log('✅ Sistema de video inicializado');
      console.log('💡 Debug disponible en window.videoDebug');
    }
</script>

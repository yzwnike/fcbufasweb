  // === SISTEMA DE PARTÍCULAS EN CANVAS ===
  function initializeParticleSystem() {
      const canvas = document.getElementById('particle-canvas');
      if (!canvas) return;
      
      const ctx = canvas.getContext('2d');
      const particles = [];
      const mouseParticles = [];
      let mouse = { x: 0, y: 0 };
      
      // Configurar canvas
      function resizeCanvas() {
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
      }
      
      resizeCanvas();
      window.addEventListener('resize', resizeCanvas);
      
      // Clase Partícula
      class Particle {
        constructor() {
          this.x = Math.random() * canvas.width;
          this.y = Math.random() * canvas.height;
          this.size = Math.random() * 3 + 1;
          this.speedX = (Math.random() - 0.5) * 2;
          this.speedY = (Math.random() - 0.5) * 2;
          this.opacity = Math.random() * 0.5 + 0.2;
          this.life = Math.random() * 200 + 100;
          this.maxLife = this.life;
          this.hue = Math.random() * 60 + 10; // Tonos naranjas
        }
        
        update() {
          this.x += this.speedX;
          this.y += this.speedY;
          this.life--;
          this.opacity = (this.life / this.maxLife) * 0.5;
          
          // Rebote en bordes
          if (this.x < 0 || this.x > canvas.width) this.speedX *= -1;
          if (this.y < 0 || this.y > canvas.height) this.speedY *= -1;
        }
        
        draw() {
          ctx.save();
          ctx.globalAlpha = this.opacity;
          ctx.fillStyle = `hsl(${this.hue}, 100%, 50%)`;
          ctx.shadowBlur = 10;
          ctx.shadowColor = `hsl(${this.hue}, 100%, 50%)`;
          ctx.beginPath();
          ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
          ctx.fill();
          ctx.restore();
        }
      }
      
      // Crear partículas iniciales
      for (let i = 0; i < 80; i++) {
        particles.push(new Particle());
      }
      
      // Seguimiento del mouse
      document.addEventListener('mousemove', (e) => {
        mouse.x = e.clientX;
        mouse.y = e.clientY;
        
        // Crear partículas del mouse
        if (Math.random() < 0.3) {
          mouseParticles.push({
            x: mouse.x,
            y: mouse.y,
            size: Math.random() * 5 + 2,
            life: 60,
            maxLife: 60,
            speedX: (Math.random() - 0.5) * 4,
            speedY: (Math.random() - 0.5) * 4,
            hue: Math.random() * 60 + 10
          });
        }
      });
      
      // Loop de animación
      function animate() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        
        // Actualizar y dibujar partículas principales
        for (let i = particles.length - 1; i >= 0; i--) {
          particles[i].update();
          particles[i].draw();
          
          if (particles[i].life <= 0) {
            particles.splice(i, 1);
            particles.push(new Particle()); // Reemplazar
          }
        }
        
        // Actualizar y dibujar partículas del mouse
        for (let i = mouseParticles.length - 1; i >= 0; i--) {
          const p = mouseParticles[i];
          p.x += p.speedX;
          p.y += p.speedY;
          p.life--;
          
          ctx.save();
          ctx.globalAlpha = p.life / p.maxLife;
          ctx.fillStyle = `hsl(${p.hue}, 100%, 60%)`;
          ctx.shadowBlur = 15;
          ctx.shadowColor = `hsl(${p.hue}, 100%, 60%)`;
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
          ctx.fill();
          ctx.restore();
          
          if (p.life <= 0) {
            mouseParticles.splice(i, 1);
          }
        }
        
        // Conectar partículas cercanas
        for (let i = 0; i < particles.length; i++) {
          for (let j = i + 1; j < particles.length; j++) {
            const dx = particles[i].x - particles[j].x;
            const dy = particles[i].y - particles[j].y;
            const distance = Math.sqrt(dx * dx + dy * dy);
            
            if (distance < 100) {
              ctx.save();
              ctx.globalAlpha = (100 - distance) / 100 * 0.3;
              ctx.strokeStyle = '#ff6b35';
              ctx.lineWidth = 1;
              ctx.beginPath();
              ctx.moveTo(particles[i].x, particles[i].y);
              ctx.lineTo(particles[j].x, particles[j].y);
              ctx.stroke();
              ctx.restore();
            }
          }
        }
        
        requestAnimationFrame(animate);
      }
      
      animate();
    }
    
    // === EFECTOS ESPECIALES AVANZADOS ===
    function initializeAdvancedEffects() {
      // Animación de las partículas flotantes con GSAP
      gsap.utils.toArray('.floating-particle').forEach((particle, i) => {

            path: `M${mouseX},${mouseY}`,
            offsetX: (i % 4) * 50 - 100,
            offsetY: (i % 4) * 50 - 100
          }
        }).eventCallback('onUpdate', function() {
          this.vars.motionPath.path = `M${mouseX + (Math.sin(Date.now() * 0.001 + i) * 50)},${mouseY + (Math.cos(Date.now() * 0.001 + i) * 50)}`;
        });
      });
      
      // Creación dinámica de partículas temporales
      setInterval(() => {
        createTemporaryParticle();
      }, 2000);
      
      function createTemporaryParticle() {
        const particle = document.createElement('div');
        particle.className = 'temp-particle';

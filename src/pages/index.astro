      rgba(200, 50, 20, 0.5) 6px,
      rgba(150, 40, 15, 0.4) 6px,
      rgba(150, 40, 15, 0.4) 8px,
      rgba(100, 30, 10, 0.3) 8px,
      rgba(100, 30, 10, 0.3) 10px);
    animation: crowdCheer2 3s ease-in-out infinite;
    border-radius: 3px;
    box-shadow: 0 3px 10px rgba(255, 107, 53, 0.4);
    border-top: 2px solid rgba(255, 140, 0, 0.3);
  }
  
  .section-1 { top: 10px; left: 0; width: 25%; animation-delay: 0s; }
  .section-2 { top: 30px; left: 20%; width: 30%; animation-delay: 0.5s; }
  .section-3 { top: 50px; left: 40%; width: 35%; animation-delay: 1s; }
  .section-4 { top: 70px; left: 65%; width: 30%; animation-delay: 1.5s; }
  .section-5 { top: 90px; left: 0; width: 100%; animation-delay: 2s; }
  
  @keyframes crowdCheer2 {
    0%, 100% { transform: scaleY(1) scaleX(1); opacity: 0.6; }
    20% { transform: scaleY(2.2) scaleX(1.1); opacity: 0.9; }
    40% { transform: scaleY(1.3) scaleX(0.95); opacity: 0.7; }
    60% { transform: scaleY(2.8) scaleX(1.15); opacity: 1; }
    80% { transform: scaleY(1.5) scaleX(1.05); opacity: 0.8; }
  }
  
  /* Confeti mejorado */
  .confetti {
    position: absolute;
    width: 15px;
    height: 15px;
    background: linear-gradient(45deg, 
      rgba(255, 107, 53, 0.95), 
      rgba(255, 69, 0, 0.9),
      rgba(255, 140, 0, 0.85),
      rgba(255, 215, 0, 0.8),
      rgba(255, 165, 0, 0.75));
    border-radius: 50%;
    animation: confettiFall 3s ease-in-out infinite;
    box-shadow: 0 0 20px rgba(255, 107, 53, 0.7), 0 0 40px rgba(255, 69, 0, 0.4);
    border: 2px solid rgba(255, 255, 255, 0.3);
  }
  
  .confetti-1 { top: -30px; left: 5%; animation-delay: 0s; }
  .confetti-2 { top: -40px; left: 20%; animation-delay: 0.3s; }
  .confetti-3 { top: -35px; left: 35%; animation-delay: 0.6s; }
  .confetti-4 { top: -45px; left: 50%; animation-delay: 0.9s; }
  .confetti-5 { top: -32px; left: 65%; animation-delay: 1.2s; }
  .confetti-6 { top: -38px; left: 80%; animation-delay: 1.5s; }
  
  @keyframes confettiFall {
    0% { transform: translateY(0) rotate(0deg) scale(0); opacity: 0; }
    10% { transform: translateY(30px) rotate(72deg) scale(1.2); opacity: 1; }
    25% { transform: translateY(100px) rotate(180deg) scale(1); opacity: 0.9; }
    50% { transform: translateY(200px) rotate(360deg) scale(0.8); opacity: 0.8; }
    75% { transform: translateY(300px) rotate(540deg) scale(1.1); opacity: 0.6; }
    90% { transform: translateY(380px) rotate(680deg) scale(0.9); opacity: 0.3; }
    100% { transform: translateY(450px) rotate(720deg) scale(0); opacity: 0; }
  }
  
  /* Scoreboards digitales */
  .scoreboard {
    position: absolute;
    top: 15px;
    padding: 6px 12px;
    background: linear-gradient(135deg, 
      rgba(0, 0, 0, 0.8), 
      rgba(20, 20, 20, 0.9));
    color: #00ff00;
    font-family: 'Courier New', monospace;
    font-size: 12px;
    font-weight: bold;
    border: 2px solid rgba(0, 255, 0, 0.3);
    border-radius: 4px;
    box-shadow: 
      0 0 10px rgba(0, 255, 0, 0.5),
      inset 0 0 10px rgba(0, 0, 0, 0.5);
    animation: scoreboardGlow 3s ease-in-out infinite;
  }
  
  .scoreboard-left { left: 20px; }
  .scoreboard-right { right: 20px; }
  
  @keyframes scoreboardGlow {
    0%, 100% { 
      box-shadow: 0 0 10px rgba(0, 255, 0, 0.5), inset 0 0 10px rgba(0, 0, 0, 0.5);
      color: #00ff00;
    }
    50% { 
      box-shadow: 0 0 20px rgba(0, 255, 0, 0.8), inset 0 0 15px rgba(0, 50, 0, 0.3);
      color: #00ff88;
    }
  }
  
  /* === ELEMENTOS ADICIONALES DEL ESTADIO === */
  
  /* Banderas adicionales */
  .flag-4 { top: 120px; left: 30%; animation-delay: 3s; }
  .flag-5 { top: 140px; right: 35%; animation-delay: 4s; }
  .flag-6 { top: 160px; left: 70%; animation-delay: 2.5s; }
  .flag-7 { top: 180px; right: 50%; animation-delay: 3.5s; }
  
  /* Reflectores del estadio */
  .stadium-light {
    position: absolute;
    width: 80px;
    height: 80px;
    background: radial-gradient(circle, 
      rgba(255, 255, 200, 0.5) 0%, 
      rgba(255, 255, 255, 0.3) 30%, 
      rgba(255, 255, 100, 0.2) 60%, 
      transparent 100%);
    border-radius: 50%;
    animation: stadiumLightPulse 5s ease-in-out infinite;
    filter: blur(3px);
    box-shadow: 0 0 50px rgba(255, 255, 200, 0.4);
  }
  
  .stadium-light.light-1 {
    top: 50px; left: 10%;
    animation-delay: 0s;
  }
  .stadium-light.light-2 {
    top: 80px; right: 10%;
    animation-delay: 1.5s;
  }
  .stadium-light.light-3 {
    top: 150px; left: 60%;
    animation-delay: 3s;
  }
  .stadium-light.light-4 {
    top: 200px; right: 40%;
    animation-delay: 4.5s;
  }
  
  @keyframes stadiumLightPulse {
    0%, 100% { opacity: 0.4; transform: scale(1); }
    50% { opacity: 0.8; transform: scale(1.2); }
  }
  
  /* Multitud extendida */
  .section-6 { top: 110px; left: 10%; width: 22%; animation-delay: 2.5s; }
  .section-7 { top: 130px; left: 35%; width: 28%; animation-delay: 3s; }
  .section-8 { top: 150px; left: 55%; width: 25%; animation-delay: 3.5s; }
  .section-9 { top: 170px; left: 75%; width: 20%; animation-delay: 4s; }
  .section-10 { top: 190px; left: 0; width: 100%; animation-delay: 4.5s; }
  
  /* Confeti adicional */
  .confetti-7 { top: -25px; left: 10%; animation-delay: 1.8s; }
  .confetti-8 { top: -42px; left: 30%; animation-delay: 2.1s; }
  .confetti-9 { top: -36px; left: 60%; animation-delay: 2.4s; }
  .confetti-10 { top: -48px; left: 85%; animation-delay: 2.7s; }
  
  /* Efectos de ambiente */
  .stadium-glow {
    position: absolute;
    border-radius: 50%;
    background: radial-gradient(circle, 
      rgba(255, 107, 53, 0.3) 0%, 
      rgba(255, 69, 0, 0.2) 40%, 
      rgba(255, 140, 0, 0.1) 70%, 
      transparent 100%);
    filter: blur(40px);
    animation: stadiumGlowPulse 6s ease-in-out infinite;
  }
  
  .stadium-glow.glow-1 {
    width: 200px; height: 200px;
    top: 100px; left: 20%;
    animation-delay: 0s;
  }
  .stadium-glow.glow-2 {
    width: 250px; height: 250px;
    top: 150px; right: 15%;
    animation-delay: 2s;
  }
  .stadium-glow.glow-3 {
    width: 180px; height: 180px;
    top: 200px; left: 60%;
    animation-delay: 4s;
  }
  
  @keyframes stadiumGlowPulse {
    0%, 100% { opacity: 0.2; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(1.3); }
  }
  
  /* Marcadores de tiempo */
  .time-display, .season-display {
    position: absolute;
    font-family: 'Arial Black', Arial, sans-serif;
    font-weight: 900;
    color: rgba(255, 107, 53, 0.3);
    font-size: 48px;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.2);
    animation: timeDisplayFloat 8s ease-in-out infinite;
    user-select: none;
    pointer-events: none;
  }
  
  .time-display {
    top: 50px;
    left: 5%;
    transform: rotate(-15deg);
    animation-delay: 0s;
  }
  
  .season-display {
    bottom: 100px;
    right: 5%;
    transform: rotate(10deg);
    animation-delay: 4s;
    font-size: 36px;
  }
  
  @keyframes timeDisplayFloat {
    0%, 100% { opacity: 0.2; transform: rotate(-15deg) translateY(0); }
    50% { opacity: 0.4; transform: rotate(-15deg) translateY(-20px); }
  }
  
  /* Patrones de césped extendidos */
  .grass-texture {
    position: absolute;
    width: 300px;
    height: 100px;
    background: repeating-linear-gradient(45deg, 
      rgba(34, 139, 34, 0.1) 0px, 
      rgba(34, 139, 34, 0.1) 4px, 
      rgba(0, 100, 0, 0.15) 4px, 
      rgba(0, 100, 0, 0.15) 8px,
      rgba(50, 150, 50, 0.08) 8px,
      rgba(50, 150, 50, 0.08) 12px);
    border-radius: 10px;
    animation: grassTextureWave 12s ease-in-out infinite;
    opacity: 0.6;
  }
  
  .grass-texture.texture-1 {
    top: 300px; left: 10%;
    animation-delay: 0s;
    transform: rotate(-5deg);
  }
  .grass-texture.texture-2 {
    top: 250px; right: 20%;
    animation-delay: 4s;
    transform: rotate(8deg);
  }
  .grass-texture.texture-3 {
    bottom: 200px; left: 50%;
    animation-delay: 8s;
    transform: rotate(-3deg);
  }
  
  @keyframes grassTextureWave {
    0%, 100% { opacity: 0.4; transform: rotate(var(--rotation, 0deg)) scale(1); }
    50% { opacity: 0.7; transform: rotate(var(--rotation, 0deg)) scale(1.05); }
  }
  
  /* === ELEMENTOS ADICIONALES EXTENDIDOS === */
  
  /* Banderas adicionales inferiores */
  .flag-8 { top: 250px; left: 15%; animation-delay: 5s; }
  .flag-9 { top: 300px; right: 25%; animation-delay: 5.5s; }
  .flag-10 { top: 350px; left: 55%; animation-delay: 6s; }
  .flag-11 { top: 400px; right: 10%; animation-delay: 6.5s; }
  
  /* Reflectores adicionales inferiores */
  .stadium-light.light-5 {
    top: 300px; left: 25%;
    animation-delay: 6s;
  }
  .stadium-light.light-6 {
    top: 350px; right: 30%;
    animation-delay: 7s;
  }
  .stadium-light.light-7 {
    top: 400px; left: 70%;
    animation-delay: 8s;
  }
  .stadium-light.light-8 {
    top: 450px; right: 60%;
    animation-delay: 9s;
  }
  
  /* Multitud extendida - niveles inferiores */
  .section-11 { top: 220px; left: 5%; width: 30%; animation-delay: 5s; }
  .section-12 { top: 240px; left: 40%; width: 25%; animation-delay: 5.5s; }
  .section-13 { top: 270px; left: 70%; width: 28%; animation-delay: 6s; }
  .section-14 { top: 300px; left: 15%; width: 35%; animation-delay: 6.5s; }
  .section-15 { top: 330px; left: 55%; width: 40%; animation-delay: 7s; }
  .section-16 { top: 360px; left: 0; width: 50%; animation-delay: 7.5s; }
  .section-17 { top: 390px; left: 30%; width: 45%; animation-delay: 8s; }
  .section-18 { top: 420px; left: 0; width: 100%; animation-delay: 8.5s; }
  
  /* Confeti adicional extendido */
  .confetti-11 { top: -28px; left: 15%; animation-delay: 3s; }
  .confetti-12 { top: -44px; left: 40%; animation-delay: 3.3s; }
  .confetti-13 { top: -32px; left: 65%; animation-delay: 3.6s; }
  .confetti-14 { top: -50px; left: 90%; animation-delay: 3.9s; }
  .confetti-15 { top: -46px; left: 75%; animation-delay: 4.2s; }
  
  /* Efectos de ambiente adicionales */
  .stadium-glow.glow-4 {
    width: 220px; height: 220px;
    top: 300px; left: 10%;
    animation-delay: 1s;
  }
  .stadium-glow.glow-5 {
    width: 190px; height: 190px;
    top: 350px; right: 20%;
    animation-delay: 3s;
  }
  .stadium-glow.glow-6 {
    width: 260px; height: 260px;
    top: 400px; left: 70%;
    animation-delay: 5s;
  }
  
  /* Marcadores de tiempo adicionales */
  .season-mid {
    top: 250px;
    left: 50%;
    transform: rotate(5deg);
    animation-delay: 2s;
    font-size: 42px;
  }
  
  .season-bottom {
    bottom: 50px;
    left: 10%;
    transform: rotate(-8deg);
    animation-delay: 6s;
    font-size: 32px;
  }
  
  /* Patrones de césped adicionales */
  .grass-texture.texture-4 {
    top: 350px; right: 30%;
    animation-delay: 2s;
    transform: rotate(12deg);
  }
  .grass-texture.texture-5 {
    bottom: 150px; left: 20%;
    animation-delay: 6s;
    transform: rotate(-7deg);
  }
  .grass-texture.texture-6 {
    bottom: 100px; right: 10%;
    animation-delay: 10s;
    transform: rotate(4deg);
  }
  .grass-texture.texture-7 {
    top: 500px; left: 60%;
    animation-delay: 12s;
    transform: rotate(-10deg);
  }
  
  /* === GRADAS INFERIORES === */
  
  .lower-stands {
    position: absolute;
    bottom: 0;
    width: 100%;
    height: 250px;
    z-index: 1;
  }
  
  .stand-lower-1 {
    bottom: 0; 
    height: 120px;
    opacity: 0.75;
    background: linear-gradient(90deg, 
      rgba(80, 80, 80, 0.4) 0%, 
      rgba(100, 100, 100, 0.5) 20%,
      rgba(120, 120, 120, 0.6) 40%,
      rgba(140, 140, 140, 0.7) 60%,
      rgba(120, 120, 120, 0.6) 80%,
      rgba(80, 80, 80, 0.4) 100%);
  }
  
  .stand-lower-2 {
    bottom: 100px;
    height: 110px;
    opacity: 0.7;
    background: linear-gradient(90deg, 
      rgba(60, 60, 60, 0.3) 0%, 
      rgba(90, 90, 90, 0.4) 25%,
      rgba(110, 110, 110, 0.5) 50%,
      rgba(90, 90, 90, 0.4) 75%,
      rgba(60, 60, 60, 0.3) 100%);
  }
  
  .stand-lower-3 {
    bottom: 180px;
    height: 100px;
    opacity: 0.65;
    background: linear-gradient(90deg, 
      rgba(40, 40, 40, 0.2) 0%, 
      rgba(70, 70, 70, 0.3) 30%,
      rgba(90, 90, 90, 0.4) 60%,
      rgba(70, 70, 70, 0.3) 90%,
      rgba(40, 40, 40, 0.2) 100%);
  }
  
  /* === ELEMENTOS DE CAMPO INFERIORES === */
  
  .field-elements-bottom {
    position: absolute;
    bottom: 0;
    width: 100%;
    height: 200px;
    z-index: 2;
  }
  
  .penalty-spot {
    position: absolute;
    width: 8px;
    height: 8px;
    background: rgba(255, 255, 255, 0.6);
    border-radius: 50%;
    box-shadow: 0 0 10px rgba(255, 255, 255, 0.4);
    animation: penaltySpotGlow 4s ease-in-out infinite;
  }
  
  .penalty-spot.spot-1 {
    bottom: 120px;
    left: 15%;
    animation-delay: 0s;
  }
  
  .penalty-spot.spot-2 {
    bottom: 120px;
    right: 15%;
    animation-delay: 2s;
  }
  
  @keyframes penaltySpotGlow {
    0%, 100% { opacity: 0.4; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.5); }
  }
  
  .corner-flag {
    position: absolute;
    width: 4px;
    height: 25px;
    background: rgba(255, 255, 255, 0.7);
    border-radius: 2px;
  }
  
  .corner-flag::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 15px;
    height: 10px;
    background: linear-gradient(45deg, #ff4500, #ff6b35);
    border-radius: 2px;
    animation: flagWave 3s ease-in-out infinite;
  }
  
  .corner-flag.corner-1 { bottom: 20px; left: 5%; }
  .corner-flag.corner-2 { bottom: 20px; right: 5%; }
  .corner-flag.corner-3 { bottom: 80px; left: 25%; }
  .corner-flag.corner-4 { bottom: 80px; right: 25%; }
  
  /* === TRIBUNA VIP === */
  
  .vip-section {
    position: absolute;
    top: 100px;
    width: 100%;
    height: 80px;
    z-index: 3;
  }
  
  .vip-box {
    position: absolute;
    width: 120px;
    height: 60px;
    background: linear-gradient(135deg, 
      rgba(255, 215, 0, 0.3) 0%, 
      rgba(255, 140, 0, 0.4) 50%, 
      rgba(255, 69, 0, 0.3) 100%);
    border: 2px solid rgba(255, 215, 0, 0.5);
    border-radius: 8px;
    box-shadow: 0 4px 15px rgba(255, 140, 0, 0.3);
    animation: vipBoxGlow 6s ease-in-out infinite;
  }
  
  .vip-box.box-1 {
    top: 10px;
    left: 20%;
    animation-delay: 0s;
  }
  
  .vip-box.box-2 {
    top: 10px;
    left: 50%;
    transform: translateX(-50%);
    animation-delay: 2s;
  }
  
  .vip-box.box-3 {
    top: 10px;
    right: 20%;
    animation-delay: 4s;
  }
  
  @keyframes vipBoxGlow {
    0%, 100% { 
      box-shadow: 0 4px 15px rgba(255, 140, 0, 0.3);
      border-color: rgba(255, 215, 0, 0.5);
    }
    50% { 
      box-shadow: 0 6px 25px rgba(255, 140, 0, 0.6);
      border-color: rgba(255, 215, 0, 0.8);
    }
  }
  
  /* === PANTALLA GIGANTE DEL ESTADIO === */
  
  .stadium-screen {
    position: absolute;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    width: 200px;
    height: 100px;
    background: linear-gradient(135deg, 
      rgba(0, 0, 0, 0.9) 0%, 
      rgba(30, 30, 30, 0.8) 50%, 
      rgba(0, 0, 0, 0.9) 100%);
    border: 3px solid rgba(100, 100, 100, 0.6);
    border-radius: 10px;
    box-shadow: 
      0 0 20px rgba(0, 255, 255, 0.4),
      inset 0 0 10px rgba(0, 0, 0, 0.7);
    animation: stadiumScreenFlicker 8s ease-in-out infinite;
  }
  
  .screen-frame {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    color: #00ffff;
    font-family: 'Courier New', monospace;
    font-size: 14px;
    font-weight: bold;
    text-align: center;
    text-shadow: 0 0 10px #00ffff;
    animation: screenTextGlow 3s ease-in-out infinite;
  }
  
  @keyframes stadiumScreenFlicker {
    0%, 100% { 
      box-shadow: 0 0 20px rgba(0, 255, 255, 0.4), inset 0 0 10px rgba(0, 0, 0, 0.7);
    }
    25% { 
      box-shadow: 0 0 30px rgba(0, 255, 255, 0.6), inset 0 0 15px rgba(0, 50, 50, 0.3);
    }
    50% { 
      box-shadow: 0 0 25px rgba(0, 255, 255, 0.5), inset 0 0 12px rgba(0, 0, 0, 0.8);
    }
    75% { 
      box-shadow: 0 0 35px rgba(0, 255, 255, 0.7), inset 0 0 18px rgba(0, 80, 80, 0.4);
    }
  }
  
  @keyframes screenTextGlow {
    0%, 100% { 
      color: #00ffff;
      text-shadow: 0 0 10px #00ffff;
    }
    50% { 
      color: #00cccc;
      text-shadow: 0 0 20px #00ffff, 0 0 30px #00cccc;
    }
  }
  
  /* === ESTILOS ESPECÍFICOS PARA MEJORAR RESPONSIVE === */
  
  /* Grid de estadísticas estable - Asegurar visibilidad */
  .stats-grid {
    display: grid !important;
    opacity: 1 !important;
    visibility: visible !important;
    transform: none !important;
    position: relative !important;
    z-index: 20 !important;
  }
  
  /* Mejora de visibilidad en stats cards */
  .stats-card {
    background: rgba(255, 255, 255, 0.98) !important;
    backdrop-filter: blur(10px) !important;
    border: 1px solid rgba(255, 107, 53, 0.2) !important;
    opacity: 1 !important;
    visibility: visible !important;
    transform: translateY(0) scale(1) !important;
    position: relative !important;
    min-height: 120px;
    display: flex !important;
    flex-direction: column !important;
    justify-content: center !important;
  }
  
  .stats-card .text-gray-700 {
    color: rgb(55, 65, 81) !important;
    font-weight: 600 !important;
  }
  
  /* Mejora de la sección match-card */
  .match-card {
    background: rgba(255, 255, 255, 0.12) !important;
    backdrop-filter: blur(25px) !important;
    border: 1px solid rgba(255, 255, 255, 0.15) !important;
  }
  
  /* Responsividad mejorada */
  @media (max-width: 768px) {
    .stadium-light {
      width: 50px;
      height: 50px;
    }
    
    .time-display {
      font-size: 24px;
    }
    
    .season-display {
      font-size: 18px;
    }
    
    .grass-texture {
      width: 200px;
      height: 60px;
    }
    
    .stadium-screen {
      width: 120px;
      height: 60px;
    }
    
    .screen-frame {
      font-size: 10px;
    }
    
    .vip-box {
      width: 80px;
      height: 40px;
    }
    
    .lower-stands {
      height: 150px;
    }
    
    .stand-lower-1 { height: 80px; }
    .stand-lower-2 { height: 70px; bottom: 70px; }
    .stand-lower-3 { height: 60px; bottom: 120px; }
  }
  
  /* Responsive específico para pantallas muy pequeñas */
  @media (max-width: 640px) {
    .stats-card {
      padding: 1rem !important;
    }
    
    .stats-card .text-2xl {
      font-size: 1.5rem !important;
    }
    
    .match-card {
      padding: 1rem !important;
    }
    
    /* Asegurar que el texto no se salga del viewport */
    .whitespace-nowrap {
      white-space: normal !important;
      word-wrap: break-word;
    }
    
    /* Mejora del header de match */
    .bg-gradient-to-r.from-orange-400.to-red-400 {
      font-size: 0.75rem !important;
      padding: 0.5rem 1rem !important;
    }
    
    /* Ajustar texto VS para móviles */
    .text-4xl {
      font-size: 2rem !important;
    }
    
    .text-5xl {
      font-size: 2.5rem !important;
    }
    
    .text-6xl {
      font-size: 3rem !important;
    }
    

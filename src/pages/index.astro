---
import Hero from '@/sections/Hero.astro'
import Layout from '@/layouts/Layout.astro'
import { FIGHTERS } from '../consts/fighters'
import { clasificacion } from '../consts/clasificacion'
import { gsap } from 'gsap'
import { ScrollTrigger } from 'gsap/ScrollTrigger'

const title = 'Web Oficial FC Bufas - Estreno Temporada 2025/26'
const description =
  'Web oficial del equipo de la liga profesional de Tiki Taka, web creada en vista de la temporada 2025-26.'
const canonical = 'https://www.fcbufasweb.vercel.app/'

export const prerender = true

// Datos reales de FC Bufas desde la clasificación
const fcBufasData = clasificacion.find(equipo => equipo.nombre === 'Fc Bufas')
const teamStats = {
  partidos: fcBufasData?.partidosJugados || 0,
  victorias: fcBufasData?.ganados || 0,
  empates: fcBufasData?.empatados || 0,
  derrotas: fcBufasData?.perdidos || 0,
  golesFavor: fcBufasData?.golesFavor || 0,
  golesContra: fcBufasData?.golesContra || 0
}

// Próximo partido - Jornada 2
const nextMatch = {
  jornada: 'J2',
  fecha: new Date('2025-09-24T20:30:00+02:00'),
  rival: 'Al-Khasino',
  campo: 'Garbí',
  imagen: '/images/equipos/equipovacio.png'
}

// Último partido jugado - J1
const lastResults = [
  {
    jornada: 'J1',
    fecha: '17 Sep 2025',
    rival: 'Pitis FC',
    resultado: '1-5',
    tipo: 'derrota',
    local: true
  }
]

// Jugadores destacados - Top 4 por variación de mercado
const topPlayers = FIGHTERS
  .filter(f => f.valorTotal !== undefined && f.historialValores && f.historialValores.length >= 2)
  .sort((a, b) => {
    // Calcular variación porcentual del valor de mercado
    const historialA = a.historialValores || []
    const historialB = b.historialValores || []
    
    const variacionA = historialA.length >= 2 
      ? Math.abs((historialA[historialA.length - 1].valor - historialA[0].valor) / historialA[0].valor * 100)
      : 0
    const variacionB = historialB.length >= 2 
      ? Math.abs((historialB[historialB.length - 1].valor - historialB[0].valor) / historialB[0].valor * 100)
      : 0
    
    // Si hay empate en variación, desempatar por valor base
    if (Math.abs(variacionA - variacionB) < 0.1) {
      return (b.valorTotal || 0) - (a.valorTotal || 0)
    }
    
    return variacionB - variacionA
  })
  .slice(0, 4)

// Formatear fecha
const formatDate = (date: Date) => {
  const options: Intl.DateTimeFormatOptions = {
    weekday: 'short',
    day: '2-digit',
    month: '2-digit'
  }
  return date.toLocaleDateString('es-ES', options)
}

// Formatear hora
const formatTime = (date: Date) => {
  return date.toLocaleTimeString('es-ES', { 
    hour: '2-digit', 
    minute: '2-digit',
    hour12: false 
  }) + 'h'
}
---

<Layout title={title} description={description} canonical={canonical}>
  <!-- Fondo espectacular con partículas y efectos -->
  <div class="fixed inset-0 overflow-hidden pointer-events-none" id="background-container">
    <!-- Gradiente base animado -->
    <div class="animated-bg absolute inset-0"></div>
    
    <!-- Sistema de partículas -->
    <div class="particles-layer absolute inset-0">
      <!-- Partículas flotantes grandes -->
      <div class="floating-particle particle-1" data-speed="0.5"></div>
      <div class="floating-particle particle-2" data-speed="0.3"></div>
      <div class="floating-particle particle-3" data-speed="0.7"></div>
      <div class="floating-particle particle-4" data-speed="0.4"></div>
      <div class="floating-particle particle-5" data-speed="0.6"></div>
      <div class="floating-particle particle-6" data-speed="0.8"></div>
      
      <!-- Partículas medianas con brillo -->
      <div class="glowing-particle glow-1"></div>
      <div class="glowing-particle glow-2"></div>
      <div class="glowing-particle glow-3"></div>
      <div class="glowing-particle glow-4"></div>
      <div class="glowing-particle glow-5"></div>
      <div class="glowing-particle glow-6"></div>
      <div class="glowing-particle glow-7"></div>
      <div class="glowing-particle glow-8"></div>
      
      <!-- Estrellas pequeñas -->
      <div class="star-particle star-1"></div>
      <div class="star-particle star-2"></div>
      <div class="star-particle star-3"></div>
      <div class="star-particle star-4"></div>
      <div class="star-particle star-5"></div>
      <div class="star-particle star-6"></div>
      <div class="star-particle star-7"></div>
      <div class="star-particle star-8"></div>
      <div class="star-particle star-9"></div>
      <div class="star-particle star-10"></div>
      <div class="star-particle star-11"></div>
      <div class="star-particle star-12"></div>
      
      <!-- Efectos de luz ambiental -->
      <div class="ambient-light light-1"></div>
      <div class="ambient-light light-2"></div>
      <div class="ambient-light light-3"></div>
      <div class="ambient-light light-4"></div>
      
      <!-- Ondas de energía -->
      <div class="energy-wave wave-1"></div>
      <div class="energy-wave wave-2"></div>
      <div class="energy-wave wave-3"></div>
    </div>
    
    <!-- Canvas para partículas dinámicas -->
    <canvas id="particle-canvas" class="absolute inset-0 w-full h-full"></canvas>
    
    <!-- Overlay sutil para legibilidad -->
    <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-transparent to-black/30"></div>
  </div>
  
  <Hero />
  
  <!-- Sección de Estadísticas -->
  <section class="relative py-20 bg-gradient-to-br from-slate-50 to-orange-50 overflow-hidden">
    <!-- Fondo futbolístico animado -->
    <div class="absolute inset-0 football-field-bg">
      <!-- Patrón de césped -->
      <div class="grass-pattern absolute inset-0 opacity-10"></div>
      
      <!-- Líneas de campo -->
      <div class="field-lines absolute inset-0">
        <div class="center-line"></div>
        <div class="center-circle"></div>
        <div class="penalty-area-left"></div>
        <div class="penalty-area-right"></div>
      </div>
      
      <!-- Balones animados -->
      <div class="football-ball ball-1"></div>
      <div class="football-ball ball-2"></div>
      <div class="football-ball ball-3"></div>
      <div class="football-ball ball-4"></div>
      <div class="football-ball ball-5"></div>
      
      <!-- Jugadores silueta -->
      <div class="player-silhouettes">
        <div class="player-silhouette player-1"></div>
        <div class="player-silhouette player-2"></div>
        <div class="player-silhouette player-3"></div>
      </div>
      
      <!-- Porterías -->
      <div class="football-goals">
        <div class="goal goal-left"></div>
        <div class="goal goal-right"></div>
      </div>
      
      <!-- Efectos de movimiento -->
      <div class="ball-trail trail-1"></div>
      <div class="ball-trail trail-2"></div>
      <div class="ball-trail trail-3"></div>
      
      <!-- Overlay sutil -->
      <div class="absolute inset-0 bg-gradient-to-b from-white/40 via-transparent to-white/60"></div>
    </div>
    
    <div class="container mx-auto px-4 relative z-10">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold text-gray-900 mb-4">Temporada 2025/26</h2>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">Los números que definen nuestro rendimiento en la liga profesional Tiki Taka</p>
      </div>
      
      <!-- Grid responsive mejorado - Mostrar todos los elementos -->
      <div class="stats-grid grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-3 sm:gap-4 lg:gap-6 max-w-6xl mx-auto" style="opacity: 1; visibility: visible;">
        <div class="stats-card bg-white rounded-xl p-4 sm:p-6 shadow-lg hover:shadow-xl transition-all duration-300 hover:scale-105" style="opacity: 1; transform: none;">
          <div class="text-2xl sm:text-3xl font-black text-blue-600 mb-2" data-counter="{teamStats.partidos}">{teamStats.partidos}</div>
          <div class="text-xs sm:text-sm font-medium text-gray-700 uppercase tracking-wide">Partidos</div>
        </div>
        
        <div class="stats-card bg-white rounded-xl p-4 sm:p-6 shadow-lg hover:shadow-xl transition-all duration-300 hover:scale-105" style="opacity: 1; transform: none;">
          <div class="text-2xl sm:text-3xl font-black text-green-600 mb-2" data-counter="{teamStats.victorias}">{teamStats.victorias}</div>
          <div class="text-xs sm:text-sm font-medium text-gray-700 uppercase tracking-wide">Victorias</div>
        </div>
        
        <div class="stats-card bg-white rounded-xl p-4 sm:p-6 shadow-lg hover:shadow-xl transition-all duration-300 hover:scale-105" style="opacity: 1; transform: none;">
          <div class="text-2xl sm:text-3xl font-black text-yellow-600 mb-2" data-counter="{teamStats.empates}">{teamStats.empates}</div>
          <div class="text-xs sm:text-sm font-medium text-gray-700 uppercase tracking-wide">Empates</div>
        </div>
        
        <div class="stats-card bg-white rounded-xl p-4 sm:p-6 shadow-lg hover:shadow-xl transition-all duration-300 hover:scale-105" style="opacity: 1; transform: none;">
          <div class="text-2xl sm:text-3xl font-black text-red-600 mb-2" data-counter="{teamStats.derrotas}">{teamStats.derrotas}</div>
          <div class="text-xs sm:text-sm font-medium text-gray-700 uppercase tracking-wide">Derrotas</div>
        </div>
        
        <div class="stats-card bg-white rounded-xl p-4 sm:p-6 shadow-lg hover:shadow-xl transition-all duration-300 hover:scale-105" style="opacity: 1; transform: none;">
          <div class="text-2xl sm:text-3xl font-black text-orange-600 mb-2" data-counter="{teamStats.golesFavor}">{teamStats.golesFavor}</div>
          <div class="text-xs sm:text-sm font-medium text-gray-700 uppercase tracking-wide">Goles a favor</div>
        </div>
        
        <div class="stats-card bg-white rounded-xl p-4 sm:p-6 shadow-lg hover:shadow-xl transition-all duration-300 hover:scale-105" style="opacity: 1; transform: none;">
          <div class="text-2xl sm:text-3xl font-black text-purple-600 mb-2" data-counter="{teamStats.golesContra}">{teamStats.golesContra}</div>
          <div class="text-xs sm:text-sm font-medium text-gray-700 uppercase tracking-wide">Goles en contra</div>
        </div>
      </div>
      
    </div>
  </section>
  
  <!-- Sección Próximo Partido -->
  <section class="relative py-20 bg-gradient-to-br from-gray-900 to-black text-white overflow-hidden">
    <!-- Fondo de estadio nocturno animado -->
    <div class="absolute inset-0 stadium-night-bg">
      <!-- Patrón de césped nocturno -->
      <div class="night-grass-pattern absolute inset-0 opacity-15"></div>
      
      <!-- Focos de estadio -->
      <div class="stadium-lights">
        <div class="spotlight spot-1"></div>
        <div class="spotlight spot-2"></div>
        <div class="spotlight spot-3"></div>
        <div class="spotlight spot-4"></div>
      </div>
      
      <!-- Balones brillantes -->
      <div class="glowing-football glow-ball-1"></div>
      <div class="glowing-football glow-ball-2"></div>
      <div class="glowing-football glow-ball-3"></div>
      
      <!-- Partículas de estadio -->
      <div class="stadium-particles">
        <div class="crowd-particle crowd-1"></div>
        <div class="crowd-particle crowd-2"></div>
        <div class="crowd-particle crowd-3"></div>
        <div class="crowd-particle crowd-4"></div>
        <div class="crowd-particle crowd-5"></div>
        <div class="crowd-particle crowd-6"></div>
      </div>
      
      <!-- Efectos de humo/vapor -->
      <div class="stadium-smoke smoke-1"></div>
      <div class="stadium-smoke smoke-2"></div>
      <div class="stadium-smoke smoke-3"></div>
      
      <!-- Overlay de ambiente nocturno -->
      <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-transparent to-black/40"></div>
    </div>
    
    <div class="container mx-auto px-4 relative z-10">
      <div class="text-center mb-8 sm:mb-12">
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold mb-4 px-2">⚽ Próximo Enfrentamiento</h2>
        <p class="text-base sm:text-lg lg:text-xl text-gray-300 px-4">No te pierdas nuestro siguiente partido en casa</p>
      </div>
      
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <div class="match-card bg-white/10 backdrop-blur-md rounded-2xl p-4 sm:p-6 lg:p-8 border border-white/20 hover:bg-white/15 transition-all duration-300">
          <!-- Header con jornada y fecha -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-6 gap-4">
            <div class="bg-gradient-to-r from-orange-400 to-red-400 text-black px-4 py-2 rounded-full text-xs sm:text-sm font-bold uppercase tracking-wider inline-flex justify-center sm:justify-start">
              {nextMatch.jornada} - Liga Tiki Taka
            </div>
            <div class="text-center sm:text-right">
              <div class="text-xl sm:text-2xl font-bold">{formatDate(nextMatch.fecha)}</div>
              <div class="text-orange-400 font-bold text-lg sm:text-xl">{formatTime(nextMatch.fecha)}</div>
            </div>
          </div>
          
          <!-- Teams display -->
          <div class="flex flex-col lg:flex-row items-center justify-between gap-6 lg:gap-4">
            <!-- FC Bufas -->
            <div class="text-center flex-shrink-0">
              <div class="w-20 h-20 sm:w-24 sm:h-24 mx-auto mb-4">
                <img src="/images/logo.webp" alt="FC Bufas" class="w-full h-full object-contain drop-shadow-lg" />
              </div>
              <div class="text-lg sm:text-xl font-bold">FC BUFAS</div>
              <div class="text-orange-400 text-sm">Local</div>
            </div>
            
            <!-- VS Section -->
            <div class="text-center px-4 sm:px-6 lg:px-8 flex-shrink-0">
              <div class="text-4xl sm:text-5xl lg:text-6xl font-black text-orange-400 mb-2">VS</div>
              <div class="text-gray-300 text-xs sm:text-sm flex items-center justify-center flex-wrap">
                <svg class="w-4 h-4 mr-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
                <span class="whitespace-nowrap">Estadio {nextMatch.campo}</span>
              </div>
            </div>
            
            <!-- Rival -->
            <div class="text-center flex-shrink-0">
              <div class="w-20 h-20 sm:w-24 sm:h-24 mx-auto mb-4">
                <img src={nextMatch.imagen} alt={nextMatch.rival} class="w-full h-full object-contain drop-shadow-lg opacity-90" />
              </div>
              <div class="text-lg sm:text-xl font-bold whitespace-nowrap">{nextMatch.rival}</div>
              <div class="text-gray-300 text-sm">Visitante</div>
            </div>
          </div>
          
          <div class="text-center mt-8">
            <a href="/calendario" class="inline-flex items-center bg-gradient-to-r from-orange-500 to-red-500 text-white px-8 py-3 rounded-full font-bold hover:scale-105 transition-transform duration-300 shadow-lg">
              Ver todos los partidos →
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Sección Últimos Resultados -->
  <section class="relative py-20 bg-black overflow-hidden" id="video-scroll-section">
    <!-- Video de fondo controlado por scroll -->
    <div class="absolute inset-0 w-full h-full">
      <!-- Fallback estático mientras se carga el video -->
      <div id="video-fallback" class="absolute inset-0 bg-gradient-to-br from-gray-900 via-black to-gray-800">
        <div class="absolute inset-0 opacity-20">
          <div class="w-full h-full bg-gradient-to-r from-orange-500/10 to-red-500/10"></div>
        </div>
      </div>
      
      <video 
        id="scroll-video"
        class="w-full h-full object-cover"
        muted="true"
        playsinline="true"
        preload="auto"
        poster=""
        webkit-playsinline="true"
        x5-playsinline="true"
        disablePictureInPicture="true"
        controlslist="nodownload nofullscreen noremoteplayback"
        style="opacity: 0; transition: opacity 1s ease-in-out;"
      >
        <source src="/video.mp4" type="video/mp4">
        <source src="/video2.webm" type="video/webm">
        Tu navegador no soporta el elemento video.
      </video>
      
      <!-- Overlay sutil para legibilidad del texto -->
      <div class="absolute inset-0 bg-black/40"></div>
    </div>
    
    <div class="container mx-auto px-4 relative z-10">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold text-white mb-4">📊 Últimos Partidos</h2>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto">Resultados de los últimos enfrentamientos oficiales del FC Bufas</p>
      </div>
      
      {lastResults.length > 0 ? (
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-6xl mx-auto">
          {lastResults.map((match, index) => (
            <div class="bg-white rounded-xl p-6 shadow-lg hover:shadow-xl transition-all duration-300 hover:scale-105 border-l-4 border-l-orange-400">
              <div class="flex items-center justify-between mb-4">
                <div class="text-sm text-gray-500 font-medium">{match.fecha}</div>
                <div class:list={[
                  "px-2 py-1 rounded-full text-xs font-bold uppercase",
                  match.tipo === 'victoria' ? "bg-green-100 text-green-800" :
                  match.tipo === 'empate' ? "bg-yellow-100 text-yellow-800" :
                  "bg-red-100 text-red-800"
                ]}>
                  {match.tipo === 'victoria' ? 'V' : match.tipo === 'empate' ? 'E' : 'D'}
                </div>
              </div>
              
              <div class="text-center mb-4">
                <div class="font-medium text-gray-900 mb-2">FC Bufas vs</div>
                <div class="font-bold text-lg text-gray-800 mb-3">{match.rival}</div>
                <div class:list={[
                  "text-3xl font-black",
                  match.tipo === 'victoria' ? "text-green-600" :
                  match.tipo === 'empate' ? "text-yellow-600" :
                  "text-red-600"
                ]}>
                  {match.resultado}
                </div>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <!-- Estado sin partidos jugados -->
        <div class="max-w-2xl mx-auto text-center">
          <div class="bg-white/10 backdrop-blur-md rounded-2xl p-12 shadow-lg border border-white/20">
            <div class="w-24 h-24 mx-auto mb-6 bg-white/20 rounded-full flex items-center justify-center">
              <svg class="w-12 h-12 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-white mb-4">Sin Partidos Jugados</h3>
            <p class="text-gray-300 text-lg mb-6">Aún no hemos disputado ningún partido oficial esta temporada.</p>
            <div class="bg-orange-500/20 border border-orange-400/30 rounded-lg p-4 mb-6">
              <div class="flex items-center">
                <svg class="w-5 h-5 text-orange-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span class="text-orange-300 font-medium">El primer partido será el {formatDate(nextMatch.fecha)} contra {nextMatch.rival}</span>
              </div>
            </div>
            <a href="/calendario" class="inline-flex items-center bg-gradient-to-r from-orange-500 to-red-500 text-white px-6 py-3 rounded-full font-bold hover:scale-105 transition-transform duration-300 shadow-lg">
              Ver Calendario Completo →
            </a>
          </div>
        </div>
      )}
      
      {lastResults.length === 0 && (
        <div class="text-center mt-12">
          <div class="inline-flex items-center bg-gradient-to-r from-blue-500 to-indigo-500 text-white px-6 py-3 rounded-full font-bold text-lg shadow-lg">
            🚀 ¡Temporada 2025/26 a punto de comenzar!
          </div>
        </div>
      )}
    </div>
  </section>
  
  <!-- Sección Jugadores Destacados -->
  <section class="relative py-20 bg-gradient-to-br from-slate-900 to-gray-900 text-white">
    <div class="container mx-auto px-4">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold mb-4">📈 Jugadores en Alza</h2>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto">Los futbolistas con mayor variación en su valor de mercado</p>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8 max-w-6xl mx-auto">
        {topPlayers.map((player, index) => (
          <div class="bg-white/10 backdrop-blur-md rounded-2xl p-6 border border-white/20 hover:bg-white/15 transition-all duration-300 hover:scale-105 group">
            <div class="text-center mb-6">
              <div class="relative w-24 h-24 mx-auto mb-4">
                <img 
                  src={`/images/fighters/big/${player.id}.webp`} 
                  alt={player.name}
                  class="w-full h-full rounded-full object-cover border-4 border-orange-400 group-hover:border-orange-300 transition-colors duration-300"
                />
                <div class="absolute -top-2 -right-2 w-8 h-8 bg-gradient-to-r from-orange-400 to-red-400 text-black rounded-full flex items-center justify-center text-sm font-bold">
                  #{index + 1}
                </div>
              </div>
              <h3 class="text-xl font-bold mb-1">{player.name}</h3>
              <p class="text-orange-400 text-sm font-medium">{player.position}</p>
            </div>
            
            <div class="grid grid-cols-2 gap-4">
              <div class="text-center">
                <div class="text-2xl font-black text-orange-400">0</div>
                <div class="text-xs text-gray-400 uppercase tracking-wide">Goles</div>
              </div>
              <div class="text-center">
                <div class="text-2xl font-black text-blue-400">0</div>
                <div class="text-xs text-gray-400 uppercase tracking-wide">Asist.</div>
              </div>
            </div>
            
            <div class="mt-6 text-center">
              <div class="bg-white/20 rounded-lg p-3">
                <div class="text-sm text-gray-300 mb-1">Valor de mercado</div>
                <div class="text-lg font-bold text-green-400">
                  {new Intl.NumberFormat('es-ES', { style: 'currency', currency: 'EUR', minimumFractionDigits: 0, maximumFractionDigits: 0 }).format(player.valorTotal || 0)}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
      
      <div class="text-center mt-12">
        <a href="/stats" class="inline-flex items-center bg-gradient-to-r from-orange-500 to-red-500 text-white px-8 py-3 rounded-full font-bold hover:scale-105 transition-transform duration-300 shadow-lg">

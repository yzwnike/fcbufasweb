          x: (i % 2 === 0 ? 100 : -100),
          ease: 'none'
        });
      });
      
      // Efecto de seguimiento del mouse para partículas brillantes
      let mouseX = 0, mouseY = 0;
      
      document.addEventListener('mousemove', (e) => {
        mouseX = e.clientX;
        mouseY = e.clientY;
      });
      
      gsap.utils.toArray('.glowing-particle').forEach((particle, i) => {
        gsap.to(particle, {
          duration: 3 + Math.random() * 2,
          repeat: -1,
          ease: 'none',

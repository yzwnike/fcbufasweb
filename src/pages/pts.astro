<script>
  // La página PTS no necesita interacciones complejas
  // Solo animaciones CSS y visualización estática
  console.log('Página PTS cargada - FC Bufas Jornada 2')
  
  // Mostrar información adicional al hacer click en las estadísticas principales
  document.querySelectorAll('.bg-gradient-to-r').forEach((card, index) => {
    card.addEventListener('click', () => {
      const info = [
        'Total de puntos conseguidos por el equipo en la Jornada 2',
        'Goles marcados: 3 por Marcos, 1 por Mister',
        'Asistencias: Fan, Albert y Mario con 1 cada uno',
        'Marcos es el MVP con 14 puntos'
      ]
      
      alert(info[index] || 'Estadística de la Jornada 2')
    })
  })
</script>

<!-- GSAP desde CDN -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>

<script>
  // GSAP Animaciones idénticas a stats.astro para mantener consistencia
  document.addEventListener('DOMContentLoaded', function() {
    const tl = gsap.timeline();
    
    tl.from('.animated-bg', {
      duration: 2,
      opacity: 0,
      scale: 1.1,
      ease: 'power2.out'
    })
    
    .from('.particle', {
      duration: 1.5,
      opacity: 0,
      scale: 0,
      rotation: 180,
      stagger: 0.2,
      ease: 'back.out(1.7)'
    }, '-=1.5')
    
    .from('.particle-medium', {
      duration: 1,
      opacity: 0,
      y: 100,
      stagger: 0.1,
      ease: 'bounce.out'
    }, '-=1')
    
    .from('.particle-small', {
      duration: 0.8,
      opacity: 0,
      scale: 0,
      stagger: 0.05,
      ease: 'power2.out'
    }, '-=0.8')
    
    .from('.light-effect', {
      duration: 2,
      opacity: 0,
      scale: 0.5,
      stagger: 0.3,
      ease: 'power2.out'
    }, '-=1');
    
    // Animaciones continuas
    gsap.to('.particle-1, .particle-3, .particle-5', {
      duration: 20,
      rotation: 360,
      repeat: -1,
      ease: 'none'
    });
    
    gsap.to('.particle-2, .particle-4, .particle-6', {
      duration: 25,
      rotation: -360,
      repeat: -1,
      ease: 'none'
    });
  });
</script>

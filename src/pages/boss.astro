---
import Layout from '@/layouts/Layout.astro';
---

<Layout title="Boss">
  <div class="min-h-screen bg-gradient-to-br from-black via-slate-900 to-slate-800">
    <div class="container mx-auto px-4 py-24 pt-28 relative z-[999] isolation-isolate">
      <h1 class="text-4xl font-extrabold text-white mb-6">Panel Boss</h1>
      <p class="text-slate-300 mb-8">Solo acceso directo a /boss</p>

      <div class="grid gap-6 md:grid-cols-3">
        <div class="md:col-span-2 rounded-xl bg-slate-900/80 ring-1 ring-white/10 p-4">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-xl font-bold text-white">Usuarios</h2>
            <button id="refresh-users" class="px-3 py-1 rounded bg-slate-700 text-white hover:bg-slate-600">Refrescar</button>
          </div>
          <div class="overflow-x-auto">
            <table class="min-w-full text-sm text-slate-200">
              <thead class="bg-slate-800/80">
                <tr>
                  <th class="px-3 py-2 text-left">ID</th>
                  <th class="px-3 py-2 text-left">Usuario</th>
                  <th class="px-3 py-2 text-left">Email</th>
                  <th class="px-3 py-2 text-right">Coins</th>
                  <th class="px-3 py-2 text-right">Cartas</th>
                  <th class="px-3 py-2 text-right">TOTW</th>
                  <th class="px-3 py-2 text-right">POTM</th>
                  <th class="px-3 py-2 text-left">Creado</th>
                </tr>
              </thead>
              <tbody id="boss-users"></tbody>
            </table>
          </div>
        </div>
        <div class="rounded-xl bg-slate-900/80 ring-1 ring-white/10 p-4">
          <h2 class="text-xl font-bold text-white mb-4">Fantasy - Plantillas</h2>
          <div class="flex items-center gap-3 mb-3">
            <div class="text-slate-300">Estado:</div>
            <div id="lock-status" class="px-2 py-1 rounded bg-slate-800 text-slate-200">-</div>
          </div>
          <div class="flex gap-2">
            <button id="btn-lock" class="px-3 py-2 rounded bg-red-600 text-white hover:bg-red-500">Cerrar plantillas</button>
            <button id="btn-unlock" class="px-3 py-2 rounded bg-green-600 text-white hover:bg-green-500">Abrir plantillas</button>
          </div>
          <p class="text-xs text-slate-400 mt-3">Al cerrar, nadie podrá crear/modificar/eliminar su plantilla de 3 jugadores hasta que lo abras o empiece nueva jornada.</p>
        </div>
      </div>
    </div>
  </div>

  <script>
    async function fetchUsers() {
      const res = await fetch('/api/boss/users', { cache: 'no-store' });
      return res.json();
    }
    async function fetchLock() {
      const res = await fetch('/api/nike-fc-cards/fantasy/admin/lock', { cache: 'no-store' });
      return res.json();
    }
    async function setLock(locked) {
      const res = await fetch('/api/nike-fc-cards/fantasy/admin/lock', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ locked }) });
      return res.json();
    }
    function renderUsers(data){
      const tbody = document.getElementById('boss-users');
      tbody.innerHTML='';
      (data.users||[]).forEach(u=>{
        const tr = document.createElement('tr');
        tr.className='hover:bg-slate-800/60';
        tr.innerHTML = `
          <td class="px-3 py-2">${u.id}</td>
          <td class="px-3 py-2 font-semibold">${u.username}</td>
          <td class="px-3 py-2">${u.email||''}</td>
          <td class="px-3 py-2 text-right">${u.coins||0}</td>
          <td class="px-3 py-2 text-right">${u.cards||0}</td>
          <td class="px-3 py-2 text-right">${u.totw||0}</td>
          <td class="px-3 py-2 text-right">${u.potm||0}</td>
          <td class="px-3 py-2">${(u.created_at||'').toString().slice(0,10)}</td>
        `;
        tbody.appendChild(tr);
      });
    }
    function renderLock(data){
      const st = document.getElementById('lock-status');
      st.textContent = data.locked ? 'CERRADAS' : 'ABIERTAS';
      st.className = 'px-2 py-1 rounded '+ (data.locked ? 'bg-red-700 text-white':'bg-green-700 text-white');
    }
    async function init(){
      try{ const u=await fetchUsers(); if(u.success) renderUsers(u);}catch{}
      try{ const l=await fetchLock(); if(l.success) renderLock(l);}catch{}
      document.getElementById('refresh-users')?.addEventListener('click', init);
      document.getElementById('btn-lock')?.addEventListener('click', async()=>{ const r=await setLock(true); if(r.success) renderLock(r); });
      document.getElementById('btn-unlock')?.addEventListener('click', async()=>{ const r=await setLock(false); if(r.success) renderLock(r); });
    }
    document.addEventListener('DOMContentLoaded', init);
  </script>
</Layout>
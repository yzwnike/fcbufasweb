---
const { pathname } = Astro.url

// Lista de rutas donde NO debe aparecer el logo
const hideLogoRoutes = ['/']
const shouldShowLogo = !hideLogoRoutes.includes(pathname)

// Comprueba si la ruta actual está activa
const isActive = (path: string) => pathname === path
---

<div class="fixed right-8 top-8 z-[100] md:hidden">
  <button
    id="menuButton"
    aria-expanded="false"
    aria-controls="menuMobileContent"
    class="hamburgerButton group relative flex h-[20px] w-6 cursor-pointer flex-col items-center justify-between transition duration-300 hover:scale-110 lg:hidden"
    aria-label="Abrir menú de navegación"
  >
    <span
      class="ease h-[2px] w-6 transform bg-gray-300 transition duration-300 group-[.open]:translate-y-2 group-[.open]:rotate-45"
    ></span>
    <span
      class="ease h-[2px] w-6 transform bg-gray-300 transition duration-300 group-[.open]:opacity-0"
    ></span>
    <span
      class="ease h-[2px] w-6 transform bg-gray-300 transition duration-300 group-[.open]:opacity-0"
    ></span>
    <span
      class="ease h-[2px] w-6 transform bg-gray-300 transition duration-300 group-[.open]:-translate-y-[0.6rem] group-[.open]:-rotate-45"
    ></span>
  </button>
</div>

<header
  class:list={[
    "fixed top-0 z-50 mx-auto flex h-20 w-full select-none items-center",
    pathname === '/' ? "text-white" : "text-black header-with-bg"
  ]}
>
  <div class="relative flex justify-between px-4 md:px-6 py-4 w-full max-w-7xl mx-auto">
    <a href="/" class="cursor-pointer transition duration-300 hover:scale-110 md:hidden">
      <img src="/favicon.svg" alt="logo" class="h-auto w-7" />
    </a>

    <div
      id="overlay-menu"
      class="bg-theme-raisin-black/50 fixed inset-0 hidden h-[100vh] md:hidden"
    >
    </div>
    <nav
      id="navContent"
      class="bg-black/90 invisible fixed right-0 top-0 mx-auto h-[100vh] w-80 max-w-sm translate-x-full items-center justify-between space-y-2 px-6 pt-14 text-xs font-light backdrop-blur-2xl md:visible md:relative md:flex md:!h-fit md:w-full md:translate-x-0 md:space-y-0 md:bg-transparent md:py-4 md:backdrop-blur-none lg:text-sm"
    >
      <div
        class:list={[
          'flex flex-col justify-start space-y-3 md:flex-row md:gap-6 lg:gap-8 md:space-y-0 md:items-center',
          shouldShowLogo ? 'md:flex-1' : 'md:flex-grow',
        ]}
      >
        <a
          href="/"
          class="group relative inline-block w-fit py-2 leading-relaxed tracking-wider transition-colors duration-200 hover:text-orange-400"
        >
          <span class:list={[
            "py-1 font-medium text-sm lg:text-base flex items-center",
            pathname === '/' ? "text-white" : "text-white md:text-black"
          ]}>
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
            </svg>
            INICIO
          </span>
          <div class="relative mt-1 h-[2px] w-full overflow-hidden">
            <div
              class:list={[
                'absolute bottom-0 left-0 h-full bg-orange-400 transition-all duration-300 ease-out',
                isActive('/') ? 'w-[51%]' : 'w-0 group-hover:w-[51%]',
              ]}
            >
            </div>
            <div
              class:list={[
                'absolute bottom-0 right-0 h-full bg-black transition-all duration-300 ease-out',
                isActive('/') ? 'w-[51%]' : 'w-0 group-hover:w-[51%]',
              ]}
            >
            </div>
          </div>
        </a>
        <a
          href="/stats"
          class="group relative inline-block w-fit py-2 leading-relaxed tracking-wider transition-colors duration-200 hover:text-orange-400"
        >
          <span class:list={[
            "py-1 font-medium text-sm lg:text-base",
            pathname === '/' ? "text-white" : "text-white md:text-black"
          ]}>Estadísticas</span>
          <div class="relative mt-1 h-[2px] w-full overflow-hidden">
            <div
              class:list={[
                'absolute bottom-0 left-0 h-full bg-orange-400 transition-all duration-300 ease-out',
                isActive('/stats') ? 'w-[51%]' : 'w-0 group-hover:w-[51%]',
              ]}
            >
            </div>
            <div
              class:list={[
                'absolute bottom-0 right-0 h-full bg-black transition-all duration-300 ease-out',
                isActive('/stats') ? 'w-[51%]' : 'w-0 group-hover:w-[51%]',
              ]}
            >
            </div>
          </div>
        </a>
        <a
          href="/pts"
          class="group relative inline-block w-fit py-2 leading-relaxed tracking-wider transition-colors duration-200 hover:text-orange-400"
        >
          <span class:list={[
            "py-1 font-medium text-sm lg:text-base",
            pathname === '/' ? "text-white" : "text-white md:text-black"
          ]}>PTS. ÚLTIMA JORNADA</span>
          <div class="relative mt-1 h-[2px] w-full overflow-hidden">
            <div
              class:list={[
                'absolute bottom-0 left-0 h-full bg-orange-400 transition-all duration-300 ease-out',
                isActive('/pts') ? 'w-[51%]' : 'w-0 group-hover:w-[51%]',
              ]}
            >
            </div>
            <div
              class:list={[
                'absolute bottom-0 right-0 h-full bg-black transition-all duration-300 ease-out',
                isActive('/pts') ? 'w-[51%]' : 'w-0 group-hover:w-[51%]',
              ]}
            >
            </div>
          </div>
        </a>
        <a
          href="/calendario"
          class="group relative inline-block w-fit py-2 leading-relaxed tracking-wider transition-colors duration-200 hover:text-orange-400"
        >
          <span class:list={[
            "py-1 font-medium text-sm lg:text-base",
            pathname === '/' ? "text-white" : "text-white md:text-black"
          ]}>CALENDARIO</span>
          <div class="relative mt-1 h-[2px] w-full overflow-hidden">
            <div
              class:list={[
                'absolute bottom-0 left-0 h-full bg-orange-400 transition-all duration-300 ease-out',
                isActive('/calendario') ? 'w-[51%]' : 'w-0 group-hover:w-[51%]',
              ]}
            >
            </div>
            <div
              class:list={[
                'absolute bottom-0 right-0 h-full bg-black transition-all duration-300 ease-out',
                isActive('/calendario') ? 'w-[51%]' : 'w-0 group-hover:w-[51%]',
              ]}
            >
            </div>
          </div>
        </a>
        <a
          href="/clasificacion"
          class="group relative inline-block w-fit py-2 leading-relaxed tracking-wider transition-colors duration-200 hover:text-orange-400"
        >
          <span class:list={[
            "py-1 font-medium text-sm lg:text-base",
            pathname === '/' ? "text-white" : "text-white md:text-black"
          ]}>CLASIFICACIÓN</span>
          <div class="relative mt-1 h-[2px] w-full overflow-hidden">
            <div
              class:list={[
                'absolute bottom-0 left-0 h-full bg-orange-400 transition-all duration-300 ease-out',
                isActive('/clasificacion') ? 'w-[51%]' : 'w-0 group-hover:w-[51%]',
              ]}
            >
            </div>
            <div
              class:list={[
                'absolute bottom-0 right-0 h-full bg-black transition-all duration-300 ease-out',
                isActive('/clasificacion') ? 'w-[51%]' : 'w-0 group-hover:w-[51%]',
              ]}
            >
            </div>
          </div>
        </a>
        <a
          href="/valores-mercado"
          class="group relative inline-block w-fit py-2 leading-relaxed tracking-wider transition-colors duration-200 hover:text-orange-400"
        >
          <span class:list={[
            "py-1 font-medium text-sm lg:text-base",
            pathname === '/' ? "text-white" : "text-white md:text-black"
          ]}>VALORES MERCADO</span>
          <div class="relative mt-1 h-[2px] w-full overflow-hidden">
            <div
              class:list={[
                'absolute bottom-0 left-0 h-full bg-orange-400 transition-all duration-300 ease-out',
                isActive('/valores-mercado') ? 'w-[51%]' : 'w-0 group-hover:w-[51%]',
              ]}
            >
            </div>
            <div
              class:list={[
                'absolute bottom-0 right-0 h-full bg-black transition-all duration-300 ease-out',
                isActive('/valores-mercado') ? 'w-[51%]' : 'w-0 group-hover:w-[51%]',
              ]}
            >
            </div>
          </div>
        </a>
        <a
          href="/cartas"
          class="group relative inline-block w-fit py-2 leading-relaxed tracking-wider transition-colors duration-200 hover:text-orange-400"
        >
          <span class:list={[
            "py-1 font-medium text-sm lg:text-base",
            pathname === '/' ? "text-white" : "text-white md:text-black"
          ]}>CARTAS</span>
          <div class="relative mt-1 h-[2px] w-full overflow-hidden">
            <div
              class:list={[
                'absolute bottom-0 left-0 h-full bg-orange-400 transition-all duration-300 ease-out',
                isActive('/cartas') ? 'w-[51%]' : 'w-0 group-hover:w-[51%]',
              ]}
            >
            </div>
            <div
              class:list={[
                'absolute bottom-0 right-0 h-full bg-black transition-all duration-300 ease-out',
                isActive('/cartas') ? 'w-[51%]' : 'w-0 group-hover:w-[51%]',
              ]}
            >
            </div>
          </div>
        </a>
        <a
          href="/nike-fc-cards"
          class="group relative inline-block w-fit py-2 leading-relaxed tracking-wider transition-colors duration-200 hover:text-orange-400"
        >
          <span class:list={[
            "py-1 font-medium text-sm lg:text-base flex items-center",
            pathname === '/' ? "text-white" : "text-white md:text-black"
          ]}>
            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
            </svg>
            NIKE FC CARDS
          </span>
          <div class="relative mt-1 h-[2px] w-full overflow-hidden">
            <div
              class:list={[
                'absolute bottom-0 left-0 h-full bg-orange-400 transition-all duration-300 ease-out',
                pathname.startsWith('/nike-fc-cards') ? 'w-[51%]' : 'w-0 group-hover:w-[51%]',
              ]}
            >
            </div>
            <div
              class:list={[
                'absolute bottom-0 right-0 h-full bg-black transition-all duration-300 ease-out',
                pathname.startsWith('/nike-fc-cards') ? 'w-[51%]' : 'w-0 group-hover:w-[51%]',
              ]}
            >
            </div>
          </div>
        </a>
      </div>

      {
        shouldShowLogo && (
          <div class="flex-1 flex justify-center">
            <a
              href="/"
              class="transition duration-300 hover:scale-110"
            >
              <img
                class="h-8 lg:h-10"
                src="/favicon.svg"
                fetchpriority="high"
                alt="FC Bufas"
                decoding="async"
              />
            </a>
          </div>
        )
      }

      <div class:list={[
        'flex-1 flex justify-end',
        !shouldShowLogo && 'hidden'
      ]}>
        <!-- Espacio para balancear el layout cuando hay logo -->
      </div>
    </nav>
  </div>
</header>

<style>
  /* Header por defecto (página de inicio) */
  header {
    background: transparent;
    animation: header-blur-scroll 0.3s linear both;
    animation-timeline: scroll();
    animation-range: 0 250px;
    border-bottom: 1px solid transparent;
  }

  /* Header con fondo naranja (otras páginas) */
  header.header-with-bg {
    background: rgba(255, 165, 0, 0.4);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid rgba(255, 107, 53, 0.2);
    box-shadow: 0 4px 20px rgba(255, 107, 53, 0.1);
  }

  @keyframes header-blur-scroll {
    0% {
      backdrop-filter: blur(0px);
      background: transparent;
    }

    100% {
      backdrop-filter: blur(10px);
      background: rgba(0, 0, 0, 0.5);
      padding-bottom: var(--spacing-6);
      border-bottom-color: black;
    }
  }

  /* Animación específica para páginas con fondo naranja */
  header.header-with-bg {
    animation: header-blur-scroll-orange 0.3s linear both;
    animation-timeline: scroll();
    animation-range: 0 250px;
  }

  @keyframes header-blur-scroll-orange {
    0% {
      backdrop-filter: blur(8px);
      background: rgba(255, 165, 0, 0.4);
      border-bottom-color: rgba(255, 107, 53, 0.2);
    }

    100% {
      backdrop-filter: blur(12px);
      background: rgba(255, 140, 0, 0.7);
      padding-bottom: var(--spacing-6);
      border-bottom-color: rgba(255, 107, 53, 0.5);
      box-shadow: 0 8px 32px rgba(255, 107, 53, 0.2);
    }
  }

  #navContent {
    transition:
      translate 0.3s ease-in-out,
      visibility 0.3s 0.3s;
  }

  #navContent.showing {
    visibility: visible;
    translate: 0 0;
    transition:
      translate 0.3s ease-in-out,
      visibility 0.3s;
  }
</style>

<script>
  import { $ } from '@/lib/dom-selector'

  document.addEventListener('astro:page-load', () => {
    function toggleMenu(
      menuBtn: Element | null,
      navContent: Element | null,
      overlayMenu: Element | null,
    ) {
      menuBtn?.classList.toggle('open')
      navContent?.classList.toggle('showing')
      tickets?.classList.toggle('neon-text')
      overlayMenu?.classList.toggle('hidden')
    }

    const navContent = $('#navContent')
    const menuButton = $('#menuButton')
    const overlayMenu = $('#overlay-menu')
    const tickets = $('#buy-tickets')

    menuButton?.addEventListener('click', () => toggleMenu(menuButton, navContent, overlayMenu))
    overlayMenu?.addEventListener('click', () => toggleMenu(menuButton, navContent, overlayMenu))
  })
</script>

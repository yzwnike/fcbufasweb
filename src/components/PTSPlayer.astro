---
export interface Props {
  player: {
    id: string
    name: string
    position: string
    puntos: number
    goles: number
    asistencias: number
    image?: string
  }
  position: {
    top: string
    left: string
  }
}

const { player, position } = Astro.props

// Determinar el color de los puntos basado en el rendimiento
const getPuntosColor = (puntos: number) => {
  if (puntos >= 6) return 'text-green-500 bg-green-100'
  if (puntos >= 4) return 'text-yellow-600 bg-yellow-100'
  if (puntos >= 2) return 'text-orange-600 bg-orange-100'
  return 'text-red-600 bg-red-100'
}

const puntosColorClass = getPuntosColor(player.puntos)
---

<div 
  class="absolute transform -translate-x-1/2 -translate-y-1/2 cursor-pointer transition-all duration-300 hover:scale-110"
  style={`top: ${position.top}; left: ${position.left};`}
  data-player-id={player.id}
>
  <!-- Contenedor principal del jugador -->
  <div class="relative flex items-center justify-center">
    
    <!-- Estadísticas lado izquierdo (goles y asistencias) -->
    <div class="flex flex-col items-center space-y-1 mr-2">
      {player.goles > 0 && (
        <div class="flex items-center justify-center w-6 h-6 bg-orange-500 rounded-full shadow-lg">
          <svg class="w-3 h-3 text-white" viewBox="0 0 24 24" fill="currentColor">
            <circle cx="12" cy="12" r="10" />
          </svg>
          <span class="absolute -top-1 -right-1 text-xs font-bold text-orange-500 bg-white rounded-full w-4 h-4 flex items-center justify-center shadow">
            {player.goles}
          </span>
        </div>
      )}
      
      {player.asistencias > 0 && (
        <div class="flex items-center justify-center w-6 h-6 bg-blue-500 rounded-full shadow-lg">
          <svg class="w-3 h-3 text-white" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2L13.09 8.26L20 9L13.09 9.74L12 16L10.91 9.74L4 9L10.91 8.26L12 2Z"/>
          </svg>
          <span class="absolute -top-1 -right-1 text-xs font-bold text-blue-500 bg-white rounded-full w-4 h-4 flex items-center justify-center shadow">
            {player.asistencias}
          </span>
        </div>
      )}
    </div>

    <!-- Jugador central -->
    <div class="relative">
      <!-- Avatar del jugador -->
      <div class="w-12 h-12 md:w-16 md:h-16 bg-gradient-to-br from-orange-400 to-orange-600 rounded-full flex items-center justify-center shadow-xl border-2 border-white">
        {player.image ? (
          <img 
            src={player.image} 
            alt={player.name}
            class="w-10 h-10 md:w-14 md:h-14 rounded-full object-cover"
            onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
          />
          <div class="w-10 h-10 md:w-14 md:h-14 rounded-full bg-gradient-to-br from-orange-400 to-orange-600 flex items-center justify-center text-white font-bold text-lg hidden">
            {player.name.charAt(0)}
          </div>
        ) : (
          <div class="text-white font-bold text-lg md:text-xl">
            {player.name.charAt(0)}
          </div>
        )}
      </div>
      
      <!-- Nombre del jugador -->
      <div class="absolute -bottom-6 left-1/2 transform -translate-x-1/2 whitespace-nowrap">
        <div class="bg-white/95 backdrop-blur-sm px-2 py-1 rounded-lg shadow-md border border-gray-200">
          <span class="text-xs font-semibold text-gray-800">{player.name}</span>
        </div>
      </div>
      
      <!-- Posición del jugador -->
      <div class="absolute -top-2 left-1/2 transform -translate-x-1/2">
        <div class="bg-gray-800/90 text-white px-1.5 py-0.5 rounded text-xs font-medium shadow-md">
          {player.position}
        </div>
      </div>
    </div>

    <!-- Puntos lado derecho -->
    <div class="ml-2 flex flex-col items-center">
      <div class={`px-2 py-1 rounded-lg shadow-lg border-2 ${puntosColorClass} border-current`}>
        <div class="text-center">
          <div class="text-lg md:text-xl font-bold leading-none">
            {player.puntos}
          </div>
          <div class="text-xs font-medium leading-none mt-0.5">
            PTS
          </div>
        </div>
      </div>
    </div>

  </div>
</div>

<style>
  /* Animación de pulso para jugadores destacados */
  [data-player-id] {
    animation: playerPulse 3s ease-in-out infinite;
  }
  
  [data-player-id]:hover {
    animation: none;
    transform: translate(-50%, -50%) scale(1.15);
  }
  
  @keyframes playerPulse {
    0%, 100% { 
      transform: translate(-50%, -50%) scale(1);
      filter: brightness(1);
    }
    50% { 
      transform: translate(-50%, -50%) scale(1.05);
      filter: brightness(1.1);
    }
  }

  /* Efecto especial para el mejor jugador */
  [data-player-id="marcos"] {
    animation: mvpGlow 2s ease-in-out infinite alternate;
  }
  
  @keyframes mvpGlow {
    from {
      filter: drop-shadow(0 0 8px rgba(34, 197, 94, 0.6));
    }
    to {
      filter: drop-shadow(0 0 16px rgba(34, 197, 94, 0.9));
    }
  }
</style>

---
interface Props {
  title: string
  date: Date
  endDate?: Date
  location: string
  description: string
  url?: string
  isMainEvent?: boolean
}

const { title, date, endDate, location, description, url, isMainEvent = false } = Astro.props

// Formatear la fecha
const formatDate = (date: Date) => {
  const options: Intl.DateTimeFormatOptions = {
    weekday: 'long',
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }
  return date.toLocaleDateString('es-ES', options)
}

const formatTime = (date: Date) => {
  return date.toLocaleTimeString('es-ES', { 
    hour: '2-digit', 
    minute: '2-digit',
    hour12: false 
  })
}

// Calcular días restantes
const today = new Date()
const timeDiff = date.getTime() - today.getTime()
const daysUntil = Math.ceil(timeDiff / (1000 * 3600 * 24))

const isPast = daysUntil < 0
const isToday = daysUntil === 0
const isSoon = daysUntil <= 7 && daysUntil > 0
---

<div class:list={[
  "relative overflow-hidden rounded-xl border transition-all duration-300 hover:shadow-lg",
  isMainEvent ? "bg-gradient-to-r from-red-50 to-orange-50 border-red-200 hover:border-red-300" : "bg-white border-gray-200 hover:border-orange-300",
  isPast ? "opacity-75" : "",
  isToday ? "ring-2 ring-orange-400 animate-pulse" : ""
]}>
  
  <!-- Indicador de evento principal -->
  {isMainEvent && (
    <div class="absolute top-0 right-0 bg-red-500 text-white text-xs font-bold px-3 py-1 rounded-bl-lg">
      ⭐ EVENTO PRINCIPAL
    </div>
  )}
  
  <!-- Indicador de estado -->
  <div class="absolute top-4 left-4 flex items-center gap-2">
    {isPast && (
      <div class="bg-gray-500 text-white text-xs px-2 py-1 rounded-full font-medium">
        ✓ Finalizado
      </div>
    )}
    {isToday && (
      <div class="bg-green-500 text-white text-xs px-2 py-1 rounded-full font-medium animate-pulse">
        🔴 HOY
      </div>
    )}
    {isSoon && !isToday && (
      <div class="bg-orange-500 text-white text-xs px-2 py-1 rounded-full font-medium">
        🔥 Próximo
      </div>
    )}
  </div>
  
  <div class="p-6">
    <!-- Fecha y tiempo -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-4">
      <div class="space-y-1">
        <h3 class:list={[
          "text-xl font-bold",
          isMainEvent ? "text-red-900" : "text-gray-900"
        ]}>
          {title}
        </h3>
        <div class="flex flex-col sm:flex-row sm:items-center gap-2 text-sm text-gray-600">
          <div class="flex items-center gap-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
            <span class="capitalize">{formatDate(date)}</span>
          </div>
          <div class="flex items-center gap-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span>
              {formatTime(date)}
              {endDate && ` - ${formatTime(endDate)}`}
            </span>
          </div>
        </div>
      </div>
      
      <!-- Contador de días -->
      <div class="mt-3 sm:mt-0">
        {!isPast && (
          <div class:list={[
            "text-center px-4 py-2 rounded-lg",
            isMainEvent ? "bg-red-100 text-red-700" : "bg-orange-100 text-orange-700"
          ]}>
            <div class="text-2xl font-bold">{daysUntil}</div>
            <div class="text-xs uppercase tracking-wide">
              {daysUntil === 1 ? 'día' : 'días'}
            </div>
          </div>
        )}
      </div>
    </div>
    
    <!-- Ubicación -->
    <div class="flex items-start gap-2 mb-4">
      <svg class="w-4 h-4 mt-0.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
      </svg>
      <span class="text-gray-700 text-sm">{location}</span>
    </div>
    
    <!-- Descripción -->
    <p class="text-gray-600 text-sm leading-relaxed mb-4">
      {description}
    </p>
    
    <!-- Acciones -->
    <div class="flex flex-col sm:flex-row gap-3">
      {url && (
        <a
          href={url}
          target="_blank"
          rel="noopener noreferrer"
          class:list={[
            "inline-flex items-center justify-center gap-2 px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200 hover:scale-105",
            isMainEvent 
              ? "bg-red-500 hover:bg-red-600 text-white shadow-lg" 
              : "bg-orange-500 hover:bg-orange-600 text-white shadow-md"
          ]}
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
          </svg>
          Ver Stream
        </a>
      )}
      
      <!-- Botón para compartir -->
      <button 
        class="inline-flex items-center justify-center gap-2 px-4 py-2 rounded-lg text-sm font-medium text-gray-700 bg-gray-100 hover:bg-gray-200 transition-all duration-200"
        onclick={`shareEvent('${title}', '${formatDate(date)} - ${formatTime(date)}', '${location}')`}
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.367 2.684 3 3 0 00-5.367-2.684z"></path>
        </svg>
        Compartir
      </button>
    </div>
  </div>
  
  <!-- Efecto de brillo para evento principal -->
  {isMainEvent && (
    <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/10 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-1000 pointer-events-none"></div>
  )}
</div>

<script>
  // Función global para compartir eventos
  window.shareEvent = function(title, datetime, location) {
    if (navigator.share) {
      navigator.share({
        title: `FC Bufas - ${title}`,
        text: `📅 ${title}\n🕐 ${datetime}\n📍 ${location}\n\n#FCBufas #Temporada2025`,
        url: window.location.href
      }).catch(err => console.log('Error sharing:', err))
    } else {
      // Fallback: copiar al portapapeles
      const text = `📅 ${title}\n🕐 ${datetime}\n📍 ${location}\n\n#FCBufas #Temporada2025\n${window.location.href}`
      navigator.clipboard.writeText(text).then(() => {
        // Mostrar notificación temporal
        const notification = document.createElement('div')
        notification.className = 'fixed top-4 right-4 bg-green-500 text-white px-4 py-2 rounded-lg shadow-lg z-50 transition-all duration-300'
        notification.textContent = '¡Evento copiado al portapapeles!'
        document.body.appendChild(notification)
        
        setTimeout(() => {
          notification.classList.add('opacity-0', 'translate-y-2')
          setTimeout(() => notification.remove(), 300)
        }, 2000)
      }).catch(err => {
        console.log('Error copying to clipboard:', err)
        alert('No se pudo copiar el evento')
      })
    }
  }
</script>

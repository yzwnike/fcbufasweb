---
export interface Props {
  variant?: 'full' | 'minimal';
}

const { variant = 'full' } = Astro.props as Props;
const current = Astro.url.pathname;
const navItems = [
  { href: '/bufas-cards', label: 'Inicio' },
  { href: '/bufas-cards/quiz', label: 'Quiz' },
  { href: '/bufas-cards/potm', label: 'VOTACIONES POTM' },
  { href: '/bufas-cards/packs', label: 'Sobres' },
  { href: '/bufas-cards/collection', label: 'Colección' },
  { href: '/bufas-cards/market', label: 'Mercado' },
  { href: '/bufas-cards/fantasy', label: 'Fantasy' },
  { href: '/bufas-cards/logros', label: 'Logros' },
  { href: '/bufas-cards/ayuda', label: 'Ayuda' },
];
const isActive = (href: string) => current === href || (href !== '/bufas-cards' && current.startsWith(href));
---

<nav class="mb-8 hidden lg:block">
  {variant === 'minimal' ? (
    <div class="inline-flex bg-black/60 border border-white/10 rounded-xl">
      <a href="/bufas-cards" class="px-4 py-2 text-sm font-semibold text-white bg-black/70 hover:bg-black/80 rounded-xl transition-colors">Inicio</a>
    </div>
  ) : (
    <ul class="flex flex-wrap gap-2 bg-black/40 border border-white/10 backdrop-blur-md rounded-xl p-2">
      {navItems.map((item) => (
        <li>
          <a href={item.href} class={`relative px-3 py-2 rounded-lg text-sm font-semibold transition-colors border ${isActive(item.href) ? 'bg-black/80 text-white border-white/20' : 'text-white/80 hover:text-white bg-black/30 hover:bg-black/40 border-white/10'}`}>
            {item.label}
            {item.href === '/bufas-cards/logros' && (
              <div id="desktop-achievements-badge" class="absolute -top-2 -right-2 bg-red-500 text-white rounded-full min-w-[18px] h-[18px] flex items-center justify-center text-xs font-bold px-1 hidden">0</div>
            )}
{item.href === '/bufas-cards/quiz' && (
              <>
<div id="desktop-quiz-badge" class="absolute -top-2 -right-2 bg-red-500 text-white rounded-full min-w-[18px] h-[18px] flex items-center justify-center text-xs font-bold px-1 hidden">!</div>
                <div id="desktop-quiz-timer" class="absolute -top-2 -right-2 bg-gray-700 text-white/90 rounded-full min-w-[28px] h-[18px] px-1 flex items-center justify-center text-[10px] font-semibold hidden"></div>
              </>
            )}
            {item.href === '/bufas-cards/packs' && (
              <div id="desktop-packs-badge" class="absolute -top-2 -right-2 bg-blue-500 text-white rounded-full min-w-[18px] h-[18px] flex items-center justify-center text-xs font-bold px-1 hidden">!</div>
            )}
          </a>
        </li>
      ))}
    </ul>
  )}
</nav>

<script>
  let quizTimerInterval = null;
  function formatRemaining(seconds) {
    const s = Math.max(0, Math.floor(seconds));
    const h = Math.floor(s / 3600);
    const m = Math.floor((s % 3600) / 60);
    const sec = s % 60;
    if (h > 0) return `${h}h ${String(m).padStart(2,'0')}m`;
    return `${String(m).padStart(2,'0')}:${String(sec).padStart(2,'0')}`;
  }
  async function updateQuizIndicators() {
    const token = window.sessionStorage.getItem('nike_fc_token');
    const badge = document.getElementById('desktop-quiz-badge');
    const timer = document.getElementById('desktop-quiz-timer');
    if (quizTimerInterval) { clearInterval(quizTimerInterval); quizTimerInterval = null; }
    if (!token) { badge && badge.classList.add('hidden'); timer && timer.classList.add('hidden'); return; }
    try {
      const res = await fetch('/api/bufas-cards/quiz/status', { headers: { Authorization: `Bearer ${token}` } });
      const data = await res.json();
      const canPlay = !!data.canPlay;
      const completed = !!data.completed;
      let remaining = typeof data.secondsRemaining === 'number' ? data.secondsRemaining : null;
      if (canPlay) {
        badge && badge.classList.remove('hidden');
        timer && timer.classList.add('hidden');
      } else {
        badge && badge.classList.add('hidden');
        if (completed && remaining != null && remaining > 0) {
          const tick = () => {
            if (!timer) return;
            timer.textContent = formatRemaining(remaining);
            timer.classList.remove('hidden');
            remaining -= 1;
            if (remaining < 0) { clearInterval(quizTimerInterval); quizTimerInterval = null; updateQuizIndicators(); }
          };
          tick();
          quizTimerInterval = setInterval(tick, 1000);
        } else {
          timer && timer.classList.add('hidden');
        }
      }
    } catch (e) {
      console.error('Quiz indicator update failed', e);
    }
  }
  const init = () => updateQuizIndicators();
  document.addEventListener('DOMContentLoaded', init);
  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:after-swap', init);
</script>

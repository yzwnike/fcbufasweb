---
export interface Props {
  variant?: 'full' | 'minimal';
}

const { variant = 'full' } = Astro.props as Props;
const current = Astro.url.pathname;
const navItems = [
  { href: '/nike-fc-cards', label: 'Inicio' },
  { href: '/nike-fc-cards/quiz', label: 'Quiz' },
  { href: '/nike-fc-cards/packs', label: 'Sobres' },
  { href: '/nike-fc-cards/collection', label: 'Colección' },
  { href: '/nike-fc-cards/market', label: 'Mercado' },
  { href: '/nike-fc-cards/fantasy', label: 'Fantasy' },
];
const isActive = (href: string) => current === href || (href !== '/nike-fc-cards' && current.startsWith(href));
---

<nav class="mb-8 hidden lg:block">
  {variant === 'minimal' ? (
    <div class="inline-flex bg-black/60 border border-white/10 rounded-xl">
      <a href="/nike-fc-cards" class="px-4 py-2 text-sm font-semibold text-white bg-black/70 hover:bg-black/80 rounded-xl transition-colors">Inicio</a>
    </div>
  ) : (
    <ul class="flex flex-wrap gap-2 bg-black/40 border border-white/10 backdrop-blur-md rounded-xl p-2">
      {navItems.map((item) => (
        <li>
          <a href={item.href} class={`px-3 py-2 rounded-lg text-sm font-semibold transition-colors border ${isActive(item.href) ? 'bg-black/80 text-white border-white/20' : 'text-white/80 hover:text-white bg-black/30 hover:bg-black/40 border-white/10'}`}>
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  )}
</nav>

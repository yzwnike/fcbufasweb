---
const current = Astro.url.pathname;
const navItems = [
  { href: '/nike-fc-cards', label: 'Dashboard', icon: 'home' },
  { href: '/nike-fc-cards/quiz', label: 'Quiz Diario', icon: 'quiz' },
  { href: '/nike-fc-cards/packs', label: 'Sobres', icon: 'package' },
  { href: '/nike-fc-cards/collection', label: 'Colección', icon: 'collection' },
  { href: '/nike-fc-cards/market', label: 'Mercado', icon: 'market' },
  { href: '/nike-fc-cards/sbc', label: 'SBC', icon: 'sbc' },
  { href: '/nike-fc-cards/fantasy', label: 'Fantasy Rush', icon: 'fantasy' },
  { href: '/nike-fc-cards/ranking', label: 'Ranking', icon: 'ranking' },
  { href: '/nike-fc-cards/logros', label: 'Logros', icon: 'trophy' },
  { href: '/nike-fc-cards/ajustes', label: 'Ajustes', icon: 'settings' },
];

const isActive = (href: string) => current === href || (href !== '/nike-fc-cards' && current.startsWith(href));

// SVG Icons
const icons = {
  home: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6',
  quiz: 'M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  package: 'M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M9 1v6m6-6v6',
  collection: 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10',
  market: 'M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4',
  sbc: 'M12 8c-1.657 0-3 1.343-3 3v2H7l5 5 5-5h-2v-2c0-1.657-1.343-3-3-3z',
  fantasy: 'M13 10V3L4 14h7v7l9-11h-7z',
  ranking: 'M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z',
  trophy: 'M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z',
  settings: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z'
};
---

<!-- Botón hamburguesa fijo -->
<button 
  id="mobile-menu-toggle"
  class="fixed top-4 right-4 z-50 lg:hidden bg-black/80 backdrop-blur-md border border-white/20 rounded-xl p-3 text-white hover:bg-black/90 transition-all duration-200"
  aria-label="Abrir menú"
>
  <svg id="menu-icon" class="w-6 h-6 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
  </svg>
  <svg id="close-icon" class="w-6 h-6 transition-transform duration-200 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
  </svg>
</button>

<!-- Overlay -->
<div 
  id="mobile-menu-overlay"
  class="fixed inset-0 bg-black/50 z-40 lg:hidden opacity-0 pointer-events-none transition-opacity duration-300"
></div>

<!-- Menú lateral -->
<nav 
  id="mobile-menu"
  class="fixed top-0 right-0 h-full w-80 max-w-[90vw] bg-gradient-to-br from-orange-900 via-orange-800 to-red-900 z-45 lg:hidden transform translate-x-full transition-transform duration-300 shadow-2xl overflow-y-auto"
>
  <div class="p-4 sm:p-6 pt-20 min-h-full flex flex-col">
    <!-- Header del menú -->
    <div class="mb-6 sm:mb-8 pb-4 sm:pb-6 border-b border-white/20">
      <h2 class="text-xl sm:text-2xl font-bold text-white mb-2">Nike FC Cards</h2>
      <p class="text-orange-200 text-xs sm:text-sm">Menú de navegación</p>
    </div>

    <!-- Lista de navegación -->
    <ul class="space-y-1 sm:space-y-2 flex-1">
      {navItems.map((item) => (
        <li>
          <a 
            href={item.href} 
            class={`flex items-center gap-3 sm:gap-4 px-3 sm:px-4 py-2 sm:py-3 rounded-lg sm:rounded-xl transition-all duration-200 text-sm sm:text-base ${
              isActive(item.href) 
                ? 'bg-white/20 text-white border border-white/30 shadow-lg' 
                : 'text-white/80 hover:text-white hover:bg-white/10 border border-transparent'
            }`}
          >
            <svg class="w-4 h-4 sm:w-5 sm:h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={icons[item.icon]}></path>
            </svg>
            <span class="font-medium truncate">{item.label}</span>
            {isActive(item.href) && (
              <div class="ml-auto w-2 h-2 bg-white rounded-full"></div>
            )}
          </a>
        </li>
      ))}
    </ul>

    <!-- Footer del menú -->
    <div class="mt-4 sm:mt-8 pt-4 sm:pt-6 border-t border-white/20 space-y-3 sm:space-y-4 flex-shrink-0">
      <!-- Botón para volver a la web principal -->
      <a 
        href="/" 
        class="flex items-center gap-2 sm:gap-3 px-3 sm:px-4 py-2 sm:py-3 rounded-lg sm:rounded-xl bg-white/10 hover:bg-white/20 text-white border border-white/20 hover:border-white/30 transition-all duration-200 group text-sm sm:text-base"
      >
        <svg class="w-4 h-4 sm:w-5 sm:h-5 flex-shrink-0 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        <span class="font-medium truncate">Volver a FC Bufas</span>
        <svg class="w-3 h-3 sm:w-4 sm:h-4 ml-auto opacity-60 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
        </svg>
      </a>
      
      <div class="flex items-center gap-2 sm:gap-3 text-orange-200 text-xs sm:text-sm">
        <svg class="w-3 h-3 sm:w-4 sm:h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <span class="truncate">Toca fuera para cerrar</span>
      </div>
    </div>
  </div>
</nav>

<script>
  function initMobileMenu() {
    const toggleButton = document.getElementById('mobile-menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const overlay = document.getElementById('mobile-menu-overlay');
    const menuIcon = document.getElementById('menu-icon');
    const closeIcon = document.getElementById('close-icon');
    
    if (!toggleButton || !menu || !overlay || !menuIcon || !closeIcon) {
      return;
    }

    let isOpen = false;

    function openMenu() {
      isOpen = true;
      menu.classList.remove('translate-x-full');
      overlay.classList.remove('opacity-0', 'pointer-events-none');
      menuIcon.classList.add('hidden');
      closeIcon.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
      isOpen = false;
      menu.classList.add('translate-x-full');
      overlay.classList.add('opacity-0', 'pointer-events-none');
      menuIcon.classList.remove('hidden');
      closeIcon.classList.add('hidden');
      document.body.style.overflow = '';
    }

    // Toggle al hacer clic en el botón
    toggleButton.addEventListener('click', () => {
      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    // Cerrar al hacer clic en el overlay
    overlay.addEventListener('click', closeMenu);

    // Cerrar con tecla ESC
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) {
        closeMenu();
      }
    });

    // Cerrar al navegar a otra página
    const menuLinks = menu.querySelectorAll('a[href]');
    menuLinks.forEach(link => {
      link.addEventListener('click', () => {
        setTimeout(closeMenu, 100); // Pequeño delay para que la navegación se vea fluida
      });
    });
  }

  // Inicializar cuando el DOM esté listo
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMobileMenu);
  } else {
    initMobileMenu();
  }

  // Reinicializar en navegaciones de Astro
  document.addEventListener('astro:page-load', initMobileMenu);
  document.addEventListener('astro:after-swap', initMobileMenu);
</script>

<style>
  /* Asegurar que el menú esté por encima de todo */
  #mobile-menu {
    z-index: 9998;
  }
  
  #mobile-menu-toggle {
    z-index: 9999;
  }
  
  #mobile-menu-overlay {
    z-index: 9997;
  }

  /* Mejoras visuales */
  #mobile-menu {
    box-shadow: -10px 0 25px -3px rgba(0, 0, 0, 0.3), -4px 0 10px -2px rgba(0, 0, 0, 0.1);
  }

  /* Animación suave para los íconos */
  #menu-icon, #close-icon {
    transition: all 0.2s ease-in-out;
  }

  /* Scroll personalizado para el menú */
  #mobile-menu {
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.3) transparent;
  }

  #mobile-menu::-webkit-scrollbar {
    width: 4px;
  }

  #mobile-menu::-webkit-scrollbar-track {
    background: transparent;
  }

  #mobile-menu::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.3);
    border-radius: 2px;
  }

  #mobile-menu::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.5);
  }
</style>
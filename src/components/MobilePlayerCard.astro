---
import type { Fighters } from '@/types/fighters'

interface Props {
  player: Fighters
}

const { player } = Astro.props
---

<a 
  href={`/luchador/${player.id}`}
  class="mobile-player-card block w-48 sm:w-56 flex-shrink-0 snap-center rounded-lg bg-gradient-to-t from-gray-900/80 to-transparent p-2 transition-all duration-300 hover:scale-105 hover:shadow-lg focus:outline-none focus:ring-2 focus:ring-orange-400"
  data-player-id={player.id}
>
  <div class="relative aspect-[3/4] overflow-hidden rounded-lg bg-gradient-to-t from-gray-800 to-gray-600">
    <img
      src={`/images/fighters/cards/${player.id}.webp`}
      alt={player.name}
      class="player-image h-full w-full object-cover transition-all duration-500"
      loading="lazy"
    />
    
    <!-- Overlay gradiente -->
    <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"></div>
    
    <!-- Información del jugador -->
    <div class="absolute bottom-0 left-0 right-0 p-2 text-white">
      <h3 class="text-sm font-bold tracking-wide">{player.name}</h3>
      {player.position && (
        <p class="text-xs text-orange-300">{player.position}</p>
      )}
      {player.goles !== undefined && (
        <div class="mt-1 flex gap-2 text-xs">
          <span class="rounded bg-orange-500/80 px-1">⚽ {player.goles}</span>
          {player.asistencias !== undefined && (
            <span class="rounded bg-blue-500/80 px-1">🅰️ {player.asistencias}</span>
          )}
        </div>
      )}
    </div>
    
    <!-- Efecto de brillo al hover -->
    <div class="absolute inset-0 -translate-x-full bg-gradient-to-r from-transparent via-white/20 to-transparent transition-transform duration-700 ease-in-out hover:translate-x-full"></div>
  </div>
</a>

<style>
  .mobile-player-card:hover .player-image {
    transform: scale(1.05);
    filter: brightness(1.1);
  }
  
  .mobile-player-card:focus .player-image {
    transform: scale(1.05);
    filter: brightness(1.1);
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const cards = document.querySelectorAll('.mobile-player-card')
    
    cards.forEach(card => {
      card.addEventListener('touchstart', () => {
        // Efecto visual al tocar en móvil
        card.classList.add('scale-95')
      })
      
      card.addEventListener('touchend', () => {
        card.classList.remove('scale-95')
      })
    })
  })
</script>

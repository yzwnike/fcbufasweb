---
import type { Fighters } from '@/types/fighters'

interface Props {
  player: Fighters
  position: {
    top: string
    left: string
  }
}

const { player, position } = Astro.props

// Solo mostrar jugadores que tengan estadísticas
const shouldShow = player.goles !== undefined
if (!shouldShow) return null
---

<div 
  class="field-player absolute transform -translate-x-1/2 -translate-y-1/2 cursor-pointer transition-all duration-300 hover:scale-110 hover:z-10"
  style={`top: ${position.top}; left: ${position.left};`}
  data-player-id={player.id}
>
  <div class="relative">
    <!-- Avatar del jugador -->
    <div class="player-avatar w-14 h-14 sm:w-20 sm:h-20 md:w-28 md:h-28 lg:w-32 lg:h-32 rounded-full overflow-hidden border-4 border-white shadow-lg bg-white">
      <img 
        src={`/images/fighters/cards/${player.id}.webp`} 
        alt={player.name}
        class="w-full h-full object-cover"
        loading="lazy"
      />
    </div>
    
    <!-- Información del jugador -->
    <div class="absolute -bottom-5 sm:-bottom-6 left-1/2 transform -translate-x-1/2 text-center">
      <div class="bg-white/90 backdrop-blur-sm px-1 py-0.5 sm:px-2 sm:py-1 rounded-full shadow-md border">
        <p class="text-[10px] sm:text-xs font-bold text-gray-900">{player.name}</p>
        <p class="text-[9px] sm:text-xs text-gray-600">{player.position}</p>
      </div>
    </div>
    
    <!-- Dorsal del jugador -->
    <div class="absolute -top-1 -right-1 sm:-top-2 sm:-right-2 bg-orange-500 text-white text-xs rounded-full w-5 h-5 sm:w-6 sm:h-6 flex items-center justify-center font-bold text-[10px] sm:text-xs">
      {player.dorsal || '?'}
    </div>
  </div>
</div>

<style>
  .field-player:hover {
    filter: brightness(1.1);
  }
  
  .field-player:hover .bg-white\/90 {
    background: rgba(255, 255, 255, 0.95);
  }
  
  .player-avatar {
    position: relative;
    animation: pulse-border 2s infinite;
  }
  
  .player-avatar::before {
    content: '';
    position: absolute;
    top: -4px;
    left: -4px;
    right: -4px;
    bottom: -4px;
    border-radius: 50%;
    background: linear-gradient(45deg, #ff6b35, #f7931e, #ffd23f, #06d6a0, #118ab2, #073b4c);
    background-size: 400%;
    z-index: -1;
    animation: gradient-rotate 3s linear infinite;
    opacity: 0.8;
  }
  
  .field-player:hover .player-avatar::before {
    opacity: 1;
    animation: gradient-rotate 1s linear infinite;
  }
  
  /* ANIMACIONES PARA JUGADOR SELECCIONADO */
  .field-player.selected {
    z-index: 100 !important;
    transform: translate(-48%, -50%) scale(1.15);
    filter: brightness(1.3) saturate(1.5);
  }
  
  .field-player.selected .player-avatar {
    animation: selected-pulse 1.5s infinite;
  }
  
  .field-player.selected .player-avatar::before {
    opacity: 1;
    animation: selected-rainbow 1s linear infinite;
    box-shadow: 0 0 30px rgba(255, 107, 53, 0.8);
  }
  
  /* Anillo giratorio exterior */
  .field-player.selected::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 150%;
    height: 150%;
    transform: translate(-50%, -50%);
    border: 3px solid transparent;
    border-radius: 50%;
    background: linear-gradient(45deg, #ff6b35, #f7931e, #ffd23f, #06d6a0, #118ab2, #073b4c) border-box;
    mask: linear-gradient(#fff 0 0) padding-box, linear-gradient(#fff 0 0);
    mask-composite: xor;
    animation: spin-ring 2s linear infinite;
    z-index: -1;
  }
  
  /* Partículas flotantes */
  .field-player.selected::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 200%;
    height: 200%;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle at 20% 20%, #ff6b35 2px, transparent 3px),
                radial-gradient(circle at 80% 30%, #f7931e 2px, transparent 3px),
                radial-gradient(circle at 30% 80%, #ffd23f 2px, transparent 3px),
                radial-gradient(circle at 70% 70%, #06d6a0 2px, transparent 3px),
                radial-gradient(circle at 90% 90%, #118ab2 2px, transparent 3px);
    animation: particles-float 3s linear infinite;
    z-index: -2;
    opacity: 0.8;
  }
  
  @keyframes gradient-rotate {
    0% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
    100% {
      background-position: 0% 50%;
    }
  }
  
  @keyframes pulse-border {
    0%, 100% {
      box-shadow: 0 0 0 0 rgba(255, 107, 53, 0.4);
    }
    50% {
      box-shadow: 0 0 0 8px rgba(255, 107, 53, 0);
    }
  }
  
  @keyframes selected-pulse {
    0%, 100% {
      box-shadow: 0 0 0 0 rgba(255, 107, 53, 0.8),
                  0 0 20px rgba(255, 107, 53, 0.6),
                  0 0 40px rgba(255, 107, 53, 0.4);
    }
    50% {
      box-shadow: 0 0 0 15px rgba(255, 107, 53, 0),
                  0 0 30px rgba(255, 107, 53, 0.8),
                  0 0 60px rgba(255, 107, 53, 0.6);
    }
  }
  
  @keyframes selected-rainbow {
    0% {
      background: linear-gradient(45deg, #ff6b35, #f7931e, #ffd23f, #06d6a0, #118ab2, #073b4c);
      background-position: 0% 50%;
    }
    25% {
      background: linear-gradient(45deg, #f7931e, #ffd23f, #06d6a0, #118ab2, #073b4c, #ff6b35);
      background-position: 25% 50%;
    }
    50% {
      background: linear-gradient(45deg, #ffd23f, #06d6a0, #118ab2, #073b4c, #ff6b35, #f7931e);
      background-position: 50% 50%;
    }
    75% {
      background: linear-gradient(45deg, #06d6a0, #118ab2, #073b4c, #ff6b35, #f7931e, #ffd23f);
      background-position: 75% 50%;
    }
    100% {
      background: linear-gradient(45deg, #118ab2, #073b4c, #ff6b35, #f7931e, #ffd23f, #06d6a0);
      background-position: 100% 50%;
    }
  }
  
  @keyframes spin-ring {
    0% {
      transform: translate(-50%, -50%) rotate(0deg);
    }
    100% {
      transform: translate(-50%, -50%) rotate(360deg);
    }
  }
  
  @keyframes particles-float {
    0% {
      transform: translate(-50%, -50%) rotate(0deg);
      opacity: 0.8;
    }
    50% {
      opacity: 1;
    }
    100% {
      transform: translate(-50%, -50%) rotate(360deg);
      opacity: 0.8;
    }
  }
</style>

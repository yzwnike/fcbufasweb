---
import BoxerCard from '@/components/BoxerCard.astro'
import BoxerBigImages from '@/components/Boxers/BoxerBigImages.astro'
import MobilePlayerCard from '@/components/MobilePlayerCard.astro'
import type { Fighters } from '@/types/fighters'
import HorizontalScroll from '@/components/Icons/HorizontalScroll.astro'
import { getBoxerById, getBoxerVersusById } from '@/lib/get-boxers'
import { removeMirroredPairs } from '@/utils/remove-mirrored-pairs'

interface Props {
  boxers: Fighters[]
  selectedBoxer: Fighters
}

const { boxers, selectedBoxer } = Astro.props

const firstRow = boxers.slice(0, 4)
const leftRow = firstRow.slice(0, 2)
const rightRow = firstRow.slice(2)

const secondRow = boxers.slice(4)
const leftSecondRow = secondRow.slice(0, 4)
const rightSecondRow = secondRow.slice(4, 10)

// Para móviles, mostrar todos los jugadores con estadísticas (incluir a Alex y Dani)
const playersWithStats = boxers.filter(player => 
  player.goles !== undefined
)

// Ordenar para que marcos sea el primero
const mobileBoxers = [
  playersWithStats.find(player => player.id === 'marcos'),
  ...playersWithStats.filter(player => player.id !== 'marcos'),
].filter(Boolean)

const animationDelay = [500, 700, 800]
const reverseDelay = [...animationDelay].reverse()

const animationDelaySecondRow = [...animationDelay, 900]
const reverseDelaySecondRow = [...animationDelaySecondRow].reverse()
---

<>
  <BoxerBigImages boxers={boxers} />

  <div
    id="fighters-selection-container"
    class="relative flex h-full w-full max-w-6xl flex-col items-center justify-end gap-4 p-2 sm:gap-8 sm:p-4"
  >
    <div
      class="hidden w-full flex-wrap justify-center gap-2 px-0 sm:gap-4 sm:justify-between sm:px-4 md:flex"
    >
      <div class="flex flex-wrap justify-start gap-2 sm:gap-4">
        {
          leftRow.map(({ id, name, versus }, index) => (
            <div
              class={`animate-fade-in-right animate-duration-slower animate-delay-${animationDelay[index]}`}
            >
              <BoxerCard id={id} name={name} class="boxer-left" versus={versus} />
            </div>
          ))
        }
      </div>

      <div class="hidden flex-wrap justify-end gap-2 sm:gap-4 md:flex">
        {
          rightRow.map(({ id, name, versus }, index) => (
            <div
              class={`animate-fade-in-left animate-duration-slower animate-delay-${reverseDelay[index]}`}
            >
              <BoxerCard id={id} name={name} class="boxer-right" versus={versus} />
            </div>
          ))
        }
      </div>
    </div>

    <div class="hidden flex-wrap justify-center gap-2 sm:gap-4 sm:justify-between md:flex">
      <div class="flex flex-wrap justify-start gap-2 sm:gap-4">
        {
          leftSecondRow.map(({ id, name, versus }, index) => (
            <div class={`animate-fade-in-up animate-delay-${animationDelaySecondRow[index]}`}>
              <BoxerCard id={id} name={name} class="boxer-left" versus={versus} />
            </div>
          ))
        }
      </div>
      <div class="hidden flex-wrap justify-end gap-2 sm:gap-4 md:flex">
        {
          rightSecondRow.map(({ id, name, versus }, index) => (
            <div class={`animate-fade-in-up animate-delay-${reverseDelaySecondRow[index]}`}>
              <BoxerCard id={id} name={name} class="boxer-right" versus={versus} />
            </div>
          ))
        }
      </div>
    </div>
  </div>
  <div class="-mt-16 flex flex-col items-center justify-center sm:-mt-20 md:mt-32 md:hidden">
    <!-- Mensaje de instrucción -->
    <div class="mb-2 px-4 text-center">
      <p class="text-theme-seashell text-sm font-medium opacity-80 animate-fade-in animate-delay-300">
        Desliza y selecciona tu jugador favorito
      </p>
    </div>
    <div class="mt-4 w-full max-w-[100vw] overflow-x-scroll sm:mt-8">
      <div
        class="fadeout-horizontal no-scrollbar flex snap-x snap-mandatory gap-8 sm:gap-12 overflow-x-scroll py-2 pr-[30%] sm:pr-[40%]"
      >
        {
          mobileBoxers
            .filter((boxer): boxer is Fighters => boxer !== undefined)
            .map((boxer, index) => (
              <div
                class:list={`w-fit flex-shrink-0 snap-center px-1 sm:px-2 ${index === 0 ? 'ml-[60%] sm:ml-[75%]' : ''} `}
              >
                <MobilePlayerCard
                  player={boxer}
                />
              </div>
            ))
        }
      </div>
    </div>
    <HorizontalScroll class:list={['text-theme-seashell w-12 sm:w-16 pt-1 sm:pt-2 opacity-80']} />
  </div>
</>

<style>
  .fadeout-horizontal {
    mask-image: linear-gradient(
      to right,
      transparent,
      black 4.5rem,
      black calc(100% - 4.5rem),
      transparent
    );
  }
</style>

---
import { ClientRouter } from 'astro:transitions'
import Analytics from '@vercel/analytics/astro'

import '@/styles/global.css'

import Header from '@/sections/Header.astro'
import Footer from '@/sections/Footer.astro'
import { fixedTitle } from '@/consts/pageTitles'
import Spotlight from '@/components/Spotlight.astro'
interface Props {
  title: string
  description?: string
  canonical?: string
  robots?: string
}

const {
  title = fixedTitle,
  description = 'Web Oficial FC Bufas - Estreno Temporada 2025/26',
  canonical,
  robots,
} = Astro.props
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>
      {title}
    </title>

    <!-- Google Search Console verification -->
    <meta name="google-site-verification" content="5VbbhgXvfqr73PyLPF2xhixWaQN3RBNUA2hpRRCKIS4" />

    <!-- SEO Keywords and optimization -->
    <meta name="keywords" content="FC Bufas, Futbol Club Bufas, Bufas FC, Bufas, equipo de fútbol, fútbol español, temporada 2025/26, estadísticas fútbol, jugadores FC Bufas, partidos FC Bufas, club de fútbol, liga española, Yazawa, Nico Vehí, Pablo Vehí, Albert Rodríguez, Marc Sánchez, Mario Roca, Marcos López, Paul Aznar, Javo Ayesta, Daniel García, Alejandro Martínez" />
    <meta name="author" content="FC Bufas" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="language" content="Spanish" />
    <meta name="geo.region" content="ES-CT" />
    <meta name="geo.placename" content="Barcelona, España" />
    <meta name="geo.position" content="41.3851;2.1734" />
    <meta name="ICBM" content="41.3851, 2.1734" />
    
    <!-- Additional SEO tags -->
    <meta name="theme-color" content="#ff6b35" />
    <meta name="msapplication-TileColor" content="#ff6b35" />
    <meta name="apple-mobile-web-app-title" content="FC Bufas" />
    <meta name="application-name" content="FC Bufas" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Preload de las fuentes para que no se vea el cambio de fuente al cargar la pagina -->
    <link
      rel="preload"
      href="/fonts/anisette-medium.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/fonts/anisette-bold.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {robots && <meta name="robots" content={robots} />}


    <meta property="og:url" content="https://fcbufasweb.vercel.app" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://fcbufasweb.vercel.app/og.jpg" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="FC Bufas" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@fcbufas" />
    <meta name="twitter:creator" content="@fcbufas" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://fcbufasweb.vercel.app/og.jpg" />

    <!-- Datos estructurados para Evento (Schema.org) -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Event",
        "name": "FC Bufas",
        "description": "Web Oficial FC Bufas - Estreno Temporada 2025/26",
        "image": "https://www.fcbufasweb.vercel.app/logo.webp",
        "startDate": "2025-07-26T18:00:00+02:00",
        "endDate": "2025-07-27T02:00:00+02:00",
        "eventStatus": "https://schema.org/EventScheduled",
        "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
        "location": {
          "@type": "Place",
          "name": "Estadio Garbí",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Barcelona",
            "addressRegion": "Cataluña",
            "addressCountry": "ES"
          }
        },
        "organizer": {
          "@type": "Person",
          "name": "Nico Vehí"
        },
        "offers": {
          "@type": "Offer",
          "url": "",
          "availability": "",
          "priceCurrency": "EUR",
          "validFrom": "2025-04-01T12:00:00+02:00"
        },
        "performer": {
          "@type": "PerformingGroup",
          "name": "Creadores de contenido"
        }
      }
    </script>

    <!-- Datos estructurados para Club de Fútbol (Schema.org) -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "SportsOrganization",
        "name": "FC Bufas",
        "alternateName": ["Futbol Club Bufas", "Bufas FC", "Bufas"],
        "description": "Club de fútbol español fundado por creadores de contenido. Temporada oficial 2025/26.",
        "url": "https://fcbufasweb.vercel.app",
        "logo": "https://fcbufasweb.vercel.app/logo.webp",
        "image": "https://fcbufasweb.vercel.app/og.jpg",
        "sport": "Football",
        "foundingDate": "2025",
        "location": {
          "@type": "Place",
          "name": "Barcelona",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Barcelona",
            "addressRegion": "Cataluña",
            "addressCountry": "ES"
          }
        },
        "founder": {
          "@type": "Person",
          "name": "Nico Vehí",
          "alternateName": "Yazawa"
        },
        "member": [
          {
            "@type": "Person",
            "name": "Albert Rodríguez",
            "jobTitle": "Jugador - Medio Izquierdo"
          },
          {
            "@type": "Person",
            "name": "Javo Ayesta",
            "jobTitle": "Jugador - Medio Centro"
          },
          {
            "@type": "Person",
            "name": "Pablo Vehí Roca",
            "jobTitle": "Jugador - Lateral Derecho"
          },
          {
            "@type": "Person",
            "name": "Marc Sánchez",
            "alternateName": "Míster",
            "jobTitle": "Jugador - Defensa Central"
          },
          {
            "@type": "Person",
            "name": "Mario Roca",
            "jobTitle": "Jugador - Medio Centro"
          },
          {
            "@type": "Person",
            "name": "Marcos López",
            "jobTitle": "Jugador - Delantero Centro"
          },
          {
            "@type": "Person",
            "name": "Paul Aznar",
            "jobTitle": "Jugador - Delantero Centro"
          }
        ],
        "sameAs": [
          "https://fcbufasweb.vercel.app"
        ]
      }
    </script>
    <ClientRouter />
    <Analytics />
  </head>
  <body>
    <Spotlight />
    <Header />
    <!-- Añadir skip link para que los usuarios de teclado puedan saltar al contenido principal -->
    <a href="#main-content" class="sr-only focus:not-sr-only"> Saltar al contenido principal </a>
    <main id="main-content">
      <div
        transition:persist
        class="mask-fade-bottom absolute inset-0 w-full bg-[url('/images/hero.avif')] bg-cover bg-center"
      >
      </div>
      <slot />
    </main>
    
    <Footer />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
    background: #b66a23;
    display: flex;
    flex-direction: column;
  }
</style>
